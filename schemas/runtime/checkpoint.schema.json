{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fenatodev/lai-harness/schemas/runtime/checkpoint.schema.json",
  "title": "LAI recovery checkpoint",
  "type": "object",
  "required": ["schema_version", "root", "run_id", "mode", "phase", "terminal", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "root": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "terminal": {"type": "boolean"},
    "tracked_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
