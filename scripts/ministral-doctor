#!/usr/bin/env bash
set -euo pipefail

key_file="${LAI_API_KEY_FILE:-$HOME/.config/lai/llama-api-key}"
host="${LAI_HOST:-$(ip route | awk '/default/ {print $3; exit}')}"
port="${LAI_PORT:-8080}"

if [[ ! -s "$key_file" ]]; then
    echo "API key: MISSING ($key_file)"
    exit 1
fi

probe_auth() {
    python3 - "$host" "$port" "$key_file" <<'PYCODE'
import sys
import urllib.error
import urllib.request

host, port, key_file = sys.argv[1:4]
try:
    with open(key_file, encoding="utf-8") as handle:
        key = handle.read().strip()
    request = urllib.request.Request(
        f"http://{host}:{port}/props",
        headers={"Authorization": "Bearer " + key},
    )
    with urllib.request.urlopen(request, timeout=3) as response:
        print(response.status)
except urllib.error.HTTPError as exc:
    print(exc.code)
except Exception:
    print("000")
PYCODE
}

unauth="$(curl -sS --max-time 3 -o /dev/null -w '%{http_code}'     "http://${host}:${port}/props" 2>/dev/null || true)"
auth="$(probe_auth 2>/dev/null || true)"

echo "# lai doctor"
echo "Server address: ${host}:${port}"
echo "Unauthenticated /props: HTTP ${unauth:-000}"
echo "Authenticated /props:   HTTP ${auth:-000}"

if [[ "$auth" == "200" && "$unauth" != "200" ]]; then
    echo "Authentication: OK"
else
    echo "Authentication: FAILED"
    exit 1
fi
