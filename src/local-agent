def python_search_fallback(query, target):
    import re

    try:
        pattern = re.compile(query)
    except re.error as exc:
        return f"ERROR: invalid search pattern: {exc}"

    if target.is_file():
        candidates = [target]
    else:
        candidates = target.rglob("*")

    matches = []
    excluded_dirs = {
        ".git",
        ".venv",
        "venv",
        "node_modules",
        "__pycache__",
        ".pytest_cache",
        ".mypy_cache",
        ".ruff_cache",
        ".cache",
        "dist",
        "build",
    }

    for candidate in candidates:
        try:
            if not candidate.is_file() or candidate.is_symlink():
                continue

            relative = candidate.relative_to(ROOT)

            if any(part in excluded_dirs for part in relative.parts[:-1]):
                continue

            with candidate.open(
                "r",
                encoding="utf-8",
                errors="replace",
            ) as handle:
                for line_number, line in enumerate(handle, 1):
                    if "\x00" in line:
                        break

                    if pattern.search(line):
                        matches.append(
                            f"{relative.as_posix()}:"
                            f"{line_number}:"
                            f"{line.rstrip()}"
                        )

                        if len(matches) >= 120:
                            return trim("\n".join(matches))
        except (OSError, UnicodeError, ValueError):
            continue

    if not matches:
        return "No matches found."

    return trim("\n".join(matches))


def tool_search(args):
    query = args["query"]
    target = safe_path(args.get("path", "."))

    if not target.exists():
        return f"ERROR: path not found: {args.get('path', '.')}"

    try:
        proc = subprocess.run(
            [
                "rg",
                "-n",
                "--hidden",
                "--glob",
                "!.git",
                "--max-count",
                "120",
                query,
                str(target),
            ],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=30,
        )
    except FileNotFoundError:
        return python_search_fallback(query, target)
    except subprocess.TimeoutExpired:
        return "ERROR: search timed out after 30 seconds"

    if proc.returncode == 1:
        return "No matches found."

    if proc.returncode not in (0, 1):
        return trim(
            f"ERROR: rg exited with code {proc.returncode}\n"
            + proc.stderr
        )

    return trim(proc.stdout)


def tool_list(args):
    target = safe_path(args.get("path", "."))
    max_depth = max(1, min(int(args.get("max_depth", 2)), 4))
    max_entries = 120

    if not target.exists():
        return f"ERROR: path not found: {args.get('path', '.')}"

    if target.is_file():
        return str(target.relative_to(ROOT))

    entries = []
    stack = [(target, 0)]

    while stack and len(entries) < max_entries:
        current, depth = stack.pop()

        try:
            children = sorted(
                current.iterdir(),
                key=lambda child: (not child.is_dir(), child.name.lower()),
            )
        except OSError as e:
            rel = current.relative_to(ROOT)
            entries.append(f"[error] {rel}: {e}")
            continue

        directories = []

        for child in children:
            if child.name == ".git":
                continue

            try:
                rel = child.relative_to(ROOT)
            except ValueError:
                continue

            if child.is_symlink():
                entries.append(f"[link] {rel}")
            elif child.is_dir():
                entries.append(f"[dir]  {rel}/")
                if depth + 1 < max_depth:
                    directories.append(child)
            else:
                entries.append(f"[file] {rel}")

            if len(entries) >= max_entries:
                break

        for directory in reversed(directories):
            stack.append((directory, depth + 1))

    if not entries:
        return "[empty directory]"

    output = "\n".join(entries)

    if len(entries) >= max_entries:
        output += "\n[list truncated at 120 entries]"

    return trim(output)


def tool_git(args):
    operation = args.get("operation")
    raw_path = args.get("path")

    max_diff_chars = 5000
    preview_per_file = 800
    preview_total = 2400

    pathspec = None

    if raw_path:
        p = safe_path(raw_path)
        pathspec = str(p.relative_to(ROOT))

    def run_git(parts):
        try:
            proc = subprocess.run(
                ["git", *parts],
                cwd=ROOT,
                text=True,
                capture_output=True,
                timeout=30,
            )
        except subprocess.TimeoutExpired:
            return None, "ERROR: git command timed out after 30 seconds"

        output = proc.stdout

        if proc.stderr:
            output += ("\n" if output else "") + proc.stderr

        if proc.returncode != 0:
            return None, trim(
                f"ERROR: git exited with code {proc.returncode}\n"
                + (output if output else "[no output]")
            )

        return output, None

    def make_diff(cached=False):
        parts = [
            "diff",
            "--no-ext-diff",
            "--no-color",
            "--unified=2",
        ]

        if cached:
            parts.insert(1, "--cached")

        if pathspec:
            parts.extend(["--", pathspec])

        output, error = run_git(parts)

        if error:
            return error

        if not output:
            return "[no changes]"

        if len(output) <= max_diff_chars:
            return output

        return (
            output[:max_diff_chars]
            + "\n\n[diff truncated at 5000 characters; "
              "use read/search for additional context if needed]"
        )

    if operation == "status":
        parts = ["status", "--short"]

        if pathspec:
            parts.extend(["--", pathspec])

        output, error = run_git(parts)

        if error:
            return error

        return trim(output if output else "[clean working tree]")

    if operation == "diff":
        return trim(make_diff(cached=False))

    if operation == "diff-staged":
        return trim(make_diff(cached=True))

    if operation != "changes":
        return f"ERROR: unsupported git operation: {operation}"

    # --------------------------------------------------------
    # Compact Git-change triage
    # --------------------------------------------------------

    status, error = run_git(["status", "--short"])

    if error:
        return error

    if not status:
        return "[clean working tree]"

    unstaged_raw, error = run_git(["diff", "--name-only"])

    if error:
        return error

    staged_raw, error = run_git(["diff", "--cached", "--name-only"])

    if error:
        return error

    untracked_raw, error = run_git([
        "ls-files",
        "--others",
        "--exclude-standard",
    ])

    if error:
        return error

    unstaged = [x for x in unstaged_raw.splitlines() if x]
    staged = [x for x in staged_raw.splitlines() if x]
    untracked = [x for x in untracked_raw.splitlines() if x]

    ordered = []

    for rel in unstaged + staged + untracked:
        if rel not in ordered:
            ordered.append(rel)

    sections = [
        "[git status]",
        status.strip(),
        "",
        "[change previews]",
    ]

    used = sum(len(x) + 1 for x in sections)

    for rel in ordered[:12]:
        kinds = []

        if rel in unstaged:
            kinds.append("unstaged")

        if rel in staged:
            kinds.append("staged")

        if rel in untracked:
            kinds.append("untracked")

        header = f"\n--- {rel} ({', '.join(kinds)}) ---\n"

        if used + len(header) >= preview_total:
            break

        sections.append(header.rstrip())
        used += len(header)

        available = min(
            preview_per_file,
            max(0, preview_total - used),
        )

        if available <= 0:
            break

        preview_parts = []

        if rel in unstaged:
            patch, patch_error = run_git([
                "diff",
                "--no-ext-diff",
                "--no-color",
                "--unified=1",
                "--",
                rel,
            ])

            if patch_error:
                preview_parts.append(patch_error)
            elif patch:
                preview_parts.append(patch)

        if rel in staged:
            patch, patch_error = run_git([
                "diff",
                "--cached",
                "--no-ext-diff",
                "--no-color",
                "--unified=1",
                "--",
                rel,
            ])

            if patch_error:
                preview_parts.append(patch_error)
            elif patch:
                preview_parts.append(patch)

        if rel in untracked:
            try:
                file_path = safe_path(rel)

                if file_path.is_file():
                    data = file_path.read_bytes()[:preview_per_file + 1]

                    if b"\x00" in data:
                        preview_parts.append("[binary untracked file]")
                    else:
                        text = data[:preview_per_file].decode(
                            errors="replace"
                        )
                        preview_parts.append(
                            "[untracked file preview]\n" + text
                        )
            except Exception as e:
                preview_parts.append(
                    f"[unable to preview untracked file: {e}]"
                )

        preview = "\n".join(preview_parts).strip()

        if not preview:
            preview = "[no textual preview]"

        if len(preview) > available:
            preview = (
                preview[:available]
                + "\n[preview truncated; request this file "
                  "specifically if deeper inspection is needed]"
            )

        sections.append(preview)
        used += len(preview)

        if used >= preview_total:
            break

    if len(ordered) > 12 or used >= preview_total:
        sections.extend([
            "",
            "[triage note]",
            "The snapshot is intentionally compact. "
            "Inspect a specific suspicious file with git diff/diff-staged "
            "path=<file>, or read an untracked file, only when needed.",
        ])

    return trim("\n".join(sections))



def _parse_web_positive_int(raw, *, maximum, label, minimum=1):
    try:
        value = int(raw)
    except (TypeError, ValueError) as exc:
        raise SystemExit(WEB_USAGE) from exc
    if not minimum <= value <= maximum:
        raise SystemExit(f"{label} must be between {minimum} and {maximum}")
    return value


def handle_web_evidence(args):
    args = list(args)
    if not args or args[0] in {"--help", "-h", "help"}:
        print(WEB_USAGE)
        return
    command = args.pop(0)
    json_mode = False
    try:
        if command == "search":
            max_results = WEB_SEARCH_DEFAULT_RESULTS
            query_parts = []
            index = 0
            while index < len(args):
                value = args[index]
                if value == "--json":
                    json_mode = True
                    index += 1
                elif value == "--max-results":
                    if index + 1 >= len(args):
                        raise SystemExit(WEB_USAGE)
                    max_results = _parse_web_positive_int(
                        args[index + 1],
                        maximum=WEB_SEARCH_MAX_RESULTS,
                        label="max-results",
                    )
                    index += 2
                elif value.startswith("--"):
                    raise SystemExit(WEB_USAGE)
                else:
                    query_parts.append(value)
                    index += 1
            query = " ".join(query_parts).strip()
            payload = search_web_evidence(query, max_results=max_results)
            if json_mode:
                print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
            else:
                print(render_web_evidence("search", payload))
            return
        if command == "fetch":
            max_chars = WEB_DEFAULT_TEXT_CHARS
            url = None
            index = 0
            while index < len(args):
                value = args[index]
                if value == "--json":
                    json_mode = True
                    index += 1
                elif value == "--max-chars":
                    if index + 1 >= len(args):
                        raise SystemExit(WEB_USAGE)
                    max_chars = _parse_web_positive_int(
                        args[index + 1],
                        maximum=WEB_MAX_TEXT_CHARS,
                        label="max-chars",
                        minimum=200,
                    )
                    index += 2
                elif value.startswith("--"):
                    raise SystemExit(WEB_USAGE)
                elif url is None:
                    url = value
                    index += 1
                else:
                    raise SystemExit(WEB_USAGE)
            payload = fetch_web_evidence(url, max_chars=max_chars)
            if json_mode:
                print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
            else:
                print(render_web_evidence("fetch", payload))
            return
    except ValueError as exc:
        raise SystemExit(f"ERROR: {exc}") from exc
    raise SystemExit(WEB_USAGE)


