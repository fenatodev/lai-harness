def _control_mcp_validate_artifact_args(arguments):
    if not isinstance(arguments, dict):
        raise ValueError("arguments must be a JSON object")
    unknown = sorted(set(arguments) - {"path", "content"})
    if unknown:
        raise ValueError("unknown argument fields: " + ", ".join(unknown))
    path = arguments.get("path")
    content = arguments.get("content")
    if not isinstance(path, str) or not path:
        raise ValueError("arguments.path must be a non-empty string")
    rel = PurePosixPath(path)
    if rel.is_absolute() or ".." in rel.parts or not rel.parts or rel.parts[0] != "artifacts":
        raise ValueError("arguments.path must stay under artifacts/")
    if any(part in {"", ".", ".git"} for part in rel.parts):
        raise ValueError("arguments.path is invalid")
    if not isinstance(content, str):
        raise ValueError("arguments.content must be a string")
    raw = content.encode("utf-8")
    if len(raw) > CONTROL_MCP_FIXTURE_ARTIFACT_LIMIT_BYTES:
        raise ValueError("arguments.content is too large")
    return str(rel), content, raw


