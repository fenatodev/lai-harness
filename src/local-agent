    def task_explicitly_requires_test_change(value):
        low = value.lower()

        phrases = (
            "adicione um teste",
            "adicione testes",
            "adicionar um teste",
            "adicionar testes",
            "crie um teste",
            "crie testes",
            "criar um teste",
            "criar testes",
            "escreva um teste",
            "escreva testes",
            "atualize o teste",
            "atualize os testes",
            "add a test",
            "add tests",
            "create a test",
            "create tests",
            "write a test",
            "write tests",
            "update the test",
            "update tests",
        )

        if any(phrase in low for phrase in phrases):
            return True

        # Explicit test paths can express the same requirement without
        # natural-language phrases such as "add a test". For example:
        # "Create app.py and tests/test_app.py".
        test_path_patterns = (
            r"(?:^|[\s`'\"(])(?:\.?/)?tests?/[^\s`'\",)]+",
            r"(?:^|[\s`'\"(])test_[A-Za-z0-9_.-]+",
            r"(?:^|[\s`'\"(])[A-Za-z0-9_.-]+\.(?:test|spec)\.[A-Za-z0-9_.-]+",
        )

        change_verb = re.search(
            r"\b(?:add|create|write|update|modify|change)\b",
            low,
        )

        explicit_test_path = any(
            re.search(pattern, low)
            for pattern in test_path_patterns
        )

        return bool(change_verb and explicit_test_path)

