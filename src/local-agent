        "Previous run: " + str(checkpoint.get("run_id") or "[unknown]"),
        "Previous phase: " + str(checkpoint.get("phase") or "[unknown]"),
        "Previous tool: " + str(checkpoint.get("last_tool") or "[none]"),
        "This is a fresh run. Do not assume any previous tool call should be replayed.",
    ]
    if tracked:
        lines.append("Tracked files at checkpoint: " + ", ".join(tracked))
    return "\n".join(lines)[:1400]


def normalize_workspace_state_paths(items):
    """Keep only verified regular files inside the current repository."""
    root = ROOT.resolve()
    normalized = []
    seen = set()

    for raw_path in items or []:
        try:
            value = str(raw_path).strip()

            if not value or value in {".", "./"}:
                continue

            candidate = Path(value)

            if not candidate.is_absolute():
                candidate = ROOT / candidate

            resolved = candidate.resolve(strict=True)

            try:
                relative = resolved.relative_to(root)
            except ValueError:
                continue

            if not resolved.is_file():
                continue

            relative_text = relative.as_posix()

            if relative_text in seen:
                continue

            seen.add(relative_text)
            normalized.append(relative_text)

        except (OSError, RuntimeError, ValueError):
            continue

    return normalized[-12:]


def load_workspace_state():
    json_path, _ = workspace_state_paths()

    base = {
        "schema_version": RUNTIME_RECORD_SCHEMA_VERSION,
        "root": str(ROOT),
        "updated_at": None,
        "last_mode": None,
        "last_task": None,
        "recent_files": [],
        "modified_files": [],
        "last_validation": None,
        "last_command": None,
        "last_git_operation": None,
        "git_status": None,
        "git_branch": None,
        "last_answer": None,
        "handoff_note": None,
    }

    if not json_path.is_file():
        return base

    try:
        data = json.loads(
            json_path.read_text(errors="replace")
        )

        version = data.get("schema_version")
        if version not in {None, RUNTIME_RECORD_SCHEMA_VERSION}:
            return base

        if data.get("root") != str(ROOT):
            return base

        base.update(data)
        base["schema_version"] = RUNTIME_RECORD_SCHEMA_VERSION

        base["recent_files"] = normalize_workspace_state_paths(
            base.get("recent_files")
        )
        base["modified_files"] = normalize_workspace_state_paths(
            base.get("modified_files")
        )
    except Exception:
        pass

    return base


def workspace_git_branch():
    try:
        proc = subprocess.run(
            ["git", "branch", "--show-current"],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=10,
        )

        if proc.returncode != 0:
            return "[unavailable]"

        return proc.stdout.strip() or "[detached HEAD]"
    except Exception:
        return "[unavailable]"


def workspace_git_head():
    try:
        proc = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=10,
        )
        if proc.returncode != 0:
            return "[unavailable]"
        return proc.stdout.strip() or "[unavailable]"
    except Exception:
        return "[unavailable]"


def cleanup_stale_workspace_states(max_age_days=None):
    time = __import__("time")

    if not STATE_BASE.is_dir():
        return

    if max_age_days is None:
        max_age_days = STATE_RETENTION_DAYS

    cutoff = (
        time.time()
        - max_age_days * 24 * 60 * 60
    )

    for json_path in STATE_BASE.glob("*.json"):
        try:
            if json_path.stat().st_mtime >= cutoff:
                continue

            md_path = json_path.with_suffix(".md")

            json_path.unlink(missing_ok=True)
            md_path.unlink(missing_ok=True)
        except Exception:
            pass


def workspace_git_status():
    try:
        proc = subprocess.run(
            ["git", "status", "--short"],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=10,
        )

        if proc.returncode != 0:
            return "[unavailable]"

        lines = proc.stdout.splitlines()

        if not lines:
            return "[clean]"

        output = "\n".join(lines[:15])

        if len(lines) > 15:
            output += "\n[status truncated]"

        return output
    except Exception:
        return "[unavailable]"


def render_workspace_handoff(state, compact=False):
    recent = state.get("recent_files") or []
    modified = state.get("modified_files") or []
    validation = state.get("last_validation")
    git_status = state.get("git_status") or "[unknown]"

    if compact:
        sections = [
            "PRIOR WORKSPACE CONTEXT "
            "(compact; may be stale; current request and repository "
            "evidence always override it):"
        ]

        if state.get("git_branch"):
            sections.append(
                "Git branch: "
                + str(state["git_branch"])[:150]
            )

        if state.get("last_task"):
            sections.append(
                "Previous task: "
                + str(state["last_task"])[:500]
            )

        if recent:
            sections.append(
                "Recent relevant files: "
                + ", ".join(recent[-8:])
            )

        if modified:
            sections.append(
                "Recently modified files: "
                + ", ".join(modified[-8:])
            )

        if validation:
            command = str(
                validation.get("command", "")
            )[:300]

            result = str(
                validation.get("result", "")
            ).replace("\n", " ")[:350]

            sections.append(
                f"Last validation: {command} -> {result}"
            )

        if state.get("handoff_note"):
            sections.append(
                "Handoff note: "
                + str(state["handoff_note"])[:500]
            )

        if state.get("last_answer"):
            sections.append(
                "Previous result: "
                + str(state["last_answer"])
                    .replace("\n", " ")[:500]
            )

        return "\n".join(sections)[:1600]

    lines = [
        "# lai workspace handoff",
        "",
        f"Repository: {state.get('root', ROOT)}",
        f"Branch: {state.get('git_branch') or '[unknown]'}",
        f"Updated: {state.get('updated_at') or '[unknown]'}",
        f"Last mode: {state.get('last_mode') or '[none]'}",
        "",
        "## Last task",
        state.get("last_task") or "[none]",
        "",
        "## Recent relevant files",
    ]

    if recent:
        lines.extend(f"- {item}" for item in recent[-12:])
    else:
        lines.append("- [none]")

    lines.extend([
        "",
        "## Recently modified files",
    ])

    if modified:
        lines.extend(
            f"- {item}"
            for item in modified[-12:]
        )
    else:
        lines.append("- [none]")

    lines.extend([
        "",
        "## Last validation",
    ])

    if validation:
        lines.append(
            f"Command: {validation.get('command', '[unknown]')}"
        )
        lines.append(
            "Result: "
            + str(
                validation.get("result", "[unknown]")
            )[:800]
        )
    else:
        lines.append("[none]")

    lines.extend([
        "",
        "## Git status",
        "```text",
        git_status,
        "```",
    ])

    if state.get("handoff_note"):
        lines.extend([
            "",
            "## Handoff note",
            str(state["handoff_note"])[:1500],
        ])

    if state.get("last_answer"):
        lines.extend([
            "",
            "## Last result",
            str(state["last_answer"])[:1800],
        ])

    lines.extend([
        "",
        "## Rule",
        "Current repository evidence and the current user request "
        "override this handoff if anything here is stale.",
    ])

    return "\n".join(lines)[:7000]


def save_workspace_state(state):
    time = __import__("time")

    STATE_BASE.mkdir(
        parents=True,
        exist_ok=True,
    )

    cleanup_stale_workspace_states()

    json_path, md_path = workspace_state_paths()

    state["schema_version"] = RUNTIME_RECORD_SCHEMA_VERSION
    state["root"] = str(ROOT)
    state["updated_at"] = time.strftime(
        "%Y-%m-%dT%H:%M:%SZ",
        time.gmtime(),
    )
    state["git_status"] = workspace_git_status()
    state["git_branch"] = workspace_git_branch()

    state["recent_files"] = normalize_workspace_state_paths(
        state.get("recent_files")
    )

    state["modified_files"] = normalize_workspace_state_paths(
        state.get("modified_files")
    )

    json_text = json.dumps(
        state,
        ensure_ascii=False,
        indent=2,
    ) + "\n"

    markdown = (
        render_workspace_handoff(state)
        + "\n"
    )

    json_path.write_text(json_text)
    md_path.write_text(markdown)

    current_json = (
        STATE_BASE.parent
        / "current-context.json"
    )

    current_md = (
        STATE_BASE.parent
        / "current-context.md"
    )

    current_json.write_text(json_text)
    current_md.write_text(markdown)

    return md_path


def clear_workspace_state():
    json_path, md_path = workspace_state_paths()

    for path in (json_path, md_path):
        try:
            path.unlink()
        except FileNotFoundError:
            pass

    current_json = (
        STATE_BASE.parent
        / "current-context.json"
    )

    current_md = (
        STATE_BASE.parent
        / "current-context.md"
    )

    remove_current = False

    try:
        data = json.loads(
            current_json.read_text(
                errors="replace"
            )
        )
        remove_current = (
            data.get("root") == str(ROOT)
        )
    except Exception:
        pass

    if remove_current:
        for path in (
            current_json,
            current_md,
        ):
            try:
                path.unlink()
            except FileNotFoundError:
                pass


def record_workspace_tool(
    state,
    name,
    args,
    result,
    is_validation=False,
):
    path = args.get("path")

    if (
        path
        and path not in {".", "./"}
        and name in {
            "read",
            "search",
            "list",
            "edit",
            "create",
            "git",
        }
    ):
        state.setdefault(
            "recent_files",
            [],
        ).append(str(path))

    if (
        name in {"edit", "create"}
        and result.startswith("OK:")
        and path
    ):
        state.setdefault(
            "modified_files",
            [],
        ).append(str(path))

    if name == "inspect":
        for inspected_path in args.get("paths") or []:
            state.setdefault(
                "recent_files",
                [],
            ).append(
                str(inspected_path)
            )

    if (
        name == "patch"
        and result.startswith("OK:")
    ):
        for change in args.get("changes") or []:
            changed_path = change.get("path")

            if changed_path:
                state.setdefault(
                    "modified_files",
                    [],
                ).append(
                    str(changed_path)
                )

                state.setdefault(
                    "recent_files",
                    [],
                ).append(
                    str(changed_path)
                )

    if name in {"bash", "validate"}:
        command = (
            str(args.get("command", ""))
            if name == "bash"
            else "validate profile=" + str(args.get("profile", ""))
        )[:500]

        state["last_command"] = command

        if is_validation:
            state["last_validation"] = {
                "command": command,
                "result": str(result)[:700],
            }

    if name in {"bash", "validate"} and is_validation:
        command = (
            str(args.get("command", ""))
            if name == "bash"
            else "validate profile=" + str(args.get("profile", ""))
        )[:500]
        record_audit_event({
            "type": "validation",
            "command": command,
            "result": str(result)[:900],
            "current_hashes": (
                hash_repository_paths(
                    state.get(
                        "modified_files"
                    ) or []
                )
            ),
        })

    if name == "git":
        state["last_git_operation"] = (
            str(args.get("operation", ""))[:100]
        )

    save_workspace_state(state)



SAFE_WORKSPACE_BASE_ENV = "LAI_SAFE_WORKSPACE_DIR"
SAFE_WORKSPACE_BRANCH = "test/lai-smoke"
SAFE_WORKSPACE_METADATA = ".lai-safe-workspace.json"


def safe_workspace_base(raw_base=None):
    configured = raw_base or os.environ.get(SAFE_WORKSPACE_BASE_ENV)
    base = Path(configured).expanduser() if configured else Path("/tmp/lai-harness-workspaces")
    base = base.resolve()
    if base == ROOT or ROOT in base.parents:
        raise SystemExit("Safe workspace base must be outside the source repository")
    return base


def slugify_safe_workspace_name(value):
    normalized = unicodedata.normalize("NFKD", str(value or ""))
    ascii_text = normalized.encode("ascii", "ignore").decode("ascii")
    slug = re.sub(r"[^a-zA-Z0-9._-]+", "-", ascii_text).strip("-._").lower()
    return (slug or "smoke")[:80]


def current_git_sha(short=False):
    args = ["rev-parse"]
    if short:
        args.append("--short=12")
    args.append("HEAD")
    return git_command_text(args, default="unknown")


def default_safe_workspace_name():
    return "lai-harness-" + slugify_safe_workspace_name(current_git_sha(short=True))


def ensure_safe_workspace_child(base, target):
    base = base.resolve()
    target = target.resolve(strict=False)
    if target == base or base not in target.parents:
        raise SystemExit("Target must be inside safe workspace base")
    return target


def parse_safe_workspace_options(raw):
    options = {"name": "", "base": None, "force": False, "all": False}
    index = 0
    positional = []
    while index < len(raw):
        token = raw[index]
        if token == "--force":
            options["force"] = True
        elif token == "--all":
            options["all"] = True
        elif token == "--name":
            index += 1
            if index >= len(raw):
                raise SystemExit("--name requires a value")
            options["name"] = raw[index]
        elif token.startswith("--name="):
            options["name"] = token.split("=", 1)[1]
        elif token == "--base":
            index += 1
            if index >= len(raw):
                raise SystemExit("--base requires a value")
            options["base"] = raw[index]
        elif token.startswith("--base="):
            options["base"] = token.split("=", 1)[1]
        elif token.startswith("-"):
            raise SystemExit(f"Unknown workspace option: {token}")
        else:
            positional.append(token)
        index += 1
    if positional and not options["name"]:
        options["name"] = positional[0]
    if len(positional) > 1:
        raise SystemExit("Workspace command accepts at most one positional name/path")
    return options


def copy_tracked_repository_files(target):
    proc = subprocess.run(
        ["git", "ls-files", "-z"],
        cwd=ROOT,
        text=False,
        capture_output=True,
        timeout=20,
        check=True,
    )
    copied = 0
    for raw_path in proc.stdout.split(b"\0"):
        if not raw_path:
            continue
        rel_text = raw_path.decode("utf-8", errors="surrogateescape")
        rel = Path(rel_text)
        if rel.is_absolute() or ".." in rel.parts or ".git" in rel.parts:
            raise SystemExit(f"Unsafe tracked path refused: {rel_text}")
        source = (ROOT / rel).resolve()
        destination = target / rel
        if not str(source).startswith(str(ROOT)):
            raise SystemExit(f"Tracked path escapes repository: {rel_text}")
        destination.parent.mkdir(parents=True, exist_ok=True)
        if source.is_symlink():
            destination.symlink_to(os.readlink(source))
        elif source.is_file():
            shutil.copy2(source, destination)
        else:
            continue
        copied += 1
    return copied


def create_safe_workspace(raw, json_mode=False):
    options = parse_safe_workspace_options(raw)
    base = safe_workspace_base(options["base"])
    name = slugify_safe_workspace_name(options["name"] or default_safe_workspace_name())
    target = ensure_safe_workspace_child(base, base / name)
    source_sha = current_git_sha(short=False)
    source_short_sha = current_git_sha(short=True)
    source_branch = workspace_git_branch()
    source_status = workspace_git_status()
    source_clean = source_status == "[clean]"

    if target.exists():
        if not options["force"]:
            raise SystemExit(
                f"Safe workspace already exists: {target}. Use --force to replace it."
            )
        shutil.rmtree(target)

    base.mkdir(parents=True, exist_ok=True)
    target.mkdir(parents=True)
    copied = copy_tracked_repository_files(target)
    metadata = {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "source_repository": str(ROOT),
        "source_branch": source_branch,
        "source_sha": source_sha,
        "source_clean": source_clean,
        "source_status": source_status,
        "safe_branch": SAFE_WORKSPACE_BRANCH,
        "copied_files": copied,
    }
    (target / SAFE_WORKSPACE_METADATA).write_text(
        json.dumps(metadata, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    subprocess.run(["git", "init", "-q"], cwd=target, check=True, timeout=20)
    subprocess.run(["git", "checkout", "-q", "-b", SAFE_WORKSPACE_BRANCH], cwd=target, check=True, timeout=20)
    subprocess.run(["git", "add", "."], cwd=target, check=True, timeout=20)
    subprocess.run(
        [
            "git",
            "-c", "user.name=lai harness",
            "-c", "user.email=lai@example.invalid",
            "commit", "-q", "-m",
            f"seed safe workspace from {source_short_sha}",
        ],
        cwd=target,
        check=True,
        timeout=20,
    )
    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "status": "created",
        "path": str(target),
        "name": name,
        "base_dir": str(base),
        "branch": SAFE_WORKSPACE_BRANCH,
        "source_repository": str(ROOT),
        "source_branch": source_branch,
        "source_sha": source_sha,
        "source_clean": source_clean,
        "source_status": source_status,
        "copied_files": copied,
        "next_commands": [
            f"cd {target}",
            "lai readiness",
            "lai implement \"faça uma alteração pequena e valide\"",
            "git diff",
        ],
    }


def workspace_git_text(path, args, default="[unavailable]"):
    try:
        proc = subprocess.run(
            ["git", *args],
            cwd=path,
            text=True,
            capture_output=True,
            timeout=5,
        )
    except Exception:
        return default
    if proc.returncode != 0:
        return default
    return proc.stdout.strip() or default


def safe_workspace_entries(base):
    if not base.is_dir():
        return []
    entries = []
    for child in sorted(base.iterdir(), key=lambda item: item.name):
        if not child.is_dir():
            continue
        metadata_path = child / SAFE_WORKSPACE_METADATA
        metadata = {}
        if metadata_path.is_file():
            try:
                metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
            except Exception:
                metadata = {}
        entries.append({
            "name": child.name,
            "path": str(child),
            "branch": workspace_git_text(child, ["branch", "--show-current"]),
            "git_status": workspace_git_text(child, ["status", "--short"], default="[not a git repository]") or "[clean]",
            "source_sha": metadata.get("source_sha", "[unknown]"),
            "version": metadata.get("version", "[unknown]"),
        })
    return entries


def collect_safe_workspace_status(raw=None):
    options = parse_safe_workspace_options(raw or [])
    base = safe_workspace_base(options["base"])
    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "repository": str(ROOT),
        "current_branch": workspace_git_branch(),
        "git_status": workspace_git_status(),
        "base_dir": str(base),
        "workspaces": safe_workspace_entries(base),
    }


def render_safe_workspace_status(raw=None, json_mode=False):
    payload = collect_safe_workspace_status(raw or [])
    if json_mode:
        return json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True)
    lines = [
        "# lai safe workspaces",
        "",
        f"Product: {payload['product']}",
        f"Version: {payload['version']}",
        f"Repository: {payload['repository']}",
        f"Current branch: {payload['current_branch']}",
        f"Source git status: {payload['git_status']}",
        f"Base dir: {payload['base_dir']}",
        "",
        "## Workspaces",
    ]
    if payload["workspaces"]:
        for item in payload["workspaces"]:
            lines.append(
                f"- {item['name']} — {item['branch']} — {item['git_status']} — {item['path']}"
            )
    else:
        lines.append("- [none]")
    lines.extend([
        "",
        "Create one with: lai workspace create --name smoke",
        "Clean one with:  lai workspace clean smoke",
        "This command does not call the model or mutate the source repository.",
    ])
    return "\n".join(lines)


def clean_safe_workspace(raw, json_mode=False):
    options = parse_safe_workspace_options(raw)
    base = safe_workspace_base(options["base"])
    targets = []
    if options["all"]:
        targets = [item for item in base.iterdir() if item.is_dir()] if base.is_dir() else []
    else:
        name = options["name"]
        if not name:
            raise SystemExit("Usage: lai workspace clean <name|path> [--base DIR] [--json]")
        candidate = Path(name).expanduser()
        target = candidate if candidate.is_absolute() else base / slugify_safe_workspace_name(name)
        targets = [ensure_safe_workspace_child(base, target)]
    removed = []
    for target in targets:
        target = ensure_safe_workspace_child(base, target)
        if not target.exists():
            raise SystemExit(f"Safe workspace not found: {target}")
        shutil.rmtree(target)
        removed.append(str(target))
    payload = {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "status": "cleaned",
        "base_dir": str(base),
        "removed": removed,
    }
    if json_mode:
        return json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True)
    lines = ["# lai safe workspace clean", "", f"Base dir: {base}"]
    if removed:
        lines.append("Removed:")
        lines.extend(f"- {item}" for item in removed)
    else:
        lines.append("Removed: [none]")
    return "\n".join(lines)


def render_safe_workspace_create(raw, json_mode=False):
    payload = create_safe_workspace(raw, json_mode=json_mode)
    if json_mode:
        return json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True)
    lines = [
        "# lai safe workspace",
        "",
        "Status: created",
        f"Path: {payload['path']}",
        f"Branch: {payload['branch']}",
        f"Source: {payload['source_repository']}@{payload['source_sha']}",
        f"Copied files: {payload['copied_files']}",
        "",
        "## Next commands",
    ]
    lines.extend(f"- `{command}`" for command in payload["next_commands"])
    lines.append("")
    lines.append("The source repository was not modified.")
    return "\n".join(lines)


