RELEASE_GOVERNANCE_USAGE = "Usage: lai release-governance [--target VERSION] [--remote] [--json]"
GITHUB_REQUIRED_STATUS_CHECKS = ("Python 3.11", "Python 3.12", "Publication gates", "Harness Score L4")


def parse_release_governance_args(args):
    raw = list(args)
    json_mode = False
    remote = False
    target = None
    positional = []
    index = 0
    while index < len(raw):
        item = raw[index]
        if item == "--json":
            json_mode = True
        elif item == "--remote":
            remote = True
        elif item == "--target":
            index += 1
            if index >= len(raw):
                raise SystemExit(RELEASE_GOVERNANCE_USAGE)
            target = raw[index]
        elif item.startswith("-"):
            raise SystemExit(RELEASE_GOVERNANCE_USAGE)
        else:
            positional.append(item)
        index += 1

    if positional:
        if len(positional) == 1 and target is None:
            target = positional[0]
        else:
            raise SystemExit(RELEASE_GOVERNANCE_USAGE)

    return {"target": target, "remote": remote, "json": json_mode}


def release_governance_pack_status(target_version, expected_tag):
    pack_dir = release_pack_default_dir(expected_tag)
    base_files = release_pack_files(
        pack_dir,
        {"target_version": target_version, "expected_tag": expected_tag},
        include_vsix=False,
    )
    required = {
        "release_body": base_files["release_body"],
        "checklist": base_files["checklist"],
        "publishing": base_files["publishing"],
        "commands": base_files["commands"],
        "summary": base_files["summary"],
    }
    missing = [name for name, path in required.items() if not path.is_file()]
    present = [name for name, path in required.items() if path.is_file()]
    vsix_path = pack_dir / f"lai-harness-{target_version}.vsix"
    status = "ok" if pack_dir.is_dir() and not missing else "warn"
    if not pack_dir.exists():
        detail = f"pack directory missing; run lai release-pack --target {target_version} --with-vsix"
    elif missing:
        detail = "missing: " + ", ".join(missing)
    else:
        detail = "required release pack files are present"

    return {
        "status": status,
        "detail": detail,
        "pack_dir": str(pack_dir),
        "present": present,
        "missing": missing,
        "required_files": {name: str(path) for name, path in required.items()},
        "vsix": {
            "path": str(vsix_path),
            "present": vsix_path.is_file(),
            "optional": True,
        },
    }


def github_repository_slug(origin=None):
    value = str(origin if origin is not None else git_origin_url()).strip()
    path = None
    if value.startswith("git@github.com:"):
        path = value.split(":", 1)[1]
    else:
        match = re.match(r"^(?:https?://github\.com/|ssh://git@github\.com/)(.+)$", value)
        if match:
            path = match.group(1)
    if not path:
        return None
    path = path.rstrip("/")
    if path.endswith(".git"):
        path = path[:-4]
    parts = path.split("/")
    if len(parts) != 2 or not all(parts):
        return None
    return f"{parts[0]}/{parts[1]}"


def github_api_token():
    for env_name in ("GH_TOKEN", "GITHUB_TOKEN"):
        token = os.environ.get(env_name, "").strip()
        if token:
            return token, env_name.lower()

    try:
        proc = subprocess.run(
            ["git", "credential", "fill"],
            cwd=ROOT,
            input="protocol=https\nhost=github.com\n\n",
            text=True,
            capture_output=True,
            timeout=5,
            env={**os.environ, "GIT_TERMINAL_PROMPT": "0"},
        )
    except Exception:
        return None, "none"
    if proc.returncode != 0:
        return None, "none"

    credentials = {}
    for line in proc.stdout.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        credentials[key.strip()] = value.strip()
    token = credentials.get("password", "")
    if not token:
        return None, "none"
    return token, "git-credential"


def github_api_get(api_path, token=None):
    base_url = os.environ.get("LAI_GITHUB_API_URL", "https://api.github.com").rstrip("/")
    url = f"{base_url}/{api_path.lstrip('/')}"
    headers = {
        "Accept": "application/vnd.github+json",
        "User-Agent": f"lai-harness/{VERSION}",
        "X-GitHub-Api-Version": "2022-11-28",
    }
    if token:
        headers["Authorization"] = f"Bearer {token}"
    request = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            raw = response.read().decode("utf-8")
            payload = json.loads(raw) if raw else {}
            return {"ok": True, "status": response.status, "data": payload, "error": ""}
    except urllib.error.HTTPError as exc:
        message = ""
        try:
            body = exc.read().decode("utf-8")
            parsed = json.loads(body) if body else {}
            message = str(parsed.get("message") or "")
        except Exception:
            message = ""
        return {
            "ok": False,
            "status": exc.code,
            "data": None,
            "error": (message or f"GitHub API HTTP {exc.code}")[:300],
        }
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        return {"ok": False, "status": 0, "data": None, "error": str(exc)[:300]}


def github_branch_protection_status(repository, token=None, branch="main"):
    encoded_branch = urllib.parse.quote(branch, safe="")
    result = github_api_get(
        f"repos/{repository}/branches/{encoded_branch}/protection",
        token=token,
    )
    if not result["ok"]:
        status = "warn" if result["status"] == 404 else "unverified"
        detail = (
            "branch protection is not enabled"
            if result["status"] == 404
            else f"could not verify branch protection: {result['error']}"
        )
        return {
            "status": status,
            "detail": detail,
            "api_status": result["status"],
            "branch": branch,
            "required_checks": list(GITHUB_REQUIRED_STATUS_CHECKS),
            "observed_checks": [],
            "requirements": {},
        }

    data = result["data"] or {}
    required_status = data.get("required_status_checks") or {}
    observed = set(required_status.get("contexts") or [])
    for check in required_status.get("checks") or []:
        context = check.get("context") if isinstance(check, dict) else None
        if context:
            observed.add(context)
    missing_checks = [name for name in GITHUB_REQUIRED_STATUS_CHECKS if name not in observed]
    requirements = {
        "pull_requests": data.get("required_pull_request_reviews") is not None,
        "strict_status_checks": required_status.get("strict") is True,
        "required_status_checks": not missing_checks,
        "linear_history": bool((data.get("required_linear_history") or {}).get("enabled")),
        "enforce_admins": bool((data.get("enforce_admins") or {}).get("enabled")),
        "force_pushes_disabled": not bool((data.get("allow_force_pushes") or {}).get("enabled")),
        "deletions_disabled": not bool((data.get("allow_deletions") or {}).get("enabled")),
    }
    missing = [name for name, enabled in requirements.items() if not enabled]
    if missing_checks:
        missing.append("checks:" + ",".join(missing_checks))
    status = "ok" if not missing else "warn"
    detail = (
        "branch protection satisfies the release policy"
        if status == "ok"
        else "branch protection needs attention: " + ", ".join(missing)
    )
    return {
        "status": status,
        "detail": detail,
        "api_status": result["status"],
        "branch": branch,
        "required_checks": list(GITHUB_REQUIRED_STATUS_CHECKS),
        "observed_checks": sorted(observed),
        "requirements": requirements,
    }


def file_sha256(path):
    digest = hashlib.sha256()
    with Path(path).open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def github_release_status(
    repository,
    expected_tag,
    pack_status,
    token=None,
    target_version=None,
):
    resolved_version = target_version or normalize_release_target(expected_tag)[0]
    expected_prerelease = release_is_prerelease(resolved_version)
    channel = release_channel(resolved_version)
    encoded_tag = urllib.parse.quote(expected_tag, safe="")
    result = github_api_get(f"repos/{repository}/releases/tags/{encoded_tag}", token=token)
    if not result["ok"]:
        status = "warn" if result["status"] == 404 else "unverified"
        detail = (
            f"GitHub Release {expected_tag} does not exist"
            if result["status"] == 404
            else f"could not verify GitHub Release: {result['error']}"
        )
        return {
            "status": status,
            "detail": detail,
            "api_status": result["status"],
            "tag": expected_tag,
            "draft": None,
            "prerelease": None,
            "expected_prerelease": expected_prerelease,
            "release_channel": channel,
            "html_url": None,
            "asset": {"status": "unverified", "optional": True},
        }

    data = result["data"] or {}
    core_ok = (
        data.get("tag_name") == expected_tag
        and data.get("draft") is False
        and data.get("prerelease") is expected_prerelease
    )
    vsix = pack_status.get("vsix") or {}
    local_path = Path(vsix.get("path", "")) if vsix.get("path") else None
    expected_name = local_path.name if local_path else None
    remote_asset = None
    if expected_name:
        remote_asset = next(
            (item for item in data.get("assets") or [] if item.get("name") == expected_name),
            None,
        )

    asset = {
        "status": "not_checked",
        "optional": True,
        "expected_name": expected_name,
        "local_present": bool(local_path and local_path.is_file()),
        "remote_present": bool(remote_asset),
        "digest_match": None,
    }
    digest_failure = False
    if asset["local_present"] and remote_asset:
        local_digest = file_sha256(local_path)
        remote_digest = str(remote_asset.get("digest") or "")
        asset["local_sha256"] = local_digest
        asset["remote_digest"] = remote_digest or None
        if remote_digest.startswith("sha256:"):
            asset["digest_match"] = remote_digest == f"sha256:{local_digest}"
            asset["status"] = "ok" if asset["digest_match"] else "fail"
            digest_failure = asset["digest_match"] is False
        else:
            asset["status"] = "digest_unavailable"
    elif asset["local_present"] and not remote_asset:
        asset["status"] = "optional_missing"
    elif remote_asset:
        asset["status"] = "remote_only"

    if not core_ok:
        status = "warn"
        detail = (
            "release exists but publication metadata does not match the expected "
            f"{channel} channel (prerelease={str(expected_prerelease).lower()})"
        )
    elif digest_failure:
        status = "fail"
        detail = "release VSIX digest does not match the local inspected artifact"
    else:
        status = "ok"
        label = "pre-release" if expected_prerelease else "stable release"
        detail = f"published {label} {expected_tag} verified"
        if asset["status"] == "ok":
            detail += "; VSIX digest matches"
        elif asset["status"] == "optional_missing":
            detail += "; optional VSIX is not attached"

    return {
        "status": status,
        "detail": detail,
        "api_status": result["status"],
        "tag": data.get("tag_name"),
        "draft": data.get("draft"),
        "prerelease": data.get("prerelease"),
        "expected_prerelease": expected_prerelease,
        "release_channel": channel,
        "html_url": data.get("html_url"),
        "asset": asset,
    }


def collect_github_release_governance(release_payload, pack_status):
    repository = github_repository_slug(release_payload.get("origin"))
    token, credential_source = github_api_token()
    if not repository:
        unavailable = {
            "status": "unverified",
            "detail": "origin is not a supported github.com repository",
            "api_status": 0,
        }
        return {
            "enabled": True,
            "repository": None,
            "authenticated": bool(token),
            "credential_source": credential_source,
            "branch_protection": {**unavailable, "branch": "main"},
            "release": {**unavailable, "tag": release_payload["expected_tag"]},
        }

    return {
        "enabled": True,
        "repository": repository,
        "authenticated": bool(token),
        "credential_source": credential_source,
        "branch_protection": github_branch_protection_status(repository, token=token),
        "release": github_release_status(
            repository,
            release_payload["expected_tag"],
            pack_status,
            token=token,
            target_version=release_payload["target_version"],
        ),
    }


def release_governance_manual_actions(release_payload, pack_status, remote_state=None):
    target_version = release_payload["target_version"]
    expected_tag = release_payload["expected_tag"]
    actions = []
    if pack_status["status"] != "ok":
        actions.append({
            "id": "release_pack",
            "status": "manual",
            "title": "Generate the local release pack",
            "detail": f"Run lai release-pack --target {target_version} --with-vsix --json.",
        })

    branch_status = None if remote_state is None else remote_state["branch_protection"]["status"]
    if branch_status != "ok":
        detail = (
            "In GitHub Settings > Branches, protect main with pull requests, required status checks, "
            "up-to-date branches, linear history, admin enforcement, and disabled force pushes/deletions."
            if remote_state is None
            else remote_state["branch_protection"]["detail"]
        )
        actions.append({
            "id": "github_branch_protection",
            "status": "manual",
            "title": "Verify GitHub branch protection for main",
            "detail": detail,
        })

    release_status = None if remote_state is None else remote_state["release"]["status"]
    if release_status != "ok":
        expected_prerelease = release_is_prerelease(target_version)
        if remote_state is None:
            if expected_prerelease:
                detail = "Use release-body.md from the release pack and publish the GitHub Release with the pre-release flag enabled."
            else:
                detail = "Use release-body.md from the release pack and publish the GitHub Release with the pre-release flag disabled."
        else:
            detail = remote_state["release"]["detail"]
        label = "pre-release" if expected_prerelease else "stable release"
        actions.append({
            "id": "github_release",
            "status": "manual",
            "title": f"Verify GitHub {label} for {expected_tag}",
            "detail": detail,
        })
    return actions


def collect_release_governance(target=None, remote=False):
    release_payload = collect_release_check(target=target)
    pack_status = release_governance_pack_status(
        release_payload["target_version"],
        release_payload["expected_tag"],
    )
    remote_state = collect_github_release_governance(release_payload, pack_status) if remote else None
    checks = []

    def add_check(name, status, detail=""):
        checks.append({
            "name": name,
            "status": status,
            "detail": str(detail or "")[:500],
        })

    release_overall = release_payload.get("overall")
    release_phase = release_payload.get("phase")
    add_check(
        "release_check",
        "ok" if release_overall == "ready" else "fail",
        f"{release_overall} / {release_phase}",
    )
    add_check(
        "local_release_phase",
        "ok" if release_phase == "released" else "warn",
        release_phase,
    )
    add_check("release_pack", pack_status["status"], pack_status["detail"])
    if remote_state is None:
        add_check(
            "github_branch_protection",
            "manual",
            "use --remote to verify GitHub branch protection read-only",
        )
        add_check(
            "github_release",
            "manual",
            "use --remote to verify GitHub release metadata read-only",
        )
    else:
        branch = remote_state["branch_protection"]
        release = remote_state["release"]
        add_check("github_branch_protection", branch["status"], branch["detail"])
        add_check("github_release", release["status"], release["detail"])

    has_failure = any(check["status"] == "fail" for check in checks)
    needs_action = any(check["status"] in {"warn", "manual", "unverified"} for check in checks)
    if has_failure:
        overall = "blocked"
    elif needs_action:
        overall = "action_required"
    else:
        overall = "ready"

    manual_actions = release_governance_manual_actions(
        release_payload,
        pack_status,
        remote_state=remote_state,
    )
    target_version = release_payload["target_version"]
    channel = release_payload.get("release_channel") or release_channel(target_version)
    expected_prerelease = release_payload.get("expected_prerelease")
    if expected_prerelease is None:
        expected_prerelease = release_is_prerelease(target_version)
    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "target_version": target_version,
        "expected_tag": release_payload["expected_tag"],
        "release_channel": channel,
        "expected_prerelease": expected_prerelease,
        "repository": str(ROOT),
        "branch": release_payload.get("branch"),
        "head": release_payload.get("head"),
        "latest_tag": release_payload.get("latest_tag"),
        "exact_tag": release_payload.get("exact_tag"),
