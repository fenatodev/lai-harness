    try:
        ready = server_ready(host)
    except Exception:
        ready = False

    if not ready:
        launch_env = dict(os.environ)
        if CONFIG.get("llama_server"):
            launch_env["LAI_LLAMA_SERVER"] = str(CONFIG["llama_server"])
