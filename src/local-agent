        raise ValueError("delegate wave directory must not be a symlink")
    if create:
        root.mkdir(parents=True, exist_ok=True, mode=0o700)
        if root.is_symlink() or not root.is_dir():
            raise ValueError("delegate wave path must be a directory")
        try:
            os.chmod(root, 0o700)
        except OSError:
            pass
    elif root.exists() and not root.is_dir():
        raise ValueError("delegate wave path must be a directory")
    return root


def _control_delegate_wave_path(wave_id):
    checked = validate_control_delegate_wave_id(wave_id)
    return _control_delegate_storage() / f"{checked}.json"


def _write_control_delegate_wave(record):
    root = _control_delegate_storage(create=True)
    path = root / f"{validate_control_delegate_wave_id(record['delegate_wave_id'])}.json"
    if path.is_symlink():
        raise ValueError("delegate wave file must not be a symlink")
    temp = root / f".{path.name}.{os.getpid()}.{secrets.token_hex(4)}.tmp"
    payload = json.dumps(record, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp, path)
        os.chmod(path, 0o600)
    finally:
        temp.unlink(missing_ok=True)
    return path


def _load_control_delegate_wave(wave_id):
    checked = validate_control_delegate_wave_id(wave_id)
    path = _control_delegate_wave_path(checked)
    if path.is_symlink() or not path.is_file():
        raise FileNotFoundError(path)
    try:
        record = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError("invalid delegate wave record") from exc
    if not isinstance(record, dict) or record.get("schema_version") != CONTROL_DELEGATE_WAVE_SCHEMA_VERSION:
        raise ValueError("unsupported delegate wave schema")
    if validate_control_delegate_wave_id(record.get("delegate_wave_id")) != checked:
        raise ValueError("delegate wave id mismatch")
    if str(record.get("repository") or "") != str(ROOT.resolve()):
        raise PermissionError("delegate wave belongs to another repository")
    return record


def _control_delegate_reject_forbidden_fields(value, *, path="request"):
    if isinstance(value, dict):
        forbidden = sorted(set(value) & CONTROL_DELEGATE_FORBIDDEN_FIELDS)
        if forbidden:
            raise ValueError(f"{path} attempts to copy authority/process material: " + ", ".join(forbidden))
        for key, item in value.items():
            _control_delegate_reject_forbidden_fields(item, path=f"{path}.{key}")
    elif isinstance(value, list):
        for index, item in enumerate(value):
            _control_delegate_reject_forbidden_fields(item, path=f"{path}[{index}]")


def _control_delegate_expires_at(now=None):
    base = time.time() if now is None else now
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(base + CONTROL_DELEGATE_TTL_SECONDS))


def _control_delegate_is_expired(record, now=None):
    expires_at = str(record.get("expires_at") or "")
    if not expires_at:
        return True
    current = now or control_run_now()
    return expires_at <= current


def _control_delegate_relative_path(value, *, field="path"):
    if not isinstance(value, str) or not value.strip():
        raise ValueError(f"{field} must be a non-empty relative path")
    path = value.replace("\\", "/").strip()
    candidate = Path(path)
    if candidate.is_absolute() or ".." in candidate.parts:
        raise ValueError(f"{field} must stay inside the delegate-owned workspace")
    if path.startswith(".") or "//" in path:
        raise ValueError(f"{field} must be a normalized relative path")
    return path


def _control_delegate_normalize_path_list(value, *, field):
    if not isinstance(value, list) or not value:
        raise ValueError(f"{field} must be a non-empty list")
    normalized = []
    seen = set()
    for item in value:
        path = _control_delegate_relative_path(item, field=field)
        if path in seen:
            raise ValueError(f"{field} contains duplicate paths")
        seen.add(path)
        normalized.append(path)
    return normalized


def _control_delegate_normalize_tasks(items):
    if not isinstance(items, list) or not 1 <= len(items) <= CONTROL_DELEGATE_MAX_TASKS:
        raise ValueError(f"tasks must contain 1 to {CONTROL_DELEGATE_MAX_TASKS} items")
    tasks = []
    seen_ids = set()
    owned_by = {}
    for index, item in enumerate(items, 1):
        if not isinstance(item, dict):
            raise ValueError("each delegate task must be an object")
        extra = set(item) - {"delegate_id", "label", "task", "owns", "depends_on", "fixture"}
        if extra:
            raise ValueError("unsupported delegate task field(s): " + ", ".join(sorted(extra)))
        delegate_id = validate_control_delegate_id(item.get("delegate_id") or f"dg-{index}")
        if delegate_id in seen_ids:
            raise ValueError("delegate_id values must be unique")
        seen_ids.add(delegate_id)
        owns = _control_delegate_normalize_path_list(item.get("owns"), field="owns")
        for owned in owns:
            if owned in owned_by:
                raise ValueError(f"ownership conflict for {owned}")
            owned_by[owned] = delegate_id
        depends_on = item.get("depends_on") or []
        if not isinstance(depends_on, list):
            raise ValueError("depends_on must be a list")
        deps = []
        for dep in depends_on:
            checked_dep = validate_control_delegate_id(dep)
            if checked_dep == delegate_id:
                raise ValueError("delegate task cannot depend on itself")
            deps.append(checked_dep)
        fixture = item.get("fixture") or {}
        if not isinstance(fixture, dict):
            raise ValueError("fixture must be an object")
        fixture_extra = set(fixture) - {"outcome", "changed_paths", "validation_passed"}
        if fixture_extra:
            raise ValueError("unsupported fixture field(s): " + ", ".join(sorted(fixture_extra)))
        outcome = str(fixture.get("outcome") or "succeeded")
        if outcome not in {"succeeded", "failed"}:
            raise ValueError("fixture outcome must be succeeded or failed")
        changed_paths = fixture.get("changed_paths")
        if changed_paths is None:
            changed = list(owns) if outcome == "succeeded" else []
        else:
            changed = _control_delegate_normalize_path_list(changed_paths, field="changed_paths")
        tasks.append({
            "delegate_id": delegate_id,
            "label": str(item.get("label") or delegate_id)[:80],
            "task_chars": len(str(item.get("task") or "")[:1200]),
            "owns": owns,
            "depends_on": deps,
            "fixture": {
                "outcome": outcome,
                "changed_paths": changed,
                "validation_passed": bool(fixture.get("validation_passed", outcome == "succeeded")),
            },
            "authority": {
                "new_grants": False,
                "copied_tokens": False,
                "copied_approvals": False,
                "policy_override": False,
            },
        })
    known = {task["delegate_id"] for task in tasks}
    missing = sorted({dep for task in tasks for dep in task["depends_on"] if dep not in known})
    if missing:
        raise ValueError("depends_on references unknown delegate(s): " + ", ".join(missing))
    return tasks


def _control_delegate_topological_waves(tasks):
    remaining = {task["delegate_id"]: task for task in tasks}
    completed = set()
    waves = []
    while remaining:
        ready = [task for task in remaining.values() if set(task["depends_on"]).issubset(completed)]
        if not ready:
            raise ValueError("delegate dependency graph contains a cycle")
        ready.sort(key=lambda item: item["delegate_id"])
        waves.append([task["delegate_id"] for task in ready])
        for task in ready:
            completed.add(task["delegate_id"])
            remaining.pop(task["delegate_id"], None)
    return waves


def control_delegate_status_payload():
    return {
        "schema_version": CONTROL_DELEGATE_WAVE_SCHEMA_VERSION,
        "product": PRODUCT_NAME,
        "version": VERSION,
        "repository": str(ROOT.resolve()),
        "capabilities": {
            "bounded_delegate_waves": True,
            "fixture_delegate_execution": True,
            "max_tasks": CONTROL_DELEGATE_MAX_TASKS,
            "max_parallelism": CONTROL_DELEGATE_MAX_PARALLELISM,
            "serial_execution_available": True,
            "unbounded_swarm": False,
            "delegate_grants_new_authority": False,
            "delegate_copies_tokens": False,
            "delegate_copies_approvals": False,
            "automatic_integration": False,
        },
    }


def _control_delegate_blocked_record(task, reason):
    return {
        "delegate_id": task["delegate_id"],
        "status": "blocked",
        "reason_code": reason,
        "owns": list(task["owns"]),
        "changed_paths": [],
        "changed_path_count": 0,
        "validation_passed": False,
        "authority": task["authority"],
        "raw_output_included": False,
    }


def _control_delegate_execute_tasks(tasks, *, cancelled=False):
    task_by_id = {task["delegate_id"]: task for task in tasks}
    waves = _control_delegate_topological_waves(tasks)
    results = {}
    produced = {}
    terminal_status = "succeeded"
    reason = "all_delegates_succeeded"
    for wave_index, wave in enumerate(waves, 1):
        for delegate_id in wave:
            task = task_by_id[delegate_id]
            deps = [results.get(dep, {}) for dep in task["depends_on"]]
            if cancelled:
                result = _control_delegate_blocked_record(task, "parent_cancelled")
                result["status"] = "cancelled"
            elif any(dep.get("status") != "succeeded" for dep in deps):
                result = _control_delegate_blocked_record(task, "dependency_failed")
                terminal_status = "blocked"
                reason = "dependency_failed"
            else:
                changed = list(task["fixture"]["changed_paths"])
                outside = [path for path in changed if path not in set(task["owns"])]
                collisions = [path for path in changed if path in produced]
                if outside:
                    result = _control_delegate_blocked_record(task, "ownership_violation")
                    result["attempted_paths"] = outside[:10]
                    terminal_status = "blocked"
                    reason = "ownership_violation"
                elif collisions:
                    result = _control_delegate_blocked_record(task, "ownership_conflict")
                    result["attempted_paths"] = collisions[:10]
                    terminal_status = "blocked"
                    reason = "ownership_conflict"
                elif task["fixture"]["outcome"] != "succeeded" or not task["fixture"]["validation_passed"]:
                    result = _control_delegate_blocked_record(task, "delegate_failed")
                    result["status"] = "failed"
                    terminal_status = "blocked"
                    reason = "delegate_failed"
                else:
                    for path in changed:
                        produced[path] = delegate_id
                    result = {
                        "delegate_id": delegate_id,
                        "status": "succeeded",
                        "reason_code": "fixture_completed",
                        "wave_index": wave_index,
                        "owns": list(task["owns"]),
                        "changed_paths": changed[:20],
                        "changed_path_count": len(changed),
                        "validation_passed": True,
                        "authority": task["authority"],
                        "raw_output_included": False,
                    }
            results[delegate_id] = result
        if terminal_status != "succeeded" or cancelled:
            for later_wave in waves[wave_index:]:
                for later_id in later_wave:
                    results[later_id] = _control_delegate_blocked_record(task_by_id[later_id], "parent_cancelled" if cancelled else "dependency_failed")
            break
    if cancelled:
        terminal_status = "cancelled"
        reason = "parent_cancelled"
    ordered = [results[task["delegate_id"]] for task in tasks]
    return terminal_status, reason, waves, ordered


def control_create_delegate_wave(server, request):
    if not isinstance(request, dict):
        raise ValueError("JSON object required")
    _control_delegate_reject_forbidden_fields(request)
    allowed = {"tasks", "max_parallelism", "budget", "cancel_before_run"}
    extra = set(request) - allowed
    if extra:
        raise ValueError("unsupported delegate wave field(s): " + ", ".join(sorted(extra)))
    tasks = _control_delegate_normalize_tasks(request.get("tasks"))
    max_parallelism = int(request.get("max_parallelism") or 1)
    if max_parallelism < 1 or max_parallelism > CONTROL_DELEGATE_MAX_PARALLELISM:
        raise ValueError("max_parallelism exceeds bounded delegate limit")
    budget = request.get("budget") or {}
    if not isinstance(budget, dict):
        raise ValueError("budget must be an object")
    budget_extra = set(budget) - {"delegate_slots"}
    if budget_extra:
        raise ValueError("unsupported budget field(s): " + ", ".join(sorted(budget_extra)))
    delegate_slots = int(budget.get("delegate_slots", len(tasks)))
    if delegate_slots < len(tasks):
        status = "blocked"
        reason = "budget_exhausted"
        waves = []
        results = [_control_delegate_blocked_record(task, "budget_exhausted") for task in tasks]
    else:
        status, reason, waves, results = _control_delegate_execute_tasks(
            tasks, cancelled=bool(request.get("cancel_before_run"))
        )
    now = control_run_now()
    wave = {
        "schema_version": CONTROL_DELEGATE_WAVE_SCHEMA_VERSION,
        "delegate_wave_id": "dw-" + secrets.token_hex(8),
        "repository": str(ROOT.resolve()),
        "created_at": now,
        "updated_at": now,
        "expires_at": _control_delegate_expires_at(),
        "status": status,
        "reason_code": reason,
        "execution": {
            "strategy": "serial" if max_parallelism == 1 else "bounded",
            "max_parallelism": max_parallelism,
            "actual_parallelism": 1,
            "serial_execution_available": True,
            "fixture_only": True,
        },
        "budget": {
            "delegate_slots_reserved": min(delegate_slots, len(tasks)),
            "delegate_slots_required": len(tasks),
            "reserved_in_parent": True,
            "child_budget_grants": False,
        },
        "waves": waves,
        "tasks": results,
        "aggregation": {
            "delegate_count": len(tasks),
            "succeeded": sum(1 for item in results if item["status"] == "succeeded"),
            "blocked": sum(1 for item in results if item["status"] == "blocked"),
            "failed": sum(1 for item in results if item["status"] == "failed"),
            "cancelled": sum(1 for item in results if item["status"] == "cancelled"),
            "changed_paths": sorted({path for item in results for path in item.get("changed_paths", [])}),
            "raw_output_included": False,
        },
        "integration": {
            "automatic": False,
            "only_by": "hash_bound_promotion",
            "source_checkout_write": False,
        },
    }
    with server.control_delegate_lock:
        _write_control_delegate_wave(wave)
    return wave


def control_delegate_wave_payload(server, wave_id):
    with server.control_delegate_lock:
        wave = _load_control_delegate_wave(wave_id)
        if _control_delegate_is_expired(wave):
            raise ValueError("delegate wave expired")
    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "repository": str(ROOT.resolve()),
        "delegate_wave": wave,
    }


def control_cancel_delegate_wave(server, wave_id, request):
    if not isinstance(request, dict):
        raise ValueError("JSON object required")
    _control_delegate_reject_forbidden_fields(request)
    if request:
        raise ValueError("delegate wave cancel accepts an empty JSON object")
    with server.control_delegate_lock:
        wave = _load_control_delegate_wave(wave_id)
        if _control_delegate_is_expired(wave):
            raise ValueError("delegate wave expired")
        if wave.get("status") not in {"succeeded", "blocked", "failed", "cancelled"}:
            wave["status"] = "cancelled"
        if wave.get("status") != "cancelled":
            wave["cancel_requested"] = True
            wave["children_cancelled"] = True
        else:
            wave["children_cancelled"] = True
        wave["updated_at"] = control_run_now()
        _write_control_delegate_wave(wave)
    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "repository": str(ROOT.resolve()),
        "delegate_wave": wave,
    }


