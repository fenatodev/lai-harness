        base = control_mcp_execution_base() / subdir
        if not base.is_dir():
            continue
        items = sorted((item for item in base.iterdir() if item.is_file() or item.is_dir()), key=lambda item: item.stat().st_mtime)
        for victim in items[:-CONTROL_MCP_EXEC_RETAIN_LIMIT]:
            try:
                if victim.is_dir():
                    shutil.rmtree(victim)
                else:
