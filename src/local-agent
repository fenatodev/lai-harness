                        )
                        for path in sanity_paths
                    }

                    matches_patch_hashes = (
                        sanity_hashes
                        == expected_hashes
                    )

                    record_audit_event({
                        "type": "sanity",
                        "status": (
                            "BUG"
                            if patch_sanity_issue
                            else "CLEAN"
                        ),
                        "issue": (
                            patch_sanity_issue
                            or None
                        ),
                        "paths": sanity_paths,
                        "hashes": sanity_hashes,
                        "expected_hashes": (
                            expected_hashes
                        ),
                        "matches_patch_hashes": (
                            matches_patch_hashes
                        ),
                    })

                    if patch_sanity_issue:
                        tool_result += (
                            "\nPOST_PATCH_SANITY: "
                            + patch_sanity_issue
                        )
                    else:
                        tool_result += (
                            "\nPOST_PATCH_SANITY: CLEAN"
                        )

                is_validation_call = (
                    name == "bash"
                    and command_satisfies_validation(
                        args.get("command", "")
                    )
                )
                record_workspace_tool(
                    workspace_state,
                    name,
                    args,
                    tool_result,
                    is_validation=is_validation_call,
                )
                checkpoint_paths = set(modified_paths)
                if name in WRITE_TOOLS and tool_result.startswith("OK:"):
                    checkpoint_paths.update(write_paths_for_call(name, args))
                checkpoint_run_transition(
                    (
                        "validation_completed"
                        if is_validation_call
                        else "tool_completed"
                    ),
                    tracked_paths=sorted(checkpoint_paths),
                    last_tool=name,
                )

            messages.append({
                "role": "tool",
                "tool_call_id": call["id"],
                "name": name,
                "content": tool_result,
            })

        if exploration_guard.exhausted and not exploration_guard.write_succeeded:
            phase_message = exploration_guard.phase_message()

            if (
                not messages
                or messages[-1].get("role") != "user"
                or messages[-1].get("content") != phase_message
            ):
                messages.append({
                    "role": "user",
                    "content": phase_message,
                })

    if mode == "plan":
        evidence = []

        if plan_project_snapshot:
            evidence.append(
                "[project snapshot]\n"
                + plan_project_snapshot
            )

        for msg in messages:
            if msg.get("role") == "tool":
                name = msg.get("name", "tool")
                body = msg.get("content", "")
                evidence.append(f"[{name}]\n{body}")

        evidence_text = "\n\n".join(evidence)

        if len(evidence_text) > 10000:
            evidence_text = (
                evidence_text[:10000]
                + "\n[evidence truncated]"
            )

        forced_messages = [
            {
                "role": "system",
                "content": (
                    system
                    + "\n\nExploration budget is exhausted. "
                      "Do not request tools. Synthesize the implementation "
                      "plan now using only the collected repository evidence."
                ),
            },
            {
                "role": "user",
                "content": (
                    task
                    + "\n\nCOLLECTED REPOSITORY EVIDENCE:\n"
                    + evidence_text
                ),
            },
        ]

        plan_synthesis_max_tokens = 1536
        plan_synthesis_retry_used = False

        while True:
            result = api_call(
                host,
                forced_messages,
                use_tools=False,
                max_tokens=plan_synthesis_max_tokens,
            )

            choice = result["choices"][0]

            if choice.get("finish_reason") != "length":
                break

            retry_max_tokens = min(
                4096,
                max(
                    plan_synthesis_max_tokens * 2,
                    plan_synthesis_max_tokens + 256,
                ),
            )

            truncation_event = {
                "type": "agent_limit",
                "reason": "response_truncated",
                "max_tokens": plan_synthesis_max_tokens,
                "retry": not plan_synthesis_retry_used,
                "retry_max_tokens": (
                    retry_max_tokens
                    if not plan_synthesis_retry_used
                    else None
                ),
            }

            record_metric_event(truncation_event)
            record_audit_event(truncation_event)

            if plan_synthesis_retry_used:
                print(
                    "Agent stopped: plan synthesis truncated twice; "
                    "refusing to return incomplete output.",
                    file=sys.stderr,
                )
                raise SystemExit(2)

            plan_synthesis_retry_used = True
            plan_synthesis_max_tokens = retry_max_tokens

        forced_content = (
            choice["message"]
            .get("content", "")
            .strip()
        )

        workspace_state["last_answer"] = forced_content[:1800]
        save_workspace_state(workspace_state)

        print(forced_content)
        return

    event = {
        "type": "agent_limit",
        "reason": "overall_round_limit_reached",
        "round_limit": max_rounds_by_mode.get(mode, MAX_ROUNDS),
    }
    record_metric_event(event)
    record_audit_event(event)
    print(
        "Agent stopped: overall round limit reached "
        f"({event['round_limit']} rounds).",
        file=sys.stderr,
    )
    raise SystemExit(2)


def run_main_with_checkpoint_lifecycle():
    try:
        main()
    except SystemExit as exc:
        finalize_run_checkpoint(
            "failed",
            reason=f"SystemExit:{exc.code}",
        )
        raise
    except BaseException as exc:
        finalize_run_checkpoint(
            "failed",
            reason=type(exc).__name__,
        )
        raise
    else:
        finalize_run_checkpoint("completed")


if __name__ == "__main__":
    run_main_with_checkpoint_lifecycle()
