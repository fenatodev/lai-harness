def normalize_model_eval_record(record, line_number):
    if not isinstance(record, dict):
        raise ValueError(f"line {line_number}: record must be a JSON object")
    missing = sorted(MODEL_EVALUATION_REQUIRED_FIELDS - set(record))
    if missing:
        raise ValueError(f"line {line_number}: missing {', '.join(missing)}")
    normalized = dict(record)
    for key in ("model", "scenario", "outcome", "validation"):
        if not isinstance(normalized.get(key), str) or not normalized[key].strip():
            raise ValueError(f"line {line_number}: {key} must be a non-empty string")
        normalized[key] = normalized[key].strip()
    normalized["outcome"] = normalized["outcome"].lower()
    normalized["validation"] = normalized["validation"].lower()
    if normalized["outcome"] not in MODEL_EVALUATION_OUTCOMES:
        raise ValueError(f"line {line_number}: invalid outcome {normalized['outcome']!r}")
    if normalized["validation"] not in MODEL_EVALUATION_VALIDATION:
        raise ValueError(f"line {line_number}: invalid validation {normalized['validation']!r}")
    for key in MODEL_EVALUATION_NUMERIC_FIELDS:
        value = normalized.get(key, 0)
        if isinstance(value, bool):
            raise ValueError(f"line {line_number}: {key} must be a non-negative number")
        try:
            numeric = float(value)
        except (TypeError, ValueError) as exc:
            raise ValueError(f"line {line_number}: {key} must be a non-negative number") from exc
        if numeric < 0:
            raise ValueError(f"line {line_number}: {key} must be a non-negative number")
        normalized[key] = numeric
    return normalized


def load_model_evaluation_records(path):
    records = []
    for line_number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        try:
            parsed = json.loads(line)
        except json.JSONDecodeError as exc:
            raise ValueError(f"line {line_number}: invalid JSON: {exc.msg}") from exc
        records.append(normalize_model_eval_record(parsed, line_number))
    if not records:
        raise ValueError("no model evaluation records found")
    return records


def score_model_evaluation_record(record):
    score = 0.0
    outcome = record["outcome"]
    validation = record["validation"]
    if outcome == "not_run":
        return 0.0
    if outcome == "pass":
        score += 40
    elif outcome == "partial":
        score += 20
    if validation == "pass":
        score += 25
    elif validation == "not_run":
        score += 5
    hallucinations = record["hallucination_flags"]
    score += max(0, 15 - hallucinations * 5)
    policy_blocks = record["policy_blocks"]
    score += max(0, 10 - policy_blocks * 5)
    truncations = record["truncation_retries"]
    score += max(0, 5 - truncations * 2)
    latency_ms = record["latency_ms"]
    tool_calls = record["tool_calls"]
    if latency_ms <= 120000 and tool_calls <= 8:
        score += 5
    elif latency_ms <= 240000 and tool_calls <= 12:
        score += 2
    return min(100.0, score)


def render_model_evaluation_score(records):
    grouped = {}
    for record in records:
        model = record["model"]
        item = grouped.setdefault(model, {"count": 0, "total": 0.0, "scenarios": []})
        score = score_model_evaluation_record(record)
        item["count"] += 1
        item["total"] += score
        item["scenarios"].append((record["scenario"], score, record["outcome"], record["validation"]))

    lines = ["# LAI Model Evaluation Score", ""]
    ranked = sorted(
        grouped.items(),
        key=lambda item: (-(item[1]["total"] / item[1]["count"]), item[0]),
    )
    for model, data in ranked:
        average = data["total"] / data["count"]
        lines.append(f"## {model}")
        lines.append(f"- records: {data['count']}")
        lines.append(f"- average_score: {average:.1f}")
        lines.append(f"- total_score: {data['total']:.1f}")
        for scenario, score, outcome, validation in sorted(data["scenarios"]):
            lines.append(
                f"  - {scenario}: {score:.1f} "
                f"(outcome={outcome}, validation={validation})"
            )
        lines.append("")
    lines.extend([
        "Decision rule:",
        "- Prefer the winner only if it improves correctness and validation without worse policy obedience.",
        "- Keep the current default when results are close or based on too few records.",
    ])
    return "\n".join(lines).rstrip()


def handle_model_evaluation(args):
    command = args[0] if args else "plan"
    if command in {"plan", "list"}:
        json_mode = len(args) > 1 and args[1] == "--json"
        print(render_model_evaluation_plan(json_mode=json_mode))
        return
    if command == "sample":
        print(render_model_evaluation_sample())
        return
    if command == "score":
        if len(args) != 2:
            raise SystemExit("Usage: lai model score <repo-relative-results.jsonl>")
        try:
            path = safe_path(args[1])
            records = load_model_evaluation_records(path)
            print(render_model_evaluation_score(records))
        except (OSError, ValueError) as exc:
            raise SystemExit(f"Invalid model evaluation results: {exc}") from exc
        return
    raise SystemExit(
        "Usage: lai model [plan [--json]|sample|score <repo-relative-results.jsonl>]"
    )


def trim(text):
    if len(text) <= MAX_TOOL_OUTPUT:
        return text
    return text[:MAX_TOOL_OUTPUT] + "\n\n[output truncated]"


def tool_read(args):
    p = safe_path(args["path"])

    if not p.is_file():
        return f"ERROR: file not found: {args['path']}"

    try:
        lines = p.read_text(errors="replace").splitlines()
    except Exception as e:
        return f"ERROR reading file: {e}"

    start = max(1, int(args.get("start_line", 1)))
    count = max(1, min(int(args.get("max_lines", 80)), 200))

    # In implementation mode, fully expose small files so that a safe
    # whole-file rewrite can be authorized without wasting another round.
    if (
        globals().get("ACTIVE_MODE") == "implement"
        and start == 1
        and len(lines) <= 180
    ):
        count = max(count, len(lines))

    end = min(len(lines), start - 1 + count)

    rel = str(p.relative_to(ROOT))
    read_paths.add(rel)

    chunk = "\n".join(lines[start - 1:end])
    header = f"[{rel}: lines {start}-{end} of {len(lines)}]\n"
    rendered = header + chunk

    if (
        start == 1
        and end == len(lines)
        and len(rendered) <= MAX_TOOL_OUTPUT
    ):
        try:
            full_read_hashes[rel] = __import__(
                "hashlib"
            ).sha256(
                p.read_bytes()
            ).hexdigest()
        except Exception:
            full_read_hashes.pop(rel, None)

    return trim(rendered)


def tool_edit(args):
    p = safe_path(args["path"])
    agents = ROOT / "AGENTS.md"

    if agents.is_file() and "AGENTS.md" not in read_paths:
        return "ERROR: AGENTS.md exists. Read AGENTS.md before editing repository files."

    if not p.is_file():
        return f"ERROR: file not found: {args['path']}"

    text = p.read_text(errors="replace")
    old = args["old"]
    new = args["new"]
    count = text.count(old)

    if count == 0:
        return "ERROR: exact old text was not found"

    if count > 1:
        return f"ERROR: old text occurs {count} times; provide a more specific exact match"

    p.write_text(text.replace(old, new, 1))
    return f"OK: edited {p.relative_to(ROOT)}"


def tool_bash(args):
    command = args["command"].strip()
    policy = evaluate_tool_policy("bash", args)
    blocked = render_policy_result(policy)
    if blocked is not None:
        return blocked

    try:
        proc = subprocess.run(
            ["bash", "-lc", command],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=120,
        )
    except subprocess.TimeoutExpired:
        return "ERROR: command timed out after 120 seconds"

    output = proc.stdout
    if proc.stderr:
        output += ("\n" if output else "") + proc.stderr

    return trim(
        f"exit_code={proc.returncode}\n"
        + (output if output else "[no output]")
    )



def python_search_fallback(query, target):
    import re

    try:
        pattern = re.compile(query)
    except re.error as exc:
        return f"ERROR: invalid search pattern: {exc}"

    if target.is_file():
        candidates = [target]
    else:
        candidates = target.rglob("*")

    matches = []
    excluded_dirs = {
        ".git",
        ".venv",
        "venv",
        "node_modules",
        "__pycache__",
        ".pytest_cache",
        ".mypy_cache",
        ".ruff_cache",
        ".cache",
        "dist",
        "build",
    }

    for candidate in candidates:
        try:
            if not candidate.is_file() or candidate.is_symlink():
                continue

            relative = candidate.relative_to(ROOT)

            if any(part in excluded_dirs for part in relative.parts[:-1]):
                continue

            with candidate.open(
                "r",
                encoding="utf-8",
                errors="replace",
            ) as handle:
                for line_number, line in enumerate(handle, 1):
                    if "\x00" in line:
                        break

                    if pattern.search(line):
                        matches.append(
                            f"{relative.as_posix()}:"
                            f"{line_number}:"
                            f"{line.rstrip()}"
                        )

                        if len(matches) >= 120:
                            return trim("\n".join(matches))
        except (OSError, UnicodeError, ValueError):
            continue

    if not matches:
        return "No matches found."

    return trim("\n".join(matches))


def tool_search(args):
    query = args["query"]
    target = safe_path(args.get("path", "."))

    if not target.exists():
        return f"ERROR: path not found: {args.get('path', '.')}"

    try:
        proc = subprocess.run(
            [
                "rg",
                "-n",
                "--hidden",
                "--glob",
                "!.git",
                "--max-count",
                "120",
                query,
                str(target),
            ],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=30,
        )
    except FileNotFoundError:
        return python_search_fallback(query, target)
    except subprocess.TimeoutExpired:
        return "ERROR: search timed out after 30 seconds"

    if proc.returncode == 1:
        return "No matches found."

    if proc.returncode not in (0, 1):
        return trim(
            f"ERROR: rg exited with code {proc.returncode}\n"
            + proc.stderr
        )

    return trim(proc.stdout)


def tool_list(args):
    target = safe_path(args.get("path", "."))
    max_depth = max(1, min(int(args.get("max_depth", 2)), 4))
    max_entries = 120

    if not target.exists():
        return f"ERROR: path not found: {args.get('path', '.')}"

    if target.is_file():
        return str(target.relative_to(ROOT))

    entries = []
    stack = [(target, 0)]

    while stack and len(entries) < max_entries:
        current, depth = stack.pop()

        try:
            children = sorted(
                current.iterdir(),
                key=lambda child: (not child.is_dir(), child.name.lower()),
            )
        except OSError as e:
            rel = current.relative_to(ROOT)
            entries.append(f"[error] {rel}: {e}")
            continue

        directories = []

        for child in children:
            if child.name == ".git":
                continue

            try:
                rel = child.relative_to(ROOT)
            except ValueError:
                continue

            if child.is_symlink():
                entries.append(f"[link] {rel}")
            elif child.is_dir():
                entries.append(f"[dir]  {rel}/")
                if depth + 1 < max_depth:
                    directories.append(child)
            else:
                entries.append(f"[file] {rel}")

            if len(entries) >= max_entries:
                break

        for directory in reversed(directories):
            stack.append((directory, depth + 1))

    if not entries:
        return "[empty directory]"

    output = "\n".join(entries)

    if len(entries) >= max_entries:
        output += "\n[list truncated at 120 entries]"

    return trim(output)


def tool_git(args):
    operation = args.get("operation")
    raw_path = args.get("path")

    max_diff_chars = 5000
    preview_per_file = 800
    preview_total = 2400

    pathspec = None

    if raw_path:
        p = safe_path(raw_path)
        pathspec = str(p.relative_to(ROOT))

    def run_git(parts):
        try:
            proc = subprocess.run(
                ["git", *parts],
                cwd=ROOT,
                text=True,
                capture_output=True,
                timeout=30,
            )
        except subprocess.TimeoutExpired:
            return None, "ERROR: git command timed out after 30 seconds"

        output = proc.stdout

        if proc.stderr:
            output += ("\n" if output else "") + proc.stderr

        if proc.returncode != 0:
            return None, trim(
                f"ERROR: git exited with code {proc.returncode}\n"
                + (output if output else "[no output]")
            )

        return output, None

    def make_diff(cached=False):
        parts = [
            "diff",
            "--no-ext-diff",
            "--no-color",
            "--unified=2",
        ]

        if cached:
            parts.insert(1, "--cached")

        if pathspec:
            parts.extend(["--", pathspec])

        output, error = run_git(parts)

        if error:
            return error

        if not output:
            return "[no changes]"

        if len(output) <= max_diff_chars:
            return output

        return (
            output[:max_diff_chars]
            + "\n\n[diff truncated at 5000 characters; "
              "use read/search for additional context if needed]"
        )

    if operation == "status":
        parts = ["status", "--short"]

        if pathspec:
            parts.extend(["--", pathspec])

        output, error = run_git(parts)

        if error:
            return error

        return trim(output if output else "[clean working tree]")

    if operation == "diff":
        return trim(make_diff(cached=False))

    if operation == "diff-staged":
        return trim(make_diff(cached=True))

    if operation != "changes":
        return f"ERROR: unsupported git operation: {operation}"

    # --------------------------------------------------------
    # Compact Git-change triage
    # --------------------------------------------------------

    status, error = run_git(["status", "--short"])

    if error:
        return error

    if not status:
        return "[clean working tree]"

    unstaged_raw, error = run_git(["diff", "--name-only"])

    if error:
        return error

    staged_raw, error = run_git(["diff", "--cached", "--name-only"])

    if error:
        return error

    untracked_raw, error = run_git([
        "ls-files",
        "--others",
        "--exclude-standard",
    ])

    if error:
        return error

    unstaged = [x for x in unstaged_raw.splitlines() if x]
    staged = [x for x in staged_raw.splitlines() if x]
    untracked = [x for x in untracked_raw.splitlines() if x]

    ordered = []

    for rel in unstaged + staged + untracked:
        if rel not in ordered:
            ordered.append(rel)

    sections = [
        "[git status]",
        status.strip(),
        "",
        "[change previews]",
    ]

    used = sum(len(x) + 1 for x in sections)

    for rel in ordered[:12]:
        kinds = []

        if rel in unstaged:
            kinds.append("unstaged")

        if rel in staged:
            kinds.append("staged")

        if rel in untracked:
            kinds.append("untracked")

        header = f"\n--- {rel} ({', '.join(kinds)}) ---\n"

        if used + len(header) >= preview_total:
            break

        sections.append(header.rstrip())
        used += len(header)

        available = min(
            preview_per_file,
            max(0, preview_total - used),
        )

        if available <= 0:
            break

        preview_parts = []

        if rel in unstaged:
            patch, patch_error = run_git([
                "diff",
                "--no-ext-diff",
                "--no-color",
                "--unified=1",
                "--",
                rel,
            ])

            if patch_error:
                preview_parts.append(patch_error)
            elif patch:
                preview_parts.append(patch)

        if rel in staged:
            patch, patch_error = run_git([
                "diff",
                "--cached",
                "--no-ext-diff",
                "--no-color",
                "--unified=1",
                "--",
                rel,
            ])

            if patch_error:
                preview_parts.append(patch_error)
            elif patch:
                preview_parts.append(patch)

        if rel in untracked:
            try:
                file_path = safe_path(rel)

                if file_path.is_file():
                    data = file_path.read_bytes()[:preview_per_file + 1]

                    if b"\x00" in data:
                        preview_parts.append("[binary untracked file]")
                    else:
                        text = data[:preview_per_file].decode(
                            errors="replace"
                        )
                        preview_parts.append(
                            "[untracked file preview]\n" + text
                        )
            except Exception as e:
                preview_parts.append(
                    f"[unable to preview untracked file: {e}]"
                )

        preview = "\n".join(preview_parts).strip()

        if not preview:
            preview = "[no textual preview]"

        if len(preview) > available:
            preview = (
                preview[:available]
                + "\n[preview truncated; request this file "
                  "specifically if deeper inspection is needed]"
            )

        sections.append(preview)
        used += len(preview)

        if used >= preview_total:
            break

    if len(ordered) > 12 or used >= preview_total:
        sections.extend([
            "",
            "[triage note]",
            "The snapshot is intentionally compact. "
            "Inspect a specific suspicious file with git diff/diff-staged "
            "path=<file>, or read an untracked file, only when needed.",
        ])

    return trim("\n".join(sections))



def tool_project(args):
    ignored = {
        ".git",
        "node_modules",
        ".venv",
        "venv",
        "dist",
        "build",
        ".next",
        "coverage",
        "__pycache__",
    }

    manifests = [
        "package.json",
        "pyproject.toml",
        "requirements.txt",
        "requirements-dev.txt",
        "uv.lock",
        "poetry.lock",
        "Pipfile",
        "go.mod",
        "Cargo.toml",
        "pom.xml",
        "build.gradle",
        "build.gradle.kts",
        "Makefile",
        "docker-compose.yml",
        "docker-compose.yaml",
        "compose.yml",
        "compose.yaml",
        "Dockerfile",
        "AGENTS.md",
    ]

    found_manifests = [
        name
        for name in manifests
        if (ROOT / name).exists()
    ]

    top = []

    try:
        children = sorted(
            ROOT.iterdir(),
            key=lambda p: (not p.is_dir(), p.name.lower()),
        )

        for child in children:
            if child.name in ignored:
                continue

            suffix = "/" if child.is_dir() else ""
            top.append(child.name + suffix)

            if len(top) >= 40:
                break
    except OSError as e:
        top = [f"[error listing root: {e}]"]

    branch = "[not a git repository]"
    status = "[unavailable]"

    try:
        proc = subprocess.run(
            ["git", "branch", "--show-current"],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=10,
        )
        if proc.returncode == 0:
            branch = proc.stdout.strip() or "[detached HEAD]"
    except Exception:
        pass

    try:
        proc = subprocess.run(
            ["git", "status", "--short"],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=10,
        )

        if proc.returncode == 0:
            lines = proc.stdout.splitlines()
            status = "\n".join(lines[:20]) if lines else "[clean]"
            if len(lines) > 20:
                status += "\n[status truncated]"
    except Exception:
        pass

    hints = []

    package_json = ROOT / "package.json"

    if package_json.is_file():
        try:
            data = json.loads(package_json.read_text(errors="replace"))
            scripts = data.get("scripts") or {}

            useful = [
                name
                for name in (
                    "test",
                    "lint",
                    "build",
                    "check",
                    "typecheck",
                    "dev",
                    "start",
                )
                if name in scripts
            ]

            if useful:
                hints.append(
                    "package scripts: "
                    + ", ".join(
                        f"{name}={scripts[name]}"
                        for name in useful
                    )
                )

            if data.get("packageManager"):
                hints.append(
                    f"packageManager: {data['packageManager']}"
                )
        except Exception:
            pass

    pyproject = ROOT / "pyproject.toml"

    if pyproject.is_file():
        try:
            import tomllib

            data = tomllib.loads(
                pyproject.read_text(errors="replace")
            )

            project = data.get("project") or {}

            if project.get("name"):
                hints.append(
                    f"python project: {project['name']}"
                )

            tool = data.get("tool") or {}

            detected_tools = [
                name
                for name in (
                    "pytest",
                    "ruff",
                    "mypy",
                    "poetry",
                    "uv",
                    "black",
                )
                if name in tool
            ]

            if detected_tools:
                hints.append(
                    "python tools: "
                    + ", ".join(detected_tools)
                )
        except Exception:
            pass

    if (ROOT / "go.mod").is_file():
        hints.append("stack hint: Go")

    if (ROOT / "Cargo.toml").is_file():
        hints.append("stack hint: Rust")

    if (
        (ROOT / "pom.xml").is_file()
        or (ROOT / "build.gradle").is_file()
        or (ROOT / "build.gradle.kts").is_file()
    ):
        hints.append("stack hint: JVM")

    output = [
        f"root: {ROOT}",
        f"git branch: {branch}",
        "",
        "manifests:",
        *(
            [f"- {name}" for name in found_manifests]
            or ["- [none detected]"]
        ),
        "",
        "top-level:",
        *[f"- {name}" for name in top],
        "",
        "project hints:",
        *(
            [f"- {hint}" for hint in hints]
            or ["- [none detected]"]
        ),
        "",
        "git status:",
        status,
    ]

    return trim("\n".join(output))


def tool_inspect(args):
    paths = args.get("paths")

    if not isinstance(paths, list) or not paths:
        return "ERROR: inspect requires a non-empty paths array"

    if len(paths) > 8:
        return "ERROR: inspect accepts at most 8 paths"

    try:
        max_lines = int(args.get("max_lines", 140))
    except Exception:
        max_lines = 140

    max_lines = max(
        20,
        min(max_lines, 180),
    )

    root_real = ROOT.resolve()

    queue = []
    queued = set()

    for raw_path in paths:
        if (
            not isinstance(raw_path, str)
            or not raw_path.strip()
        ):
            return (
                "ERROR: every inspect path must be "
                "a non-empty string"
            )

        rel = raw_path.strip().replace("\\", "/")

        while rel.startswith("./"):
            rel = rel[2:]

        if rel not in queued:
            queue.append(rel)
            queued.add(rel)

    chunks = []
    inspected = set()

    # Debug gets automatic local dependency expansion.
    # This is intentionally restricted to local JS/TS imports.
    follow_local_dependencies = (
        globals().get("ACTIVE_MODE") == "debug"
    )

    dependency_patterns = [
        re.compile(
            r"""require\(\s*['"](\.[^'"]+)['"]\s*\)"""
        ),
        re.compile(
            r"""from\s+['"](\.[^'"]+)['"]"""
        ),
        re.compile(
            r"""import\s+['"](\.[^'"]+)['"]"""
        ),
    ]

    js_extensions = (
        ".js",
        ".cjs",
        ".mjs",
        ".jsx",
        ".ts",
        ".cts",
        ".mts",
        ".tsx",
    )

    def resolve_local_dependency(
        source_rel,
        specifier,
    ):
        source = root_real / source_rel

        base = (
            source.parent
            / specifier
        )

        candidates = []

        if base.suffix:
            candidates.append(base)
        else:
            candidates.append(base)

            for ext in js_extensions:
                candidates.append(
                    Path(str(base) + ext)
                )

            for ext in js_extensions:
                candidates.append(
                    base / ("index" + ext)
                )

        for candidate in candidates:
            try:
                resolved = candidate.resolve()
                rel = resolved.relative_to(root_real)
            except Exception:
                continue

            if resolved.is_file():
                return rel.as_posix()

        return None

    while queue and len(inspected) < 8:
        rel = queue.pop(0)

        if rel in inspected:
            continue

        inspected.add(rel)

        result = tool_read({
            "path": rel,
            "start_line": 1,
            "max_lines": max_lines,
        })

        chunks.append(
            f"===== {rel} =====\n{result}"
        )

        if (
            not follow_local_dependencies
            or str(result).startswith("ERROR:")
        ):
            continue

        suffix = Path(rel).suffix.lower()

        if suffix not in js_extensions:
            continue

        candidate = root_real / rel

        try:
            source_text = candidate.read_text(
                errors="replace"
            )[:100000]
        except Exception:
            continue

        discovered = []

        for pattern in dependency_patterns:
            for match in pattern.finditer(
                source_text
            ):
                target = resolve_local_dependency(
                    rel,
                    match.group(1),
                )

                if (
                    target
                    and target not in inspected
                    and target not in queued
                ):
                    discovered.append(target)

        for target in discovered:
            if (
                len(inspected)
                + len(queue)
                >= 8
            ):
                break

            queue.append(target)
            queued.add(target)

    return trim(
        "\n\n".join(chunks)
    )



def tool_patch(args):
    changes = args.get("changes")

    if (
        not isinstance(changes, list)
        or not changes
    ):
        return (
            "ERROR: patch requires a "
            "non-empty changes array"
        )

    if len(changes) > 6:
        return (
            "ERROR: patch accepts at most 6 changes"
        )

    agents = ROOT / "AGENTS.md"

    observed_reads = globals().get(
        "read_paths",
        set(),
    )

    normalized_reads = {
        str(item)
        .replace("\\", "/")
        .lstrip("./")
        for item in observed_reads
    }

    if (
        agents.is_file()
        and "AGENTS.md" not in normalized_reads
    ):
        return (
            "ERROR: AGENTS.md exists. "
            "Inspect AGENTS.md before modifying files."
        )

    root_real = ROOT.resolve()

    buffers = {}
    real_paths = {}

    applied = 0
    already_applied = 0

    for index, change in enumerate(
        changes,
        start=1,
    ):
        if not isinstance(change, dict):
            return (
                f"ERROR: patch change #{index} "
                "must be an object"
            )

        rel = str(
            change.get("path", "")
        ).strip()

        old = change.get("old")
        new = change.get("new")

        while rel.startswith("./"):
            rel = rel[2:]

        if not rel:
            return (
                f"ERROR: patch change #{index} "
                "has empty path"
            )

        if (
            not isinstance(old, str)
            or not isinstance(new, str)
        ):
            return (
                f"ERROR: patch change #{index} "
                "old/new must be strings"
            )

        candidate = root_real / rel

        try:
            resolved = candidate.resolve()
            resolved.relative_to(root_real)
        except Exception:
            return (
                "ERROR: path escapes repository: "
                + rel
            )

        cursor = root_real

        for part in Path(rel).parts:
            cursor = cursor / part

            if cursor.is_symlink():
                return (
                    "ERROR: patch refuses symlink "
                    f"path: {rel}"
                )

        if not candidate.is_file():
            return (
                "ERROR: patch target is not "
                f"a file: {rel}"
            )

        if rel not in buffers:
            try:
                text = candidate.read_text(
                    errors="strict"
                )
            except Exception as exc:
                return (
                    f"ERROR: cannot read {rel}: "
                    f"{type(exc).__name__}: {exc}"
                )

            if len(text) > 500_000:
                return (
                    "ERROR: patch target too large: "
                    + rel
                )

            buffers[rel] = text
            real_paths[rel] = candidate

        text = buffers[rel]
        count = text.count(old)

        if count == 1:
            buffers[rel] = text.replace(
                old,
                new,
                1,
            )

            applied += 1

        elif (
            count == 0
            and new
            and new in text
        ):
            # Retry-safe. A successful previous patch
            # must not trigger another destructive edit loop.
            already_applied += 1

        elif count == 0:
            return (
                f"ERROR: stale patch for {rel}: "
                "old text is not present. "
                "Do not retry the same replacement. "
                "Inspect current content if more work remains."
            )

        else:
            return (
                f"ERROR: old text occurs {count} "
                f"times in {rel}; replacement "
                "must be unique."
            )

    # Atomic at logical batch level:
    # no file is touched until every replacement
    # has been validated in memory.
    try:
        for rel, text in buffers.items():
            real_paths[rel].write_text(text)
    except Exception as exc:
        return (
            "ERROR: patch write failed: "
            f"{type(exc).__name__}: {exc}"
        )

    return (
        f"OK: patch applied={applied}, "
        f"already_applied={already_applied}; "
        f"files={', '.join(buffers)}"
    )


def tool_create(args):
    p = safe_path(args["path"])
    agents = ROOT / "AGENTS.md"

    if agents.is_file() and "AGENTS.md" not in read_paths:
        return "ERROR: AGENTS.md exists. Read AGENTS.md before creating repository files."

    if p.exists():
        return f"ERROR: file already exists: {args['path']}. Use edit instead."

    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(args["content"])

    return f"OK: created {p.relative_to(ROOT)}"


def tool_rewrite(args):
    raw_path = str(args.get("path") or "").strip()
    content = args.get("content")

    if not raw_path:
        return "ERROR: rewrite requires a non-empty path"

    if not isinstance(content, str):
        return "ERROR: rewrite content must be a string"

    rel = raw_path.replace("\\", "/")

    while rel.startswith("./"):
        rel = rel[2:]

    if Path(rel).is_absolute():
        return "ERROR: rewrite requires a repository-relative path"

    agents = ROOT / "AGENTS.md"

    if agents.is_file() and "AGENTS.md" not in read_paths:
        return (
            "ERROR: AGENTS.md exists. "
            "Inspect AGENTS.md before modifying files."
        )

    root_real = ROOT.resolve()
    candidate = root_real / rel

    # Refuse symlink traversal even when the resolved target remains
    # inside the repository.
    cursor = root_real

    for part in Path(rel).parts:
        cursor = cursor / part

        if cursor.is_symlink():
            return (
                "ERROR: rewrite refuses symlink path: "
                + rel
            )

    try:
        resolved = candidate.resolve()
        resolved.relative_to(root_real)
    except Exception:
        return "ERROR: path escapes repository: " + rel

    if not candidate.is_file():
        return "ERROR: rewrite target is not a file: " + rel

    observed_hash = full_read_hashes.get(rel)

    if not observed_hash:
        return (
            "ERROR: rewrite requires a full inspection of "
            f"{rel} before replacing its contents."
        )

    try:
        current_bytes = candidate.read_bytes()
    except Exception as exc:
        return (
            f"ERROR: cannot read {rel}: "
            f"{type(exc).__name__}: {exc}"
        )

    current_hash = __import__(
        "hashlib"
    ).sha256(
        current_bytes
    ).hexdigest()

    if current_hash != observed_hash:
        full_read_hashes.pop(rel, None)
        return (
            "ERROR: rewrite target changed after inspection: "
            f"{rel}. Inspect the current file before rewriting it."
        )

    encoded = content.encode("utf-8")

    if len(encoded) > 500_000:
        return "ERROR: rewrite content too large: " + rel

    os_module = __import__("os")
    stat_module = __import__("stat")
    tempfile_module = __import__("tempfile")

    temp_path = None

    try:
        mode = stat_module.S_IMODE(
            candidate.stat().st_mode
        )

        with tempfile_module.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=candidate.parent,
            prefix=".lai-rewrite-",
            delete=False,
        ) as handle:
            handle.write(content)
            handle.flush()
            os_module.fsync(handle.fileno())
            temp_path = Path(handle.name)

        temp_path.chmod(mode)
        os_module.replace(
            temp_path,
            candidate,
        )

    except Exception as exc:
        if temp_path is not None:
            try:
                temp_path.unlink(missing_ok=True)
            except Exception:
                pass

        return (
            "ERROR: rewrite write failed: "
            f"{type(exc).__name__}: {exc}"
        )

    new_hash = __import__(
        "hashlib"
    ).sha256(
        candidate.read_bytes()
    ).hexdigest()

    # The model authored the complete new file, so the new state is also
    # known in full and can safely participate in a later guarded rewrite.
    full_read_hashes[rel] = new_hash
    read_paths.add(rel)

    return f"OK: rewritten {rel}"


METRICS_DIR = CONFIG["metrics_dir"]
METRICS_FILE = METRICS_DIR / "events.jsonl"

_metrics_time = __import__("time")
_metrics_os = __import__("os")

RUN_ID = (
    f"{int(_metrics_time.time() * 1000)}-"
    f"{_metrics_os.getpid()}"
)

ACTIVE_MODE = "unknown"
ACTIVE_TASK = ""
METRICS_PRUNED = False


def llama_api_key():
    key_path = CONFIG["api_key_file"]

    if not key_path.is_file():
        raise RuntimeError(
            f"LAI API key not found: {key_path}"
        )

    key = key_path.read_text(errors="replace").strip()

    if not key:
        raise RuntimeError(
            f"LAI API key is empty: {key_path}"
        )

    return key


def server_ready(host):
    req = urllib.request.Request(
        f"http://{host}:{LLAMA_PORT}/props",
        headers={
            "Authorization": f"Bearer {llama_api_key()}",
        },
    )

    with urllib.request.urlopen(req, timeout=2) as response:
        return response.status == 200


def doctor_status(host):
    url = f"http://{host}:{LLAMA_PORT}/props"

    def request_status(request):
        try:
            with urllib.request.urlopen(request, timeout=3) as response:
                return response.status
        except urllib.error.HTTPError as exc:
            return exc.code
        except Exception:
            return 0

    unauthenticated = request_status(url)
    authenticated = request_status(urllib.request.Request(
        url,
        headers={"Authorization": f"Bearer {llama_api_key()}"},
    ))
    return unauthenticated, authenticated


def record_metric_event(event):
    global METRICS_PRUNED

    METRICS_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    if (
        not METRICS_PRUNED
        and METRICS_FILE.is_file()
        and METRICS_FILE.stat().st_size > 5_000_000
    ):
        try:
            lines = METRICS_FILE.read_text(
                errors="replace"
            ).splitlines()

            METRICS_FILE.write_text(
                "\n".join(lines[-3000:]) + "\n"
            )
        except Exception:
            pass

        METRICS_PRUNED = True

    payload = {
        "ts": _metrics_time.strftime(
            "%Y-%m-%dT%H:%M:%SZ",
            _metrics_time.gmtime(),
        ),
        "run_id": RUN_ID,
        "repo": str(ROOT),
        "mode": ACTIVE_MODE,
        **event,
    }

    try:
        with METRICS_FILE.open(
            "a",
            encoding="utf-8",
        ) as fh:
            fh.write(
                json.dumps(
                    payload,
                    ensure_ascii=False,
                )
                + "\n"
            )
    except Exception:
        pass


def print_lai_metrics():
    if not METRICS_FILE.is_file():
        print("# LAI Metrics")
        print()
        print("No metrics recorded yet.")
        return

    events = []

    try:
        lines = METRICS_FILE.read_text(
            errors="replace"
        ).splitlines()[-2500:]

        for line in lines:
            try:
                events.append(json.loads(line))
            except Exception:
                pass
    except Exception as e:
        print(f"ERROR reading metrics: {e}")
        return

    runs = {}

    for event in events:
        run_id = event.get("run_id")

        if not run_id:
            continue

        run = runs.setdefault(
            run_id,
            {
                "ts": event.get("ts"),
                "repo": event.get("repo"),
                "mode": event.get("mode", "unknown"),
                "api_calls": 0,
                "tool_calls": 0,
                "prompt_tokens": 0,
                "completion_tokens": 0,
                "api_ms": 0.0,
                "tool_ms": 0.0,
                "tools": {},
                "limits": [],
            },
        )

        if event.get("type") == "run_start":
            run["mode"] = event.get(
                "mode",
                run["mode"],
            )
            run["ts"] = event.get(
                "ts",
                run["ts"],
            )

        elif event.get("type") == "api":
            run["api_calls"] += 1
            run["prompt_tokens"] += int(
                event.get("prompt_tokens") or 0
            )
            run["completion_tokens"] += int(
                event.get("completion_tokens") or 0
            )
            run["api_ms"] += float(
                event.get("duration_ms") or 0
            )

        elif event.get("type") == "tool":
            run["tool_calls"] += 1
            run["tool_ms"] += float(
                event.get("duration_ms") or 0
            )

            name = event.get("name", "unknown")
            run["tools"][name] = (
                run["tools"].get(name, 0) + 1
            )

        elif event.get("type") == "agent_limit":
            run["limits"].append(event)

