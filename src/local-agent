MUTATING_GIT_SUBCOMMANDS = {
    "add", "am", "checkout", "cherry-pick", "clean", "clone",
    "commit", "fetch", "init", "merge", "mv", "pull", "push",
    "rebase", "reset", "restore", "revert", "rm", "switch", "tag",
    "update-ref", "symbolic-ref",
}

SHELL_CONTROL_TOKENS = {";", "&&", "||", "|", "&", "(", ")"}
GIT_GLOBAL_OPTIONS_WITH_VALUES = {
    "-C", "-c", "--git-dir", "--work-tree", "--namespace",
    "--super-prefix", "--config-env",
}


def git_mutation_in_shell(command):
    try:
        lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|()")
        lexer.whitespace_split = True
        tokens = list(lexer)
    except ValueError:
        return None

    for index, token in enumerate(tokens):
        if Path(token).name not in {"git", "git.exe"}:
            continue

        cursor = index + 1
        while cursor < len(tokens):
            candidate = tokens[cursor]
            if candidate in SHELL_CONTROL_TOKENS:
                break
            if candidate in GIT_GLOBAL_OPTIONS_WITH_VALUES:
                cursor += 2
                continue
            if any(candidate.startswith(option + "=") for option in GIT_GLOBAL_OPTIONS_WITH_VALUES):
                cursor += 1
                continue
            if candidate.startswith("-"):
                cursor += 1
                continue

            subcommand = candidate.lower()
            arguments = []
            cursor += 1
            while cursor < len(tokens) and tokens[cursor] not in SHELL_CONTROL_TOKENS:
                arguments.append(tokens[cursor])
                cursor += 1

            if subcommand in MUTATING_GIT_SUBCOMMANDS:
                return subcommand

            if subcommand == "branch":
                mutation_flags = {
                    "-d", "-D", "-m", "-M", "-c", "-C", "--delete",
                    "--move", "--copy", "--edit-description",
                    "--set-upstream-to", "--unset-upstream",
                }
                non_options = [arg for arg in arguments if not arg.startswith("-")]
                if mutation_flags.intersection(arguments) or non_options:
                    return subcommand

            if subcommand == "remote":
                if arguments and arguments[0] not in {"-v", "show", "get-url"}:
                    return subcommand

            if subcommand == "config":
                mutation_flags = {
                    "--add", "--unset", "--unset-all", "--replace-all",
                    "--rename-section", "--remove-section",
                }
                non_options = [arg for arg in arguments if not arg.startswith("-")]
                if mutation_flags.intersection(arguments) or len(non_options) > 1:
                    return subcommand

            break

    return None


def protected_branch_write_override_enabled():
    return os.environ.get(PROTECTED_WRITE_OVERRIDE_ENV, "").strip().lower() in {
        "1",
        "true",
        "yes",
        "on",
    }


def current_policy_git_branch():
    try:
        proc = subprocess.run(
            ["git", "branch", "--show-current"],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=5,
        )
        if proc.returncode != 0:
            return "[unavailable]"
        return proc.stdout.strip() or "[detached HEAD]"
    except Exception:
        return "[unavailable]"


def is_protected_write_branch(branch):
    branch = str(branch or "").strip()
    return (
        branch in PROTECTED_WRITE_BRANCHES
        or any(branch.startswith(prefix) for prefix in PROTECTED_WRITE_BRANCH_PREFIXES)
    )


def evaluate_tool_policy(name, args, mode=None):
    mode = mode or globals().get("ACTIVE_MODE", "unknown")
    known_tools = {item["function"]["name"] for item in TOOLS}
    if name not in known_tools:
        return {"decision": "DENY", "reason": f"unknown tool: {name}"}

    read_only_modes = {"selection", "test", "review", "debug", "diagnose", "security", "plan", "release"}
    if name in WRITE_TOOLS and mode in read_only_modes:
        return {
            "decision": "DENY",
            "reason": f"tool {name} is not permitted in read-only mode {mode}",
        }

    if name in WRITE_TOOLS and not protected_branch_write_override_enabled():
        branch = current_policy_git_branch()
        if is_protected_write_branch(branch):
            return {
                "decision": "DENY",
                "reason": (
                    f"tool {name} is not permitted on protected branch {branch}; "
                    f"create a feature/test branch or set {PROTECTED_WRITE_OVERRIDE_ENV}=1"
                ),
            }

    if name != "bash":
        return {"decision": "ALLOW", "reason": "builtin tool allowed by policy"}

    command = str(args.get("command", "")).strip()
    for pattern, reason in POLICY_DENY_COMMANDS:
        if re.search(pattern, command, re.IGNORECASE):
            return {"decision": "DENY", "reason": reason}

    git_mutation = git_mutation_in_shell(command)
    if git_mutation:
        return {
            "decision": "ASK",
            "reason": f"git {git_mutation} requires explicit user action",
        }

    for pattern, reason in POLICY_ASK_COMMANDS:
        if re.search(pattern, command, re.IGNORECASE):
            return {"decision": "ASK", "reason": reason}

    return {"decision": "ALLOW", "reason": "shell command allowed by policy"}


POLICY_CHECK_USAGE = (
    "Usage: lai policy-check [--stdin | --tool TOOL [--command COMMAND] "
    "[--args-json JSON]] [--mode MODE] [--json]"
)


def parse_policy_check_args(args):
    options = {
        "stdin": False,
        "tool": None,
        "command": None,
        "args_json": None,
        "mode": None,
        "json": False,
    }
    index = 0
    while index < len(args):
        item = args[index]
        if item == "--stdin":
            options["stdin"] = True
            index += 1
            continue
        if item == "--json":
            options["json"] = True
            index += 1
            continue
        if item in {"--tool", "--command", "--args-json", "--mode"}:
            if index + 1 >= len(args):
                raise SystemExit(POLICY_CHECK_USAGE)
            key = item[2:].replace("-", "_")
            options[key] = args[index + 1]
            index += 2
            continue
        raise SystemExit(POLICY_CHECK_USAGE)
    return options


def policy_check_request(options, stdin_text=None):
    if options["stdin"]:
        if options["tool"] or options["command"] or options["args_json"]:
            raise SystemExit(POLICY_CHECK_USAGE)
        raw = sys.stdin.read() if stdin_text is None else stdin_text
        try:
            request = json.loads(raw)
        except (TypeError, json.JSONDecodeError) as exc:
            raise SystemExit(f"Invalid policy-check stdin JSON: {exc}") from exc
        if not isinstance(request, dict):
            raise SystemExit("Invalid policy-check stdin JSON: object required")
        tool = request.get("tool")
        tool_args = request.get("args", {})
        mode = request.get("mode", options["mode"])
    else:
        tool = options["tool"]
        mode = options["mode"]
        tool_args = {}
        if options["args_json"] is not None:
            try:
                tool_args = json.loads(options["args_json"])
            except json.JSONDecodeError as exc:
                raise SystemExit(f"Invalid --args-json: {exc}") from exc
        if options["command"] is not None:
            if not isinstance(tool_args, dict):
                raise SystemExit("Invalid --args-json: object required")
            tool_args = dict(tool_args)
            tool_args["command"] = options["command"]

    if not isinstance(tool, str) or not tool.strip():
        raise SystemExit(POLICY_CHECK_USAGE)
    if not isinstance(tool_args, dict):
        raise SystemExit("Policy-check args must be a JSON object")
    if mode is not None and not isinstance(mode, str):
        raise SystemExit("Policy-check mode must be a string")
    return tool.strip(), tool_args, mode


def render_policy_check(args, stdin_text=None):
    options = parse_policy_check_args(args)
    tool, tool_args, mode = policy_check_request(options, stdin_text=stdin_text)
    policy = evaluate_tool_policy(tool, tool_args, mode=mode)
    payload = {
        "decision": policy["decision"],
        "reason": policy["reason"],
        "tool": tool,
        "mode": mode or globals().get("ACTIVE_MODE", "unknown"),
        "executed": False,
    }
    if options["json"]:
        return json.dumps(payload, ensure_ascii=False, sort_keys=True)
    return f"{payload['decision']}: {payload['reason']}"


def render_policy_result(policy):
    decision = policy.get("decision", "DENY")
    reason = str(policy.get("reason") or "policy decision has no reason")
    if decision == "ASK":
        return f"POLICY ASK: {reason}. Do not execute automatically."
    if decision == "DENY":
        return f"POLICY DENY: {reason}."
    return None


