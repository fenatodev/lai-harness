        raise ValueError("fork_id must be fk- plus 1 to 32 lowercase identifier characters")
    return value


def _control_experiment_storage(create=False):
    root = Path(control_experiment_base()).expanduser()
    if root.is_symlink():
        raise ValueError("control experiment directory must not be a symlink")
    if create:
        root.mkdir(parents=True, exist_ok=True, mode=0o700)
        if root.is_symlink() or not root.is_dir():
            raise ValueError("control experiment path must be a directory")
        try:
            os.chmod(root, 0o700)
        except OSError:
            pass
    elif root.exists() and not root.is_dir():
        raise ValueError("control experiment path must be a directory")
    return root


def _control_experiment_path(experiment_id):
    checked = validate_control_experiment_id(experiment_id)
    return _control_experiment_storage() / f"{checked}.json"


def _write_control_experiment(record):
    root = _control_experiment_storage(create=True)
    path = root / f"{validate_control_experiment_id(record['experiment_id'])}.json"
    if path.is_symlink():
        raise ValueError("control experiment file must not be a symlink")
    temp = root / f".{path.name}.{os.getpid()}.{secrets.token_hex(4)}.tmp"
    payload = json.dumps(record, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp, path)
        os.chmod(path, 0o600)
    finally:
        temp.unlink(missing_ok=True)
    return path


def _load_control_experiment(experiment_id):
    checked = validate_control_experiment_id(experiment_id)
    path = _control_experiment_path(checked)
    if path.is_symlink() or not path.is_file():
        raise FileNotFoundError(path)
    try:
        record = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError("invalid control experiment record") from exc
    if not isinstance(record, dict) or record.get("schema_version") != CONTROL_EXPERIMENT_SCHEMA_VERSION:
        raise ValueError("unsupported control experiment schema")
    if validate_control_experiment_id(record.get("experiment_id")) != checked:
        raise ValueError("control experiment id mismatch")
    if str(record.get("repository") or "") != str(ROOT.resolve()):
        raise PermissionError("control experiment belongs to another repository")
    return record


def _control_experiment_reject_forbidden_fields(value, *, path="request"):
    if isinstance(value, dict):
        forbidden = sorted(set(value) & CONTROL_EXPERIMENT_FORBIDDEN_FIELDS)
        if forbidden:
            raise ValueError(f"{path} attempts to copy authority/process material: " + ", ".join(forbidden))
        for key, item in value.items():
            _control_experiment_reject_forbidden_fields(item, path=f"{path}.{key}")
    elif isinstance(value, list):
        for index, item in enumerate(value):
            _control_experiment_reject_forbidden_fields(item, path=f"{path}[{index}]")


def _control_experiment_expires_at(now=None):
    base = time.time() if now is None else now
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(base + CONTROL_EXPERIMENT_TTL_SECONDS))


def _control_experiment_is_expired(record, now=None):
    expires_at = str(record.get("expires_at") or "")
    if not expires_at:
        return True
    current = now or control_run_now()
    return expires_at <= current


