def run_tool(name, args):
    print(
        f"\n[{name}] "
        f"{json.dumps(args, ensure_ascii=False)}",
        file=sys.stderr,
    )

    started = _metrics_time.perf_counter()

    global LAST_PATCH_HASHES, LAST_PATCH_PATHS

    audit_patch_paths = []

    if name == "patch":
        audit_patch_paths = [
            str(change.get("path"))
            for change in (
                args.get("changes") or []
            )
            if change.get("path")
        ]

        audit_before_hashes = (
            hash_repository_paths(
                audit_patch_paths
            )
        )
    else:
        audit_before_hashes = {}

    try:
        if name == "read":
            result = tool_read(args)
        elif name == "search":
            result = tool_search(args)
        elif name == "list":
            result = tool_list(args)
        elif name == "git":
            result = tool_git(args)
        elif name == "project":
            result = tool_project(args)
        elif name == "inspect":
            result = tool_inspect(args)
        elif name == "patch":
            result = tool_patch(args)
        elif name == "edit":
            result = tool_edit(args)
        elif name == "create":
            result = tool_create(args)
        elif name == "bash":
            result = tool_bash(args)
        else:
            result = f"ERROR: unknown tool: {name}"
    except Exception as e:
        result = (
            f"ERROR: {type(e).__name__}: {e}"
        )

    duration_ms = (
        _metrics_time.perf_counter()
        - started
    ) * 1000.0

    if name == "patch":
        audit_after_hashes = (
            hash_repository_paths(
                audit_patch_paths
            )
        )

        LAST_PATCH_PATHS = list(
            audit_patch_paths
        )

        LAST_PATCH_HASHES = dict(
            audit_after_hashes
        )

        record_audit_event({
            "type": "patch",
            "paths": audit_patch_paths,
            "before_hashes": (
                audit_before_hashes
            ),
            "after_hashes": (
                audit_after_hashes
            ),
            "result": str(result)[:900],
        })

    record_metric_event({
        "type": "tool",
        "name": name,
        "duration_ms": round(duration_ms, 2),
        "ok": not (
            str(result).startswith("ERROR:")
            or str(result).startswith("BLOCKED:")
        ),
    })

    return result



def api_call(
    host,
