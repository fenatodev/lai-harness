def handle_safe_workspace(raw):
    raw = list(raw)
    json_mode = "--json" in raw
    raw = [item for item in raw if item != "--json"]
    command = raw[0] if raw else "status"
    rest = raw[1:] if raw else []
    if command in {"help", "--help", "-h"}:
        return safe_workspace_help()
    if command in {"status", "list"}:
        return render_safe_workspace_status(rest, json_mode=json_mode)
    if command in {"create", "clone-smoke", "smoke"}:
        return render_safe_workspace_create(rest, json_mode=json_mode)
    if command == "clean":
        return clean_safe_workspace(rest, json_mode=json_mode)
    raise SystemExit(
        "Usage: lai workspace status|create|clone-smoke|clean [options]"
    )



