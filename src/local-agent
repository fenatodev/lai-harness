def _sandbox_exec_rewrite_git_hooks(command):
    try:
        tokens = shlex.split(command, posix=True)
    except ValueError:
        tokens = []
    if len(tokens) >= 2 and Path(tokens[0]).name in {"git", "git.exe"} and tokens[1] in {"commit", "add", "status", "diff", "log"}:
        if tokens[1] == "commit":
            tokens = [tokens[0], "-c", "core.hooksPath=/dev/null", *tokens[1:]]
        return " ".join(shlex.quote(token) for token in tokens)

    def replace_commit(match):
        prefix = match.group(1) or ""
        return f"{prefix}git -c core.hooksPath=/dev/null commit"

    return re.sub(
        r"(^|(?:&&|\|\||;)\s*)git\s+commit\b",
        replace_commit,
        command,
    )


def tool_sandbox_exec(args):
    if not isinstance(args, dict) or not set(args).issubset({"command", "timeout_seconds"}):
        return "ERROR: sandbox_exec requires command and optional timeout_seconds only"
    command = args.get("command")
    if not isinstance(command, str):
        return "ERROR: sandbox_exec command must be a string"
    timeout = args.get("timeout_seconds", SANDBOX_EXEC_TIMEOUT_SECONDS)
    if not isinstance(timeout, int) or timeout < 1 or timeout > SANDBOX_EXEC_TIMEOUT_SECONDS:
        return f"ERROR: sandbox_exec timeout_seconds must be 1..{SANDBOX_EXEC_TIMEOUT_SECONDS}"
    policy = sandbox_exec_policy(command)
    blocked = render_policy_result(policy)
    if blocked is not None:
        return blocked
    rewritten = _sandbox_exec_rewrite_git_hooks(command.strip())
    try:
        proc = subprocess.Popen(
            ["bash", "-lc", rewritten],
            cwd=str(ROOT),
            env=_sandbox_exec_env(),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=False,
            shell=False,
            start_new_session=True,
        )
        try:
            stdout, stderr = proc.communicate(timeout=timeout)
            timed_out = False
        except subprocess.TimeoutExpired:
            timed_out = True
            control_terminate_process(proc, force=False)
            try:
                stdout, stderr = proc.communicate(timeout=1)
            except subprocess.TimeoutExpired:
                control_terminate_process(proc, force=True)
                stdout, stderr = proc.communicate(timeout=1)
        raw = b""
        if stdout:
            raw += stdout
        if stderr:
            raw += (b"\n" if raw else b"") + stderr
        truncated = len(raw) > SANDBOX_EXEC_OUTPUT_LIMIT_BYTES
        if truncated:
            raw = raw[:SANDBOX_EXEC_OUTPUT_LIMIT_BYTES]
        output = raw.decode("utf-8", errors="replace") if raw else "[no output]"
        if truncated:
            output += "\n[sandbox_exec output truncated]"
        outcome = "timeout" if timed_out else "completed"
        return trim(
            f"exit_code={proc.returncode}\n"
            f"sandbox_exec={outcome}\n"
            f"timeout_seconds={timeout}\n"
            + output
        )
    except FileNotFoundError:
        return "ERROR: sandbox_exec shell executable unavailable"
    except Exception as exc:
        return f"ERROR: sandbox_exec failed: {type(exc).__name__}: {exc}"


