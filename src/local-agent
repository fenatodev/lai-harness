    return control_credential_base() / "refs" / f"{checked}.json"


def _control_credential_receipt_path(receipt_id):
    if not isinstance(receipt_id, str) or not re.fullmatch(r"rc-[0-9a-f]{16}", receipt_id):
        raise ValueError("receipt_id is invalid")
    return control_credential_base() / "receipts" / f"{receipt_id}.json"


def _control_fake_outbox_path(receipt_id):
    if not isinstance(receipt_id, str) or not re.fullmatch(r"rc-[0-9a-f]{16}", receipt_id):
        raise ValueError("receipt_id is invalid")
    return control_credential_base() / "fake-outbox" / f"{receipt_id}.json"


def _control_private_json_write(target, payload):
    target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    text = json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    temp = target.with_name(f".{target.name}.{os.getpid()}.{secrets.token_hex(4)}.tmp")
    try:
        fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.replace(temp, target)
        os.chmod(target, 0o600)
    finally:
        temp.unlink(missing_ok=True)


