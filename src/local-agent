    if requested_server != CONTROL_MCP_FIXTURE_SERVER or requested_tool != CONTROL_MCP_FIXTURE_TOOL:
        return {
            "schema_version": CONTROL_MCP_EXEC_SCHEMA_VERSION,
            "decision": "DENY",
            "reason": "MCP server or tool is not enabled for execution",
            "executed": False,
        }
    config_sha256, tool_schema_sha256 = _control_mcp_fixture_hashes()
    if request.get("config_sha256") != config_sha256:
        raise ControlMcpExecutionConflict("MCP server config drift")
    if request.get("tool_schema_sha256") != tool_schema_sha256:
        raise ControlMcpExecutionConflict("MCP tool schema drift")
    artifact_rel, content, raw = _control_mcp_validate_artifact_args(request.get("arguments"))
    if not remote_project_sandbox_available():
        raise ControlMcpExecutionConflict("verified sandbox executor is unavailable")
    mcp_execution_id = "mx-" + secrets.token_hex(8)
    mcp_receipt_id = "mr-" + secrets.token_hex(8)
    workspace = _control_mcp_workspace_path(mcp_execution_id)
    workspace.mkdir(parents=True, exist_ok=True, mode=0o700)
    try:
        workspace.chmod(0o700)
    except OSError:
        pass
    call_payload = {"path": artifact_rel, "content": content}
    script = _control_mcp_fixture_script()
    argv = remote_project_sandbox_docker_argv(
        ["python3", "-I", "-c", script], workspace=workspace, source_root=workspace
    )
    execution_record = {
        "schema_version": CONTROL_MCP_EXEC_SCHEMA_VERSION,
        "mcp_execution_id": mcp_execution_id,
        "server": requested_server,
        "tool": requested_tool,
        "config_sha256": config_sha256,
        "tool_schema_sha256": tool_schema_sha256,
        "runtime": CONTROL_MCP_FIXTURE_RUNTIME,
        "created_at": _control_authority_timestamp(),
        "artifact_rel": artifact_rel,
        "content_sha256": hashlib.sha256(raw).hexdigest(),
    }
    stdout = ""
    stderr = ""
    stdout_truncated = False
    stderr_truncated = False
    outcome = "failed"
    executed = False
    reason_code = "mcp_tool_failed"
    artifact = None
    try:
        if request.get("simulate_timeout"):
            raise subprocess.TimeoutExpired(argv, CONTROL_MCP_FIXTURE_TIMEOUT_SECONDS)
        proc = subprocess.run(
            argv,
            cwd=workspace,
            input=json.dumps(call_payload, ensure_ascii=False),
            text=True,
            capture_output=True,
            timeout=CONTROL_MCP_FIXTURE_TIMEOUT_SECONDS,
            shell=False,
            env=_control_mcp_minimal_env(),
        )
        stdout = proc.stdout or ""
        stderr = proc.stderr or ""
        if request.get("simulate_output_flood"):
            stdout += "X" * (CONTROL_MCP_FIXTURE_OUTPUT_LIMIT_BYTES + 32)
        if len(stdout.encode("utf-8", errors="replace")) > CONTROL_MCP_FIXTURE_OUTPUT_LIMIT_BYTES:
            stdout = stdout[:CONTROL_MCP_FIXTURE_OUTPUT_LIMIT_BYTES]
            stdout_truncated = True
        if len(stderr.encode("utf-8", errors="replace")) > CONTROL_MCP_FIXTURE_OUTPUT_LIMIT_BYTES:
            stderr = stderr[:CONTROL_MCP_FIXTURE_OUTPUT_LIMIT_BYTES]
            stderr_truncated = True
        if proc.returncode != 0:
            reason_code = "mcp_tool_nonzero_exit"
        else:
            response_text = "{malformed" if request.get("simulate_malformed_json") else stdout
            try:
                response = json.loads(response_text)
            except json.JSONDecodeError:
                reason_code = "malformed_mcp_response"
            else:
                target = workspace / artifact_rel
                if not target.is_file():
                    reason_code = "mcp_artifact_missing"
                elif not bool(response.get("ok")):
                    reason_code = "mcp_tool_rejected"
                else:
                    artifact_bytes = target.read_bytes()
                    artifact = {
                        "relative_path": artifact_rel,
                        "bytes": len(artifact_bytes),
                        "sha256": hashlib.sha256(artifact_bytes).hexdigest(),
                    }
                    outcome = "delivered"
                    executed = True
                    reason_code = "fixture_artifact_written"
    except subprocess.TimeoutExpired:
        outcome = "outcome_unknown"
        executed = "unknown"
        reason_code = "mcp_timeout_after_start"
    receipt = {
        "schema_version": CONTROL_MCP_EXEC_SCHEMA_VERSION,
        "mcp_receipt_id": mcp_receipt_id,
        "mcp_execution_id": mcp_execution_id,
        "server": requested_server,
        "tool": requested_tool,
        "runtime": CONTROL_MCP_FIXTURE_RUNTIME,
        "outcome": outcome,
        "executed": executed,
        "reason_code": reason_code,
        "created_at": _control_authority_timestamp(),
        "artifact": artifact,
        "stdout_truncated": stdout_truncated,
        "stderr_truncated": stderr_truncated,
        "stdout_sha256": hashlib.sha256(stdout.encode("utf-8", errors="replace")).hexdigest(),
        "stderr_sha256": hashlib.sha256(stderr.encode("utf-8", errors="replace")).hexdigest(),
    }
    execution_record.update({
        "mcp_receipt_id": mcp_receipt_id,
        "outcome": outcome,
        "executed": executed,
        "reason_code": reason_code,
    })
    with server.control_mcp_execution_lock:
        _control_private_json_write(_control_mcp_execution_path(mcp_execution_id), execution_record)
        _control_private_json_write(_control_mcp_receipt_path(mcp_receipt_id), receipt)
        _control_mcp_prune()
    return _control_mcp_public_receipt(receipt)


