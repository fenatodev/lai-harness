def normalize_model_eval_record(record, line_number):
    if not isinstance(record, dict):
        raise ValueError(f"line {line_number}: record must be a JSON object")
    missing = sorted(MODEL_EVALUATION_REQUIRED_FIELDS - set(record))
    if missing:
        raise ValueError(f"line {line_number}: missing {', '.join(missing)}")
    normalized = dict(record)
    for key in ("model", "scenario", "outcome", "validation"):
        if not isinstance(normalized.get(key), str) or not normalized[key].strip():
            raise ValueError(f"line {line_number}: {key} must be a non-empty string")
        normalized[key] = normalized[key].strip()
    normalized["outcome"] = normalized["outcome"].lower()
    normalized["validation"] = normalized["validation"].lower()
    if normalized["outcome"] not in MODEL_EVALUATION_OUTCOMES:
        raise ValueError(f"line {line_number}: invalid outcome {normalized['outcome']!r}")
    if normalized["validation"] not in MODEL_EVALUATION_VALIDATION:
        raise ValueError(f"line {line_number}: invalid validation {normalized['validation']!r}")
    for key in MODEL_EVALUATION_NUMERIC_FIELDS:
        value = normalized.get(key, 0)
        if isinstance(value, bool):
            raise ValueError(f"line {line_number}: {key} must be a non-negative number")
        try:
            numeric = float(value)
        except (TypeError, ValueError) as exc:
            raise ValueError(f"line {line_number}: {key} must be a non-negative number") from exc
        if numeric < 0:
            raise ValueError(f"line {line_number}: {key} must be a non-negative number")
        normalized[key] = numeric
    return normalized


def load_model_evaluation_records(path):
    records = []
    for line_number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        try:
            parsed = json.loads(line)
        except json.JSONDecodeError as exc:
            raise ValueError(f"line {line_number}: invalid JSON: {exc.msg}") from exc
        records.append(normalize_model_eval_record(parsed, line_number))
    if not records:
        raise ValueError("no model evaluation records found")
    return records


def score_model_evaluation_record(record):
    score = 0.0
    outcome = record["outcome"]
    validation = record["validation"]
    if outcome == "not_run":
        return 0.0
    if outcome == "pass":
        score += 40
    elif outcome == "partial":
        score += 20
    if validation == "pass":
        score += 25
    elif validation == "not_run":
        score += 5
    hallucinations = record["hallucination_flags"]
    score += max(0, 15 - hallucinations * 5)
    policy_blocks = record["policy_blocks"]
    score += max(0, 10 - policy_blocks * 5)
    truncations = record["truncation_retries"]
    score += max(0, 5 - truncations * 2)
    latency_ms = record["latency_ms"]
    tool_calls = record["tool_calls"]
    if latency_ms <= 120000 and tool_calls <= 8:
        score += 5
    elif latency_ms <= 240000 and tool_calls <= 12:
        score += 2
    return min(100.0, score)


def render_model_evaluation_score(records):
    grouped = {}
    for record in records:
        model = record["model"]
        item = grouped.setdefault(
            model, {"count": 0, "total": 0.0, "scenarios": [], "scenario_counts": {}}
        )
        score = score_model_evaluation_record(record)
        item["count"] += 1
        item["total"] += score
        item["scenario_counts"][record["scenario"]] = (
            item["scenario_counts"].get(record["scenario"], 0) + 1
        )
        item["scenarios"].append((record["scenario"], score, record["outcome"], record["validation"]))

    lines = ["# lai model evaluation score", ""]
    ranked = sorted(
        grouped.items(),
        key=lambda item: (-(item[1]["total"] / item[1]["count"]), item[0]),
    )
    for model, data in ranked:
        average = data["total"] / data["count"]
        lines.append(f"## {model}")
        lines.append(f"- records: {data['count']}")
        lines.append(f"- average_score: {average:.1f}")
        lines.append(f"- total_score: {data['total']:.1f}")
        covered = MODEL_EVALUATION_MODEL_BACKED_SCENARIOS & set(data["scenario_counts"])
        minimum_samples = (
            min(data["scenario_counts"].get(item, 0) for item in MODEL_EVALUATION_MODEL_BACKED_SCENARIOS)
            if covered == MODEL_EVALUATION_MODEL_BACKED_SCENARIOS else 0
        )
        decision_eligible = (
            covered == MODEL_EVALUATION_MODEL_BACKED_SCENARIOS and minimum_samples >= 2
        )
        lines.append(f"- coverage: {len(covered)}/{len(MODEL_EVALUATION_MODEL_BACKED_SCENARIOS)}")
        lines.append(f"- minimum_samples_per_required_scenario: {minimum_samples}")
        lines.append(f"- decision_eligible: {'yes' if decision_eligible else 'no'}")
        for scenario, score, outcome, validation in sorted(data["scenarios"]):
            lines.append(
                f"  - {scenario}: {score:.1f} "
                f"(outcome={outcome}, validation={validation})"
            )
        lines.append("")
    lines.extend([
        "Decision rule:",
        "- Prefer the winner only if it improves correctness and validation without worse policy obedience.",
        "- Keep the current default when results are close or based on too few records.",
    ])
    return "\n".join(lines).rstrip()




def _model_capability_average(values):
    numbers = [float(value) for value in values if value is not None]
    if not numbers:
        return None
    return sum(numbers) / len(numbers)


def _model_capability_ratio(records, predicate):
    if not records:
        return None
    return sum(1 for record in records if predicate(record)) / len(records)


def _model_capability_dimension(records, *, scenarios=None, numeric=None, inverse=False):
    selected = [record for record in records if scenarios is None or record["scenario"] in scenarios]
    if not selected:
        return {"status": "unknown", "samples": 0, "value": None}
    if numeric:
        average = _model_capability_average(record[numeric] for record in selected)
        value = average if not inverse or average is None else max(0.0, average)
    else:
        value = _model_capability_average(score_model_evaluation_record(record) for record in selected)
    return {
        "status": "measured",
        "samples": len(selected),
        "value": round(value, 3) if value is not None else None,
    }


def _model_capability_known_value(value):
    if isinstance(value, str) and value.strip():
        return value.strip()
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        return value
    return None


def _model_capability_metadata(records, *keys):
    values = []
    for record in records:
        for key in keys:
            value = _model_capability_known_value(record.get(key))
            if value is not None:
                values.append(value)
                break
    unique = sorted({str(value) for value in values})
    if not unique:
        return {"status": "unknown", "value": None}
    if len(unique) == 1:
        return {"status": "known", "value": unique[0]}
    return {"status": "mixed", "value": unique}


def _model_capability_hardware(records):
    hardware_values = []
    for record in records:
        hardware = record.get("hardware")
        if isinstance(hardware, dict):
            public = {
                key: hardware.get(key)
                for key in ("system", "release", "machine", "cpu_count", "python")
                if _model_capability_known_value(hardware.get(key)) is not None
            }
            if public:
                hardware_values.append(public)
    if not hardware_values:
        return {"status": "unknown", "value": None}
    encoded = sorted({json.dumps(item, sort_keys=True) for item in hardware_values})
    if len(encoded) == 1:
        return {"status": "known", "value": json.loads(encoded[0])}
    return {"status": "mixed", "value": [json.loads(item) for item in encoded]}


def _model_capability_repetition_summary(records):
    scenario_samples = {}
    for record in records:
        scenario = record.get("scenario")
        if isinstance(scenario, str):
            scenario_samples[scenario] = scenario_samples.get(scenario, 0) + 1
    if not scenario_samples:
        return {"status": "unknown", "value": None}
    values = sorted(set(scenario_samples.values()))
    return {
        "status": "known" if len(values) == 1 else "mixed",
        "value": values[0] if len(values) == 1 else values,
    }


def _model_capability_evidence_descriptor(model_records):
    return {
        "model": _model_capability_metadata(model_records, "model"),
        "quantization": _model_capability_metadata(model_records, "model_ftype", "quantization"),
        "runtime": _model_capability_metadata(model_records, "runtime", "server_runtime"),
        "template": _model_capability_metadata(model_records, "template", "chat_template"),
        "hardware": _model_capability_hardware(model_records),
        "suite": _model_capability_metadata(model_records, "suite", "fixture_schema_version"),
        "repetitions": _model_capability_repetition_summary(model_records),
    }


def model_capability_profile(records, *, current_model=None):
    current_model = str(current_model or MODEL)
    normalized = [normalize_model_eval_record(record, index + 1) for index, record in enumerate(records)]
    grouped = {}
    for record in normalized:
        grouped.setdefault(record["model"], []).append(record)
    model_profiles = []
    required = sorted(MODEL_EVALUATION_MODEL_BACKED_SCENARIOS)
    for model, model_records in sorted(grouped.items()):
        scenario_counts = {scenario: 0 for scenario in required}
        for record in model_records:
            if record["scenario"] in scenario_counts:
                scenario_counts[record["scenario"]] += 1
        covered = [scenario for scenario, count in scenario_counts.items() if count > 0]
        minimum_samples = min(scenario_counts.values()) if scenario_counts else 0
        decision_eligible = all(
            count >= MODEL_CAPABILITY_PROFILE_MIN_SAMPLES_PER_SCENARIO
            for count in scenario_counts.values()
        )
        scores = [score_model_evaluation_record(record) for record in model_records]
        validation_rate = _model_capability_ratio(
            model_records, lambda record: record["validation"] == "pass"
        )
        dimensions = {
            "planning": _model_capability_dimension(
                model_records,
                scenarios={"plan-repo-change", "plan-validation-command-grounding"},
            ),
            "coding": _model_capability_dimension(model_records, scenarios={"implement-small-diff"}),
            "debug": _model_capability_dimension(model_records, scenarios={"debug-repro"}),
            "tools": _model_capability_dimension(model_records, numeric="tool_calls"),
            "context": _model_capability_dimension(model_records, scenarios={"context-ranking"}),
            "patch": _model_capability_dimension(model_records, scenarios={"implement-small-diff"}),
            "latency": _model_capability_dimension(model_records, numeric="latency_ms"),
            "refusal": _model_capability_dimension(model_records, numeric="refusal_flags"),
            "truncation": _model_capability_dimension(model_records, numeric="truncation_retries"),
            "hallucination": _model_capability_dimension(model_records, numeric="hallucination_flags"),
            "validation": {
                "status": "measured" if validation_rate is not None else "unknown",
                "samples": len(model_records),
                "value": round(validation_rate, 3) if validation_rate is not None else None,
            },
        }
        unknown_dimensions = sorted(
            name for name, value in dimensions.items() if value.get("status") == "unknown"
        )
        model_profiles.append({
            "model": model,
            "records": len(model_records),
            "evidence": _model_capability_evidence_descriptor(model_records),
            "average_score": round(_model_capability_average(scores) or 0.0, 3),
            "total_score": round(sum(scores), 3),
            "scenario_counts": scenario_counts,
            "coverage": {
                "covered": len(covered),
                "required": len(required),
                "minimum_samples_per_required_scenario": minimum_samples,
                "decision_eligible": decision_eligible,
            },
            "dimensions": dimensions,
            "unknown_dimensions": unknown_dimensions,
        })
    eligible = [item for item in model_profiles if item["coverage"]["decision_eligible"]]
    current_profile = next((item for item in model_profiles if item["model"] == current_model), None)
    if not eligible:
        recommendation = {
            "decision": "keep_current",
            "selected_model": current_model,
            "reason_code": "insufficient_evidence",
            "auto_switch": False,
            "manual_selection_precedes_router": True,
            "default_model_changed": False,
            "budget_effect": "unknown",
            "load_cost": "unknown",
            "session_grant_preserved_on_manual_selection": True,
        }
    else:
        ranked = sorted(eligible, key=lambda item: (-item["average_score"], item["model"]))
        winner = ranked[0]
        current_score = current_profile["average_score"] if current_profile else None
        if winner["model"] == current_model:
            reason = "current_model_has_best_evidence"
            selected = current_model
        elif current_score is not None and winner["average_score"] < current_score + 8:
            reason = "evidence_margin_too_small"
            selected = current_model
        else:
            reason = "manual_review_required_for_candidate"
            selected = current_model
        recommendation = {
            "decision": "keep_current" if selected == current_model else "manual_review",
            "selected_model": selected,
            "candidate_model": winner["model"],
            "candidate_average_score": winner["average_score"],
            "reason_code": reason,
            "auto_switch": False,
            "manual_selection_precedes_router": True,
            "default_model_changed": False,
            "budget_effect": "requires_operator_review",
            "load_cost": "unknown_without_manual_profile",
            "session_grant_preserved_on_manual_selection": True,
        }
    return {
        "schema_version": MODEL_CAPABILITY_PROFILE_SCHEMA_VERSION,
        "product": PRODUCT_NAME,
        "version": VERSION,
        "current_model": current_model,
        "source": "model-eval-jsonl",
        "fixture_schema_version": 1,
        "required_scenarios": required,
        "dimensions": list(MODEL_CAPABILITY_PROFILE_DIMENSIONS),
        "min_samples_per_required_scenario": MODEL_CAPABILITY_PROFILE_MIN_SAMPLES_PER_SCENARIO,
        "router_enabled": False,
        "download_enabled": False,
        "cloud_fallback_enabled": False,
        "default_model_changed": False,
        "models": model_profiles,
        "recommendation": recommendation,
    }


def render_model_capability_profile(records, *, current_model=None, json_mode=False):
    payload = model_capability_profile(records, current_model=current_model)
    if json_mode:
        return json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True)
    lines = [
        "# lai model capability profile",
        f"Current model: {payload['current_model']}",
        f"Router enabled: {str(payload['router_enabled']).lower()}",
        f"Recommendation: {payload['recommendation']['decision']} ({payload['recommendation']['reason_code']})",
        "",
    ]
    for model in payload["models"]:
        coverage = model["coverage"]
        lines.append(f"## {model['model']}")
        lines.append(f"- records: {model['records']}")
        lines.append(f"- average_score: {model['average_score']:.1f}")
        lines.append(
            f"- coverage: {coverage['covered']}/{coverage['required']} "
            f"min={coverage['minimum_samples_per_required_scenario']} "
            f"eligible={'yes' if coverage['decision_eligible'] else 'no'}"
        )
        if model["unknown_dimensions"]:
            lines.append("- unknown: " + ", ".join(model["unknown_dimensions"]))
        lines.append("")
    lines.extend([
        "Decision boundary:",
        "- Manual model selection precedes any router.",
        "- This profile never downloads, starts cloud fallback, or changes the default model.",
    ])
    return "\n".join(lines).rstrip()

