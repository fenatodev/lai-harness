def render_release_governance(args=None):
    options = parse_release_governance_args(args or [])
    payload = collect_release_governance(target=options["target"], remote=options["remote"])
    if options["json"]:
        return json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True)

    lines = [
