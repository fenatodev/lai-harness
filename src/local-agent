def _control_external_validate_credential(secret_ref, audience, operation):
    record = _control_credential_load(secret_ref)
    if record.get("status") != "active":
        raise ControlExternalActionConflict("credential reference is not active")
    if record.get("revoked_at"):
        raise ControlExternalActionConflict("credential reference is revoked")
    if time.time() > float(record.get("expires_at_epoch") or 0):
        raise ControlExternalActionConflict("credential reference expired")
    if record.get("adapter") != "fake":
        raise ControlExternalActionConflict("credential adapter mismatch")
    if record.get("audience") != audience:
        raise ControlExternalActionConflict("credential audience mismatch")
    if record.get("operation") != operation:
        raise ControlExternalActionConflict("credential operation mismatch")
    return record


def control_create_external_action_intent(server, request):
    if not isinstance(request, dict):
        raise ValueError("JSON object required")
    unknown = sorted(set(request) - {
        "adapter", "operation", "principal", "secret_ref", "credential_audience",
        "credential_operation", "target_remote", "target_branch", "source_branch",
        "baseline_sha", "patch_sha256", "expected_remote_sha", "ttl_seconds",
    })
    if unknown:
        raise ValueError("unknown fields: " + ", ".join(unknown))
    adapter = request.get("adapter", "fake_git_remote")
    operation = request.get("operation", "push_branch")
    if adapter != "fake_git_remote" or operation != "push_branch":
        return {
            "schema_version": CONTROL_EXTERNAL_ACTION_SCHEMA_VERSION,
            "decision": "DENY",
            "reason": "external action adapter or operation is not enabled",
            "executed": False,
        }
    principal = str(request.get("principal", "operator")).strip()
    if not principal or len(principal) > 120:
        raise ValueError("principal must be a bounded non-empty string")
    secret_ref = _control_credential_validate_ref(request.get("secret_ref"))
    target_remote = _control_external_fake_remote_slug(request.get("target_remote"))
    target_branch = _control_external_validate_branch(request.get("target_branch"), label="target_branch")
    source_branch = _control_external_validate_branch(request.get("source_branch"), label="source_branch")
    baseline_sha = _control_external_validate_sha(request.get("baseline_sha"), label="baseline_sha")
    patch_sha256 = _control_external_validate_patch_sha(request.get("patch_sha256"))
    expected_remote_sha = request.get("expected_remote_sha")
    if expected_remote_sha in {None, ""}:
        expected_remote_sha = None
    else:
        expected_remote_sha = _control_external_validate_sha(expected_remote_sha, label="expected_remote_sha")
    ttl = request.get("ttl_seconds", CONTROL_EXTERNAL_ACTION_DEFAULT_TTL_SECONDS)
    if not isinstance(ttl, int) or not 1 <= ttl <= CONTROL_EXTERNAL_ACTION_MAX_TTL_SECONDS:
        raise ValueError("ttl_seconds is out of range")
    current_branch = workspace_git_branch()
    current_head = workspace_git_head()
    if current_branch != source_branch:
        raise ControlExternalActionConflict("source branch drift")
    if current_head != baseline_sha:
        raise ControlExternalActionConflict("baseline sha drift")
    credential_audience = str(request.get("credential_audience") or f"fake-git:{target_remote}").strip()
    credential_operation = str(request.get("credential_operation") or "external_git_effect").strip()
    if not credential_audience or not credential_operation:
        raise ValueError("credential audience and operation must be non-empty")
    with server.control_credential_lock:
        _control_external_validate_credential(secret_ref, credential_audience, credential_operation)
    now = time.time()
    material = {
        "schema_version": CONTROL_EXTERNAL_ACTION_SCHEMA_VERSION,
        "adapter": adapter,
        "operation": operation,
        "principal": principal,
        "secret_ref": secret_ref,
        "credential_audience": credential_audience,
        "credential_operation": credential_operation,
        "target_remote": target_remote,
        "target_branch": target_branch,
        "source_branch": source_branch,
        "baseline_sha": baseline_sha,
        "patch_sha256": patch_sha256,
        "expected_remote_sha": expected_remote_sha,
    }
    payload_sha256 = _control_authority_sha256(material)
    record = dict(material)
    record.update({
        "external_action_id": "ea-" + secrets.token_hex(8),
        "status": "pending",
        "created_at": _control_authority_timestamp(now),
        "expires_at": _control_authority_timestamp(now + ttl),
        "expires_at_epoch": now + ttl,
        "used_at": None,
        "revoked_at": None,
        "payload_sha256": payload_sha256,
    })
    with server.control_external_action_lock:
        _control_private_json_write(_control_external_action_path(record["external_action_id"]), record)
        _control_external_prune()
    return _control_external_public_intent(record)


def control_execute_external_action(server, request):
    if not isinstance(request, dict):
        raise ValueError("JSON object required")
    unknown = sorted(set(request) - {"external_action_id", "payload_sha256", "principal", "simulate_timeout_after_send"})
    if unknown:
        raise ValueError("unknown fields: " + ", ".join(unknown))
    external_action_id = _control_external_action_validate_id(request.get("external_action_id"))
    payload_sha256 = request.get("payload_sha256")
    if not isinstance(payload_sha256, str) or not re.fullmatch(r"[0-9a-f]{64}", payload_sha256):
        raise ValueError("payload_sha256 must be a 64-character lowercase sha256")
    principal = str(request.get("principal", "operator")).strip()
    simulate_timeout = bool(request.get("simulate_timeout_after_send"))
    with server.control_external_action_lock:
        record = _control_external_load_action(external_action_id)
        if record.get("status") != "pending":
            raise ControlExternalActionConflict("external action is not pending")
        if record.get("revoked_at"):
            raise ControlExternalActionConflict("external action is revoked")
        if record.get("used_at"):
            raise ControlExternalActionConflict("external action was already used")
        if record.get("principal") != principal:
            raise ControlExternalActionConflict("external action principal mismatch")
        if time.time() > float(record.get("expires_at_epoch") or 0):
            record["status"] = "expired"
            _control_private_json_write(_control_external_action_path(external_action_id), record)
            raise ControlExternalActionConflict("external action expired")
        if record.get("payload_sha256") != payload_sha256:
            raise ControlExternalActionConflict("external action hash mismatch")
        _control_external_validate_branch(record.get("target_branch"), label="target_branch")
        if workspace_git_branch() != record.get("source_branch"):
            raise ControlExternalActionConflict("source branch drift")
        if workspace_git_head() != record.get("baseline_sha"):
            raise ControlExternalActionConflict("baseline sha drift")
        remote = _control_external_load_remote(record.get("target_remote"))
        branches = remote.setdefault("branches", {})
        current_remote_sha = branches.get(record.get("target_branch"))
        expected_remote_sha = record.get("expected_remote_sha")
        if expected_remote_sha is not None and current_remote_sha != expected_remote_sha:
            raise ControlExternalActionConflict("target remote drift")
        with server.control_credential_lock:
            _control_external_validate_credential(
                record.get("secret_ref"),
                record.get("credential_audience"),
                record.get("credential_operation"),
            )
            credential_receipt = control_use_credential_ref(server, {
                "secret_ref": record.get("secret_ref"),
                "adapter": "fake",
                "audience": record.get("credential_audience"),
                "operation": record.get("credential_operation"),
                "payload": {
                    "adapter": record.get("adapter"),
                    "operation": record.get("operation"),
                    "target_remote": record.get("target_remote"),
                    "target_branch": record.get("target_branch"),
                    "baseline_sha": record.get("baseline_sha"),
                    "patch_sha256": record.get("patch_sha256"),
                },
                "simulate_timeout_after_send": simulate_timeout,
            })
        branches[record.get("target_branch")] = record.get("baseline_sha")
        _control_external_write_remote(record.get("target_remote"), remote)
        receipt_id = "er-" + secrets.token_hex(8)
        outcome = credential_receipt.get("outcome") or "delivered"
        receipt = {
            "schema_version": CONTROL_EXTERNAL_ACTION_SCHEMA_VERSION,
            "external_receipt_id": receipt_id,
            "external_action_id": external_action_id,
            "credential_receipt_id": credential_receipt.get("receipt_id"),
            "adapter": record.get("adapter"),
            "operation": record.get("operation"),
            "target_remote": record.get("target_remote"),
            "target_branch": record.get("target_branch"),
            "baseline_sha": record.get("baseline_sha"),
            "patch_sha256": record.get("patch_sha256"),
            "outcome": outcome,
            "created_at": _control_authority_timestamp(),
            "reason_code": "timeout_after_send" if outcome == "outcome_unknown" else "fake_remote_updated",
        }
        record["status"] = "used"
        record["used_at"] = receipt["created_at"]
        record["external_receipt_id"] = receipt_id
        record["outcome"] = outcome
        _control_private_json_write(_control_external_action_path(external_action_id), record)
        _control_private_json_write(_control_external_receipt_path(receipt_id), receipt)
        _control_external_prune()
        return _control_external_public_receipt(receipt)


class ControlBrowserConflict(RuntimeError):
    pass


def _control_browser_validate_session_id(value):
    if not isinstance(value, str) or not re.fullmatch(CONTROL_BROWSER_SESSION_PATTERN, value):
        raise ValueError("browser_session_id is invalid")
    return value


def _control_browser_validate_download_id(value):
    if not isinstance(value, str) or not re.fullmatch(CONTROL_BROWSER_DOWNLOAD_PATTERN, value):
        raise ValueError("browser_download_id is invalid")
    return value


def _control_browser_session_path(session_id):
    checked = _control_browser_validate_session_id(session_id)
    return control_browser_base() / "sessions" / f"{checked}.json"


def _control_browser_download_path(session_id, download_id):
    checked_session = _control_browser_validate_session_id(session_id)
    checked_download = _control_browser_validate_download_id(download_id)
