    return control_external_action_base() / "fake-remotes" / f"{_control_external_fake_remote_slug(remote)}.json"


def _control_external_validate_branch(branch, *, label="target_branch"):
    if not isinstance(branch, str) or not re.fullmatch(CONTROL_EXTERNAL_ACTION_BRANCH_RE, branch):
        raise ValueError(f"{label} is invalid")
    if ".." in branch or branch.startswith("/") or branch.endswith("/") or "//" in branch or branch.endswith(".lock"):
        raise ValueError(f"{label} is invalid")
    if label == "target_branch" and is_protected_write_branch(branch):
        raise ControlExternalActionConflict("target branch is protected")
    return branch


def _control_external_validate_sha(value, *, label):
    if not isinstance(value, str) or not re.fullmatch(r"[0-9a-f]{40}", value):
        raise ValueError(f"{label} must be a 40-character lowercase sha")
    return value


def _control_external_validate_patch_sha(value):
    if not isinstance(value, str) or not re.fullmatch(r"[0-9a-f]{64}", value):
        raise ValueError("patch_sha256 must be a 64-character lowercase sha256")
    return value


def _control_external_load_action(external_action_id):
    path = _control_external_action_path(external_action_id)
    try:
        record = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise KeyError(external_action_id) from None
    except json.JSONDecodeError as exc:
        raise ControlExternalActionConflict("external action state is invalid") from exc
    if not isinstance(record, dict):
        raise ControlExternalActionConflict("external action state is invalid")
    if record.get("schema_version") != CONTROL_EXTERNAL_ACTION_SCHEMA_VERSION:
        raise ControlExternalActionConflict("external action schema version is unsupported")
    if record.get("external_action_id") != external_action_id:
        raise ControlExternalActionConflict("external action identity mismatch")
    return record


def _control_external_load_remote(remote):
    path = _control_external_fake_remote_path(remote)
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        payload = {"schema_version": CONTROL_EXTERNAL_ACTION_SCHEMA_VERSION, "remote": remote, "branches": {}}
    except json.JSONDecodeError as exc:
        raise ControlExternalActionConflict("fake remote state is invalid") from exc
    if not isinstance(payload, dict) or not isinstance(payload.get("branches", {}), dict):
        raise ControlExternalActionConflict("fake remote state is invalid")
    return payload


def _control_external_write_remote(remote, payload):
    payload = dict(payload)
    payload["schema_version"] = CONTROL_EXTERNAL_ACTION_SCHEMA_VERSION
    payload["remote"] = remote
    _control_private_json_write(_control_external_fake_remote_path(remote), payload)


