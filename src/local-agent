def _parse_skill_frontmatter(text):
    if not text.startswith("---\n"):
        raise ValueError("missing frontmatter")
    end = text.find("\n---\n", 4)
    if end < 0:
        raise ValueError("unterminated frontmatter")
    metadata = {}
    for line in text[4:end].splitlines():
        if not line.strip():
            continue
        if ":" not in line:
            raise ValueError("invalid frontmatter entry")
        key, value = line.split(":", 1)
        key, value = key.strip(), value.strip()
        if key in metadata:
            raise ValueError(f"duplicate frontmatter key: {key}")
        metadata[key] = value
    return metadata, text[end + 5:].strip()


def _parse_skill_list(value):
    raw = str(value or "").strip()
    if not raw:
        return []
    if raw.startswith("["):
        try:
            parsed = json.loads(raw)
        except json.JSONDecodeError as exc:
            raise ValueError("skill list metadata must be JSON string array or comma list") from exc
        if not isinstance(parsed, list) or not all(isinstance(item, str) for item in parsed):
            raise ValueError("skill list metadata must contain strings only")
        items = parsed
    else:
        items = raw.split(",")
    normalized = []
    for item in items:
        value = item.strip()
        if not value:
            continue
        if len(value) > 80 or not re.fullmatch(r"[A-Za-z0-9_.:/@+-]+", value):
            raise ValueError("skill metadata item contains unsupported characters")
        normalized.append(value)
    return sorted(dict.fromkeys(normalized))


def parse_standard_skill_contract(path, expected_name=None):
    text = path.read_text(encoding="utf-8", errors="replace")
    metadata, body = _parse_skill_frontmatter(text)
    name = metadata.get("name", "")
    description = metadata.get("description", "")
    if not name or not description:
        raise ValueError("name and description are required")
    if expected_name is not None and name != expected_name:
        raise ValueError(f"expected skill name {expected_name!r}, got {name!r}")
    if not body:
        raise ValueError("skill body is empty")
    try:
        schema_version = int(metadata.get("schema_version") or SKILL_CONTRACT_SCHEMA_VERSION)
    except ValueError as exc:
        raise ValueError("skill schema_version must be an integer") from exc
    if schema_version > SKILL_CONTRACT_SCHEMA_VERSION:
        raise ValueError("unsupported future skill schema_version")
    unknown_fields = sorted(set(metadata) - SKILL_CONTRACT_ALLOWED_FIELDS)
    authority_claims = sorted(
        key for key in metadata
        if key in SKILL_CONTRACT_AUTHORITY_FIELDS or key not in SKILL_CONTRACT_ALLOWED_FIELDS
    )
    declared = {field: _parse_skill_list(metadata.get(field, "")) for field in SKILL_CONTRACT_LIST_FIELDS}
    return {
        "schema_version": SKILL_CONTRACT_SCHEMA_VERSION,
        "declared_schema_version": schema_version,
        "name": name,
        "description": description,
        "version": metadata.get("version") or "unknown",
        "provenance": metadata.get("provenance") or "unknown",
        "declared": declared,
        "unknown_metadata_fields": unknown_fields,
        "authority_claims": authority_claims,
        "body": body,
        "body_sha256": hashlib.sha256(body.encode("utf-8")).hexdigest(),
        "grants_authority": False,
        "executes_hooks_on_load": False,
        "tool_permissions_from_skill": False,
    }


def parse_standard_skill(path, expected_name=None):
    return parse_standard_skill_contract(path, expected_name=expected_name)["body"]


def load_mode_skill(mode, skills_dir=None):
    base = Path(skills_dir or SKILLS_DIR)
    standard = base / mode / "SKILL.md"
    legacy = base / f"{mode}.txt"

    if standard.is_file():
        try:
            return parse_standard_skill(standard, expected_name=mode)
        except (OSError, ValueError) as exc:
            raise SystemExit(f"Invalid skill {standard}: {exc}") from exc

    if legacy.is_file():
        return legacy.read_text(errors="replace").strip()

    raise SystemExit(f"Skill não encontrada: {standard} or {legacy}")


