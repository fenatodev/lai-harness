def sanitize_update_vulnerability(item):
    if not isinstance(item, dict):
        return {"id": "unknown", "summary": "unstructured vulnerability metadata"}
    fixed_in = item.get("fixed_in") or []
    if not isinstance(fixed_in, list):
        fixed_in = []
    return {
        "id": str(item.get("id") or item.get("source") or "unknown")[:120],
        "summary": str(item.get("details") or item.get("summary") or "")[:300],
        "fixed_in": [str(value)[:80] for value in fixed_in[:8]],
    }


def check_update_pypi_source(source):
    package = source["package"]
    current = update_source_current_version(source, allow_server=False)
    encoded = urllib.parse.quote(package, safe="")
    latest_payload = update_http_json(f"https://pypi.org/pypi/{encoded}/json")
    if not isinstance(latest_payload, dict):
        raise ValueError("PyPI latest response must be an object")
    latest = str((latest_payload.get("info") or {}).get("version") or "").strip() or None
    vulnerabilities = []
    if current:
        current_encoded = urllib.parse.quote(str(current), safe="")
        current_payload = update_http_json(
            f"https://pypi.org/pypi/{encoded}/{current_encoded}/json"
        )
        if not isinstance(current_payload, dict):
            raise ValueError("PyPI release response must be an object")
        raw_vulnerabilities = current_payload.get("vulnerabilities") or []
        if not isinstance(raw_vulnerabilities, list):
            raise ValueError("PyPI vulnerabilities field must be a list")
        vulnerabilities = [sanitize_update_vulnerability(item) for item in raw_vulnerabilities[:20]]
    return {
        "current_version": current,
        "latest_version": latest,
        "status": classify_update_version(current, latest),
        "security_status": "vulnerable" if vulnerabilities else "clear",
        "vulnerability_count": len(vulnerabilities),
        "vulnerabilities": vulnerabilities,
        "source_url": f"https://pypi.org/project/{encoded}/",
        "content_trust": "trusted-metadata-untrusted-text",
    }


def check_update_npm_source(source):
    package = source["package"]
    current = update_source_current_version(source, allow_server=False)
    encoded = urllib.parse.quote(package, safe="@/")
    payload = update_http_json(f"https://registry.npmjs.org/{encoded}/latest")
    if not isinstance(payload, dict):
        raise ValueError("npm latest response must be an object")
    latest = str(payload.get("version") or "").strip() or None
    return {
        "current_version": current,
        "latest_version": latest,
        "status": classify_update_version(current, latest),
        "security_status": "unknown",
        "vulnerability_count": None,
        "vulnerabilities": [],
        "source_url": f"https://www.npmjs.com/package/{package}",
        "content_trust": "trusted-metadata-untrusted-text",
    }


def check_update_github_release_source(source):
    repository = source["repository"]
    encoded_repository = "/".join(
        urllib.parse.quote(part, safe="") for part in repository.split("/", 1)
    )
    payload = update_http_json(
        f"https://api.github.com/repos/{encoded_repository}/releases/latest"
    )
    if not isinstance(payload, dict):
        raise ValueError("GitHub release response must be an object")
    tag = str(payload.get("tag_name") or "").strip() or None
    body = str(payload.get("body") or "")
    current = update_source_current_version(source, allow_server=True)
    reference = source.get("category") == "reference-agent"
    return {
        "current_version": current,
        "latest_version": tag,
        "status": classify_update_version(current, tag, reference=reference),
        "security_status": "unknown",
        "vulnerability_count": None,
        "vulnerabilities": [],
        "source_url": (
            f"https://github.com/{repository}/releases/tag/"
            + urllib.parse.quote(str(tag or ""), safe="")
            if tag else f"https://github.com/{repository}/releases"
        ),
        "release_name": str(payload.get("name") or "")[:240],
        "published_at": str(payload.get("published_at") or "")[:80],
        "release_notes_sha256": hashlib.sha256(body.encode("utf-8")).hexdigest(),
        "release_notes_excerpt": update_release_excerpt(body),
        "content_trust": "untrusted-upstream-release-notes",
    }


