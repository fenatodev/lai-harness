def resolve_rollback_run_id(selector):
    wanted = str(selector or "").strip()
    checkpoint = load_run_checkpoint()
    if wanted == "--last":
        if not checkpoint:
            raise SystemExit("rollback requires an active checkpoint")
        return str(checkpoint.get("run_id") or "")
    return wanted


def collect_rollback_plan(selector, dry_run=True):
    run_id = resolve_rollback_run_id(selector)
    if not run_id:
        raise SystemExit("rollback requires a run id")
    checkpoint = load_run_checkpoint()
    if not checkpoint or checkpoint.get("run_id") != run_id:
        raise SystemExit("rollback requires the active checkpoint for that run")
    expected_hashes = checkpoint.get("tracked_hashes") or {}
    if not isinstance(expected_hashes, dict):
        raise SystemExit("rollback checkpoint hash map is invalid")
    snapshot = load_run_snapshots(run_id)
    if not snapshot:
        raise SystemExit("rollback snapshot not found")
    actions = []
    blocked = []
    for item in snapshot.get("files") or []:
        rel = normalize_snapshot_path(item.get("path"))
        if not rel:
            blocked.append({"path": item.get("path"), "reason": "invalid snapshot path"})
            continue
        expected_current = expected_hashes.get(rel)
        current_hashes = hash_repository_paths([rel])
        current_hash = current_hashes.get(rel)
        if not expected_current:
            blocked.append({"path": rel, "reason": "missing checkpoint hash"})
            continue
        if current_hash != expected_current:
            blocked.append({"path": rel, "reason": "current file hash differs from checkpoint"})
            continue
        if item.get("status") != "captured":
            blocked.append({"path": rel, "reason": item.get("reason") or "snapshot not captured"})
            continue
        if item.get("exists") is False:
            actions.append({"path": rel, "action": "delete-created-file", "sha256": current_hash})
            continue
        content = item.get("content")
        if not isinstance(content, str):
            blocked.append({"path": rel, "reason": "snapshot content missing"})
            continue
        before_hash = item.get("sha256")
        if hashlib.sha256(content.encode("utf-8")).hexdigest() != before_hash:
            blocked.append({"path": rel, "reason": "snapshot content hash mismatch"})
            continue
        actions.append({"path": rel, "action": "restore-file", "before_sha256": before_hash, "current_sha256": current_hash})
    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "repository": str(ROOT),
        "run_id": run_id,
        "dry_run": bool(dry_run),
        "action_count": len(actions),
        "blocked_count": len(blocked),
        "actions": actions,
        "blocked": blocked,
    }


def atomic_restore_text(path, content):
    os_module = __import__("os")
    stat_module = __import__("stat")
    tempfile_module = __import__("tempfile")
    mode = stat_module.S_IMODE(path.stat().st_mode) if path.exists() else 0o644
    temp_path = None
    try:
        with tempfile_module.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=path.parent,
            prefix=".lai-rollback-",
            delete=False,
        ) as handle:
            handle.write(content)
            handle.flush()
            os_module.fsync(handle.fileno())
            temp_path = Path(handle.name)
        temp_path.chmod(mode)
        os_module.replace(temp_path, path)
    except Exception:
        if temp_path is not None:
            try:
                temp_path.unlink(missing_ok=True)
            except Exception:
                pass
        raise


def apply_rollback_plan(selector, dry_run=True):
    plan = collect_rollback_plan(selector, dry_run=dry_run)
    if plan["blocked"]:
        return plan
    if dry_run:
        return plan
    snapshot = load_run_snapshots(plan["run_id"])
    by_path = {item.get("path"): item for item in snapshot.get("files") or []}
    for action in plan["actions"]:
        rel = action["path"]
        candidate = ROOT.resolve() / rel
        item = by_path[rel]
        if action["action"] == "delete-created-file":
            candidate.unlink()
        elif action["action"] == "restore-file":
            atomic_restore_text(candidate, item["content"])
    plan["dry_run"] = False
    plan["applied"] = True
    record_audit_event({
        "type": "rollback",
        "run_id": plan["run_id"],
        "actions": [{"path": item["path"], "action": item["action"]} for item in plan["actions"]],
    })
    return plan


def render_rollback(args):
    raw = list(args or [])
    if raw in (["--help"], ["-h"], ["help"]):
        return ROLLBACK_USAGE
    json_mode = "--json" in raw
    dry_run = "--dry-run" in raw
    raw = [item for item in raw if item not in {"--json", "--dry-run"}]
    if len(raw) != 1:
        raise SystemExit(ROLLBACK_USAGE)
    payload = apply_rollback_plan(raw[0], dry_run=dry_run)
    if json_mode:
        return json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True)
    lines = ["# lai rollback", "", "Run ID: " + str(payload.get("run_id")), "Dry run: " + str(payload.get("dry_run")).lower(), "Actions: " + str(payload.get("action_count")), "Blocked: " + str(payload.get("blocked_count"))]
    for item in payload.get("actions") or []:
        lines.append("- " + item["action"] + ": " + item["path"])
    for item in payload.get("blocked") or []:
        lines.append("BLOCKED: " + str(item.get("path")) + " — " + str(item.get("reason")))
    return "\n".join(lines)


