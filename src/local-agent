    req = urllib.request.Request(
        f"http://{host}:{LLAMA_PORT}/v1/chat/completions",
        data=json.dumps(payload).encode(),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {key}",
        },
    )

    started = _metrics_time.perf_counter()

    try:
        with urllib.request.urlopen(
            req,
            timeout=180,
        ) as response:
            result = json.loads(
                response.read().decode()
            )
    except Exception as e:
        duration_ms = (
            _metrics_time.perf_counter()
            - started
        ) * 1000.0

        record_metric_event({
            "type": "api",
            "duration_ms": round(duration_ms, 2),
            "error": type(e).__name__,
            "prompt_tokens": 0,
            "completion_tokens": 0,
            "total_tokens": 0,
            "max_tokens": max_tokens,
            "tool_schema_count": len(
                selected_tools
                if use_tools
                else []
            ),
        })

        raise

    duration_ms = (
        _metrics_time.perf_counter()
        - started
    ) * 1000.0

    usage = result.get("usage") or {}

    record_metric_event({
        "type": "api",
        "duration_ms": round(duration_ms, 2),
        "prompt_tokens": int(
            usage.get("prompt_tokens") or 0
        ),
        "completion_tokens": int(
            usage.get("completion_tokens") or 0
        ),
        "total_tokens": int(
            usage.get("total_tokens") or 0
        ),
        "max_tokens": max_tokens,
        "tool_schema_count": len(
            selected_tools
            if use_tools
            else []
        ),
    })

    return result


STATE_BASE = CONFIG["state_dir"]

def classify_patch_sanity(
    host,
    task,
    diff_text,
):
    if not diff_text.strip():
        return None

    # Keep only file headers, hunks and additions.
    # This reduces distraction and prefill.
    focused_lines = []

    for line in diff_text.splitlines():
        if (
            line.startswith("diff --git ")
            or line.startswith("+++ ")
            or line.startswith("@@ ")
            or (
                line.startswith("+")
                and not line.startswith("+++")
            )
        ):
            focused_lines.append(line)

    focused = "\n".join(
        focused_lines
    )[:4500]

    if not focused.strip():
        return None

    messages = [
        {
            "role": "system",
            "content": (
                "You are a strict added-lines defect checker. "
                "Review ONLY concrete defects introduced by the patch. "
                "Return exactly CLEAN or one line beginning BUG:. "
                "Report only defects likely to break execution or an "
                "explicit acceptance criterion: misspelled/undefined "
                "identifier, syntax/runtime defect, broken import/export, "
                "invalid API use, or explicitly missing requested behavior. "
                "Do not report style, naming, formatting, optional "
                "improvements, speculative edge cases, or pre-existing "
                "issues. If an added line in the supplied patch clearly "
                "defines/imports an identifier, do not call it undefined."
            ),
        },
        {
            "role": "user",
            "content": (
                "TASK:\n"
                + task[:1000]
                + "\n\nADDED PATCH LINES:\n"
                + focused
            ),
        },
    ]

    try:
        result = api_call(
            host,
            messages,
            use_tools=False,
            max_tokens=64,
        )

        text = (
            result["choices"][0]["message"]
            .get("content", "")
            .strip()
        )
    except Exception:
        return None

    upper = text.upper()

    if upper == "CLEAN":
        return None

    if upper.startswith("BUG:"):
        return text[:500]

    return None



def post_patch_sanity(
    host,
    task,
    paths,
):
    normalized = []

    for raw_path in paths:
        value = str(
            raw_path or ""
        ).strip()

        while value.startswith("./"):
            value = value[2:]

        if (
            value
            and value not in normalized
        ):
            normalized.append(value)

    if not normalized:
        return None

    root_real = ROOT.resolve()

    # --------------------------------------------------------
    # 1. Deterministic syntax checks for runnable JS.
    # --------------------------------------------------------

    node_path = __import__(
        "shutil"
    ).which("node")

    if node_path:
        for rel in normalized:
            suffix = Path(
                rel
            ).suffix.lower()

            if suffix not in {
                ".js",
                ".cjs",
                ".mjs",
            }:
                continue

            candidate = root_real / rel

            if not candidate.is_file():
                continue

            try:
                proc = subprocess.run(
                    [
                        node_path,
                        "--check",
                        str(candidate),
                    ],
                    cwd=ROOT,
                    text=True,
                    capture_output=True,
                    timeout=15,
                )
            except Exception:
                proc = None

            if (
                proc is not None
                and proc.returncode != 0
            ):
                detail = (
                    proc.stderr.strip()
                    or proc.stdout.strip()
                    or "syntax check failed"
                )

                detail = " ".join(
                    detail.split()
                )[:320]

                return (
                    f"BUG: node --check failed for "
                    f"{rel}: {detail}"
                )

    # --------------------------------------------------------
    # 2. Deterministic added-line inspection.
    # --------------------------------------------------------

    try:
        proc = subprocess.run(
            [
                "git",
                "diff",
                "--no-ext-diff",
                "--unified=1",
                "--",
                *normalized,
            ],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=15,
        )
    except Exception:
        return None

    if proc.returncode != 0:
        return None

    diff_text = proc.stdout

    if not diff_text.strip():
        return None

    current_file = None

    added_by_file = {}

    for line in diff_text.splitlines():
        if line.startswith("+++ b/"):
            current_file = line[6:]
            added_by_file.setdefault(
                current_file,
                [],
            )
            continue

        if (
            current_file
            and line.startswith("+")
            and not line.startswith("+++")
        ):
            added_by_file[
                current_file
            ].append(line[1:])

    # Detect glued constructor/function names such as:
    #
    #   throw newError(...)
    #
    # If newError is not declared/imported in the file,
    # this is a concrete latent runtime defect even when
    # the branch is not exercised by tests.

    suspicious_call = re.compile(
        r"\b(new[A-Z][A-Za-z0-9_$]*)\s*\("
    )

    for rel, added_lines in added_by_file.items():
        suffix = Path(
            rel
        ).suffix.lower()

        if suffix not in {
            ".js",
            ".cjs",
            ".mjs",
            ".jsx",
            ".ts",
            ".cts",
            ".mts",
            ".tsx",
        }:
            continue

        candidate = root_real / rel

        try:
            full_text = candidate.read_text(
                errors="replace"
            )
        except Exception:
            continue

        for added in added_lines:
            for match in suspicious_call.finditer(
                added
            ):
                identifier = match.group(1)
                escaped = re.escape(
                    identifier
                )

                declaration_patterns = [
                    rf"\bfunction\s+{escaped}\b",
                    rf"\bclass\s+{escaped}\b",
                    rf"\b(?:const|let|var)\s+{escaped}\b",
                    rf"\bimport\b[^\n]*\b{escaped}\b",
                    rf"\{{[^}}\n]*\b{escaped}\b[^}}\n]*\}}\s*=\s*require\(",
                ]

                declared = any(
                    re.search(
                        pattern,
                        full_text,
                    )
                    for pattern
                    in declaration_patterns
                )

                if declared:
                    continue

                # Strong special case:
                # "newError(...)" is commonly a missing space
                # for "new Error(...)".
                suggested = None

                constructor = (
                    identifier[3:]
                    if identifier.startswith("new")
                    else ""
                )

                builtin_constructors = {
                    "Error",
                    "TypeError",
                    "RangeError",
                    "ReferenceError",
                    "SyntaxError",
                    "URIError",
                    "EvalError",
                    "Date",
                    "Map",
                    "Set",
                    "WeakMap",
                    "WeakSet",
                    "Promise",
                    "RegExp",
                    "Array",
                    "Object",
                }

                if (
                    constructor
                    in builtin_constructors
                ):
                    suggested = (
                        f" If `{constructor}` constructor "
                        f"was intended, use "
                        f"`new {constructor}(...)`."
                    )

                return (
                    f"BUG: added call `{identifier}(...)` "
                    f"in {rel} is not declared or imported "
                    f"in that file."
                    + (suggested or "")
                )

    # --------------------------------------------------------
    # 3. Small LLM check for defects not caught statically.
    # --------------------------------------------------------

    return classify_patch_sanity(
        host,
        task,
        diff_text,
    )




def workspace_state_paths():
    hashlib = __import__("hashlib")

    key = hashlib.sha256(
        str(ROOT).encode("utf-8")
    ).hexdigest()[:16]

    return (
        STATE_BASE / f"{key}.json",
        STATE_BASE / f"{key}.md",
    )


def load_workspace_state():
    json_path, _ = workspace_state_paths()

    base = {
        "root": str(ROOT),
        "updated_at": None,
        "last_mode": None,
        "last_task": None,
        "recent_files": [],
        "modified_files": [],
        "last_validation": None,
        "last_command": None,
        "last_git_operation": None,
        "git_status": None,
        "git_branch": None,
        "last_answer": None,
        "handoff_note": None,
    }

    if not json_path.is_file():
        return base

    try:
        data = json.loads(
            json_path.read_text(errors="replace")
        )

        if data.get("root") != str(ROOT):
            return base

        base.update(data)
    except Exception:
        pass

    return base


def workspace_git_branch():
    try:
        proc = subprocess.run(
            ["git", "branch", "--show-current"],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=10,
        )

        if proc.returncode != 0:
            return "[unavailable]"

        return proc.stdout.strip() or "[detached HEAD]"
    except Exception:
        return "[unavailable]"


def cleanup_stale_workspace_states(max_age_days=45):
    time = __import__("time")

    if not STATE_BASE.is_dir():
        return

    cutoff = (
        time.time()
        - max_age_days * 24 * 60 * 60
    )

    for json_path in STATE_BASE.glob("*.json"):
        try:
            if json_path.stat().st_mtime >= cutoff:
                continue

            md_path = json_path.with_suffix(".md")

            json_path.unlink(missing_ok=True)
            md_path.unlink(missing_ok=True)
        except Exception:
            pass


def workspace_git_status():
    try:
        proc = subprocess.run(
            ["git", "status", "--short"],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=10,
        )

        if proc.returncode != 0:
            return "[unavailable]"

        lines = proc.stdout.splitlines()

        if not lines:
            return "[clean]"

        output = "\n".join(lines[:15])

        if len(lines) > 15:
            output += "\n[status truncated]"

        return output
    except Exception:
        return "[unavailable]"


def render_workspace_handoff(state, compact=False):
    recent = state.get("recent_files") or []
    modified = state.get("modified_files") or []
    validation = state.get("last_validation")
    git_status = state.get("git_status") or "[unknown]"

    if compact:
        sections = [
            "PRIOR WORKSPACE CONTEXT "
            "(compact; may be stale; current request and repository "
            "evidence always override it):"
        ]

        if state.get("git_branch"):
            sections.append(
                "Git branch: "
                + str(state["git_branch"])[:150]
            )

        if state.get("last_task"):
            sections.append(
                "Previous task: "
                + str(state["last_task"])[:500]
            )

        if recent:
            sections.append(
                "Recent relevant files: "
                + ", ".join(recent[-8:])
            )

        if modified:
            sections.append(
                "Recently modified files: "
                + ", ".join(modified[-8:])
            )

        if validation:
            command = str(
                validation.get("command", "")
            )[:300]

            result = str(
                validation.get("result", "")
            ).replace("\n", " ")[:350]

            sections.append(
                f"Last validation: {command} -> {result}"
            )

        if state.get("handoff_note"):
            sections.append(
                "Handoff note: "
                + str(state["handoff_note"])[:500]
            )

        if state.get("last_answer"):
            sections.append(
                "Previous result: "
                + str(state["last_answer"])
                    .replace("\n", " ")[:500]
            )

        return "\n".join(sections)[:1600]

    lines = [
        "# LAI Workspace Handoff",
        "",
        f"Repository: {state.get('root', ROOT)}",
        f"Branch: {state.get('git_branch') or '[unknown]'}",
        f"Updated: {state.get('updated_at') or '[unknown]'}",
        f"Last mode: {state.get('last_mode') or '[none]'}",
        "",
        "## Last task",
        state.get("last_task") or "[none]",
        "",
        "## Recent relevant files",
    ]

    if recent:
        lines.extend(f"- {item}" for item in recent[-12:])
    else:
        lines.append("- [none]")

    lines.extend([
        "",
        "## Recently modified files",
    ])

    if modified:
        lines.extend(
            f"- {item}"
            for item in modified[-12:]
        )
    else:
        lines.append("- [none]")

    lines.extend([
        "",
        "## Last validation",
    ])

    if validation:
        lines.append(
            f"Command: {validation.get('command', '[unknown]')}"
        )
        lines.append(
            "Result: "
            + str(
                validation.get("result", "[unknown]")
            )[:800]
        )
    else:
        lines.append("[none]")

    lines.extend([
        "",
        "## Git status",
        "```text",
        git_status,
        "```",
    ])

    if state.get("handoff_note"):
        lines.extend([
            "",
            "## Handoff note",
            str(state["handoff_note"])[:1500],
        ])

    if state.get("last_answer"):
        lines.extend([
            "",
            "## Last result",
            str(state["last_answer"])[:1800],
        ])

    lines.extend([
        "",
        "## Rule",
        "Current repository evidence and the current user request "
        "override this handoff if anything here is stale.",
    ])

    return "\n".join(lines)[:7000]


def save_workspace_state(state):
    time = __import__("time")

    STATE_BASE.mkdir(
        parents=True,
        exist_ok=True,
    )

    cleanup_stale_workspace_states()

    json_path, md_path = workspace_state_paths()

    state["root"] = str(ROOT)
    state["updated_at"] = time.strftime(
        "%Y-%m-%dT%H:%M:%SZ",
        time.gmtime(),
    )
    state["git_status"] = workspace_git_status()
    state["git_branch"] = workspace_git_branch()

    state["recent_files"] = list(
        dict.fromkeys(
            state.get("recent_files") or []
        )
    )[-12:]

    state["modified_files"] = list(
        dict.fromkeys(
            state.get("modified_files") or []
        )
    )[-12:]

    json_text = json.dumps(
        state,
        ensure_ascii=False,
        indent=2,
    ) + "\n"

    markdown = (
        render_workspace_handoff(state)
        + "\n"
    )

    json_path.write_text(json_text)
    md_path.write_text(markdown)

    current_json = (
        STATE_BASE.parent
        / "current-context.json"
    )

    current_md = (
        STATE_BASE.parent
        / "current-context.md"
    )

    current_json.write_text(json_text)
    current_md.write_text(markdown)

    return md_path


def clear_workspace_state():
    json_path, md_path = workspace_state_paths()

    for path in (json_path, md_path):
        try:
            path.unlink()
        except FileNotFoundError:
            pass

    current_json = (
        STATE_BASE.parent
        / "current-context.json"
    )

    current_md = (
        STATE_BASE.parent
        / "current-context.md"
    )

    remove_current = False

    try:
        data = json.loads(
            current_json.read_text(
                errors="replace"
            )
        )
        remove_current = (
            data.get("root") == str(ROOT)
        )
    except Exception:
        pass

    if remove_current:
        for path in (
            current_json,
            current_md,
        ):
            try:
                path.unlink()
            except FileNotFoundError:
                pass


def record_workspace_tool(
    state,
    name,
    args,
    result,
    is_validation=False,
):
    path = args.get("path")

    if (
        path
        and path not in {".", "./"}
        and name in {
            "read",
            "search",
            "list",
            "edit",
            "create",
            "git",
        }
    ):
        state.setdefault(
            "recent_files",
            [],
        ).append(str(path))

    if (
        name in {"edit", "create"}
        and result.startswith("OK:")
        and path
    ):
        state.setdefault(
            "modified_files",
            [],
        ).append(str(path))

    if name == "inspect":
        for inspected_path in args.get("paths") or []:
            state.setdefault(
                "recent_files",
                [],
            ).append(
                str(inspected_path)
            )

    if (
        name == "patch"
        and result.startswith("OK:")
    ):
        for change in args.get("changes") or []:
            changed_path = change.get("path")

            if changed_path:
                state.setdefault(
                    "modified_files",
                    [],
                ).append(
                    str(changed_path)
                )

                state.setdefault(
                    "recent_files",
                    [],
                ).append(
                    str(changed_path)
                )

    if name == "bash":
        command = str(
            args.get("command", "")
        )[:500]

        state["last_command"] = command

        if is_validation:
            state["last_validation"] = {
                "command": command,
                "result": str(result)[:700],
            }

    if (
        name == "bash"
        and is_validation
    ):
        record_audit_event({
            "type": "validation",
            "command": str(
                args.get("command", "")
            )[:500],
            "result": str(result)[:900],
            "current_hashes": (
                hash_repository_paths(
                    state.get(
                        "modified_files"
                    ) or []
                )
            ),
        })

    if name == "git":
        state["last_git_operation"] = (
            str(args.get("operation", ""))[:100]
        )

    save_workspace_state(state)



def main():
    args = list(CLI_ARGS)

    if args and args[0] in {"--version", "-V"}:
        print(f"lai-local-agent {VERSION}")
        return

    if args and args[0] == "--show-config":
        visible = {
            key: str(value) if isinstance(value, Path) else value
            for key, value in CONFIG.items()
        }
        print(json.dumps(visible, indent=2, sort_keys=True))
        return

    if args and args[0] == "--doctor":
        host = gateway()
        unauthenticated, authenticated = doctor_status(host)
        print("# LAI Doctor")
        print(f"Server address: {host}:{LLAMA_PORT}")
        print(f"Unauthenticated /props: HTTP {unauthenticated or '000'}")
        print(f"Authenticated /props:   HTTP {authenticated or '000'}")
        if authenticated == 200 and unauthenticated != 200:
            print("Authentication: OK")
            return
        print("Authentication: FAILED")
        raise SystemExit(1)

    if args and args[0] == "--metrics":
        print_lai_metrics()
        return

    if args and args[0] == "--audit":
        print_lai_audit()
        return

    if args and args[0] == "--handoff":
        state = load_workspace_state()
        note = " ".join(args[1:]).strip()

        if note:
            state["handoff_note"] = note[:1500]
            save_workspace_state(state)

        _, md_path = workspace_state_paths()

        print(render_workspace_handoff(state))
        print()
        print(f"Context file: {md_path}")
        print(
            "Current context: "
            f"{STATE_BASE.parent / 'current-context.md'}"
        )
        return

    if args and args[0] == "--clear-context":
        clear_workspace_state()
        print("LAI workspace context cleared.")
        return

    if args and args[0] == "--status":
        state = load_workspace_state()

        # Atualiza apenas informações voláteis sem precisar do modelo.
        state["git_status"] = workspace_git_status()
        state["git_branch"] = workspace_git_branch()

        recent = state.get("recent_files") or []
        modified = state.get("modified_files") or []
        validation = state.get("last_validation")

        print("# LAI Workspace Status")
        print()
        print(f"Repository: {ROOT}")
        print(
            "Branch: "
            + str(state.get("git_branch") or "[unknown]")
        )
        print(
            "Context updated: "
            + str(state.get("updated_at") or "[never]")
        )
        print(
            "Last mode: "
            + str(state.get("last_mode") or "[none]")
        )

        print()
        print("## Last task")
        print(state.get("last_task") or "[none]")

        print()
        print("## Recent files")
        if recent:
            for item in recent[-8:]:
                print(f"- {item}")
        else:
            print("- [none]")

        print()
        print("## Modified by LAI")
        if modified:
            for item in modified[-8:]:
                print(f"- {item}")
        else:
            print("- [none]")

        print()
        print("## Last validation")
        if validation:
            print(
                "Command: "
                + str(validation.get("command", "[unknown]"))
            )
            result = str(
                validation.get("result", "[unknown]")
            ).replace("\n", " ")
            print("Result: " + result[:500])
        else:
            print("[none]")

        print()
        print("## Git status")
        print("```text")
        print(state.get("git_status") or "[unknown]")
        print("```")

        if state.get("handoff_note"):
            print()
            print("## Handoff note")
            print(state["handoff_note"])

        _, md_path = workspace_state_paths()

        print()
        print(f"Context file: {md_path}")
        print(
            "Current context: "
            f"{STATE_BASE.parent / 'current-context.md'}"
        )
        return

    supported_modes = {
        "--selection": "selection",
        "--fix": "fix",
        "--test": "test",
        "--review": "review",
        "--debug": "debug",
        "--refactor": "refactor",
        "--security": "security",
        "--plan": "plan",
        "--implement": "implement",
    }

    mode = "general"

    if args and args[0] in supported_modes:
        mode = supported_modes[args[0]]
        args = args[1:]

