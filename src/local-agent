        },
        "server": {
            "host": host,
            "port": LLAMA_PORT,
            "unauthenticated_props": unauthenticated,
            "authenticated_props": authenticated,
            "authentication_ok": server_ok,
        },
        "paths": path_checks,
        "skills": skills,
        "active_spec": spec_status,
        "recovery": recovery_status,
        "run_count": len(runs),
