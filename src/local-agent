def _git_numstat(args):
    try:
        proc = subprocess.run(
            ["git", *args, "--numstat"],
            cwd=ROOT, text=True, capture_output=True, timeout=10,
        )
    except Exception:
        return {}
    if proc.returncode != 0:
        return {}
    stats = {}
    for line in proc.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) < 3:
            continue
        raw_path = parts[-1]
        if " -> " in raw_path:
            raw_path = raw_path.split(" -> ", 1)[1]
        rel = _context_rel_path_safe(raw_path)
        if rel is None:
            continue
        def number(value):
            return None if value == "-" else int(value) if value.isdigit() else None
        stats[rel] = {"additions": number(parts[0]), "deletions": number(parts[1])}
    return stats


def context_git_diff_payload(limit=60):
    limit = max(1, min(int(limit), 200))
    changes = context_git_changes_payload(limit=200)
    staged_stats = _git_numstat(["diff", "--cached"])
    unstaged_stats = _git_numstat(["diff"])
    by_path = {}
    for item in changes.get("entries", []):
        rel = item.get("path")
        if not rel:
            continue
        by_path[rel] = {
            "path": rel,
            "index_status": item.get("index_status"),
            "worktree_status": item.get("worktree_status"),
            "staged": bool(item.get("staged")),
            "unstaged": bool(item.get("unstaged")),
            "untracked": bool(item.get("untracked")),
            "staged_additions": None,
            "staged_deletions": None,
            "unstaged_additions": None,
            "unstaged_deletions": None,
        }
    for rel, stat in staged_stats.items():
        by_path.setdefault(rel, {"path": rel, "staged": True, "unstaged": False, "untracked": False})
        by_path[rel]["staged"] = True
        by_path[rel]["staged_additions"] = stat.get("additions")
        by_path[rel]["staged_deletions"] = stat.get("deletions")
    for rel, stat in unstaged_stats.items():
        by_path.setdefault(rel, {"path": rel, "staged": False, "unstaged": True, "untracked": False})
        by_path[rel]["unstaged"] = True
        by_path[rel]["unstaged_additions"] = stat.get("additions")
        by_path[rel]["unstaged_deletions"] = stat.get("deletions")
    entries = sorted(by_path.values(), key=lambda item: item.get("path") or "")
    def total(key):
        return sum(int(item.get(key) or 0) for item in entries if item.get(key) is not None)
    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "diff_version": 1,
        "repository": ".",
        "metadata_only": True,
        "inspected_content": False,
        "overall": changes.get("overall", "unknown"),
        "entries": entries[:limit],
        "entry_count": len(entries),
        "entry_limit": limit,
        "entry_list_truncated": len(entries) > limit,
        "totals": {
            "staged_additions": total("staged_additions"),
            "staged_deletions": total("staged_deletions"),
            "unstaged_additions": total("unstaged_additions"),
            "unstaged_deletions": total("unstaged_deletions"),
            "untracked_paths": sum(1 for item in entries if item.get("untracked")),
        },
        "trust": "Metadata-only Git diff summary. Inspect raw diffs before relying on code changes.",
    }


