def prune_update_intelligence_results(result_dir, keep=UPDATE_RESULT_RETENTION):
    if keep < 1:
        raise ValueError("update result retention must be positive")
    candidates = []
    for path in result_dir.glob("*.json"):
        if path.name == "latest.json" or path.is_symlink() or not path.is_file():
            continue
        try:
            candidates.append((path.stat().st_mtime_ns, path.name, path))
        except OSError:
            continue
    candidates.sort(reverse=True)
    for _, _, path in candidates[keep:]:
        try:
            path.unlink()
        except FileNotFoundError:
            pass


def run_update_check():
    manifest = load_update_sources()
    result_dir = update_result_directory()
    previous = load_latest_update_summary()
    previous_by_id = {
        item.get("id"): item for item in (previous or {}).get("sources", [])
        if isinstance(item, dict) and item.get("id")
    }
    workspace_before = update_workspace_snapshot()
    records = []
    for source in manifest["sources"]:
        try:
            record = check_update_source(source)
        except (OSError, ValueError) as exc:
            record = {
                "id": source["id"],
                "category": source["category"],
                "source_type": source["source_type"],
                "current_version": update_source_current_version(source, allow_server=False),
                "latest_version": None,
                "status": "check_failed",
                "security_status": "unknown",
                "vulnerability_count": None,
                "vulnerabilities": [],
                "source_url": "",
                "content_trust": "none",
                "error": str(exc)[:400],
            }
        old = previous_by_id.get(source["id"])
        if old is None:
            record["changed_since_last_check"] = None
        else:
            record["changed_since_last_check"] = (
                update_observation_key(record) != update_observation_key(old)
            )
        records.append(record)

    workspace_after = update_workspace_snapshot()
    if workspace_after != workspace_before:
        raise ValueError("active repository changed during update intelligence check")

    vulnerability_count = sum(
        int(record.get("vulnerability_count") or 0) for record in records
    )
    update_candidates = [
        record["id"] for record in records if record.get("status") == "update_available"
    ]
    failed_sources = [
        record["id"] for record in records if record.get("status") == "check_failed"
    ]
    reference_changes = [
        record["id"] for record in records
        if record.get("category") == "reference-agent"
        and record.get("changed_since_last_check") is True
    ]
    if vulnerability_count:
        overall = "security_attention"
    elif failed_sources:
        overall = "partial"
    elif update_candidates:
        overall = "updates_available"
    elif reference_changes:
        overall = "reference_changes"
    else:
        overall = "current"

    now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    run_id = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + "-" + secrets.token_hex(4)
    summary = {
        "schema_version": UPDATE_INTELLIGENCE_SCHEMA_VERSION,
        "product": PRODUCT_NAME,
        "version": VERSION,
        "created_at": now,
        "check_id": run_id,
        "overall": overall,
        "network_mode": "explicit-public-metadata-only",
        "manifest_sha256": manifest["manifest_sha256"],
        "harness_executable_sha256": hashlib.sha256(Path(__file__).resolve().read_bytes()).hexdigest(),
        "workspace_head": (workspace_before or {}).get("head"),
        "workspace_clean": not bool((workspace_before or {}).get("status", "")),
        "vulnerability_count": vulnerability_count,
        "update_candidates": update_candidates,
        "failed_sources": failed_sources,
        "reference_changes": reference_changes,
        "retention_count": UPDATE_RESULT_RETENTION,
        "sources": records,
    }
    result_dir.mkdir(parents=True, exist_ok=True)
    try:
        result_dir.chmod(0o700)
    except OSError:
        pass
    result_path = result_dir / f"{run_id}.json"
    summary["result_path"] = str(result_path)
    summary["latest_path"] = str(update_latest_summary_path())
    text = json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    _atomic_write_text(result_path, text)
    _atomic_write_text(update_latest_summary_path(), text)
    prune_update_intelligence_results(result_dir)
    for path in (result_path, update_latest_summary_path()):
        try:
            path.chmod(0o600)
        except OSError:
            pass
    return summary


def render_update_check(summary, json_mode=False):
    if json_mode:
        return json.dumps(summary, indent=2, sort_keys=True)
    lines = [
        "# lai update intelligence check",
        f"Overall: {summary['overall']}",
        f"Created: {summary['created_at']}",
        f"Vulnerabilities: {summary['vulnerability_count']}",
        f"Update candidates: {len(summary['update_candidates'])}",
        f"Reference changes: {len(summary['reference_changes'])}",
        f"Failed sources: {len(summary['failed_sources'])}",
        "",
        "Sources:",
    ]
    for record in summary["sources"]:
        current = record.get("current_version") or "?"
        latest = record.get("latest_version") or "?"
        changed = record.get("changed_since_last_check")
        changed_text = "first" if changed is None else ("changed" if changed else "same")
        lines.append(
            f"- {record['id']}: {record['status']} current={current} latest={latest} "
            f"security={record['security_status']} observation={changed_text}"
        )
        if record.get("error"):
            lines.append(f"  error: {record['error']}")
        if int(record.get("vulnerability_count") or 0):
            for vulnerability in record.get("vulnerabilities", [])[:5]:
                lines.append(
                    f"  vulnerability: {vulnerability.get('id')} {vulnerability.get('summary', '')}".rstrip()
                )
    lines.extend([
        "",
        f"Result: {summary.get('result_path', '[not persisted]')}",
        "",
        "Safety:",
        "- Remote metadata was read only from fixed official public endpoints.",
        "- Upstream release-note text is untrusted evidence and is never executed or injected as instructions.",
        "- No dependency, model, skill, tool, repository file, Git ref, or release was changed.",
    ])
    return "\n".join(lines)


