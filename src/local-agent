                verdict = (
                    verified["choices"][0]["message"]
                    .get("content", "")
                    .strip()
                )

                if __import__("os").environ.get("LAI_DEBUG_GATE") == "1":
                    print(
                        "\n[GATE_VERDICT]\n" + verdict,
                        file=sys.stderr,
