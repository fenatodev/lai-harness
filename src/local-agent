def control_create_browser_session(server, request):
    if not isinstance(request, dict):
        raise ValueError("JSON object required")
    unknown = sorted(set(request) - {"adapter", "url", "html", "ttl_seconds"})
    if unknown:
        raise ValueError("unknown fields: " + ", ".join(unknown))
    adapter = request.get("adapter", "fixture_browser")
    if adapter != "fixture_browser":
        return {
            "schema_version": CONTROL_BROWSER_SCHEMA_VERSION,
            "decision": "DENY",
            "reason": "browser adapter is not enabled in this v1 contract",
            "executed": False,
        }
    current_url = _control_browser_validate_fixture_url(request.get("url", "fixture://local/index.html"))
    html_text = _control_browser_validate_html(request.get("html", ""))
    ttl = request.get("ttl_seconds", CONTROL_BROWSER_DEFAULT_TTL_SECONDS)
    if not isinstance(ttl, int) or not 1 <= ttl <= CONTROL_BROWSER_MAX_TTL_SECONDS:
        raise ValueError("ttl_seconds is out of range")
    now = time.time()
    session_id = "br-" + secrets.token_hex(8)
    profile = _control_browser_profile_path(session_id)
    profile.mkdir(parents=True, exist_ok=True, mode=0o700)
    record = {
        "schema_version": CONTROL_BROWSER_SCHEMA_VERSION,
        "browser_session_id": session_id,
        "status": "active",
        "adapter": adapter,
        "origin": current_url,
        "current_url": current_url,
        "html": html_text,
        "dom_sha256": _control_browser_dom_sha256(html_text),
        "created_at": _control_authority_timestamp(now),
        "expires_at": _control_authority_timestamp(now + ttl),
        "expires_at_epoch": now + ttl,
        "downloads": [],
    }
    with server.control_browser_lock:
        _control_browser_store_session(record)
        _control_browser_prune()
    return _control_browser_public_session(record)


def control_browser_navigate(server, browser_session_id, request):
    if not isinstance(request, dict):
        raise ValueError("JSON object required")
    unknown = sorted(set(request) - {"url", "html"})
    if unknown:
        raise ValueError("unknown fields: " + ", ".join(unknown))
    new_url = _control_browser_validate_fixture_url(request.get("url"))
    new_html = _control_browser_validate_html(request.get("html", ""))
    with server.control_browser_lock:
        record = _control_browser_active(_control_browser_load_session(browser_session_id))
        record["current_url"] = new_url
        record["html"] = new_html
        record["dom_sha256"] = _control_browser_dom_sha256(new_html)
        _control_browser_store_session(record)
        return _control_browser_public_session(record)


def control_browser_extract_payload(server, browser_session_id):
    with server.control_browser_lock:
        record = _control_browser_active(_control_browser_load_session(browser_session_id))
        text, truncated = _control_browser_visible_text(record.get("html", ""))
        return {
            "schema_version": CONTROL_BROWSER_SCHEMA_VERSION,
