def clean_safe_workspace(raw, json_mode=False):
    options = parse_safe_workspace_options(raw)
    base = safe_workspace_base(options["base"])
    targets = []
    if options["all"]:
        targets = [item for item in base.iterdir() if item.is_dir()] if base.is_dir() else []
    else:
        name = options["name"]
        if not name:
            raise SystemExit("Usage: lai workspace clean <name|path> [--base DIR] [--json]")
        candidate = Path(name).expanduser()
        target = candidate if candidate.is_absolute() else base / slugify_safe_workspace_name(name)
        targets = [ensure_safe_workspace_child(base, target)]
    removed = []
    for target in targets:
        target = ensure_safe_workspace_child(base, target)
        if not target.exists():
            raise SystemExit(f"Safe workspace not found: {target}")
        shutil.rmtree(target)
        removed.append(str(target))
    payload = {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "status": "cleaned",
        "base_dir": str(base),
        "removed": removed,
    }
    if json_mode:
        return json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True)
    lines = ["# lai safe workspace clean", "", f"Base dir: {base}"]
    if removed:
        lines.append("Removed:")
        lines.extend(f"- {item}" for item in removed)
    else:
        lines.append("Removed: [none]")
    return "\n".join(lines)


def render_safe_workspace_create(raw, json_mode=False):
