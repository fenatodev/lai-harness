    workspace_state["last_task"] = task[:900]

    save_workspace_state(workspace_state)

    if not task:
        task = input("local-agent> ").strip()

    if not task:
        raise SystemExit("No task provided.")

    exact = re.fullmatch(
        r"(?:responda|responda apenas|responda somente|respond only|reply only)\s*:\s*(.+)",
        task,
        flags=re.IGNORECASE | re.DOTALL,
    )

    if exact:
        print(exact.group(1).strip())
        return

