def model_evaluation_git(repo, *args, check=True):
    proc = subprocess.run(
        ["git", *args], cwd=repo, text=True, capture_output=True, timeout=20,
    )
    if check and proc.returncode != 0:
        raise ValueError(f"fixture git command failed: {' '.join(args)}: {proc.stderr.strip()}")
    return proc


def model_evaluation_changed_paths(repo):
    proc = model_evaluation_git(repo, "status", "--porcelain=v1", "-z", "--untracked-files=all")
    raw = proc.stdout
    items = raw.split("\0")
    paths = []
    index = 0
    while index < len(items):
        item = items[index]
        if not item:
            index += 1
            continue
        status = item[:2]
        path = item[3:] if len(item) >= 4 else ""
        if path:
            paths.append(path)
        if status.startswith("R") or status.startswith("C"):
            index += 1
        index += 1
    return sorted(set(paths))


def model_evaluation_prepare_fixture(base, fixture):
    repo = base / fixture["id"]
