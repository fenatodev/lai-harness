def parse_control_session_limit(args, default=10):
    if "--limit" not in args:
        return default
    index = args.index("--limit")
    try:
        value = int(args[index + 1])
    except Exception:
        raise SystemExit("Invalid --limit value")
    if value < 1 or value > 50:
        raise SystemExit("--limit must be between 1 and 50")
    del args[index:index + 2]
    return value


def handle_control_sessions(args):
    raw = list(args)
    json_mode = "--json" in raw
    raw = [item for item in raw if item != "--json"]
    if not raw or raw[0].startswith("--"):
        command = "list"
        command_args = raw
    else:
        command = raw[0]
        command_args = raw[1:]
    try:
        if command == "list":
            limit = parse_control_session_limit(command_args, default=10)
            if command_args:
                raise SystemExit(CONTROL_SESSIONS_USAGE)
            print(render_control_sessions_list(limit=limit, json_mode=json_mode))
            return
        if command == "show":
            if len(command_args) != 1:
                raise SystemExit(CONTROL_SESSIONS_USAGE)
            print(render_control_session_show(command_args[0], json_mode=json_mode))
            return
        if command == "delete":
            if len(command_args) != 1:
                raise SystemExit(CONTROL_SESSIONS_USAGE)
            print(render_control_session_delete(command_args[0], json_mode=json_mode))
            return
    except FileNotFoundError as exc:
        raise SystemExit(f"Control session not found: {exc.filename or raw[-1]}") from exc
    except PermissionError as exc:
        raise SystemExit("Control session belongs to another repository") from exc
    except ValueError as exc:
        raise SystemExit(str(exc)) from exc
    raise SystemExit(CONTROL_SESSIONS_USAGE)


def control_api_key_path(config=None):
    config = CONFIG if config is None else config
    return Path(config["control_api_key_file"]).expanduser()


def control_api_token_status(path=None):
    target = Path(path).expanduser() if path is not None else control_api_key_path()
    result = {
        "path": str(target),
        "exists": False,
        "secure": False,
        "mode": None,
        "detail": "missing",
    }
    try:
        if target.is_symlink():
            result["exists"] = True
            result["detail"] = "symlink token files are not allowed"
            return result
        if not target.is_file():
            if target.exists():
                result["detail"] = "path exists but is not a regular file"
            return result
        mode = target.stat().st_mode & 0o777
        result["exists"] = True
        result["mode"] = format(mode, "04o")
        if target.stat().st_size <= 0:
            result["detail"] = "file is empty"
            return result
        if mode & 0o077:
            result["detail"] = "permissions expose the token to group or other users"
            return result
        if not (mode & 0o400):
            result["detail"] = "owner read permission is required"
            return result
        result["secure"] = True
        result["detail"] = "ready"
        return result
    except OSError as exc:
        result["detail"] = f"error: {exc}"
        return result


def control_api_key(path=None):
    target = Path(path).expanduser() if path is not None else control_api_key_path()
    status = control_api_token_status(target)
    if not status["exists"]:
        raise RuntimeError(f"LAI control API token not found: {target}")
    if not status["secure"]:
        raise RuntimeError(f"LAI control API token is unsafe: {status['detail']}")
    token = target.read_text(encoding="utf-8", errors="strict").strip()
    if not token:
        raise RuntimeError(f"LAI control API token is empty: {target}")
    return token


def init_control_api_token(path=None, force=False):
    target = Path(path).expanduser() if path is not None else control_api_key_path()
    existed = target.exists() or target.is_symlink()
    if existed and not force:
        raise SystemExit(f"Control API token already exists: {target}. Use --force to replace it")
    if existed and target.is_dir():
        raise SystemExit(f"Control API token path is a directory: {target}")
    target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    token = secrets.token_urlsafe(CONTROL_API_TOKEN_BYTES)
    temp = target.with_name(f".{target.name}.{os.getpid()}.{secrets.token_hex(4)}.tmp")
    try:
        fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as handle:
                handle.write(token + "\n")
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(temp, 0o600)
            os.replace(temp, target)
            os.chmod(target, 0o600)
        except Exception:
            try:
                os.close(fd)
            except OSError:
                pass
            raise
    finally:
        try:
            temp.unlink()
        except FileNotFoundError:
            pass
    status = control_api_token_status(target)
    if not status["secure"]:
        raise RuntimeError(f"Control API token initialization failed: {status['detail']}")
    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "path": str(target),
        "created": True,
        "replaced": bool(existed),
        "mode": status["mode"],
        "secret_printed": False,
    }


CONTROL_TOKEN_USAGE = "Usage: lai control-token init [--force] [--json] | lai control-token status [--json]"


def render_control_token(args=None):
    raw = list(args or [])
    json_mode = "--json" in raw
    force = "--force" in raw
    raw = [item for item in raw if item not in {"--json", "--force"}]
    command = raw[0] if raw else "status"
    if len(raw) > 1 or command not in {"init", "status"}:
        raise SystemExit(CONTROL_TOKEN_USAGE)
    if force and command != "init":
        raise SystemExit(CONTROL_TOKEN_USAGE)
    if command == "init":
        payload = init_control_api_token(force=force)
    else:
        status = control_api_token_status()
        payload = {
            "product": PRODUCT_NAME,
            "version": VERSION,
            **status,
            "secret_printed": False,
        }
    if json_mode:
        return json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True)
    lines = [
        "# lai control token",
        f"Path: {payload['path']}",
        f"Status: {'ready' if payload.get('secure', True) else payload.get('detail', 'not ready')}",
    ]
    if payload.get("created"):
        lines.append(f"Created: yes (mode {payload.get('mode')})")
        lines.append("Secret: [not printed]")
    elif payload.get("mode"):
        lines.append(f"Mode: {payload.get('mode')}")
    return "\n".join(lines)


def control_bind_is_loopback(bind):
    value = str(bind or "").strip()
    if value.lower() == "localhost":
        return True
    try:
        address = ipaddress.ip_address(value)
    except ValueError:
        return False
    return address.version == 4 and address.is_loopback


class ControlLocalChatRejected(ValueError):
    def __init__(self, status, code, message):
        super().__init__(message)
        self.status = int(status)
        self.code = str(code)
        self.message = str(message)


def _control_local_chat_error(exc):
    return {"error": {"code": exc.code, "message": exc.message}}


def control_local_chat_parse_client_version(raw):
    try:
        version = int(str(raw))
    except (TypeError, ValueError) as exc:
        raise ControlLocalChatRejected(
            400, "invalid_client_version", "client_version must be an integer"
        ) from exc
    if version != LOCAL_CHAT_SUPPORTED_CLIENT_VERSION:
        raise ControlLocalChatRejected(
            426,
            "unsupported_client_version",
            f"client_version {version} is not supported by local-chat v{LOCAL_CHAT_SUPPORTED_CLIENT_VERSION}",
        )
    return version


def control_local_chat_negotiate_query(query):
    channel = (query.get("channel") or ["local-chat"])[0]
    if channel not in LOCAL_CHAT_SUPPORTED_CHANNELS:
        raise ControlLocalChatRejected(
            400, "unsupported_channel", "channel must be local-chat or inspector"
        )
    return {
        "channel": channel,
        "client_version": control_local_chat_parse_client_version(
            (query.get("client_version") or [str(LOCAL_CHAT_SUPPORTED_CLIENT_VERSION)])[0]
        ),
    }


def control_local_chat_workspace_id(root=None):
    root = Path(root or ROOT).resolve()
    digest = hashlib.sha256(str(root).encode("utf-8")).hexdigest()[:16]
    return "lw-" + digest


def control_local_chat_validate_workspace_id(workspace_id, *, root=None):
    expected = control_local_chat_workspace_id(root=root)
    if not isinstance(workspace_id, str) or not hmac.compare_digest(workspace_id, expected):
        raise ControlLocalChatRejected(
            404, "workspace_not_registered", "workspace_id is not registered on this server"
        )
    return expected


def control_local_chat_host_is_loopback(value):
    host = str(value or "").strip()
    if not host:
        return False
    if host.startswith("["):
        end = host.find("]")
        host = host[1:end] if end > 0 else host
    elif ":" in host:
        host = host.rsplit(":", 1)[0]
    host = host.strip().lower()
    if host == "localhost":
        return True
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return False


def control_local_chat_origin_is_allowed(value):
    if not value:
        return True
    try:
        parsed = urllib.parse.urlsplit(str(value))
    except ValueError:
        return False
    if parsed.scheme != "http":
        return False
    return control_local_chat_host_is_loopback(parsed.netloc)


def control_local_chat_validate_request_headers(headers, server, *, require_csrf=False):
    if not control_local_chat_host_is_loopback(headers.get("Host", "")):
        raise ControlLocalChatRejected(
            403, "host_not_allowed", "local-chat requests require a loopback Host header"
        )
    origin = headers.get("Origin", "")
    if origin and not control_local_chat_origin_is_allowed(origin):
        raise ControlLocalChatRejected(
            403, "origin_not_allowed", "local-chat requests require a loopback Origin"
        )
    if require_csrf:
        supplied = headers.get(LOCAL_CHAT_CSRF_HEADER, "")
        expected = getattr(server, "local_chat_csrf_token", "")
        if not supplied or not expected or not hmac.compare_digest(supplied, expected):
            raise ControlLocalChatRejected(
                403, "csrf_required", f"valid {LOCAL_CHAT_CSRF_HEADER} header required"
            )


