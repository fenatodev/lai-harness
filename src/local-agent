def hash_repository_paths(paths):
    hashlib = __import__("hashlib")

    output = {}

    for raw_path in paths:
        rel = str(raw_path or "").strip()

        while rel.startswith("./"):
            rel = rel[2:]

        if not rel:
            continue

        candidate = ROOT / rel

        try:
            resolved = candidate.resolve()
            resolved.relative_to(ROOT.resolve())
        except Exception:
            output[rel] = "[invalid]"
            continue

        if not resolved.is_file():
            output[rel] = "[missing]"
            continue

        try:
            digest = hashlib.sha256(
                resolved.read_bytes()
            ).hexdigest()

            output[rel] = digest
        except Exception as exc:
            output[rel] = (
                "[error:"
                + type(exc).__name__
                + "]"
            )

    return output


