def tool_names_for_mode(mode, remote_control_child=False):
    names = set(LOCAL_TOOL_NAMES_BY_MODE.get(mode, frozenset()))
    if not remote_control_child:
        return names
    remote_names = CONTROL_RUN_TOOL_NAMES_BY_MODE.get(mode)
    if remote_names is None:
        raise ValueError(f"mode {mode} has no remote control capability profile")
    names.intersection_update(remote_names)
    forbidden = names & CONTROL_RUN_FORBIDDEN_TOOL_NAMES
    if forbidden:
        raise RuntimeError(
            "remote control capability profile contains forbidden tool(s): "
            + ", ".join(sorted(forbidden))
        )
    return names


