def model_evaluation_measure_events(metrics_events, audit_events):
    api_events = [event for event in metrics_events if event.get("type") == "api"]
    tool_events = [event for event in metrics_events if event.get("type") == "tool"]
    limit_events = [event for event in metrics_events if event.get("type") == "agent_limit"]
    policy_blocks = sum(
        1 for event in [*metrics_events, *audit_events]
        if str(event.get("decision") or "").upper() == "DENY"
    )
    return {
        "prompt_tokens": sum(int(event.get("prompt_tokens") or 0) for event in api_events),
        "completion_tokens": sum(int(event.get("completion_tokens") or 0) for event in api_events),
        "tool_calls": len(tool_events),
        "truncation_retries": sum(
            1 for event in limit_events if event.get("reason") == "response_truncated"
        ),
        "policy_blocks": policy_blocks,
    }


