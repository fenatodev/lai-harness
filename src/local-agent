def _control_experiment_normalize_approaches(items):
    if not isinstance(items, list) or not CONTROL_EXPERIMENT_MIN_FORKS <= len(items) <= CONTROL_EXPERIMENT_MAX_FORKS:
        raise ValueError("approaches must contain 2 to 4 items")
    approaches = []
    seen = set()
    for index, item in enumerate(items, 1):
        if isinstance(item, str):
            slug = re.sub(r"[^a-z0-9._-]+", "-", item.lower()).strip("-._")[:24]
            approach_id = "fk-" + (slug or str(index))
            label = item[:80]
            task = ""
        elif isinstance(item, dict):
            extra = set(item) - {"fork_id", "label", "task"}
            if extra:
                raise ValueError("unsupported approach field(s): " + ", ".join(sorted(extra)))
            approach_id = str(item.get("fork_id") or f"fk-{index}")
            label = str(item.get("label") or approach_id)[:80]
            task = str(item.get("task") or "")[:1200]
        else:
            raise ValueError("each approach must be a string or object")
        checked = validate_control_experiment_fork_id(approach_id)
        if checked in seen:
            raise ValueError("fork_id values must be unique")
        seen.add(checked)
        approaches.append({"fork_id": checked, "label": label, "task": task})
    return approaches


def control_create_session_fork_experiment(server, request):
    if not isinstance(request, dict):
        raise ValueError("JSON object required")
    _control_experiment_reject_forbidden_fields(request)
    allowed = {"parent_session_id", "approaches", "budget"}
    extra = set(request) - allowed
    if extra:
        raise ValueError("unsupported experiment field(s): " + ", ".join(sorted(extra)))
    parent_session_id = validate_control_session_id(request.get("parent_session_id"))
    approaches = _control_experiment_normalize_approaches(request.get("approaches"))
    now = control_run_now()
    with server.control_session_lock:
        parent = load_control_session(control_session_base(), parent_session_id, str(ROOT.resolve()))
        parent_snapshot = _control_session_snapshot_public(parent)
        forks = []
        for approach in approaches:
            child = create_control_session(control_session_base(), now, str(ROOT.resolve()))
            forks.append({
                **approach,
                "session_id": child["session_id"],
                "base_session_id": parent_session_id,
                "base_snapshot_sha256": parent_snapshot["snapshot_sha256"],
                "turn_count": 0,
                "history_trusted": False,
                "workspace_independent": True,
                "copied_tokens": False,
                "copied_approvals": False,
                "copied_processes": False,
                "grant": {
                    "new_authority": False,
                    "subset_of_parent": True,
                    "budget_reserved_by_fork": False,
                },
            })
    experiment = {
        "schema_version": CONTROL_EXPERIMENT_SCHEMA_VERSION,
        "experiment_id": "ex-" + secrets.token_hex(8),
        "repository": str(ROOT.resolve()),
        "created_at": now,
        "updated_at": now,
        "expires_at": _control_experiment_expires_at(),
        "base": {**_control_experiment_source_snapshot(), "parent_session": parent_snapshot},
        "forks": forks,
        "comparisons": [],
        "integration": {
            "automatic": False,
            "only_by": "hash_bound_promotion",
            "requires_patch_sha256": True,
            "source_checkout_write": False,
        },
    }
    with server.control_experiment_lock:
        _write_control_experiment(experiment)
    return experiment


