def makefile_targets(root=None):
    root = ROOT if root is None else Path(root)
    path = root / "Makefile"
    if not path.is_file():
        return []
    targets = []
    for line in path.read_text(errors="replace").splitlines():
        match = re.match(r"^([A-Za-z0-9_.-]+):(?:\s|$)", line)
        if match and not match.group(1).startswith("."):
            targets.append(match.group(1))
    return sorted(dict.fromkeys(targets))


def _project_python(root):
    candidate = Path(root) / ".venv" / "bin" / "python"
    if candidate.is_file() and os.access(candidate, os.X_OK):
        return str(candidate)
    return sys.executable


def validation_command_candidates(root=None):
    root = ROOT if root is None else Path(root)
    candidates = {profile: [] for profile in VALIDATION_PROFILES}

    def add(profile, argv):
        command = tuple(str(item) for item in argv)
        if command and command not in candidates[profile]:
            candidates[profile].append(command)

    targets = set(makefile_targets(root))
    make_profiles = {
        "test": ("test-dev", "test"),
        "check": ("check",),
        "lint": ("lint",),
        "build": ("build",),
        "typecheck": ("typecheck",),
        "full": ("validate",),
    }
    for profile, names in make_profiles.items():
        for name in names:
            if name in targets:
                add(profile, ("make", name))

    package_json = root / "package.json"
    if package_json.is_file():
        try:
            data = json.loads(package_json.read_text(errors="replace"))
        except Exception:
            data = {}
        scripts = data.get("scripts") if isinstance(data, dict) else {}
        scripts = scripts if isinstance(scripts, dict) else {}
        package_manager = str(data.get("packageManager") or "").split("@", 1)[0]
        if package_manager not in {"npm", "pnpm", "yarn", "bun"}:
            if (root / "pnpm-lock.yaml").is_file():
                package_manager = "pnpm"
            elif (root / "yarn.lock").is_file():
                package_manager = "yarn"
            elif (root / "bun.lock").is_file() or (root / "bun.lockb").is_file():
                package_manager = "bun"
            else:
                package_manager = "npm"
        script_profiles = {
            "test": ("test",),
            "check": ("check",),
            "lint": ("lint",),
            "build": ("build",),
            "typecheck": ("typecheck",),
            "full": ("validate", "ci"),
        }
        for profile, names in script_profiles.items():
            for name in names:
                if name in scripts:
                    add(profile, (package_manager, "run", name))

    pyproject = root / "pyproject.toml"
    pytest_configured = (root / "pytest.ini").is_file() or (root / "conftest.py").is_file()
    if pyproject.is_file():
        try:
            data = tomllib.loads(pyproject.read_text(errors="replace"))
            pytest_configured = pytest_configured or "pytest" in (data.get("tool") or {})
        except Exception:
            pass
    if pytest_configured:
        add("test", (_project_python(root), "-m", "pytest", "-q"))

    if (root / "go.mod").is_file():
        add("test", ("go", "test", "./..."))
        add("check", ("go", "test", "./..."))
    if (root / "Cargo.toml").is_file():
        add("test", ("cargo", "test"))
        add("check", ("cargo", "check"))

    if not candidates["full"]:
        for fallback in ("check", "test"):
            if candidates[fallback]:
                candidates["full"].append(candidates[fallback][0])
                break
    return candidates


def select_validation_command(profile, root=None):
    if profile not in VALIDATION_PROFILES:
        raise ValueError("unknown validation profile")
    commands = validation_command_candidates(root).get(profile) or []
    return commands[0] if commands else None


def remote_validation_sandbox_available(image=REMOTE_VALIDATION_SANDBOX_IMAGE):
    try:
        proc = subprocess.run(
            ["docker", "image", "inspect", image],
            text=True,
            capture_output=True,
            timeout=10,
            shell=False,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return False
    return proc.returncode == 0


def _remote_dependency_mounts(source_root):
    mounts = []
    source_root = Path(source_root).resolve()
    for name in (".venv", "node_modules"):
        source = source_root / name
        if source.is_dir() and not source.is_symlink():
            mounts.extend([
                "--mount",
                f"type=bind,src={source},dst=/workspace/{name},readonly",
            ])
    return mounts


def remote_validation_docker_argv(argv, *, workspace=None, source_root=None):
    workspace = Path(workspace or ROOT).resolve()
    source_root = Path(
        source_root
        or os.environ.get(REMOTE_VALIDATION_SOURCE_ROOT_ENV)
        or workspace
    ).resolve()
    if not workspace.is_dir():
        raise RuntimeError("remote validation workspace is unavailable")
    uid = os.getuid() if hasattr(os, "getuid") else 1000
    gid = os.getgid() if hasattr(os, "getgid") else 1000
    command = [
        "docker", "run", "--rm", "--pull=never",
        "--network=none", "--read-only", "--cap-drop=ALL",
        "--security-opt=no-new-privileges", "--pids-limit=128",
        "--memory=1g", "--cpus=2", "--user", f"{uid}:{gid}",
        "--tmpfs", "/tmp:rw,nosuid,nodev,size=128m",
        "--env", "HOME=/tmp", "--env", "CI=1",
        "--workdir", "/workspace",
        "--mount", f"type=bind,src={workspace},dst=/workspace",
    ]
    for runtime_path in ("/usr", "/bin", "/lib", "/lib64", "/usr/local"):
        path = Path(runtime_path)
        if path.exists():
            command.extend([
                "--mount",
                f"type=bind,src={path},dst={path},readonly",
            ])

    executable = shutil.which(str(argv[0]))
    if executable:
        resolved = Path(executable).resolve()
        nvm_parts = resolved.parts
        if ".nvm" in nvm_parts and "versions" in nvm_parts and "node" in nvm_parts:
            try:
                node_index = nvm_parts.index("node")
                version_root = Path(*nvm_parts[: node_index + 2])
                if version_root.is_dir() and not version_root.is_symlink():
                    command.extend([
                        "--mount",
                        f"type=bind,src={version_root},dst=/opt/lai-node,readonly",
                    ])
                    command.extend([
                        "--env",
                        "PATH=/opt/lai-node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                    ])
            except (ValueError, IndexError):
                pass

    command.extend(_remote_dependency_mounts(source_root))
    command.append(REMOTE_VALIDATION_SANDBOX_IMAGE)
    command.extend(str(item) for item in argv)
    return command


def _run_validation_argv(argv, profile, *, remote=False):
    command = list(argv)
    if remote:
        if not remote_validation_sandbox_available():
            return "ERROR: remote validation sandbox image is unavailable; no image was pulled"
        command = remote_validation_docker_argv(command)
    try:
        proc = subprocess.run(
            command,
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=VALIDATION_TIMEOUT_SECONDS,
            shell=False,
        )
    except FileNotFoundError:
        return f"ERROR: validation executable unavailable for profile={profile}"
    except subprocess.TimeoutExpired:
        return f"ERROR: validation timed out after {VALIDATION_TIMEOUT_SECONDS} seconds"
    output = proc.stdout
    if proc.stderr:
        output += ("\n" if output else "") + proc.stderr
    return trim(
        f"exit_code={proc.returncode}\n"
        f"validation_profile={profile}\n"
        "argv=" + json.dumps(list(argv), ensure_ascii=False) + "\n"
        + (output if output else "[no output]")
    )


def tool_validate(args):
    if not isinstance(args, dict) or set(args) != {"profile"}:
        return "ERROR: validate requires exactly one profile"
    profile = args.get("profile")
    if profile not in VALIDATION_PROFILES:
        return "ERROR: unknown validation profile"
    argv = select_validation_command(profile)
    if argv is None:
        return f"ERROR: no recognized validation command for profile={profile}"
    remote = os.environ.get("LAI_CONTROL_RUN_CHILD") == "1"
    return _run_validation_argv(argv, profile, remote=remote)



