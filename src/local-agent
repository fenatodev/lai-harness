            },
            "secret_material_printed": False,
        }


def control_browser_download(server, browser_session_id, request):
    if not isinstance(request, dict):
        raise ValueError("JSON object required")
    unknown = sorted(set(request) - {"filename", "content_type", "body"})
    if unknown:
        raise ValueError("unknown fields: " + ", ".join(unknown))
    filename = request.get("filename")
    if not isinstance(filename, str) or not re.fullmatch(r"[A-Za-z0-9_.-]{1,120}", filename):
        raise ValueError("filename is invalid")
    content_type = request.get("content_type", "text/plain")
    media_type = str(content_type).split(";", 1)[0].strip().lower()
    if media_type not in CONTROL_BROWSER_ALLOWED_DOWNLOAD_TYPES:
        raise ControlBrowserConflict("download content type is not allowed")
    body = request.get("body", "")
    if not isinstance(body, str):
        raise ValueError("body must be text")
    raw = body.encode("utf-8", errors="replace")
    if len(raw) > CONTROL_BROWSER_MAX_DOWNLOAD_BYTES:
        raise ControlBrowserConflict("download exceeds quarantine limit")
    with server.control_browser_lock:
        record = _control_browser_active(_control_browser_load_session(browser_session_id))
        download_id = "bw-" + secrets.token_hex(8)
        target = _control_browser_download_path(browser_session_id, download_id)
        target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        target.write_bytes(raw)
        os.chmod(target, 0o600)
        receipt = {
            "schema_version": CONTROL_BROWSER_SCHEMA_VERSION,
            "browser_download_id": download_id,
            "browser_session_id": browser_session_id,
            "filename": filename,
            "content_type": media_type,
            "bytes": len(raw),
            "sha256": hashlib.sha256(raw).hexdigest(),
            "status": "quarantined",
            "path_exposed": False,
            "created_at": _control_authority_timestamp(),
            "secret_material_printed": False,
        }
        record.setdefault("downloads", []).append(receipt)
        _control_browser_store_session(record)
        return receipt


def control_browser_action(server, browser_session_id, request):
    if not isinstance(request, dict):
        raise ValueError("JSON object required")
    unknown = sorted(set(request) - {"action", "expected_dom_sha256", "critical", "adapter", "external_action_id"})
    if unknown:
        raise ValueError("unknown fields: " + ", ".join(unknown))
    action = request.get("action")
    if action not in {"click", "submit"}:
        raise ValueError("action must be click or submit")
    expected_dom = request.get("expected_dom_sha256")
    if not isinstance(expected_dom, str) or not re.fullmatch(r"[0-9a-f]{64}", expected_dom):
        raise ValueError("expected_dom_sha256 must be a 64-character lowercase sha256")
    with server.control_browser_lock:
        record = _control_browser_active(_control_browser_load_session(browser_session_id))
        if expected_dom != record.get("dom_sha256"):
            raise ControlBrowserConflict("browser DOM drift before action")
        critical = bool(request.get("critical"))
        if critical and request.get("adapter") != "external_action":
            return {
                "schema_version": CONTROL_BROWSER_SCHEMA_VERSION,
                "browser_session_id": browser_session_id,
                "action": action,
                "decision": "DENY",
                "reason_code": "critical_action_requires_adapter",
                "executed": False,
                "secret_material_printed": False,
            }
        return {
            "schema_version": CONTROL_BROWSER_SCHEMA_VERSION,
            "browser_session_id": browser_session_id,
            "action": action,
            "decision": "ALLOW" if not critical else "DENY",
            "reason_code": "fixture_noncritical_action_recorded" if not critical else "external_action_adapter_not_executed_by_browser",
            "executed": False,
            "secret_material_printed": False,
        }


def control_delete_browser_session(server, browser_session_id):
    with server.control_browser_lock:
        record = _control_browser_load_session(browser_session_id)
        if record.get("status") == "active":
            record["status"] = "closed"
            record["closed_at"] = _control_authority_timestamp()
            _control_browser_store_session(record)
        profile = _control_browser_profile_path(browser_session_id)
        if profile.exists():
            shutil.rmtree(profile, ignore_errors=True)
        return _control_browser_public_session(record)


