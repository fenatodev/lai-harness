def _context_file_sha256(rel):
    try:
        return hashlib.sha256((ROOT / rel).read_bytes()).hexdigest()
    except OSError:
        return None


def _context_python_module_name(rel):
    path = PurePosixPath(str(rel).replace("\\", "/"))
    if path.suffix != ".py":
        return None
    parts = list(path.with_suffix("").parts)
    if parts and parts[-1] == "__init__":
        parts = parts[:-1]
    if not parts:
        return None
    return ".".join(parts)


def _context_graph_module_aliases(python_paths):
    aliases = {}
    basename_index = {}
    for rel in python_paths:
        module = _context_python_module_name(rel)
        if not module:
            continue
        aliases[module] = rel
        parts = module.split(".")
        if parts and parts[0] == "src" and len(parts) > 1:
            aliases.setdefault(".".join(parts[1:]), rel)
        basename_index.setdefault(parts[-1], set()).add(rel)
    for name, paths in basename_index.items():
        if len(paths) == 1:
            aliases.setdefault(name, next(iter(paths)))
    return aliases


def _context_graph_resolve_module(module_name, aliases):
    module = str(module_name or "").strip(".")
    if not module:
        return None
    candidates = [module]
    parts = module.split(".")
    while len(parts) > 1:
        parts = parts[:-1]
        candidates.append(".".join(parts))
    for candidate in candidates:
        rel = aliases.get(candidate)
        if rel:
            return rel
    return None


def _context_graph_add_edge(edges, seen_edges, source, target, edge_type, status, *, line=0, import_name="", provenance="python_ast", source_hash=None, target_hash=None):
    if len(edges) >= CONTEXT_GRAPH_MAX_EDGES:
        return
    key = (source, target or "", edge_type, status, int(line or 0), import_name)
    if key in seen_edges:
        return
    seen_edges.add(key)
    edges.append({
        "source": source,
        "target": target,
        "edge_type": edge_type,
        "status": status,
        "line": int(line or 0),
        "import": str(import_name or "")[:120],
        "provenance": provenance,
        "source_sha256": source_hash,
        "target_sha256": target_hash,
    })


def _context_graph_candidate_test_targets(test_rel, aliases):
    path = PurePosixPath(test_rel)
    stem = path.stem
    if not stem.startswith("test_"):
        return []
    base = stem[5:]
    candidates = [base, f"src.{base}"]
    if "_" in base:
        dotted = base.replace("_", ".")
        candidates.extend([dotted, f"src.{dotted}"])
    output = []
    for candidate in candidates:
        target = _context_graph_resolve_module(candidate, aliases)
        if target and target != test_rel and target not in output:
            output.append(target)
    return output


def _context_graph_python_edges_for_tree(rel, tree, aliases, file_hashes, edges, seen_edges):
    source_hash = file_hashes.get(rel)
    is_test = PurePosixPath(rel).name.startswith("test_") or rel.startswith("tests/")
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                name = str(alias.name or "")
                target = _context_graph_resolve_module(name, aliases)
                _context_graph_add_edge(
                    edges, seen_edges, rel, target, "test_import" if is_test and target else "import",
                    "resolved" if target else "unknown", line=getattr(node, "lineno", 0),
                    import_name=name, source_hash=source_hash, target_hash=file_hashes.get(target),
                )
        elif isinstance(node, ast.ImportFrom):
            base = str(node.module or "")
            names = [str(alias.name or "") for alias in node.names]
            candidates = [base]
            candidates.extend(f"{base}.{name}" for name in names if base and name != "*")
            target = None
            import_name = base
            for candidate in candidates:
                target = _context_graph_resolve_module(candidate, aliases)
                if target:
                    import_name = candidate
                    break
            _context_graph_add_edge(
                edges, seen_edges, rel, target, "test_import" if is_test and target else "import",
                "resolved" if target else "unknown", line=getattr(node, "lineno", 0),
                import_name=import_name, source_hash=source_hash, target_hash=file_hashes.get(target),
            )
        elif isinstance(node, ast.Call):
            func = node.func
            dynamic = False
            if isinstance(func, ast.Name) and func.id == "__import__":
                dynamic = True
            elif isinstance(func, ast.Attribute) and func.attr == "import_module":
                dynamic = True
            if not dynamic:
                continue
            raw = node.args[0].value if node.args and isinstance(node.args[0], ast.Constant) and isinstance(node.args[0].value, str) else "[dynamic]"
            target = _context_graph_resolve_module(raw, aliases) if raw != "[dynamic]" else None
            _context_graph_add_edge(
                edges, seen_edges, rel, target, "dynamic_import",
                "heuristic" if target else "unknown", line=getattr(node, "lineno", 0),
                import_name=raw, provenance="python_ast_dynamic", source_hash=source_hash,
                target_hash=file_hashes.get(target),
            )


def context_code_graph_payload(max_files=CONTEXT_GRAPH_MAX_FILES, max_edges=CONTEXT_GRAPH_MAX_EDGES):
    max_files = max(1, min(int(max_files), CONTEXT_GRAPH_MAX_FILES))
    max_edges = max(1, min(int(max_edges), CONTEXT_GRAPH_MAX_EDGES))
    inventory = repository_context_inventory(max_files=max_files)
    python_paths = [rel for rel in inventory if PurePosixPath(rel).suffix == ".py"]
    file_hashes = {rel: _context_file_sha256(rel) for rel in python_paths}
    file_hashes = {rel: value for rel, value in file_hashes.items() if value}
    cache_key = (
        str(ROOT.resolve()), CONTEXT_GRAPH_SCHEMA_VERSION, CONTEXT_GRAPH_PARSER_VERSION,
        max_files, max_edges, tuple(sorted(file_hashes.items())),
    )
    cached = CONTEXT_GRAPH_CACHE.get(cache_key)
    if cached is not None:
        payload = json.loads(json.dumps(cached))
        payload["cache_status"] = "hit"
        return payload
    aliases = _context_graph_module_aliases([rel for rel in python_paths if rel in file_hashes])
    nodes = []
    edges = []
    seen_nodes = set()
    seen_edges = set()
    parsed = 0
    skipped = []
    for rel in sorted(python_paths):
        file_hash = file_hashes.get(rel)
        if not file_hash:
            skipped.append({"path": rel, "reason": "unreadable"})
            continue
        path = ROOT / rel
        try:
            if path.stat().st_size > 1024 * 1024:
                skipped.append({"path": rel, "reason": "too_large"})
                continue
            text = path.read_text(encoding="utf-8", errors="replace")
            tree = ast.parse(text, filename=rel)
        except (OSError, SyntaxError, UnicodeError):
            skipped.append({"path": rel, "reason": "parse_failed"})
            continue
        parsed += 1
        module = _context_python_module_name(rel) or rel
        module_key = (rel, "module", module)
        if module_key not in seen_nodes and len(nodes) < CONTEXT_GRAPH_MAX_NODES:
            seen_nodes.add(module_key)
            nodes.append({"path": rel, "kind": "module", "name": module, "line": 1, "file_sha256": file_hash})
        for node in tree.body:
            if isinstance(node, ast.ClassDef):
                key = (rel, "class", node.name)
                if key not in seen_nodes and len(nodes) < CONTEXT_GRAPH_MAX_NODES:
                    seen_nodes.add(key)
                    nodes.append({"path": rel, "kind": "class", "name": node.name, "line": int(getattr(node, "lineno", 0) or 0), "file_sha256": file_hash})
                for child in node.body:
                    if isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef)):
                        name = f"{node.name}.{child.name}"
                        key = (rel, "method", name)
                        if key not in seen_nodes and len(nodes) < CONTEXT_GRAPH_MAX_NODES:
                            seen_nodes.add(key)
                            nodes.append({"path": rel, "kind": "method", "name": name, "line": int(getattr(child, "lineno", 0) or 0), "file_sha256": file_hash})
            elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                key = (rel, "function", node.name)
                if key not in seen_nodes and len(nodes) < CONTEXT_GRAPH_MAX_NODES:
                    seen_nodes.add(key)
                    nodes.append({"path": rel, "kind": "function", "name": node.name, "line": int(getattr(node, "lineno", 0) or 0), "file_sha256": file_hash})
        _context_graph_python_edges_for_tree(rel, tree, aliases, file_hashes, edges, seen_edges)
    for rel in sorted(python_paths):
        if rel not in file_hashes:
            continue
        if PurePosixPath(rel).name.startswith("test_") or rel.startswith("tests/"):
            for target in _context_graph_candidate_test_targets(rel, aliases):
                _context_graph_add_edge(
                    edges, seen_edges, rel, target, "test_relation", "heuristic",
                    line=0, import_name="", provenance="test_name_heuristic",
                    source_hash=file_hashes.get(rel), target_hash=file_hashes.get(target),
                )
    nodes = sorted(nodes, key=lambda item: (item["path"], item["kind"], item["name"], int(item["line"])))[:CONTEXT_GRAPH_MAX_NODES]
    edges = sorted(edges, key=lambda item: (item["source"], item["target"] or "", item["edge_type"], int(item["line"]), item["import"]))[:max_edges]
    payload = {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "graph_version": CONTEXT_GRAPH_SCHEMA_VERSION,
        "parser_version": CONTEXT_GRAPH_PARSER_VERSION,
        "repository": ".",
        "metadata_only": True,
        "inspected_content": False,
        "advisory_only": True,
        "cache_status": "miss",
        "inventory_limit": max_files,
        "python_file_count": len(python_paths),
        "parsed_file_count": parsed,
        "node_count": len(nodes),
        "edge_count": len(edges),
        "edge_limit": max_edges,
        "edge_list_truncated": len(seen_edges) > len(edges),
        "nodes": nodes,
        "edges": edges,
        "skipped_files": skipped[:20],
        "ignored_directories": sorted(CONTEXT_IGNORED_DIRS),
        "trust": (
            "Advisory Python AST graph only. Edges may be resolved, heuristic, or unknown; "
            "dynamic behavior and runtime imports require direct inspection and validation."
        ),
    }
    CONTEXT_GRAPH_CACHE.clear()
    CONTEXT_GRAPH_CACHE[cache_key] = json.loads(json.dumps(payload))
    return payload


def context_code_graph_references(terms, inventory):
    normalized_terms = [term for term in terms if len(term) >= 3]
    if not normalized_terms:
        return {}
    known = set(inventory)
    try:
        graph = context_code_graph_payload(max_files=min(CONTEXT_INVENTORY_LIMIT, 400), max_edges=CONTEXT_GRAPH_MAX_EDGES)
    except Exception:
        return {}
    refs = {}
    matched = set()
    for node in graph.get("nodes", []):
        rel = node.get("path")
        if rel not in known:
            continue
        searchable = _context_fold_text(" ".join([str(node.get("name") or ""), str(rel)]))
        if any(term in searchable for term in normalized_terms):
            matched.add(rel)
            refs.setdefault(rel, []).append("symbol:" + str(node.get("kind") or "node"))
    for edge in graph.get("edges", []):
        source = edge.get("source")
        target = edge.get("target")
        import_name = _context_fold_text(edge.get("import") or "")
        edge_type = str(edge.get("edge_type") or "edge")
        if source in known and any(term in import_name for term in normalized_terms):
            refs.setdefault(source, []).append(edge_type)
            if target in known:
                refs.setdefault(target, []).append("import_target")
        if source in matched and target in known:
            refs.setdefault(target, []).append("linked_from:" + edge_type)
        if target in matched and source in known:
            refs.setdefault(source, []).append("linked_to:" + edge_type)
    return {path: sorted(set(values))[:3] for path, values in refs.items()}


def render_context_code_graph(payload):
    lines = [
        "# lai context graph",
        f"Product: {payload.get('product')} {payload.get('version')}",
        f"Parser: {payload.get('parser_version')}",
        f"Repository: {payload.get('repository')}",
        f"Metadata-only: {str(payload.get('metadata_only')).lower()}",
        f"Cache: {payload.get('cache_status')}",
        f"Python files: {int(payload.get('parsed_file_count') or 0)}/{int(payload.get('python_file_count') or 0)}",
        f"Nodes: {int(payload.get('node_count') or 0)}",
        f"Edges: {int(payload.get('edge_count') or 0)}",
        "",
        "## Edges",
    ]
    for edge in payload.get("edges", [])[:24]:
        target = edge.get("target") or "[unknown]"
        lines.append(
            f"- {edge.get('source')} -> {target} | {edge.get('edge_type')} | {edge.get('status')} | {edge.get('provenance')}"
        )
    if not payload.get("edges"):
        lines.append("- [none]")
    if payload.get("edge_list_truncated"):
        lines.append("- [truncated]")
    lines.extend(["", "## Nodes"])
    for node in payload.get("nodes", [])[:24]:
        lines.append(f"- {node.get('path')} | line {int(node.get('line') or 0)} | {node.get('kind')} {node.get('name')}")
    if not payload.get("nodes"):
        lines.append("- [none]")
    if payload.get("skipped_files"):
        lines.extend(["", "## Skipped"])
        for item in payload.get("skipped_files", [])[:12]:
            lines.append(f"- {item.get('path')}: {item.get('reason')}")
    lines.append("")
    lines.append("Trust: " + str(payload.get("trust", "")))
    return "\n".join(lines)


