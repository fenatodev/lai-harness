                self._json(400, {"error": {"code": "invalid_authority_request", "message": str(exc)}})
                return
            self._json(200, {
                "product": PRODUCT_NAME,
                "version": VERSION,
                "repository": str(ROOT),
                "approval": approval,
            })
            return
        if promotion_match:
            if parsed.query:
                self._json(400, {"error": {"code": "invalid_request", "message": "promotion endpoint does not accept query parameters"}})
                return
            try:
                promotion = control_promote_run(self.server, promotion_match.group(1), request)
            except ControlPromotionConflict as exc:
                self._json(409, {"error": {"code": "promotion_conflict", "message": str(exc)}})
                return
            except ControlPromotionRejected as exc:
                payload = {"error": {"code": "promotion_rejected", "message": str(exc)}}
                if exc.detail is not None:
                    payload["detail"] = exc.detail
                self._json(422, payload)
                return
            except ValueError as exc:
                self._json(400, {"error": {"code": "invalid_promotion_request", "message": str(exc)}})
                return
            if promotion is None:
                self._json(404, {"error": {"code": "run_not_found", "message": "control run not found"}})
                return
            self._json(200, {
                "product": PRODUCT_NAME,
                "version": VERSION,
                "repository": str(ROOT),
                "promotion": promotion,
            })
            return
        if parsed.path == "/v1/mcp/execution/call":
            if parsed.query:
                self._json(400, {"error": {"code": "invalid_request", "message": "MCP execution endpoint does not accept query parameters"}})
                return
            try:
                receipt = control_execute_mcp_fixture(self.server, request)
            except ControlMcpExecutionConflict as exc:
                self._json(409, {"error": {"code": "mcp_execution_conflict", "message": str(exc)}})
                return
            except ValueError as exc:
                self._json(400, {"error": {"code": "invalid_mcp_execution_request", "message": str(exc)}})
                return
            status = 200 if receipt.get("mcp_receipt_id") else 422
            self._json(status, {
                "product": PRODUCT_NAME,
                "version": VERSION,
                "repository": str(ROOT),
                "receipt": receipt,
            })
            return
        if parsed.path == "/v1/mcp/policy-check":
            try:
                payload = control_mcp_policy_payload(request)
            except ValueError as exc:
                self._json(400, {"error": {"code": "invalid_mcp_policy_request", "message": str(exc)}})
                return
            self._json(200, payload)
            return
        if parsed.path == "/v1/runs":
            try:
                record = control_submit_run(self.server, request)
            except KeyError:
                self._json(404, {"error": {"code": "session_not_found", "message": "control session not found"}})
                return
            except ControlRunQueueFull as exc:
                self._json(429, {"error": {"code": "queue_full", "message": str(exc)}})
                return
            except RuntimeError as exc:
                self._json(503, {"error": {"code": "run_unavailable", "message": str(exc)}})
                return
            except ValueError as exc:
                self._json(400, {"error": {"code": "invalid_run_request", "message": str(exc)}})
                return
            self._json(202, {
                "product": PRODUCT_NAME,
                "version": VERSION,
                "repository": str(ROOT),
                "run": record,
            })
            return
        try:
            payload = control_policy_payload(request)
        except ValueError as exc:
            self._json(400, {"error": {"code": "invalid_policy_request", "message": str(exc)}})
            return
        self._json(200, payload)

    def do_DELETE(self):
        if not self._require_auth():
            return
        parsed = urllib.parse.urlsplit(self.path)
        session_match = re.fullmatch(r"/v1/sessions/(cs-[0-9a-f]{16})", parsed.path)
        browser_match = re.fullmatch(r"/v1/browser/sessions/(br-[0-9a-f]{16})", parsed.path)
        if browser_match:
            try:
                payload = control_delete_browser_session(self.server, browser_match.group(1))
            except KeyError:
                self._json(404, {"error": {"code": "browser_session_not_found", "message": "browser session not found"}})
                return
            except ControlBrowserConflict as exc:
                self._json(409, {"error": {"code": "browser_conflict", "message": str(exc)}})
                return
            self._json(200, {"product": PRODUCT_NAME, "version": VERSION, "repository": str(ROOT), "browser": payload})
            return
        credential_match = re.fullmatch(r"/v1/credentials/refs/(sr-[0-9a-f]{16})", parsed.path)
        if credential_match:
            try:
                payload = control_revoke_credential_ref(self.server, credential_match.group(1))
            except KeyError:
                self._json(404, {"error": {"code": "credential_not_found", "message": "credential reference not found"}})
                return
            except ControlCredentialConflict as exc:
                self._json(409, {"error": {"code": "credential_conflict", "message": str(exc)}})
                return
            except ValueError as exc:
                self._json(400, {"error": {"code": "invalid_credential_request", "message": str(exc)}})
                return
            self._json(200, {
                "product": PRODUCT_NAME,
                "version": VERSION,
                "repository": str(ROOT),
                "credential": payload,
            })
            return
        approval_match = re.fullmatch(r"/v1/authority/approvals/(ca-[0-9a-f]{16})", parsed.path)
        if approval_match:
            try:
                payload = control_revoke_authority_intent(self.server, approval_match.group(1))
            except KeyError:
                self._json(404, {"error": {"code": "approval_not_found", "message": "approval intent not found"}})
                return
            except ControlApprovalConflict as exc:
                self._json(409, {"error": {"code": "approval_conflict", "message": str(exc)}})
                return
            except ValueError as exc:
                self._json(400, {"error": {"code": "invalid_authority_request", "message": str(exc)}})
                return
            self._json(200, {
                "product": PRODUCT_NAME,
                "version": VERSION,
                "repository": str(ROOT),
                "authority": payload,
            })
            return
        if session_match:
            try:
                payload = control_delete_session(self.server, session_match.group(1))
            except FileNotFoundError:
                self._json(404, {"error": {"code": "session_not_found", "message": "control session not found"}})
                return
            except PermissionError:
                self._json(404, {"error": {"code": "session_not_found", "message": "control session not found"}})
                return
            except ValueError:
                self._json(500, {"error": {"code": "session_state_invalid", "message": "control session state is invalid"}})
                return
            self._json(200, payload)
            return
        if re.fullmatch(r"/v1/runs/cr-[0-9a-f]{16}/promotion", parsed.path):
            self._json(405, {"error": {"code": "method_not_allowed", "message": "method not allowed"}})
            return
        if not parsed.path.startswith("/v1/runs/"):
            self._json(405, {"error": {"code": "method_not_allowed", "message": "method not allowed"}})
            return
        control_run_id = parsed.path[len("/v1/runs/"):]
        if not control_run_id or "/" in control_run_id:
            self._json(404, {"error": {"code": "run_not_found", "message": "control run not found"}})
            return
        try:
            status, record = control_cancel_run(self.server, control_run_id)
        except KeyError:
            self._json(404, {"error": {"code": "run_not_found", "message": "control run not found"}})
            return
        except ValueError as exc:
            self._json(409, {"error": {"code": "run_not_cancellable", "message": str(exc)}})
            return
        self._json(status, {
            "product": PRODUCT_NAME,
            "version": VERSION,
            "repository": str(ROOT),
            "run": record,
        })

    def do_PUT(self):
        self._method_not_allowed()

    def do_PATCH(self):
        self._method_not_allowed()

    def do_OPTIONS(self):
        self._method_not_allowed()


CONTROL_SERVE_USAGE = "Usage: lai serve [--bind 127.0.0.1] [--port 8765]"


def parse_control_serve_args(args=None):
    raw = list(args or [])
    bind = CONTROL_API_DEFAULT_BIND
    port = CONTROL_API_DEFAULT_PORT
    index = 0
    while index < len(raw):
        item = raw[index]
        if item in {"--bind", "--port"}:
            index += 1
            if index >= len(raw):
                raise SystemExit(CONTROL_SERVE_USAGE)
            value = raw[index]
            if item == "--bind":
                bind = value
            else:
                try:
                    port = int(value)
                except ValueError as exc:
                    raise SystemExit(CONTROL_SERVE_USAGE) from exc
            index += 1
            continue
        raise SystemExit(CONTROL_SERVE_USAGE)
    if not control_bind_is_loopback(bind):
        raise SystemExit("lai serve is loopback-only in this beta; use 127.0.0.1 or localhost")
    if not 1 <= port <= 65535:
        raise SystemExit("lai serve port must be between 1 and 65535")
    return {"bind": bind, "port": port}


def create_control_server(bind=CONTROL_API_DEFAULT_BIND, port=CONTROL_API_DEFAULT_PORT, token=None):
    if not control_bind_is_loopback(bind):
        raise ValueError("control API bind must be loopback-only")
    if not 0 <= int(port) <= 65535:
        raise ValueError("control API port must be between 0 and 65535")
    actual_bind = "127.0.0.1" if str(bind).lower() == "localhost" else str(bind)
    server = LaiControlHTTPServer((actual_bind, int(port)), LaiControlRequestHandler)
    server.control_token = control_api_key() if token is None else str(token)
    if not server.control_token:
        server.server_close()
        raise ValueError("control API token must not be empty")
    server.local_chat_csrf_token = secrets.token_urlsafe(24)
    initialize_control_runs(server)
    return server


def run_control_server(args=None):
    options = parse_control_serve_args(args)
    try:
        server = create_control_server(options["bind"], options["port"])
    except (OSError, RuntimeError, ValueError) as exc:
        raise SystemExit(f"lai serve: {exc}") from exc
    host, port = server.server_address[:2]
    print(f"lai control API listening on http://{host}:{port}", flush=True)
    print("scope=loopback auth=bearer model_execution=readonly shell_execution=false", flush=True)
    try:
        server.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


