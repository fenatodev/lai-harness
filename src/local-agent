def git_command_text(args, default="[unavailable]", timeout=10):
    try:
        proc = subprocess.run(
            ["git", *args],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=timeout,
        )
    except Exception:
        return default
    if proc.returncode != 0:
        return default
    return proc.stdout.strip() or default


