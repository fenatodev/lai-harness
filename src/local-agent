def sanitize_export_filename(value):
    text = str(value or "").strip()
    cleaned = re.sub(r"[^A-Za-z0-9_.-]+", "-", text).strip(".-")
    return cleaned[:120] or "run"


def run_history_export_text(value, limit=500):
    return compact_run_history_value(value, limit=limit)


def sanitize_run_history_export_event(event):
    kind = str(event.get("type") or "unknown")
    record = {
        "ts": event.get("ts"),
        "source": event.get("source"),
        "type": kind,
    }

    for key in (
        "run_id",
        "repo",
        "mode",
        "name",
        "tool",
        "decision",
        "phase",
        "outcome",
        "status",
    ):
        if event.get(key) is not None:
            record[key] = event.get(key)

    if event.get("reason") is not None:
        record["reason"] = run_history_export_text(event.get("reason"), limit=300)

    if event.get("command") is not None:
        record["command"] = run_history_export_text(event.get("command"), limit=240)

    if kind == "validation":
        record["validation_status"] = run_history_validation_status(event)
        if event.get("result") is not None:
            record["result"] = run_history_export_text(event.get("result"), limit=400)

    for key in (
        "paths",
        "modified_paths",
        "reasons",
        "phases",
        "limits",
    ):
        value = event.get(key)
        if isinstance(value, list):
            record[key] = [run_history_export_text(item, limit=160) for item in value[:50]]

    for key in (
        "before_hashes",
        "after_hashes",
        "current_hashes",
        "hashes",
        "expected_hashes",
    ):
        value = event.get(key)
        if isinstance(value, dict):
            record[key] = {
                str(item_key)[:200]: str(item_value)[:80]
                for item_key, item_value in sorted(value.items())[:50]
            }

    return {key: value for key, value in record.items() if value is not None}


