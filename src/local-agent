def canonical_tool_signature(name, args):
    return (
        str(name)
        + ":"
        + json.dumps(
            args,
            ensure_ascii=False,
            sort_keys=True,
            separators=(",", ":"),
        )
    )


def tool_signature_hash(name, args):
    hashlib = __import__("hashlib")
    signature = canonical_tool_signature(name, args)
    return hashlib.sha256(signature.encode("utf-8")).hexdigest()


class PreWriteExplorationGuard:
    def __init__(self, enabled, budget=PRE_WRITE_EXPLORATION_BUDGET):
        self.enabled = enabled
        self.budget = budget
        self.calls = 0
        self.signature_hashes = set()
        self.write_succeeded = False
        self.exhausted = False
        self.reason = None
        self.trigger = None
        self.signature_hash = None
        self.tool_name = None

    def check(self, name, args):
        if (
            not self.enabled
            or self.write_succeeded
            or name not in READ_ONLY_TOOLS
        ):
            return None

        signature_hash = tool_signature_hash(name, args)

        if self.exhausted:
            return self.blocked_result()

        if signature_hash in self.signature_hashes:
            self._exhaust("repeated_read_only_call", name, signature_hash)
            return self.blocked_result()

        self.signature_hashes.add(signature_hash)
        self.calls += 1

        if self.calls >= self.budget:
            self._exhaust("budget_reached", name, signature_hash)

        return None

    def note_successful_write(self):
        self.write_succeeded = True
        self.signature_hashes.clear()

    def _exhaust(self, trigger, tool_name, signature_hash):
        if self.exhausted:
            return

        self.exhausted = True
        self.reason = "exploration_budget_exhausted"
        self.trigger = trigger
        self.tool_name = str(tool_name)
        self.signature_hash = signature_hash

    def blocked_result(self):
        return (
            "BLOCKED: pre-write exploration budget exhausted. "
            "Do not request more diagnostic tools. Edit the relevant file "
            "now, or explicitly conclude that implementation is impossible "
            "from the collected evidence."
        )

    def phase_message(self):
        return (
            "PRE-WRITE EXPLORATION ENDED: the deterministic exploration "
            f"budget is exhausted ({self.calls}/{self.budget}; "
            f"trigger={self.trigger}). Do not request read-only or diagnostic "
            "tools. Your next action must be an edit/create/patch operation, "
            "or an explicit impossibility conclusion using exactly this prefix: "
            "IMPLEMENTATION_IMPOSSIBLE: followed by the reason. Any unmarked "
            "text response will be rejected."
        )

