def github_repository_slug(origin=None):
    value = str(origin if origin is not None else git_origin_url()).strip()
    path = None
    if value.startswith("git@github.com:"):
        path = value.split(":", 1)[1]
    else:
        match = re.match(r"^(?:https?://github\.com/|ssh://git@github\.com/)(.+)$", value)
        if match:
            path = match.group(1)
    if not path:
        return None
    path = path.rstrip("/")
    if path.endswith(".git"):
        path = path[:-4]
    parts = path.split("/")
    if len(parts) != 2 or not all(parts):
        return None
    return f"{parts[0]}/{parts[1]}"


def github_api_token():
    for env_name in ("GH_TOKEN", "GITHUB_TOKEN"):
        token = os.environ.get(env_name, "").strip()
        if token:
            return token, env_name.lower()

    try:
        proc = subprocess.run(
            ["git", "credential", "fill"],
            cwd=ROOT,
            input="protocol=https\nhost=github.com\n\n",
            text=True,
            capture_output=True,
            timeout=5,
            env={**os.environ, "GIT_TERMINAL_PROMPT": "0"},
        )
    except Exception:
        return None, "none"
    if proc.returncode != 0:
        return None, "none"

    credentials = {}
    for line in proc.stdout.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        credentials[key.strip()] = value.strip()
    token = credentials.get("password", "")
    if not token:
        return None, "none"
    return token, "git-credential"


def github_api_get(api_path, token=None):
    base_url = os.environ.get("LAI_GITHUB_API_URL", "https://api.github.com").rstrip("/")
    url = f"{base_url}/{api_path.lstrip('/')}"
    headers = {
        "Accept": "application/vnd.github+json",
        "User-Agent": f"lai-harness/{VERSION}",
        "X-GitHub-Api-Version": "2022-11-28",
    }
    if token:
        headers["Authorization"] = f"Bearer {token}"
    request = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            raw = response.read().decode("utf-8")
            payload = json.loads(raw) if raw else {}
            return {"ok": True, "status": response.status, "data": payload, "error": ""}
    except urllib.error.HTTPError as exc:
        message = ""
        try:
            body = exc.read().decode("utf-8")
            parsed = json.loads(body) if body else {}
            message = str(parsed.get("message") or "")
        except Exception:
            message = ""
        return {
            "ok": False,
            "status": exc.code,
            "data": None,
            "error": (message or f"GitHub API HTTP {exc.code}")[:300],
        }
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        return {"ok": False, "status": 0, "data": None, "error": str(exc)[:300]}


def github_branch_protection_status(repository, token=None, branch="main"):
    encoded_branch = urllib.parse.quote(branch, safe="")
    result = github_api_get(
        f"repos/{repository}/branches/{encoded_branch}/protection",
        token=token,
    )
    if not result["ok"]:
        status = "warn" if result["status"] == 404 else "unverified"
        detail = (
            "branch protection is not enabled"
            if result["status"] == 404
            else f"could not verify branch protection: {result['error']}"
        )
        return {
            "status": status,
            "detail": detail,
            "api_status": result["status"],
            "branch": branch,
            "required_checks": list(GITHUB_REQUIRED_STATUS_CHECKS),
            "observed_checks": [],
            "requirements": {},
        }

    data = result["data"] or {}
    required_status = data.get("required_status_checks") or {}
    observed = set(required_status.get("contexts") or [])
    for check in required_status.get("checks") or []:
        context = check.get("context") if isinstance(check, dict) else None
        if context:
            observed.add(context)
    missing_checks = [name for name in GITHUB_REQUIRED_STATUS_CHECKS if name not in observed]
    requirements = {
        "pull_requests": data.get("required_pull_request_reviews") is not None,
        "strict_status_checks": required_status.get("strict") is True,
        "required_status_checks": not missing_checks,
        "linear_history": bool((data.get("required_linear_history") or {}).get("enabled")),
        "enforce_admins": bool((data.get("enforce_admins") or {}).get("enabled")),
        "force_pushes_disabled": not bool((data.get("allow_force_pushes") or {}).get("enabled")),
        "deletions_disabled": not bool((data.get("allow_deletions") or {}).get("enabled")),
    }
    missing = [name for name, enabled in requirements.items() if not enabled]
    if missing_checks:
        missing.append("checks:" + ",".join(missing_checks))
    status = "ok" if not missing else "warn"
    detail = (
        "branch protection satisfies the beta policy"
        if status == "ok"
        else "branch protection needs attention: " + ", ".join(missing)
    )
    return {
        "status": status,
        "detail": detail,
        "api_status": result["status"],
        "branch": branch,
        "required_checks": list(GITHUB_REQUIRED_STATUS_CHECKS),
        "observed_checks": sorted(observed),
        "requirements": requirements,
    }


def file_sha256(path):
    digest = hashlib.sha256()
    with Path(path).open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def github_release_status(repository, expected_tag, pack_status, token=None):
    encoded_tag = urllib.parse.quote(expected_tag, safe="")
    result = github_api_get(f"repos/{repository}/releases/tags/{encoded_tag}", token=token)
    if not result["ok"]:
        status = "warn" if result["status"] == 404 else "unverified"
        detail = (
            f"GitHub Release {expected_tag} does not exist"
            if result["status"] == 404
            else f"could not verify GitHub Release: {result['error']}"
        )
        return {
            "status": status,
            "detail": detail,
            "api_status": result["status"],
            "tag": expected_tag,
            "draft": None,
            "prerelease": None,
            "html_url": None,
            "asset": {"status": "unverified", "optional": True},
        }

    data = result["data"] or {}
    core_ok = (
        data.get("tag_name") == expected_tag
        and data.get("draft") is False
        and data.get("prerelease") is True
    )
    vsix = pack_status.get("vsix") or {}
    local_path = Path(vsix.get("path", "")) if vsix.get("path") else None
    expected_name = local_path.name if local_path else None
    remote_asset = None
    if expected_name:
        remote_asset = next(
            (item for item in data.get("assets") or [] if item.get("name") == expected_name),
            None,
        )

    asset = {
        "status": "not_checked",
        "optional": True,
        "expected_name": expected_name,
        "local_present": bool(local_path and local_path.is_file()),
        "remote_present": bool(remote_asset),
        "digest_match": None,
    }
    digest_failure = False
    if asset["local_present"] and remote_asset:
        local_digest = file_sha256(local_path)
        remote_digest = str(remote_asset.get("digest") or "")
        asset["local_sha256"] = local_digest
        asset["remote_digest"] = remote_digest or None
        if remote_digest.startswith("sha256:"):
            asset["digest_match"] = remote_digest == f"sha256:{local_digest}"
            asset["status"] = "ok" if asset["digest_match"] else "fail"
            digest_failure = asset["digest_match"] is False
        else:
            asset["status"] = "digest_unavailable"
    elif asset["local_present"] and not remote_asset:
        asset["status"] = "optional_missing"
    elif remote_asset:
        asset["status"] = "remote_only"

    if not core_ok:
        status = "warn"
        detail = "release exists but is not a published pre-release for the expected tag"
    elif digest_failure:
        status = "fail"
        detail = "release VSIX digest does not match the local inspected artifact"
    else:
        status = "ok"
        detail = f"published pre-release {expected_tag} verified"
        if asset["status"] == "ok":
            detail += "; VSIX digest matches"
        elif asset["status"] == "optional_missing":
            detail += "; optional VSIX is not attached"

    return {
        "status": status,
        "detail": detail,
        "api_status": result["status"],
        "tag": data.get("tag_name"),
        "draft": data.get("draft"),
        "prerelease": data.get("prerelease"),
        "html_url": data.get("html_url"),
        "asset": asset,
    }


def collect_github_release_governance(release_payload, pack_status):
    repository = github_repository_slug(release_payload.get("origin"))
    token, credential_source = github_api_token()
    if not repository:
        unavailable = {
            "status": "unverified",
            "detail": "origin is not a supported github.com repository",
            "api_status": 0,
        }
        return {
            "enabled": True,
            "repository": None,
            "authenticated": bool(token),
            "credential_source": credential_source,
            "branch_protection": {**unavailable, "branch": "main"},
            "release": {**unavailable, "tag": release_payload["expected_tag"]},
        }

    return {
        "enabled": True,
        "repository": repository,
        "authenticated": bool(token),
        "credential_source": credential_source,
        "branch_protection": github_branch_protection_status(repository, token=token),
        "release": github_release_status(
            repository,
            release_payload["expected_tag"],
            pack_status,
            token=token,
        ),
    }


def release_governance_manual_actions(release_payload, pack_status, remote_state=None):
    target_version = release_payload["target_version"]
    expected_tag = release_payload["expected_tag"]
    actions = []
    if pack_status["status"] != "ok":
        actions.append({
            "id": "release_pack",
            "status": "manual",
            "title": "Generate the local release pack",
            "detail": f"Run lai release-pack --target {target_version} --with-vsix --json.",
        })

    branch_status = None if remote_state is None else remote_state["branch_protection"]["status"]
    if branch_status != "ok":
        detail = (
            "In GitHub Settings > Branches, protect main with pull requests, required status checks, "
            "up-to-date branches, linear history, admin enforcement, and disabled force pushes/deletions."
            if remote_state is None
            else remote_state["branch_protection"]["detail"]
        )
        actions.append({
            "id": "github_branch_protection",
            "status": "manual",
            "title": "Verify GitHub branch protection for main",
            "detail": detail,
        })

    release_status = None if remote_state is None else remote_state["release"]["status"]
    if release_status != "ok":
        detail = (
            "Use release-body.md from the release pack and mark the GitHub Release as a pre-release while the project remains beta."
            if remote_state is None
            else remote_state["release"]["detail"]
        )
        actions.append({
            "id": "github_release",
            "status": "manual",
            "title": f"Verify GitHub pre-release for {expected_tag}",
            "detail": detail,
        })
    return actions


def collect_release_governance(target=None, remote=False):
    release_payload = collect_release_check(target=target)
    pack_status = release_governance_pack_status(
        release_payload["target_version"],
        release_payload["expected_tag"],
    )
    remote_state = collect_github_release_governance(release_payload, pack_status) if remote else None
    checks = []

    def add_check(name, status, detail=""):
        checks.append({
            "name": name,
            "status": status,
            "detail": str(detail or "")[:500],
        })

    release_overall = release_payload.get("overall")
    release_phase = release_payload.get("phase")
    add_check(
        "release_check",
        "ok" if release_overall == "ready" else "fail",
        f"{release_overall} / {release_phase}",
    )
    add_check(
        "local_release_phase",
        "ok" if release_phase == "released" else "warn",
        release_phase,
    )
    add_check("release_pack", pack_status["status"], pack_status["detail"])
    if remote_state is None:
        add_check(
            "github_branch_protection",
            "manual",
            "use --remote to verify GitHub branch protection read-only",
        )
        add_check(
            "github_release",
            "manual",
            "use --remote to verify the GitHub pre-release read-only",
        )
    else:
        branch = remote_state["branch_protection"]
        release = remote_state["release"]
        add_check("github_branch_protection", branch["status"], branch["detail"])
        add_check("github_release", release["status"], release["detail"])

    has_failure = any(check["status"] == "fail" for check in checks)
    needs_action = any(check["status"] in {"warn", "manual", "unverified"} for check in checks)
    if has_failure:
        overall = "blocked"
    elif needs_action:
        overall = "action_required"
    else:
        overall = "ready"

    manual_actions = release_governance_manual_actions(
        release_payload,
        pack_status,
        remote_state=remote_state,
    )
    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "target_version": release_payload["target_version"],
        "expected_tag": release_payload["expected_tag"],
        "repository": str(ROOT),
        "branch": release_payload.get("branch"),
        "head": release_payload.get("head"),
        "latest_tag": release_payload.get("latest_tag"),
        "exact_tag": release_payload.get("exact_tag"),
        "release_check_overall": release_overall,
        "release_check_phase": release_phase,
        "release_pack": pack_status,
        "remote": remote_state or {"enabled": False},
        "manual_actions": manual_actions,
        "checks": checks,
        "overall": overall,
        "safety": (
            "read-only; --remote performs GitHub API GET requests only; no tag, merge, push, "
            "upload, publication, model call, or repository file mutation was executed"
        ),
    }


def render_release_governance(args=None):
    options = parse_release_governance_args(args or [])
    payload = collect_release_governance(target=options["target"], remote=options["remote"])
    if options["json"]:
        return json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True)

    lines = [
        "# lai release governance",
        "",
        f"Product: {payload['product']}",
        f"Version: {payload['version']}",
        f"Target version: {payload['target_version']}",
        f"Expected tag: {payload['expected_tag']}",
        f"Repository: {payload['repository']}",
        f"Branch: {payload['branch']}",
        f"HEAD: {payload['head']}",
        f"Exact tag on HEAD: {payload['exact_tag']}",
        f"Latest reachable tag: {payload['latest_tag']}",
        f"Release check: {payload['release_check_overall']} / {payload['release_check_phase']}",
        f"Remote GitHub verification: {'enabled' if payload['remote']['enabled'] else 'disabled'}",
        f"Overall: {payload['overall']}",
        "",
        "## Checks",
    ]
    for check in payload["checks"]:
        lines.append(f"- [{check['status']}] {check['name']}: {check['detail']}")

    pack = payload["release_pack"]
    lines.extend([
        "",
        "## Release pack",
        f"Status: {pack['status']}",
        f"Detail: {pack['detail']}",
        f"Directory: {pack['pack_dir']}",
        f"VSIX: {pack['vsix']['path']} ({'present' if pack['vsix']['present'] else 'optional/missing'})",
    ])
    remote_state = payload["remote"]
    if remote_state["enabled"]:
        lines.extend([
            "",
            "## Remote GitHub state",
            f"Repository: {remote_state.get('repository')}",
            f"Authenticated: {remote_state.get('authenticated')}",
            f"Credential source: {remote_state.get('credential_source')}",
            f"Branch protection: {remote_state['branch_protection']['status']} — {remote_state['branch_protection']['detail']}",
            f"GitHub Release: {remote_state['release']['status']} — {remote_state['release']['detail']}",
        ])

    lines.extend(["", "## Manual actions"])
    if payload["manual_actions"]:
        for index, action in enumerate(payload["manual_actions"], start=1):
            lines.append(f"{index}. {action['title']} — {action['detail']}")
    else:
        lines.append("- none; verified release governance requirements are satisfied")

    lines.extend([
        "",
        "Release governance is read-only. With --remote it performs GitHub API GET requests only; it does not tag, merge, push, upload, publish, call the model, or mutate repository files.",
    ])
    return "\n".join(lines)


def run_tool(name, args):
    print(
        f"\n[{name}] "
        f"{json.dumps(args, ensure_ascii=False)}",
        file=sys.stderr,
    )

    started = _metrics_time.perf_counter()

    global LAST_PATCH_HASHES, LAST_PATCH_PATHS

    policy = evaluate_tool_policy(name, args)
    policy_result = render_policy_result(policy)
    if policy_result is not None:
        record_audit_event({
            "type": "policy_decision",
            "tool": name,
            "decision": policy["decision"],
            "reason": policy["reason"],
        })
        duration_ms = (
            _metrics_time.perf_counter()
            - started
        ) * 1000.0
        record_metric_event({
            "type": "tool",
            "name": name,
            "duration_ms": round(duration_ms, 2),
            "ok": False,
            "policy": policy["decision"],
        })
        return policy_result

    audit_patch_paths = []

    if name == "patch":
        audit_patch_paths = [
            str(change.get("path"))
            for change in (
                args.get("changes") or []
            )
            if change.get("path")
        ]
    elif name == "rewrite":
        rewrite_path = args.get("path")
        audit_patch_paths = (
            [str(rewrite_path)]
            if rewrite_path
            else []
        )

    if name in {"patch", "rewrite"}:
        audit_before_hashes = (
            hash_repository_paths(
                audit_patch_paths
            )
        )
    else:
        audit_before_hashes = {}

    try:
        if name == "read":
            result = tool_read(args)
        elif name == "search":
            result = tool_search(args)
        elif name == "list":
            result = tool_list(args)
        elif name == "git":
            result = tool_git(args)
        elif name == "project":
            result = tool_project(args)
        elif name == "inspect":
            result = tool_inspect(args)
        elif name == "patch":
            result = tool_patch(args)
        elif name == "edit":
            result = tool_edit(args)
        elif name == "create":
            result = tool_create(args)
        elif name == "rewrite":
            result = tool_rewrite(args)
        elif name == "validate":
            result = tool_validate(args)
        elif name == "bash":
            result = tool_bash(args)
        else:
            result = f"ERROR: unknown tool: {name}"
    except Exception as e:
        result = (
            f"ERROR: {type(e).__name__}: {e}"
        )

    duration_ms = (
        _metrics_time.perf_counter()
        - started
    ) * 1000.0

    if name in {"patch", "rewrite"}:
        audit_after_hashes = (
            hash_repository_paths(
                audit_patch_paths
            )
        )

        LAST_PATCH_PATHS = list(
            audit_patch_paths
        )

        LAST_PATCH_HASHES = dict(
            audit_after_hashes
        )

        record_audit_event({
            "type": name,
            "paths": audit_patch_paths,
            "before_hashes": (
                audit_before_hashes
            ),
            "after_hashes": (
                audit_after_hashes
            ),
            "result": str(result)[:900],
        })

    record_metric_event({
        "type": "tool",
        "name": name,
        "duration_ms": round(duration_ms, 2),
        "ok": not (
            str(result).startswith("ERROR:")
            or str(result).startswith("BLOCKED:")
            or str(result).startswith("POLICY ASK:")
            or str(result).startswith("POLICY DENY:")
        ),
    })

    return result



def api_call(
    host,
    messages,
    use_tools=True,
    max_tokens=2048,
    tools=None,
):
    payload = {
        "model": MODEL,
        "messages": messages,
        "temperature": 0,
        "max_tokens": max_tokens,
    }

    selected_tools = (
        TOOLS
        if tools is None
        else tools
    )

    if use_tools and selected_tools:
        payload["tools"] = selected_tools
        payload["tool_choice"] = "auto"

    key = llama_api_key()

    req = urllib.request.Request(
        f"http://{host}:{LLAMA_PORT}/v1/chat/completions",
        data=json.dumps(payload).encode(),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {key}",
        },
    )

    started = _metrics_time.perf_counter()

    try:
        with urllib.request.urlopen(
            req,
            timeout=180,
        ) as response:
            result = json.loads(
                response.read().decode()
            )
    except Exception as e:
        duration_ms = (
            _metrics_time.perf_counter()
            - started
        ) * 1000.0

        record_metric_event({
            "type": "api",
            "duration_ms": round(duration_ms, 2),
            "error": type(e).__name__,
            "prompt_tokens": 0,
            "completion_tokens": 0,
            "total_tokens": 0,
            "max_tokens": max_tokens,
            "tool_schema_count": len(
                selected_tools
                if use_tools
                else []
            ),
        })

        raise

    duration_ms = (
        _metrics_time.perf_counter()
        - started
    ) * 1000.0

    usage = result.get("usage") or {}

    record_metric_event({
        "type": "api",
        "duration_ms": round(duration_ms, 2),
        "prompt_tokens": int(
            usage.get("prompt_tokens") or 0
        ),
        "completion_tokens": int(
            usage.get("completion_tokens") or 0
        ),
        "total_tokens": int(
            usage.get("total_tokens") or 0
        ),
        "max_tokens": max_tokens,
        "tool_schema_count": len(
            selected_tools
            if use_tools
            else []
        ),
    })

    return result


CONTEXT_INVENTORY_LIMIT = 400
CONTEXT_RESULT_LIMIT = 8
CONTEXT_INTELLIGENCE_MODES = {"plan", "debug", "diagnose", "fix", "ci-fix", "release", "implement", "refactor"}
CONTEXT_RENDER_LIMIT = 1800
CONTEXT_SAMPLE_BYTES = 32768
CONTEXT_IGNORED_DIRS = {
    ".git", ".specs", "node_modules", ".venv", "venv", "dist", "build",
    ".next", "coverage", "__pycache__", ".pytest_cache", ".mypy_cache",
}
CONTEXT_TEXT_SUFFIXES = {
    ".py", ".js", ".cjs", ".mjs", ".jsx", ".ts", ".tsx", ".json",
    ".toml", ".yaml", ".yml", ".md", ".txt", ".sh", ".go", ".rs",
    ".java", ".kt", ".html", ".css", ".scss", ".sql",
}
CONTEXT_MANIFESTS = {
    "AGENTS.md", "Makefile", "package.json", "pyproject.toml",
    "requirements.txt", "requirements-dev.in", "requirements-dev.txt", "mypy.ini",
    "go.mod", "Cargo.toml",
    "pom.xml", "build.gradle", "build.gradle.kts", "Dockerfile",
}
CONTEXT_STOPWORDS = {
    "the", "and", "for", "with", "from", "this", "that", "into", "add",
    "fix", "make", "change", "update", "create", "repair", "test", "tests",
    "file", "files", "code", "repo", "repository", "project", "task",
    "inspect", "search", "context", "src", "para", "com", "arquivo", "arquivos",
    "codigo", "projeto", "teste", "testes",
    "uma", "um", "que", "por", "dos", "das", "de", "do", "da", "sem",
}


def _context_fold_text(value):
    return "".join(
        char for char in unicodedata.normalize("NFKD", str(value or ""))
        if not unicodedata.combining(char)
    ).lower()


def context_task_terms(task):
    values = re.findall(r"[A-Za-z0-9_.:/-]+", _context_fold_text(task))
    terms = set()
    for value in values:
        for part in re.split(r"[./:_-]+", value):
            if len(part) >= 3 and part not in CONTEXT_STOPWORDS and not part.isdigit():
                terms.add(part)
    return sorted(terms)


def _context_path_allowed(rel):
    path = Path(str(rel).replace("\\", "/"))
    if path.is_absolute() or ".." in path.parts:
        return False
    if any(part in CONTEXT_IGNORED_DIRS for part in path.parts):
        return False
    candidate = ROOT / path
    try:
        if candidate.is_symlink():
            return False
        resolved = candidate.resolve(strict=True)
        resolved.relative_to(ROOT.resolve())
        return resolved.is_file()
    except (OSError, RuntimeError, ValueError):
        return False


def repository_context_inventory(max_files=CONTEXT_INVENTORY_LIMIT):
    max_files = max(1, min(int(max_files), 800))
    paths = []
    try:
        proc = subprocess.run(
            ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
            cwd=ROOT, text=False, capture_output=True, timeout=10,
        )
        if proc.returncode == 0:
            paths = [
                item.decode("utf-8", errors="replace")
                for item in proc.stdout.split(b"\0") if item
            ]
    except Exception:
        paths = []

    if not paths:
        try:
            for current, dirs, files in os.walk(ROOT):
                dirs[:] = sorted(d for d in dirs if d not in CONTEXT_IGNORED_DIRS)
                for name in sorted(files):
                    candidate = Path(current) / name
                    try:
                        rel = candidate.relative_to(ROOT).as_posix()
                    except ValueError:
                        continue
                    paths.append(rel)
                    if len(paths) >= max_files * 2:
                        break
                if len(paths) >= max_files * 2:
                    break
        except OSError:
            pass
    normalized = []
    seen = set()
    for raw in sorted(paths):
        rel = str(raw).replace("\\", "/")
        while rel.startswith("./"):
            rel = rel[2:]
        if not rel or rel in seen or not _context_path_allowed(rel):
            continue
        seen.add(rel)
        normalized.append(rel)
        if len(normalized) >= max_files:
            break
    return normalized


def context_git_changed_paths():
    try:
        proc = subprocess.run(
            ["git", "status", "--porcelain=v1", "-z", "--untracked-files=all"],
            cwd=ROOT, text=False, capture_output=True, timeout=10,
        )
        if proc.returncode != 0:
            return set()
    except Exception:
        return set()
    output = set()
    for item in proc.stdout.split(b"\0"):
        if len(item) < 4 or item[2:3] != b" ":
            continue
        rel = item[3:].decode("utf-8", errors="replace").replace("\\", "/")
        if _context_path_allowed(rel):
            output.add(rel)
    return output

def context_spec_references(active_spec, inventory):
    if not active_spec or not isinstance(active_spec, dict):
        return set()
    text = str(active_spec.get("text") or "")
    known = set(inventory)
    output = set()
    for raw in re.findall(r"`([^`\n]+)`", text):
        rel = raw.strip().replace("\\", "/")
        while rel.startswith("./"):
            rel = rel[2:]
        if rel in known:
            output.add(rel)
    return output


def _context_content_match_count(rel, terms):
    path = ROOT / rel
    if path.suffix.lower() not in CONTEXT_TEXT_SUFFIXES and path.name not in CONTEXT_MANIFESTS:
        return 0
    try:
        if path.stat().st_size > 262144:
            return 0
        text = _context_fold_text(
            path.read_bytes()[:CONTEXT_SAMPLE_BYTES].decode("utf-8", errors="replace")
        )
    except (OSError, UnicodeError):
        return 0
    return sum(1 for term in terms if len(term) >= 4 and term in text)


def rank_context_candidates(task, workspace_state=None, active_spec=None, limit=CONTEXT_RESULT_LIMIT):
    inventory = repository_context_inventory()
    if not inventory:
        return []
    terms = context_task_terms(task)
    changed = context_git_changed_paths()
    state = workspace_state if isinstance(workspace_state, dict) else load_workspace_state()
    try:
        recent = set(normalize_workspace_state_paths(state.get("recent_files") or []))
        modified = set(normalize_workspace_state_paths(state.get("modified_files") or []))
    except Exception:
        recent, modified = set(), set()
    spec_refs = context_spec_references(active_spec, inventory)
    semantic_refs = context_semantic_references(terms, inventory)
    active_spec_rel = None
    if active_spec and active_spec.get("path"):
        try:
            active_spec_rel = active_spec["path"].resolve().relative_to(ROOT.resolve()).as_posix()
        except (OSError, RuntimeError, ValueError):
            active_spec_rel = None
    ranked = []
    for rel in inventory:
        if rel == active_spec_rel:
            continue
        reasons = []
        score = 0
        path_low = _context_fold_text(rel)
        path_parts = set(re.split(r"[./_\-]+", path_low))
        if rel in changed:
            score += 60
            reasons.append("git_changed")
        if rel in modified:
            score += 35
            reasons.append("modified")
        if rel in recent:
            score += 18
            reasons.append("recent")
        if rel in spec_refs:
            score += 45
            reasons.append("spec_reference")
        if rel in semantic_refs:
            score += 38
            reasons.append("semantic_contract:" + ",".join(semantic_refs[rel][:2]))
        if any(term in path_low or term in path_parts for term in terms):
            score += 50
            reasons.append("task_path_match")
        matches = _context_content_match_count(rel, terms)
        if matches:
            score += min(32, matches * 8)
            reasons.append("content_match")
        if Path(rel).name in CONTEXT_MANIFESTS:
            score += 10
            reasons.append("manifest")
        if score:
            ranked.append({"path": rel, "score": score, "reasons": reasons})
    ranked.sort(key=lambda item: (-item["score"], item["path"]))
    return ranked[:max(1, min(int(limit), CONTEXT_RESULT_LIMIT))]

def render_context_candidates(candidates, max_chars=CONTEXT_RENDER_LIMIT):
    lines = [
        "CONTEXT CANDIDATES (advisory metadata only; inspect files before relying on them):"
    ]
    for item in candidates or []:
        reasons = ",".join(item.get("reasons") or []) or "none"
        lines.append(
            f"- score={int(item.get('score') or 0)} path={item.get('path')} reasons={reasons}"
        )
    if len(lines) == 1:
        lines.append("- [none]")
    return "\n".join(lines)[:max(80, min(int(max_chars), CONTEXT_RENDER_LIMIT))]


