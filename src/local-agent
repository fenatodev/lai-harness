def _model_bridge_socket_path():
    value = os.environ.get(CONTROL_MODEL_BRIDGE_SOCKET_ENV, "").strip()
    return value or None


def _recv_exact(sock, size):
    chunks = []
    remaining = int(size)
    while remaining > 0:
        chunk = sock.recv(remaining)
        if not chunk:
            raise EOFError("model bridge closed before payload completed")
        chunks.append(chunk)
        remaining -= len(chunk)
    return b"".join(chunks)


def model_bridge_chat_completion(payload):
    socket_path = _model_bridge_socket_path()
    if not socket_path:
        raise ModelAPIError("model bridge socket is not configured")
    body = json.dumps({
        "schema_version": CONTROL_MODEL_BRIDGE_SCHEMA_VERSION,
        "payload": payload,
    }).encode("utf-8")
    if len(body) > CONTROL_MODEL_BRIDGE_REQUEST_LIMIT_BYTES:
        raise ModelAPIError("model bridge request is too large")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(180)
        client.connect(socket_path)
        client.sendall(len(body).to_bytes(4, "big") + body)
        size = int.from_bytes(_recv_exact(client, 4), "big")
        if size <= 0 or size > CONTROL_MODEL_BRIDGE_RESPONSE_LIMIT_BYTES:
            raise ModelAPIError("model bridge response is invalid or too large")
        response = json.loads(_recv_exact(client, size).decode("utf-8"))
    if not isinstance(response, dict) or response.get("schema_version") != CONTROL_MODEL_BRIDGE_SCHEMA_VERSION:
        raise ModelAPIError("model bridge response schema is invalid")
    if not response.get("ok"):
        message = str(response.get("error") or "model bridge call failed")[:500]
        raise ModelAPIError(message)
    result = response.get("response")
    if not isinstance(result, dict):
        raise ModelAPIError("model bridge returned invalid model response")
    return result


def _control_model_bridge_api_key(api_key_file=None):
    if api_key_file:
        return Path(api_key_file).read_text(encoding="utf-8").strip()
    return llama_api_key()


def control_model_bridge_call_model(host, port, api_key_file, payload):
    key = _control_model_bridge_api_key(api_key_file)
    request = urllib.request.Request(
        f"http://{host}:{port}/v1/chat/completions",
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {key}",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=180) as response:
            return json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        raise ModelAPIError(model_api_http_error_message(exc, api_key=key)) from None


def _control_model_bridge_handle_connection(conn, host, port, api_key_file):
    try:
        size = int.from_bytes(_recv_exact(conn, 4), "big")
        if size <= 0 or size > CONTROL_MODEL_BRIDGE_REQUEST_LIMIT_BYTES:
            raise ValueError("model bridge request is invalid or too large")
        request = json.loads(_recv_exact(conn, size).decode("utf-8"))
        if not isinstance(request, dict) or request.get("schema_version") != CONTROL_MODEL_BRIDGE_SCHEMA_VERSION:
            raise ValueError("model bridge request schema is invalid")
        payload = request.get("payload")
        if not isinstance(payload, dict):
            raise ValueError("model bridge payload must be an object")
        response = {
            "schema_version": CONTROL_MODEL_BRIDGE_SCHEMA_VERSION,
            "ok": True,
            "response": control_model_bridge_call_model(host, port, api_key_file, payload),
        }
    except Exception as exc:
        response = {
            "schema_version": CONTROL_MODEL_BRIDGE_SCHEMA_VERSION,
            "ok": False,
            "error": str(exc)[:500],
        }
    raw = json.dumps(response, ensure_ascii=False).encode("utf-8")
    if len(raw) > CONTROL_MODEL_BRIDGE_RESPONSE_LIMIT_BYTES:
        raw = json.dumps({
            "schema_version": CONTROL_MODEL_BRIDGE_SCHEMA_VERSION,
            "ok": False,
            "error": "model bridge response is too large",
        }).encode("utf-8")
    try:
        conn.sendall(len(raw).to_bytes(4, "big") + raw)
    except OSError:
        pass


def start_control_model_bridge(socket_path, host, port=None, api_key_file=None):
    path = Path(socket_path)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    try:
        path.unlink()
    except FileNotFoundError:
        pass
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(path))
    try:
        path.chmod(0o600)
    except OSError:
        pass
    server.listen(4)
    server.settimeout(0.2)
    stop = threading.Event()

    def loop():
        while not stop.is_set():
            try:
                conn, _addr = server.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            with conn:
                _control_model_bridge_handle_connection(conn, host, port or LLAMA_PORT, api_key_file)

    thread = threading.Thread(target=loop, name="lai-model-bridge", daemon=True)
    thread.start()

    def close():
        stop.set()
        try:
            server.close()
        except OSError:
            pass
        try:
            path.unlink()
        except (FileNotFoundError, OSError):
            pass

    return close


def doctor_status(host):
