            "%Y-%m-%dT%H:%M:%SZ",
            _metrics_time.gmtime(),
        ),
        "run_id": RUN_ID,
        "repo": str(ROOT),
        "mode": ACTIVE_MODE,
        **event,
        "schema_version": RUNTIME_RECORD_SCHEMA_VERSION,
    }

    try:
        with AUDIT_FILE.open(
            "a",
            encoding="utf-8",
        ) as fh:
            fh.write(
                json.dumps(
                    payload,
                    ensure_ascii=False,
                )
                + "\n"
            )
    except Exception:
        pass


def _runtime_trajectory_clean_metadata(details):
    clean = {}

    for key, value in (details or {}).items():
        if key not in RUNTIME_TRAJECTORY_METADATA_KEYS:
            continue

        if value is None or value == "":
            continue

        if isinstance(value, bool):
            clean[key] = value
        elif isinstance(value, int):
            clean[key] = value
        elif isinstance(value, float):
            clean[key] = round(value, 3)
        else:
            clean[key] = " ".join(str(value).split())[:160]

    return clean


def record_trajectory_event(
    event_type,
    status,
    *,
    reason_code=None,
    actor="agent-loop",
    parent_span_id=None,
    **metadata,
):
    global RUNTIME_TRAJECTORY_SEQUENCE
    RUNTIME_TRAJECTORY_SEQUENCE += 1
    sequence = RUNTIME_TRAJECTORY_SEQUENCE
    stem = f"rt-{RUN_ID}-{sequence:06d}"
    payload = {
        "schema_version": RUNTIME_TRAJECTORY_SCHEMA_VERSION,
        "sequence": sequence,
        "event_id": stem,
        "action_id": stem + "-action",
        "span_id": stem + "-span",
        "parent_span_id": parent_span_id,
        "run_id": RUN_ID,
        "event_type": str(event_type)[:80],
        "status": str(status)[:80],
        "actor": str(actor)[:80],
        "reason_code": str(reason_code or event_type)[:80],
    }
    clean = _runtime_trajectory_clean_metadata(metadata)
    if clean:
        payload["metadata"] = clean
    record_audit_event({"type": "trajectory", "trajectory": payload})
    return payload


def run_budget_default_limits(mode, round_limit=None):
    limits = dict(RUN_BUDGET_DEFAULT_LIMITS)
    if round_limit is not None:
        limits["rounds"] = int(round_limit)
    if mode == "plan":
        limits["model_calls"] = 8
        limits["tool_calls"] = 16
        limits["truncation_retries"] = 4
    elif mode in {"review", "security", "diagnose", "release"}:
        limits["model_calls"] = 24
        limits["tool_calls"] = 80
    return limits


class RunBudgetController:
    def __init__(self, mode, *, limits=None, emit=None, clock=None):
        self.mode = str(mode or "unknown")
        self.limits = {
            key: int(value)
            for key, value in (limits or {}).items()
            if key in RUN_BUDGET_DIMENSIONS and value is not None
        }
        self.consumed = {key: 0 for key in RUN_BUDGET_DIMENSIONS}
        self.reserved = {key: 0 for key in RUN_BUDGET_DIMENSIONS}
        self.unknown_counters = set()
        self.sequence = 0
        self.exhausted = False
        self.exhausted_dimension = None
        self.emit = emit
        self.clock = clock or control_run_now
        self.lock = threading.Lock()
        self._emit("budget_started", "active", reason_code="budget_started")

    def snapshot(self):
        with self.lock:
            consumed = dict(self.consumed)
            for key in self.unknown_counters:
                consumed[key] = None
            return {
                "schema_version": RUN_BUDGET_SCHEMA_VERSION,
                "mode": self.mode,
                "limits": dict(self.limits),
                "reserved": dict(self.reserved),
                "consumed": consumed,
                "unknown_counters": sorted(self.unknown_counters),
                "exhausted": self.exhausted,
                "exhausted_dimension": self.exhausted_dimension,
            }

    def _emit(self, event_type, status, *, reason_code, **metadata):
        self.sequence += 1
        payload = {
            "schema_version": RUN_BUDGET_SCHEMA_VERSION,
            "sequence": self.sequence,
            "event_type": str(event_type)[:80],
            "status": str(status)[:80],
            "mode": self.mode,
            "at": self.clock(),
            "reason_code": str(reason_code)[:80],
        }
        clean = {
            key: value
            for key, value in metadata.items()
            if value is not None and value != ""
        }
        if clean:
            payload["metadata"] = clean
        event = {"type": "budget", "budget": payload}
        if self.emit is None:
            record_audit_event(event)
        else:
            self.emit(event)
        return payload

    def _would_exceed_locked(self, dimension, amount):
        limit = self.limits.get(dimension)
        if limit is None:
            return False
        if dimension in self.unknown_counters:
            return True
        return self.consumed[dimension] + self.reserved[dimension] + amount > limit

    def reserve(self, dimension, amount=1, *, reason_code="reserve"):
        dimension = str(dimension)
        amount = int(amount)
        if dimension not in RUN_BUDGET_DIMENSIONS or amount <= 0:
            raise ValueError("invalid budget reservation")
        with self.lock:
            if self.exhausted or self._would_exceed_locked(dimension, amount):
                self.exhausted = True
                self.exhausted_dimension = dimension
                self._emit(
                    "budget_exhausted", "blocked",
                    reason_code="budget_exhausted",
                    dimension=dimension,
                    requested=amount,
                    limit=self.limits.get(dimension),
                    consumed=self.consumed.get(dimension),
                    reserved=self.reserved.get(dimension),
                )
                return None
            self.reserved[dimension] += amount
            reservation = {
                "dimension": dimension,
                "amount": amount,
                "sequence": self.sequence + 1,
            }
            self._emit(
                "budget_reserved", "reserved",
                reason_code=reason_code,
                dimension=dimension,
                amount=amount,
                reserved=self.reserved[dimension],
                limit=self.limits.get(dimension),
            )
            return reservation

    def consume(self, reservation, *, observed=None, status="consumed"):
        if not reservation:
            return None
        dimension = reservation["dimension"]
        amount = int(reservation["amount"] if observed is None else observed)
        with self.lock:
            self.reserved[dimension] = max(
                0,
                self.reserved[dimension] - int(reservation["amount"]),
            )
            self.consumed[dimension] += amount
            return self._emit(
                "budget_consumed", status,
                reason_code="budget_consumed",
                dimension=dimension,
                amount=amount,
                consumed=self.consumed[dimension],
                reserved=self.reserved[dimension],
                limit=self.limits.get(dimension),
            )

    def observe(self, dimension, value, *, reason_code="budget_observed"):
        dimension = str(dimension)
        if dimension not in RUN_BUDGET_DIMENSIONS:
            raise ValueError("invalid budget counter")
        with self.lock:
            if value is None:
                self.unknown_counters.add(dimension)
                observed = None
            else:
                observed = int(value)
                if dimension not in self.unknown_counters:
                    self.consumed[dimension] += observed
            return self._emit(
                "budget_observed", "observed",
                reason_code=reason_code,
                dimension=dimension,
                observed=observed,
                consumed=(
                    None
                    if dimension in self.unknown_counters
                    else self.consumed[dimension]
                ),
                limit=self.limits.get(dimension),
            )


