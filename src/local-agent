def parse_mcp_policy_args(args):
    options = {"operation": None, "server": None, "tool": None, "json": False}
    index = 0
    while index < len(args):
        item = args[index]
        if item == "--json":
            options["json"] = True
            index += 1
            continue
        if item in {"--operation", "--server", "--tool"}:
            if index + 1 >= len(args):
                raise SystemExit(MCP_POLICY_USAGE)
            options[item[2:].replace("-", "_")] = args[index + 1]
            index += 2
            continue
        raise SystemExit(MCP_POLICY_USAGE)
    if not options["operation"]:
        raise SystemExit(MCP_POLICY_USAGE)
    return options


def render_mcp_policy_check(args):
    if args and args[0] in MCP_HELP_ARGS:
        if len(args) == 1:
            return MCP_POLICY_USAGE
        raise SystemExit(MCP_POLICY_USAGE)
    options = parse_mcp_policy_args(args)
    payload = control_mcp_policy_payload(options)
    if options["json"]:
        return json.dumps(payload, ensure_ascii=False, sort_keys=True)
    return f"{payload['decision']}: {payload['reason']}"


def _parse_mcp_json_only_args(args, usage):
    json_mode = False
    for item in args:
        if item == "--json":
            json_mode = True
            continue
        raise SystemExit(usage)
    return json_mode


def handle_mcp(args):
    command = args[0] if args else "status"
    rest = args[1:] if args else []
    if command in MCP_HELP_ARGS:
        print(MCP_USAGE)
        print(MCP_STATUS_USAGE)
        print(MCP_TOOLS_USAGE)
        print(MCP_POLICY_USAGE)
        return
    if command == "status":
        if rest and rest[0] in MCP_HELP_ARGS:
            if len(rest) == 1:
                print(MCP_STATUS_USAGE)
                return
            raise SystemExit(MCP_STATUS_USAGE)
        print(render_mcp_status(json_mode=_parse_mcp_json_only_args(rest, MCP_STATUS_USAGE)))
        return
    if command == "tools":
        if rest and rest[0] in MCP_HELP_ARGS:
            if len(rest) == 1:
                print(MCP_TOOLS_USAGE)
                return
            raise SystemExit(MCP_TOOLS_USAGE)
        print(render_mcp_tools(json_mode=_parse_mcp_json_only_args(rest, MCP_TOOLS_USAGE)))
        return
    if command == "policy-check":
        print(render_mcp_policy_check(rest))
        return
    if command == "--json":
        print(render_mcp_status(json_mode=True))
        return
    raise SystemExit(MCP_USAGE)


