        f"Directory: {pack['pack_dir']}",
        f"VSIX: {pack['vsix']['path']} ({'present' if pack['vsix']['present'] else 'optional/missing'})",
    ])
    remote_state = payload["remote"]
    if remote_state["enabled"]:
        lines.extend([
            "",
            "## Remote GitHub state",
            f"Repository: {remote_state.get('repository')}",
            f"Authenticated: {remote_state.get('authenticated')}",
            f"Credential source: {remote_state.get('credential_source')}",
            f"Branch protection: {remote_state['branch_protection']['status']} — {remote_state['branch_protection']['detail']}",
