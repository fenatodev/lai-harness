    }


def _control_authority_find_existing(payload_sha256):
    base = control_authority_base()
    if not base.is_dir():
        return None
    for path in sorted(base.glob("ca-*.json")):
        try:
            record = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        if (
            isinstance(record, dict)
            and record.get("schema_version") == CONTROL_AUTHORITY_SCHEMA_VERSION
            and record.get("payload_sha256") == payload_sha256
            and record.get("status") == "pending"
            and not record.get("revoked_at")
            and not record.get("used_at")
        ):
            return record
    return None


def control_create_authority_intent(server, request):
    if not isinstance(request, dict):
        raise ValueError("JSON object required")
    unknown = sorted(set(request) - {
        "tool", "args", "mode", "principal", "destination", "ttl_seconds", "backend",
    })
    if unknown:
        raise ValueError("unknown fields: " + ", ".join(unknown))
    backend = request.get("backend", "local")
    if backend != "local":
        return {
            "schema_version": CONTROL_AUTHORITY_SCHEMA_VERSION,
            "decision": "DENY",
            "reason": "authority backend is not applicable in this v1 contract",
            "executed": False,
        }
    tool = request.get("tool")
    args = request.get("args", {})
    mode = request.get("mode")
    principal = request.get("principal", "operator")
    destination = request.get("destination", {"kind": "tool"})
    ttl = request.get("ttl_seconds", CONTROL_AUTHORITY_DEFAULT_TTL_SECONDS)
    if not isinstance(tool, str) or not tool.strip():
        raise ValueError("tool must be a non-empty string")
    if not isinstance(args, dict):
        raise ValueError("args must be a JSON object")
    if mode is not None and not isinstance(mode, str):
        raise ValueError("mode must be a string")
    if not isinstance(principal, str) or not principal.strip():
        raise ValueError("principal must be a non-empty string")
    if not isinstance(destination, dict):
        raise ValueError("destination must be a JSON object")
    if not isinstance(ttl, int) or not 1 <= ttl <= CONTROL_AUTHORITY_MAX_TTL_SECONDS:
        raise ValueError("ttl_seconds is out of range")
    policy = evaluate_tool_policy(tool.strip(), args, mode=mode)
    if policy["decision"] != "ASK":
        return {
            "schema_version": CONTROL_AUTHORITY_SCHEMA_VERSION,
            "decision": policy["decision"],
            "reason": policy["reason"],
            "tool": tool.strip(),
            "mode": mode or "unknown",
            "approval_required": False,
            "executed": False,
        }
    payload = {
        "tool": tool.strip(),
        "args": args,
        "mode": mode or "unknown",
        "backend": backend,
    }
    preconditions = _control_authority_preconditions(mode, policy)
    intent_material = {
        "payload": payload,
        "destination": destination,
        "principal": principal.strip(),
        "preconditions": preconditions,
    }
    payload_sha256 = _control_authority_sha256(intent_material)
    args_sha256 = _control_authority_sha256(args)
    with server.control_authority_lock:
        existing = _control_authority_find_existing(payload_sha256)
        if existing is not None:
            return _control_authority_public_record(existing)
        now = time.time()
        approval_intent_id = "ca-" + secrets.token_hex(8)
        record = {
            "schema_version": CONTROL_AUTHORITY_SCHEMA_VERSION,
            "approval_intent_id": approval_intent_id,
            "status": "pending",
            "decision": "ASK",
            "reason": policy["reason"],
            "principal": principal.strip(),
            "created_at": _control_authority_timestamp(now),
            "expires_at": _control_authority_timestamp(now + ttl),
            "expires_at_epoch": now + ttl,
            "revoked_at": None,
            "used_at": None,
            "payload": payload,
            "destination": destination,
            "preconditions": preconditions,
            "payload_sha256": payload_sha256,
            "args_sha256": args_sha256,
            "checkpoint_authority": False,
            "text_authority": False,
            "executed": False,
        }
        _control_authority_write(record)
        _control_authority_prune()
        return _control_authority_public_record(record)


def control_approve_authority_intent(server, request):
    if not isinstance(request, dict):
        raise ValueError("JSON object required")
    unknown = sorted(set(request) - {"approval_intent_id", "payload_sha256", "principal"})
    if unknown:
        raise ValueError("unknown fields: " + ", ".join(unknown))
    approval_intent_id = _control_authority_validate_id(request.get("approval_intent_id"))
    approved_hash = request.get("payload_sha256")
    if not isinstance(approved_hash, str) or not re.fullmatch(r"[0-9a-f]{64}", approved_hash):
        raise ValueError("payload_sha256 must be a lowercase sha256 hex digest")
    principal = request.get("principal")
    with server.control_authority_lock:
        record = _control_authority_load(approval_intent_id)
        if record.get("status") != "pending":
            raise ControlApprovalConflict("approval intent is not pending")
        if record.get("revoked_at"):
            raise ControlApprovalConflict("approval intent is revoked")
        if record.get("used_at"):
            raise ControlApprovalConflict("approval intent was already used")
        if principal is not None and principal != record.get("principal"):
            raise ControlApprovalConflict("approval principal mismatch")
        if time.time() > float(record.get("expires_at_epoch") or 0):
            record["status"] = "expired"
            _control_authority_write(record)
            raise ControlApprovalConflict("approval intent expired")
        if not hmac.compare_digest(str(record.get("payload_sha256") or ""), approved_hash):
            raise ControlApprovalConflict("approval hash does not match intent payload")
        preconditions = record.get("preconditions") or {}
        current = _control_authority_preconditions(
            (record.get("payload") or {}).get("mode"),
            evaluate_tool_policy(
                (record.get("payload") or {}).get("tool"),
                (record.get("payload") or {}).get("args") or {},
                mode=(record.get("payload") or {}).get("mode"),
            ),
        )
        checked_keys = ("repository", "workspace", "branch", "git_status", "policy_decision", "policy_reason")
        drift = [key for key in checked_keys if preconditions.get(key) != current.get(key)]
        if drift:
            raise ControlApprovalConflict("approval preconditions changed: " + ", ".join(drift))
        record["status"] = "approved"
        record["used_at"] = _control_authority_timestamp()
        _control_authority_write(record)
        return {
            "schema_version": CONTROL_AUTHORITY_SCHEMA_VERSION,
            "approval_intent_id": approval_intent_id,
            "status": "approved",
            "used_once": True,
            "executed": False,
            "execution_enabled": False,
            "reason": "approval recorded and consumed; v1 does not execute approved tool payloads",
            "payload_sha256": approved_hash,
        }


def control_revoke_authority_intent(server, approval_intent_id):
    approval_intent_id = _control_authority_validate_id(approval_intent_id)
    with server.control_authority_lock:
        record = _control_authority_load(approval_intent_id)
        if record.get("used_at"):
            raise ControlApprovalConflict("approval intent was already used")
        if not record.get("revoked_at"):
            record["status"] = "revoked"
            record["revoked_at"] = _control_authority_timestamp()
            _control_authority_write(record)
        return _control_authority_public_record(record)


