def _control_session_snapshot_public(session):
    public = control_session_public_record(session, include_turns=False)
    digest_source = json.dumps(
        {
            "session_id": session["session_id"],
            "repository": session["repository"],
            "turn_count": len(session["turns"]),
            "turn_ids": [turn.get("control_run_id") for turn in session["turns"]],
        },
        sort_keys=True,
    )
    public["snapshot_sha256"] = hashlib.sha256(digest_source.encode("utf-8")).hexdigest()
    public["history_trusted"] = False
    public["turn_bodies_included"] = False
    return public


