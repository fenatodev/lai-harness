def runtime_record_schema_supported(payload):
    if not isinstance(payload, dict):
        return False
    version = payload.get("schema_version")
    return version in {None, RUNTIME_RECORD_SCHEMA_VERSION}


def prune_jsonl_tail(path, max_bytes, keep_lines):
    try:
        if not path.is_file() or path.stat().st_size <= max_bytes:
            return False
        lines = path.read_text(errors="replace").splitlines()[-keep_lines:]
        text = "\n".join(lines)
        if text:
            text += "\n"
        temp = path.with_name(f".{path.name}.{os.getpid()}.{RUN_ID}.retention.tmp")
        try:
            with temp.open("w", encoding="utf-8") as fh:
                fh.write(text)
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(temp, path)
        finally:
            temp.unlink(missing_ok=True)
        return True
    except Exception:
        return False


