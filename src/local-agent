STATE_BASE = CONFIG["state_dir"]

def post_patch_sanity(
    host,
    task,
    paths,
):
    normalized = []

    for raw_path in paths:
        value = str(
            raw_path or ""
        ).strip()

        while value.startswith("./"):
            value = value[2:]

        if (
            value
            and value not in normalized
        ):
            normalized.append(value)

    if not normalized:
        return None

    root_real = ROOT.resolve()

    # --------------------------------------------------------
    # 1. Deterministic Python syntax checks.
    # --------------------------------------------------------

    for rel in normalized:
        if Path(rel).suffix.lower() != ".py":
            continue

        candidate = root_real / rel

        if not candidate.is_file():
            continue

        try:
            source = candidate.read_text(
                encoding="utf-8",
                errors="replace",
            )
            compile(
                source,
                str(candidate),
                "exec",
            )
        except SyntaxError as exc:
            location = (
                f" line {exc.lineno}"
                if exc.lineno
                else ""
            )
            detail = str(exc.msg or "invalid syntax")[:240]

            return (
                f"BUG: Python syntax check failed for "
                f"{rel}{location}: {detail}"
            )
        except Exception:
            pass

    # --------------------------------------------------------
    # 2. Deterministic syntax checks for runnable JS.
    # --------------------------------------------------------

    node_path = __import__(
        "shutil"
    ).which("node")

    if node_path:
        for rel in normalized:
            suffix = Path(
                rel
            ).suffix.lower()

            if suffix not in {
                ".js",
                ".cjs",
                ".mjs",
            }:
                continue

            candidate = root_real / rel

            if not candidate.is_file():
                continue

            try:
                proc = subprocess.run(
                    [
                        node_path,
                        "--check",
                        str(candidate),
                    ],
                    cwd=ROOT,
                    text=True,
                    capture_output=True,
                    timeout=15,
                )
            except Exception:
                proc = None

            if (
                proc is not None
                and proc.returncode != 0
            ):
                detail = (
                    proc.stderr.strip()
                    or proc.stdout.strip()
                    or "syntax check failed"
                )

                detail = " ".join(
                    detail.split()
                )[:320]

                return (
                    f"BUG: node --check failed for "
                    f"{rel}: {detail}"
                )

    # --------------------------------------------------------
    # 3. Deterministic added-line inspection.
    # --------------------------------------------------------

    try:
        proc = subprocess.run(
            [
                "git",
                "diff",
                "--no-ext-diff",
                "--unified=1",
                "--",
                *normalized,
            ],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=15,
        )
    except Exception:
        return None

    if proc.returncode != 0:
        return None

    diff_text = proc.stdout

    if not diff_text.strip():
        return None

    current_file = None

    added_by_file = {}

    for line in diff_text.splitlines():
        if line.startswith("+++ b/"):
            current_file = line[6:]
            added_by_file.setdefault(
                current_file,
                [],
            )
            continue

        if (
            current_file
            and line.startswith("+")
            and not line.startswith("+++")
        ):
            added_by_file[
                current_file
            ].append(line[1:])

    # Detect glued constructor/function names such as:
    #
    #   throw newError(...)
    #
    # If newError is not declared/imported in the file,
    # this is a concrete latent runtime defect even when
    # the branch is not exercised by tests.

    suspicious_call = re.compile(
        r"\b(new[A-Z][A-Za-z0-9_$]*)\s*\("
    )

    for rel, added_lines in added_by_file.items():
        suffix = Path(
            rel
        ).suffix.lower()

        if suffix not in {
            ".js",
            ".cjs",
            ".mjs",
            ".jsx",
            ".ts",
            ".cts",
            ".mts",
            ".tsx",
        }:
            continue

        candidate = root_real / rel

        try:
            full_text = candidate.read_text(
                errors="replace"
            )
        except Exception:
            continue

        for added in added_lines:
            for match in suspicious_call.finditer(
                added
            ):
                identifier = match.group(1)
                escaped = re.escape(
                    identifier
                )

                declaration_patterns = [
                    rf"\bfunction\s+{escaped}\b",
                    rf"\bclass\s+{escaped}\b",
                    rf"\b(?:const|let|var)\s+{escaped}\b",
                    rf"\bimport\b[^\n]*\b{escaped}\b",
                    rf"\{{[^}}\n]*\b{escaped}\b[^}}\n]*\}}\s*=\s*require\(",
                ]

                declared = any(
                    re.search(
                        pattern,
                        full_text,
                    )
                    for pattern
                    in declaration_patterns
                )

                if declared:
                    continue

                # Strong special case:
                # "newError(...)" is commonly a missing space
                # for "new Error(...)".
                suggested = None

                constructor = (
                    identifier[3:]
                    if identifier.startswith("new")
                    else ""
                )

                builtin_constructors = {
                    "Error",
                    "TypeError",
                    "RangeError",
                    "ReferenceError",
                    "SyntaxError",
                    "URIError",
                    "EvalError",
                    "Date",
                    "Map",
                    "Set",
                    "WeakMap",
                    "WeakSet",
                    "Promise",
                    "RegExp",
                    "Array",
                    "Object",
                }

                if (
                    constructor
                    in builtin_constructors
                ):
                    suggested = (
                        f" If `{constructor}` constructor "
                        f"was intended, use "
                        f"`new {constructor}(...)`."
                    )

                return (
                    f"BUG: added call `{identifier}(...)` "
                    f"in {rel} is not declared or imported "
                    f"in that file."
                    + (suggested or "")
                )

    # Blocking post-patch sanity is intentionally deterministic.
    # Broader code review belongs in explicit validation/review flows.
    return None




def workspace_state_paths():
    hashlib = __import__("hashlib")

    key = hashlib.sha256(
        str(ROOT).encode("utf-8")
    ).hexdigest()[:16]

    return (
        STATE_BASE / f"{key}.json",
        STATE_BASE / f"{key}.md",
    )


CHECKPOINT_SCHEMA_VERSION = 1


def run_checkpoint_path():
    hashlib = __import__("hashlib")
    key = hashlib.sha256(str(ROOT).encode("utf-8")).hexdigest()[:16]
    path = STATE_BASE.parent / "checkpoints" / f"{key}.json"
    try:
        path.resolve().relative_to(ROOT.resolve())
    except ValueError:
        return path
    raise RuntimeError("recovery checkpoint directory must be outside repository")


def _atomic_write_text(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_name(f".{path.name}.{os.getpid()}.{RUN_ID}.tmp")
    try:
        with temp.open("w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(temp, path)
    except Exception:
        try:
            temp.unlink()
        except FileNotFoundError:
            pass
        raise


def build_run_checkpoint(
    mode, task, phase, tracked_paths=None, terminal=False,
    resumed_from=None, last_tool=None, reason=None,
):
    time = __import__("time")
    normalized = []
    for raw_path in tracked_paths or []:
        rel = str(raw_path or "").replace("\\", "/").strip()
        while rel.startswith("./"):
            rel = rel[2:]
        if rel and rel not in normalized:
            normalized.append(rel)
    checkpoint = {
        "schema_version": CHECKPOINT_SCHEMA_VERSION,
        "root": str(ROOT),
        "run_id": RUN_ID,
        "resumed_from": resumed_from,
        "mode": str(mode)[:80],
        "task": str(task)[:900],
        "phase": str(phase)[:80],
        "terminal": bool(terminal),
        "branch": workspace_git_branch(),
        "git_status": workspace_git_status(),
        "tracked_hashes": hash_repository_paths(normalized),
        "last_tool": str(last_tool)[:80] if last_tool else None,
        "reason": str(reason)[:500] if reason else None,
        "updated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    return checkpoint


def save_run_checkpoint(checkpoint):
    path = run_checkpoint_path()
    text = json.dumps(checkpoint, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    _atomic_write_text(path, text)
    return path


def load_run_checkpoint():
    path = run_checkpoint_path()
    if not path.is_file():
        return None
    data = json.loads(path.read_text(errors="replace"))
    if data.get("schema_version") != CHECKPOINT_SCHEMA_VERSION:
        raise ValueError("unsupported recovery checkpoint schema")
    if data.get("root") != str(ROOT):
        raise ValueError("recovery checkpoint repository mismatch")
    return data


def check_recovery_compatibility(checkpoint):
    reasons = []
    if checkpoint.get("root") != str(ROOT):
        reasons.append("repository root changed")
    expected_branch = checkpoint.get("branch")
    current_branch = workspace_git_branch()
    if expected_branch in {None, "[unavailable]"} or current_branch == "[unavailable]":
        reasons.append("Git branch evidence unavailable")
    elif expected_branch != current_branch:
        reasons.append(f"branch changed: {expected_branch} -> {current_branch}")
    expected_status = checkpoint.get("git_status")
    current_status = workspace_git_status()
    if expected_status in {None, "[unavailable]"} or current_status == "[unavailable]":
        reasons.append("Git status evidence unavailable")
    elif expected_status != current_status:
        reasons.append("Git status changed since checkpoint")
    expected_hashes = checkpoint.get("tracked_hashes") or {}
    if not isinstance(expected_hashes, dict):
        reasons.append("tracked hash map is invalid")
        expected_hashes = {}
    current_hashes = hash_repository_paths(expected_hashes.keys())
    for path, expected in expected_hashes.items():
        if not re.fullmatch(r"[0-9a-f]{64}", str(expected or "")):
            reasons.append(f"tracked checkpoint hash is invalid: {path}")
        elif current_hashes.get(path) != expected:
            reasons.append(f"tracked file hash changed: {path}")
    return not reasons, reasons


def inspect_recovery_checkpoint():
    try:
        checkpoint = load_run_checkpoint()
    except Exception as exc:
        return {"status": "blocked", "resumable": False, "checkpoint": None, "reasons": [str(exc)]}
    if checkpoint is None:
        return {"status": "none", "resumable": False, "checkpoint": None, "reasons": []}
    if checkpoint.get("terminal"):
        return {"status": "terminal", "resumable": False, "checkpoint": checkpoint, "reasons": []}
    try:
        compatible, reasons = check_recovery_compatibility(checkpoint)
    except Exception as exc:
        return {
            "status": "blocked",
            "resumable": False,
            "checkpoint": checkpoint,
            "reasons": ["invalid recovery checkpoint: " + str(exc)],
        }
    return {
        "status": "interrupted" if compatible else "blocked",
        "resumable": compatible,
        "checkpoint": checkpoint,
        "reasons": reasons,
    }


def print_recovery_status():
    state = inspect_recovery_checkpoint()
    checkpoint = state.get("checkpoint") or {}
    print("# LAI Recovery")
    print(f"Status: {state['status']}")
    if checkpoint:
        print("Run ID: " + str(checkpoint.get("run_id") or "[unknown]"))
        print("Mode: " + str(checkpoint.get("mode") or "[unknown]"))
        print("Phase: " + str(checkpoint.get("phase") or "[unknown]"))
        print("Updated: " + str(checkpoint.get("updated_at") or "[unknown]"))
        print("Resumable: " + ("yes" if state.get("resumable") else "no"))
    for reason in state.get("reasons") or []:
        print("Blocked: " + str(reason))


RUN_CHECKPOINT_CONTEXT = None


def start_run_checkpoint(mode, task, resumed_from=None, tracked_paths=None):
    global RUN_CHECKPOINT_CONTEXT
    if mode == "selection":
        RUN_CHECKPOINT_CONTEXT = None
        return None
    RUN_CHECKPOINT_CONTEXT = {
        "mode": mode,
        "task": task,
        "resumed_from": resumed_from,
        "tracked_paths": list(dict.fromkeys(str(p) for p in (tracked_paths or []) if p)),
        "last_tool": None,
        "terminal": False,
    }
    phase = "resumed" if resumed_from else "started"
    try:
        checkpoint = checkpoint_run_transition(phase)
    except Exception:
        RUN_CHECKPOINT_CONTEXT = None
        raise
    if resumed_from:
        record_audit_event({
            "type": "recovery_resume",
            "from_run_id": resumed_from,
            "new_run_id": RUN_ID,
        })
    return checkpoint


def checkpoint_run_transition(
    phase, terminal=False, tracked_paths=None, last_tool=None, reason=None,
):
    global RUN_CHECKPOINT_CONTEXT
    context = RUN_CHECKPOINT_CONTEXT
    if not context:
        return None
    if tracked_paths is not None:
        existing = context.get("tracked_paths") or []
        context["tracked_paths"] = list(dict.fromkeys(
            [*(str(p) for p in existing if p), *(str(p) for p in tracked_paths if p)]
        ))
    if last_tool is not None:
        context["last_tool"] = str(last_tool)
    context["terminal"] = bool(terminal)
    checkpoint = build_run_checkpoint(
        mode=context["mode"],
        task=context["task"],
        phase=phase,
        tracked_paths=context.get("tracked_paths") or [],
        terminal=terminal,
        resumed_from=context.get("resumed_from"),
        last_tool=context.get("last_tool"),
        reason=reason,
    )
    save_run_checkpoint(checkpoint)
    record_audit_event({
        "type": "checkpoint",
        "phase": phase,
        "terminal": bool(terminal),
        "last_tool": context.get("last_tool"),
        "reason": reason,
    })
    return checkpoint


def finalize_run_checkpoint(phase="completed", reason=None):
    context = RUN_CHECKPOINT_CONTEXT
    if not context or context.get("terminal"):
        return None
    return checkpoint_run_transition(phase, terminal=True, reason=reason)


def render_recovery_context(checkpoint):
    if not checkpoint:
        return ""
    tracked = sorted((checkpoint.get("tracked_hashes") or {}).keys())[:12]
    lines = [
        "RECOVERY CONTEXT (non-authoritative; current repository evidence and rules override it):",
        "Previous run: " + str(checkpoint.get("run_id") or "[unknown]"),
        "Previous phase: " + str(checkpoint.get("phase") or "[unknown]"),
        "Previous tool: " + str(checkpoint.get("last_tool") or "[none]"),
        "This is a fresh run. Do not assume any previous tool call should be replayed.",
    ]
    if tracked:
        lines.append("Tracked files at checkpoint: " + ", ".join(tracked))
    return "\n".join(lines)[:1400]


def normalize_workspace_state_paths(items):
    """Keep only verified regular files inside the current repository."""
    root = ROOT.resolve()
    normalized = []
    seen = set()

    for raw_path in items or []:
        try:
            value = str(raw_path).strip()

            if not value or value in {".", "./"}:
                continue

            candidate = Path(value)

            if not candidate.is_absolute():
                candidate = ROOT / candidate

            resolved = candidate.resolve(strict=True)

            try:
                relative = resolved.relative_to(root)
            except ValueError:
                continue

            if not resolved.is_file():
                continue

            relative_text = relative.as_posix()

            if relative_text in seen:
                continue

            seen.add(relative_text)
            normalized.append(relative_text)

        except (OSError, RuntimeError, ValueError):
            continue

    return normalized[-12:]


def load_workspace_state():
    json_path, _ = workspace_state_paths()

    base = {
        "root": str(ROOT),
        "updated_at": None,
        "last_mode": None,
        "last_task": None,
        "recent_files": [],
        "modified_files": [],
        "last_validation": None,
        "last_command": None,
        "last_git_operation": None,
        "git_status": None,
        "git_branch": None,
        "last_answer": None,
        "handoff_note": None,
    }

    if not json_path.is_file():
        return base

    try:
        data = json.loads(
            json_path.read_text(errors="replace")
        )

        if data.get("root") != str(ROOT):
            return base

        base.update(data)

        base["recent_files"] = normalize_workspace_state_paths(
            base.get("recent_files")
        )
        base["modified_files"] = normalize_workspace_state_paths(
            base.get("modified_files")
        )
    except Exception:
        pass

    return base


def workspace_git_branch():
    try:
        proc = subprocess.run(
            ["git", "branch", "--show-current"],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=10,
        )

        if proc.returncode != 0:
            return "[unavailable]"

        return proc.stdout.strip() or "[detached HEAD]"
    except Exception:
        return "[unavailable]"


def cleanup_stale_workspace_states(max_age_days=45):
    time = __import__("time")

    if not STATE_BASE.is_dir():
        return

    cutoff = (
        time.time()
        - max_age_days * 24 * 60 * 60
    )

    for json_path in STATE_BASE.glob("*.json"):
        try:
            if json_path.stat().st_mtime >= cutoff:
                continue

            md_path = json_path.with_suffix(".md")

            json_path.unlink(missing_ok=True)
            md_path.unlink(missing_ok=True)
        except Exception:
            pass


def workspace_git_status():
    try:
        proc = subprocess.run(
            ["git", "status", "--short"],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=10,
        )

        if proc.returncode != 0:
            return "[unavailable]"

        lines = proc.stdout.splitlines()

        if not lines:
            return "[clean]"

        output = "\n".join(lines[:15])

        if len(lines) > 15:
            output += "\n[status truncated]"

        return output
    except Exception:
        return "[unavailable]"


def render_workspace_handoff(state, compact=False):
    recent = state.get("recent_files") or []
    modified = state.get("modified_files") or []
    validation = state.get("last_validation")
    git_status = state.get("git_status") or "[unknown]"

    if compact:
        sections = [
            "PRIOR WORKSPACE CONTEXT "
            "(compact; may be stale; current request and repository "
            "evidence always override it):"
        ]

        if state.get("git_branch"):
            sections.append(
                "Git branch: "
                + str(state["git_branch"])[:150]
            )

        if state.get("last_task"):
            sections.append(
                "Previous task: "
                + str(state["last_task"])[:500]
            )

        if recent:
            sections.append(
                "Recent relevant files: "
                + ", ".join(recent[-8:])
            )

        if modified:
            sections.append(
                "Recently modified files: "
                + ", ".join(modified[-8:])
            )

        if validation:
            command = str(
                validation.get("command", "")
            )[:300]

            result = str(
                validation.get("result", "")
            ).replace("\n", " ")[:350]

            sections.append(
                f"Last validation: {command} -> {result}"
            )

        if state.get("handoff_note"):
            sections.append(
                "Handoff note: "
                + str(state["handoff_note"])[:500]
            )

        if state.get("last_answer"):
            sections.append(
                "Previous result: "
                + str(state["last_answer"])
                    .replace("\n", " ")[:500]
            )

        return "\n".join(sections)[:1600]

    lines = [
        "# LAI Workspace Handoff",
        "",
        f"Repository: {state.get('root', ROOT)}",
        f"Branch: {state.get('git_branch') or '[unknown]'}",
        f"Updated: {state.get('updated_at') or '[unknown]'}",
        f"Last mode: {state.get('last_mode') or '[none]'}",
        "",
        "## Last task",
        state.get("last_task") or "[none]",
        "",
        "## Recent relevant files",
    ]

    if recent:
        lines.extend(f"- {item}" for item in recent[-12:])
    else:
        lines.append("- [none]")

    lines.extend([
        "",
        "## Recently modified files",
    ])

    if modified:
        lines.extend(
            f"- {item}"
            for item in modified[-12:]
        )
    else:
        lines.append("- [none]")

    lines.extend([
        "",
        "## Last validation",
    ])

    if validation:
        lines.append(
            f"Command: {validation.get('command', '[unknown]')}"
        )
        lines.append(
            "Result: "
            + str(
                validation.get("result", "[unknown]")
            )[:800]
        )
    else:
        lines.append("[none]")

    lines.extend([
        "",
        "## Git status",
        "```text",
        git_status,
        "```",
    ])

    if state.get("handoff_note"):
        lines.extend([
            "",
            "## Handoff note",
            str(state["handoff_note"])[:1500],
        ])

    if state.get("last_answer"):
        lines.extend([
            "",
            "## Last result",
            str(state["last_answer"])[:1800],
        ])

    lines.extend([
        "",
        "## Rule",
        "Current repository evidence and the current user request "
        "override this handoff if anything here is stale.",
    ])

    return "\n".join(lines)[:7000]


def save_workspace_state(state):
    time = __import__("time")

    STATE_BASE.mkdir(
        parents=True,
        exist_ok=True,
    )

    cleanup_stale_workspace_states()

    json_path, md_path = workspace_state_paths()

    state["root"] = str(ROOT)
    state["updated_at"] = time.strftime(
        "%Y-%m-%dT%H:%M:%SZ",
        time.gmtime(),
    )
    state["git_status"] = workspace_git_status()
    state["git_branch"] = workspace_git_branch()

    state["recent_files"] = normalize_workspace_state_paths(
        state.get("recent_files")
    )

    state["modified_files"] = normalize_workspace_state_paths(
        state.get("modified_files")
    )

    json_text = json.dumps(
        state,
        ensure_ascii=False,
        indent=2,
    ) + "\n"

    markdown = (
        render_workspace_handoff(state)
        + "\n"
    )

    json_path.write_text(json_text)
    md_path.write_text(markdown)

    current_json = (
        STATE_BASE.parent
        / "current-context.json"
    )

    current_md = (
        STATE_BASE.parent
        / "current-context.md"
    )

    current_json.write_text(json_text)
    current_md.write_text(markdown)

    return md_path


def clear_workspace_state():
    json_path, md_path = workspace_state_paths()

    for path in (json_path, md_path):
        try:
            path.unlink()
        except FileNotFoundError:
            pass

    current_json = (
        STATE_BASE.parent
        / "current-context.json"
    )

    current_md = (
        STATE_BASE.parent
        / "current-context.md"
    )

    remove_current = False

    try:
        data = json.loads(
            current_json.read_text(
                errors="replace"
            )
        )
        remove_current = (
            data.get("root") == str(ROOT)
        )
    except Exception:
        pass

    if remove_current:
        for path in (
            current_json,
            current_md,
        ):
            try:
                path.unlink()
            except FileNotFoundError:
                pass


def record_workspace_tool(
    state,
    name,
    args,
    result,
    is_validation=False,
):
    path = args.get("path")

    if (
        path
        and path not in {".", "./"}
        and name in {
            "read",
            "search",
            "list",
            "edit",
            "create",
            "git",
        }
    ):
        state.setdefault(
            "recent_files",
            [],
        ).append(str(path))

    if (
        name in {"edit", "create"}
        and result.startswith("OK:")
        and path
    ):
        state.setdefault(
            "modified_files",
            [],
        ).append(str(path))

    if name == "inspect":
