    return control_browser_base() / "profiles" / checked


def _control_browser_validate_fixture_url(url):
    if not isinstance(url, str) or not url.strip():
        raise ValueError("url must be a non-empty fixture:// URL")
    if len(url.encode("utf-8", errors="replace")) > 2048:
        raise ValueError("url is too large")
    try:
        parsed = urllib.parse.urlsplit(url.strip())
    except ValueError as exc:
        raise ValueError("invalid fixture URL") from exc
    if parsed.scheme != "fixture":
        raise ValueError("browser fixture adapter accepts fixture:// URLs only")
    host = (parsed.hostname or "").lower()
    if not re.fullmatch(r"[a-z0-9][a-z0-9.-]{0,80}", host):
        raise ValueError("fixture host is invalid")
    if host in {"control", "model", "metadata", "localhost", "127.0.0.1"}:
        raise ControlBrowserConflict("browser fixture destination is forbidden")
    path = parsed.path or "/"
    if ".." in PurePosixPath(path).parts:
        raise ValueError("fixture path traversal is invalid")
    return urllib.parse.urlunsplit(("fixture", host, path, parsed.query, ""))


def _control_browser_validate_html(value):
    if not isinstance(value, str):
        raise ValueError("html must be a string")
    if len(value.encode("utf-8", errors="replace")) > CONTROL_BROWSER_MAX_HTML_BYTES:
        raise ValueError("html exceeds browser fixture limit")
    return value


def _control_browser_dom_sha256(html_text):
    return hashlib.sha256(str(html_text).encode("utf-8", errors="replace")).hexdigest()


def _control_browser_redact_text(text):
    patterns = [
        r"(?i)(api[_ -]?key|token|secret|password|control[_ -]?token)\s*[:=]\s*[^\s<]+",
        r"(?i)(authorization\s*:\s*bearer)\s+[^\s<]+",
    ]
    redacted = str(text)
    for pattern in patterns:
        redacted = re.sub(pattern, r"\1=[redacted]", redacted)
    return redacted


def _control_browser_visible_text(html_text, *, limit=CONTROL_BROWSER_MAX_TEXT_CHARS):
    text = re.sub(r"(?is)<(script|style|noscript|svg)\b.*?</\1>", " ", html_text)
    text = re.sub(r"(?is)<[^>]+>", " ", text)
    text = html.unescape(text)
    text = _control_browser_redact_text(text)
    lines = [" ".join(line.split()) for line in text.splitlines()]
    collapsed = "\n".join(line for line in lines if line)
    if len(collapsed) > limit:
        return collapsed[: max(0, limit - 1)] + "…", True
    return collapsed, False


def _control_browser_load_session(session_id):
    path = _control_browser_session_path(session_id)
    try:
        record = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise KeyError(session_id) from None
    except json.JSONDecodeError as exc:
        raise ControlBrowserConflict("browser session state is invalid") from exc
    if not isinstance(record, dict):
        raise ControlBrowserConflict("browser session state is invalid")
    if record.get("schema_version") != CONTROL_BROWSER_SCHEMA_VERSION:
        raise ControlBrowserConflict("browser session schema version is unsupported")
    if record.get("browser_session_id") != session_id:
        raise ControlBrowserConflict("browser session identity mismatch")
    return record


def _control_browser_store_session(record):
    _control_private_json_write(_control_browser_session_path(record["browser_session_id"]), record)


def _control_browser_active(record):
    if record.get("status") != "active":
        raise ControlBrowserConflict("browser session is not active")
    if time.time() > float(record.get("expires_at_epoch") or 0):
        record["status"] = "expired"
        _control_browser_store_session(record)
        raise ControlBrowserConflict("browser session expired")
    return record


def _control_browser_public_session(record):
    return {
        "schema_version": CONTROL_BROWSER_SCHEMA_VERSION,
        "browser_session_id": record.get("browser_session_id"),
        "status": record.get("status"),
        "adapter": record.get("adapter"),
        "current_url": record.get("current_url"),
        "origin": record.get("origin"),
        "dom_sha256": record.get("dom_sha256"),
        "created_at": record.get("created_at"),
        "expires_at": record.get("expires_at"),
        "ephemeral_profile": True,
        "profile_path_exposed": False,
        "personal_profile": False,
        "authenticated_browser": False,
        "secret_material_printed": False,
    }


def _control_browser_prune():
    for subdir in ("sessions", "downloads"):
        base = control_browser_base() / subdir
        if not base.is_dir():
            continue
        files = sorted((item for item in base.rglob("*.json") if item.is_file()), key=lambda item: item.stat().st_mtime)
        for victim in files[:-CONTROL_BROWSER_RETAIN_LIMIT]:
            try:
                victim.unlink()
            except OSError:
                pass


