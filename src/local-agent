def write_text_file(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(content, encoding="utf-8")
    tmp.replace(path)


def write_run_history_export(selector, out_dir=None):
    run = resolve_run_history_record(selector)
    safe_run_id = sanitize_export_filename(run["run_id"])
    base = Path(out_dir).expanduser() if out_dir else (DATA_BASE / "exports")
    if not base.is_absolute():
        base = (ROOT / base).resolve()
    else:
        base = base.resolve()
    export_dir = base / ("lai-run-" + safe_run_id)
    export_dir.mkdir(parents=True, exist_ok=True)

    public_record = run_history_public_record(run)
    events = [
        sanitize_run_history_export_event(event)
        for event in run_history_sorted_events(run)
    ]

    files = {
        "summary.json": json.dumps(
            {
                "product": PRODUCT_NAME,
                "version": VERSION,
                "repository": str(ROOT),
                "selector": str(selector),
                "run_id": run["run_id"],
                "sanitized": True,
                "event_count": len(events),
                "run": public_record,
                "files": ["summary.json", "timeline.jsonl", "report.md"],
            },
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
        ) + "\n",
        "timeline.jsonl": "".join(
            json.dumps(event, ensure_ascii=False, sort_keys=True) + "\n"
            for event in events
        ),
        "report.md": render_run_history_export_report(run, public_record, events),
    }

    for name, content in files.items():
        write_text_file(export_dir / name, content)

    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "repository": str(ROOT),
        "selector": str(selector),
        "run_id": run["run_id"],
        "export_dir": str(export_dir),
        "sanitized": True,
        "event_count": len(events),
        "files": sorted(files),
    }


def parse_run_history_out_dir(args):
    if "--out" not in args:
        return None
    index = args.index("--out")
    try:
        value = args[index + 1]
    except Exception:
        raise SystemExit("Missing value for --out")
    del args[index:index + 2]
    return value


