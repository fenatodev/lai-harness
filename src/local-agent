        return MODEL_EVALUATION_SOURCE_FIXTURE_FILE
    return model_evaluation_result_dir() / "fixtures-v1.json"


def load_model_evaluation_fixtures():
    try:
        payload = json.loads(model_evaluation_fixture_file().read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError(f"invalid model evaluation fixture file: {exc}") from exc
    if payload.get("schema_version") != 1 or not isinstance(payload.get("fixtures"), list):
        raise ValueError("unsupported model evaluation fixture schema")
    fixtures = payload["fixtures"]
    ids = [item.get("id") for item in fixtures if isinstance(item, dict)]
    if len(ids) != len(fixtures) or len(set(ids)) != len(ids):
        raise ValueError("model evaluation fixture ids must be unique strings")
    return payload


def model_evaluation_safe_result_path(raw):
    result_base = model_evaluation_result_dir().resolve()
    if raw == "latest":
        candidates = sorted(
            result_base.glob("*.jsonl"),
            key=lambda item: item.stat().st_mtime,
            reverse=True,
        ) if result_base.is_dir() else []
        if not candidates:
            raise ValueError("no model evaluation results found")
        return candidates[0]

    supplied = Path(raw).expanduser()
    candidates = [supplied] if supplied.is_absolute() else [ROOT / supplied, result_base / supplied]
    for candidate in candidates:
        resolved = candidate.resolve()
        if not resolved.is_file():
            continue
        try:
            resolved.relative_to(ROOT.resolve())
            return resolved
        except ValueError:
            pass
        try:
            resolved.relative_to(result_base)
            return resolved
        except ValueError:
            continue
    raise ValueError("model evaluation result path is outside repository and LAI model-eval data")


def model_evaluation_server_profile():
    host = gateway()
    req = urllib.request.Request(
        f"http://{host}:{LLAMA_PORT}/props",
        headers={"Authorization": f"Bearer {llama_api_key()}"},
    )
    try:
        with urllib.request.urlopen(req, timeout=5) as response:
            props = json.loads(response.read().decode("utf-8", errors="replace"))
    except (OSError, urllib.error.URLError, json.JSONDecodeError) as exc:
        raise ValueError(f"unable to read authenticated model server props: {exc}") from exc
    default_settings = props.get("default_generation_settings") or {}
    return {
        "host": str(host),
        "port": int(LLAMA_PORT),
        "model_alias": str(props.get("model_alias") or MODEL),
        "model_ftype": str(props.get("model_ftype") or ""),
        "context_size": int(default_settings.get("n_ctx") or default_settings.get("n_ctx_train") or 0),
        "total_slots": int(props.get("total_slots") or 0),
    }


