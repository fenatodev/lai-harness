def load_configuration(argv, environ=None, home=None):
    environ = dict(os.environ if environ is None else environ)
    home = Path.home() if home is None else Path(home)
    remaining = list(argv)
    cli = {}

    while remaining and remaining[0] in CONFIG_OPTIONS:
        option = remaining.pop(0)
        if not remaining:
            raise SystemExit(f"Missing value for {option}")
        cli[CONFIG_OPTIONS[option]] = remaining.pop(0)

    default_config_dir = Path(
        environ.get(
            "LAI_CONFIG_DIR",
            Path(environ.get("XDG_CONFIG_HOME", home / ".config")) / "lai",
        )
    ).expanduser()
    config_dir = Path(cli.get("config_dir", default_config_dir)).expanduser()
    config_file = Path(
        cli.get(
            "config_file",
            environ.get("LAI_CONFIG_FILE", config_dir / "config.toml"),
        )
    ).expanduser()

    file_values = {}
    if config_file.is_file():
        try:
            document = tomllib.loads(config_file.read_text(encoding="utf-8"))
            file_values = document.get("lai", {})
            if not isinstance(file_values, dict):
                raise ValueError("[lai] must be a TOML table")
        except (OSError, tomllib.TOMLDecodeError, ValueError) as exc:
            raise SystemExit(f"Invalid LAI config {config_file}: {exc}") from exc

    default_data_dir = Path(
        environ.get(
            "XDG_DATA_HOME",
            home / ".local" / "share",
        )
    ) / "lai"
    defaults = {
        "host": None,
        "port": 8080,
        "model": DEFAULT_MODEL,
        "config_dir": str(config_dir),
        "config_file": str(config_file),
        "data_dir": str(default_data_dir),
        "api_key_file": str(config_dir / "llama-api-key"),
        "skills_dir": None,
        "state_dir": None,
        "metrics_dir": None,
        "audit_dir": None,
        "llama_server": None,
        "server_launcher": "lai-server-start",
        "chat_template": None,
    }
    env_names = {
        key: "LAI_" + key.upper()
        for key in defaults
    }
    values = {**defaults, **file_values}
    values.update({
        key: environ[name]
        for key, name in env_names.items()
        if name in environ
    })
    values.update(cli)

    try:
        values["port"] = int(values["port"])
        if not 1 <= values["port"] <= 65535:
            raise ValueError
    except (TypeError, ValueError) as exc:
        raise SystemExit("LAI port must be an integer from 1 to 65535") from exc

    data_dir = Path(str(values["data_dir"])).expanduser()
    for key, fallback in {
        "config_dir": config_dir,
        "config_file": config_file,
        "data_dir": data_dir,
        "api_key_file": config_dir / "llama-api-key",
        "skills_dir": data_dir / "skills",
        "state_dir": data_dir / "state",
        "metrics_dir": data_dir / "metrics",
        "audit_dir": data_dir / "audit",
    }.items():
        values[key] = Path(str(values.get(key) or fallback)).expanduser()

    return values, remaining


