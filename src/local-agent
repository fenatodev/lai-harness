def remote_sandbox_image_is_digest_pinned(image):
    return bool(re.fullmatch(r"[A-Za-z0-9./_-]+(?::[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}", str(image or "")))


def remote_validation_sandbox_image():
    value = os.environ.get(REMOTE_VALIDATION_SANDBOX_IMAGE_ENV, "").strip()
    return value or REMOTE_VALIDATION_SANDBOX_IMAGE_DEFAULT


def remote_sandbox_container_python():
    value = os.environ.get(REMOTE_SANDBOX_CONTAINER_PYTHON_ENV, "").strip()
    if not value:
        return REMOTE_SANDBOX_CONTAINER_PYTHON_DEFAULT
    if not re.fullmatch(r"[A-Za-z0-9._-]+", value) or value.startswith("-"):
        return REMOTE_SANDBOX_CONTAINER_PYTHON_DEFAULT
    return value


def remote_sandbox_non_root_user():
    uid = os.getuid() if hasattr(os, "getuid") else 1000
    gid = os.getgid() if hasattr(os, "getgid") else 1000
    if uid == 0:
        return REMOTE_SANDBOX_USER_FALLBACK
    if gid == 0:
        gid = uid
    return f"{uid}:{gid}"


