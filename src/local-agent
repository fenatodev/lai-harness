            except FileNotFoundError:
                pass


def record_workspace_tool(
    state,
    name,
    args,
    result,
    is_validation=False,
):
    path = args.get("path")

    if (
        path
        and path not in {".", "./"}
        and name in {
            "read",
            "search",
            "list",
            "edit",
            "create",
            "git",
        }
    ):
        state.setdefault(
            "recent_files",
            [],
        ).append(str(path))

    if (
        name in {"edit", "create"}
        and result.startswith("OK:")
        and path
    ):
        state.setdefault(
            "modified_files",
            [],
        ).append(str(path))

    if name == "inspect":
        for inspected_path in args.get("paths") or []:
            state.setdefault(
                "recent_files",
                [],
            ).append(
                str(inspected_path)
            )

    if (
        name == "patch"
        and result.startswith("OK:")
    ):
        for change in args.get("changes") or []:
            changed_path = change.get("path")

            if changed_path:
                state.setdefault(
                    "modified_files",
                    [],
                ).append(
                    str(changed_path)
                )

                state.setdefault(
                    "recent_files",
                    [],
                ).append(
                    str(changed_path)
                )

    if name in {"bash", "validate"}:
        command = (
            str(args.get("command", ""))
            if name == "bash"
            else "validate profile=" + str(args.get("profile", ""))
        )[:500]

        state["last_command"] = command

        if is_validation:
            state["last_validation"] = {
                "command": command,
                "result": str(result)[:700],
            }

    if name in {"bash", "validate"} and is_validation:
        command = (
            str(args.get("command", ""))
            if name == "bash"
            else "validate profile=" + str(args.get("profile", ""))
        )[:500]
        record_audit_event({
            "type": "validation",
            "command": command,
            "result": str(result)[:900],
            "current_hashes": (
                hash_repository_paths(
                    state.get(
                        "modified_files"
                    ) or []
                )
            ),
        })

    if name == "git":
        state["last_git_operation"] = (
            str(args.get("operation", ""))[:100]
        )

    save_workspace_state(state)



SAFE_WORKSPACE_BASE_ENV = "LAI_SAFE_WORKSPACE_DIR"
SAFE_WORKSPACE_BRANCH = "test/lai-smoke"
SAFE_WORKSPACE_METADATA = ".lai-safe-workspace.json"


def safe_workspace_base(raw_base=None):
    configured = raw_base or os.environ.get(SAFE_WORKSPACE_BASE_ENV)
    base = Path(configured).expanduser() if configured else Path("/tmp/lai-harness-workspaces")
    base = base.resolve()
    if base == ROOT or ROOT in base.parents:
        raise SystemExit("Safe workspace base must be outside the source repository")
    return base


def slugify_safe_workspace_name(value):
    normalized = unicodedata.normalize("NFKD", str(value or ""))
    ascii_text = normalized.encode("ascii", "ignore").decode("ascii")
    slug = re.sub(r"[^a-zA-Z0-9._-]+", "-", ascii_text).strip("-._").lower()
    return (slug or "smoke")[:80]


def current_git_sha(short=False):
    args = ["rev-parse"]
    if short:
        args.append("--short=12")
    args.append("HEAD")
    return git_command_text(args, default="unknown")


def default_safe_workspace_name():
    return "lai-harness-" + slugify_safe_workspace_name(current_git_sha(short=True))


def ensure_safe_workspace_child(base, target):
    base = base.resolve()
    target = target.resolve(strict=False)
    if target == base or base not in target.parents:
        raise SystemExit("Target must be inside safe workspace base")
    return target


def parse_safe_workspace_options(raw):
    options = {"name": "", "base": None, "force": False, "all": False}
    index = 0
    positional = []
    while index < len(raw):
        token = raw[index]
        if token == "--force":
            options["force"] = True
        elif token == "--all":
            options["all"] = True
        elif token == "--name":
            index += 1
            if index >= len(raw):
                raise SystemExit("--name requires a value")
            options["name"] = raw[index]
        elif token.startswith("--name="):
            options["name"] = token.split("=", 1)[1]
        elif token == "--base":
            index += 1
            if index >= len(raw):
                raise SystemExit("--base requires a value")
            options["base"] = raw[index]
        elif token.startswith("--base="):
            options["base"] = token.split("=", 1)[1]
        elif token.startswith("-"):
            raise SystemExit(f"Unknown workspace option: {token}")
        else:
            positional.append(token)
        index += 1
    if positional and not options["name"]:
        options["name"] = positional[0]
    if len(positional) > 1:
        raise SystemExit("Workspace command accepts at most one positional name/path")
    return options


def copy_tracked_repository_files(target):
    proc = subprocess.run(
        ["git", "ls-files", "-z"],
        cwd=ROOT,
        text=False,
        capture_output=True,
        timeout=20,
        check=True,
    )
    copied = 0
    for raw_path in proc.stdout.split(b"\0"):
        if not raw_path:
            continue
        rel_text = raw_path.decode("utf-8", errors="surrogateescape")
        rel = Path(rel_text)
        if rel.is_absolute() or ".." in rel.parts or ".git" in rel.parts:
            raise SystemExit(f"Unsafe tracked path refused: {rel_text}")
        source = (ROOT / rel).resolve()
        destination = target / rel
        if not str(source).startswith(str(ROOT)):
            raise SystemExit(f"Tracked path escapes repository: {rel_text}")
        destination.parent.mkdir(parents=True, exist_ok=True)
        if source.is_symlink():
            destination.symlink_to(os.readlink(source))
        elif source.is_file():
            shutil.copy2(source, destination)
        else:
            continue
        copied += 1
    return copied


def create_safe_workspace(raw, json_mode=False):
    options = parse_safe_workspace_options(raw)
    base = safe_workspace_base(options["base"])
    name = slugify_safe_workspace_name(options["name"] or default_safe_workspace_name())
    target = ensure_safe_workspace_child(base, base / name)
    source_sha = current_git_sha(short=False)
    source_short_sha = current_git_sha(short=True)
    source_branch = workspace_git_branch()
    source_status = workspace_git_status()
    source_clean = source_status == "[clean]"

    if target.exists():
        if not options["force"]:
            raise SystemExit(
                f"Safe workspace already exists: {target}. Use --force to replace it."
            )
        shutil.rmtree(target)

    base.mkdir(parents=True, exist_ok=True)
    target.mkdir(parents=True)
    copied = copy_tracked_repository_files(target)
    metadata = {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "source_repository": str(ROOT),
        "source_branch": source_branch,
        "source_sha": source_sha,
        "source_clean": source_clean,
        "source_status": source_status,
        "safe_branch": SAFE_WORKSPACE_BRANCH,
        "copied_files": copied,
    }
    (target / SAFE_WORKSPACE_METADATA).write_text(
        json.dumps(metadata, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    subprocess.run(["git", "init", "-q"], cwd=target, check=True, timeout=20)
    subprocess.run(["git", "checkout", "-q", "-b", SAFE_WORKSPACE_BRANCH], cwd=target, check=True, timeout=20)
    subprocess.run(["git", "add", "."], cwd=target, check=True, timeout=20)
    subprocess.run(
        [
            "git",
            "-c", "user.name=lai harness",
            "-c", "user.email=lai@example.invalid",
            "commit", "-q", "-m",
            f"seed safe workspace from {source_short_sha}",
        ],
        cwd=target,
        check=True,
        timeout=20,
    )
    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "status": "created",
        "path": str(target),
        "name": name,
        "base_dir": str(base),
        "branch": SAFE_WORKSPACE_BRANCH,
        "source_repository": str(ROOT),
        "source_branch": source_branch,
        "source_sha": source_sha,
        "source_clean": source_clean,
        "source_status": source_status,
        "copied_files": copied,
        "next_commands": [
            f"cd {target}",
            "lai readiness",
            "lai implement \"faça uma alteração pequena e valide\"",
            "git diff",
        ],
    }


def workspace_git_text(path, args, default="[unavailable]"):
    try:
        proc = subprocess.run(
            ["git", *args],
            cwd=path,
            text=True,
            capture_output=True,
            timeout=5,
        )
    except Exception:
        return default
    if proc.returncode != 0:
        return default
    return proc.stdout.strip() or default


def safe_workspace_entries(base):
    if not base.is_dir():
        return []
    entries = []
    for child in sorted(base.iterdir(), key=lambda item: item.name):
        if not child.is_dir():
            continue
        metadata_path = child / SAFE_WORKSPACE_METADATA
        metadata = {}
        if metadata_path.is_file():
            try:
                metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
            except Exception:
                metadata = {}
        entries.append({
            "name": child.name,
            "path": str(child),
            "branch": workspace_git_text(child, ["branch", "--show-current"]),
            "git_status": workspace_git_text(child, ["status", "--short"], default="[not a git repository]") or "[clean]",
            "source_sha": metadata.get("source_sha", "[unknown]"),
            "version": metadata.get("version", "[unknown]"),
        })
    return entries


def collect_safe_workspace_status(raw=None):
    options = parse_safe_workspace_options(raw or [])
    base = safe_workspace_base(options["base"])
    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "repository": str(ROOT),
        "current_branch": workspace_git_branch(),
        "git_status": workspace_git_status(),
        "base_dir": str(base),
        "workspaces": safe_workspace_entries(base),
    }


def render_safe_workspace_status(raw=None, json_mode=False):
