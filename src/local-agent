def control_create_credential_ref(server, request):
    if not isinstance(request, dict):
        raise ValueError("JSON object required")
    unknown = sorted(set(request) - {
        "adapter", "audience", "operation", "secret", "principal", "ttl_seconds",
    })
    if unknown:
        raise ValueError("unknown fields: " + ", ".join(unknown))
    adapter = request.get("adapter", "fake")
    if adapter != "fake":
        return {
            "schema_version": CONTROL_CREDENTIAL_SCHEMA_VERSION,
            "decision": "DENY",
            "reason": "credential adapter is not enabled in this v1 contract",
            "executed": False,
        }
    audience = request.get("audience")
    operation = request.get("operation")
    secret = request.get("secret")
    principal = request.get("principal", "operator")
    ttl = request.get("ttl_seconds", CONTROL_CREDENTIAL_DEFAULT_TTL_SECONDS)
    if not isinstance(audience, str) or not audience.strip():
        raise ValueError("audience must be a non-empty string")
    if not isinstance(operation, str) or not operation.strip():
        raise ValueError("operation must be a non-empty string")
    if not isinstance(secret, str) or not secret:
        raise ValueError("secret must be a non-empty string")
    if not isinstance(principal, str) or not principal.strip():
        raise ValueError("principal must be a non-empty string")
    if not isinstance(ttl, int) or not 1 <= ttl <= CONTROL_CREDENTIAL_MAX_TTL_SECONDS:
        raise ValueError("ttl_seconds is out of range")
    now = time.time()
    secret_ref = "sr-" + secrets.token_hex(8)
    record = {
        "schema_version": CONTROL_CREDENTIAL_SCHEMA_VERSION,
        "secret_ref": secret_ref,
        "status": "active",
        "adapter": adapter,
        "audience": audience.strip(),
        "operation": operation.strip(),
        "principal": principal.strip(),
        "created_at": _control_authority_timestamp(now),
        "expires_at": _control_authority_timestamp(now + ttl),
        "expires_at_epoch": now + ttl,
        "revoked_at": None,
        "secret": secret,
        "secret_sha256": hashlib.sha256(secret.encode("utf-8")).hexdigest(),
    }
    with server.control_credential_lock:
        _control_private_json_write(_control_credential_path(secret_ref), record)
        _control_credential_prune()
    return _control_credential_public_ref(record)


def control_revoke_credential_ref(server, secret_ref):
    secret_ref = _control_credential_validate_ref(secret_ref)
    with server.control_credential_lock:
        record = _control_credential_load(secret_ref)
        if not record.get("revoked_at"):
            record["status"] = "revoked"
            record["revoked_at"] = _control_authority_timestamp()
            _control_private_json_write(_control_credential_path(secret_ref), record)
        return _control_credential_public_ref(record)


def control_use_credential_ref(server, request):
    if not isinstance(request, dict):
        raise ValueError("JSON object required")
    unknown = sorted(set(request) - {
        "secret_ref", "adapter", "audience", "operation", "payload", "simulate_timeout_after_send",
    })
    if unknown:
        raise ValueError("unknown fields: " + ", ".join(unknown))
    secret_ref = _control_credential_validate_ref(request.get("secret_ref"))
    adapter = request.get("adapter", "fake")
    audience = request.get("audience")
    operation = request.get("operation")
    payload = request.get("payload", {})
    if adapter != "fake":
        return {
            "schema_version": CONTROL_CREDENTIAL_SCHEMA_VERSION,
            "decision": "DENY",
            "reason": "credential adapter is not enabled in this v1 contract",
            "executed": False,
        }
    if not isinstance(audience, str) or not audience.strip():
        raise ValueError("audience must be a non-empty string")
    if not isinstance(operation, str) or not operation.strip():
        raise ValueError("operation must be a non-empty string")
    if not isinstance(payload, dict):
        raise ValueError("payload must be a JSON object")
    with server.control_credential_lock:
        record = _control_credential_load(secret_ref)
        if record.get("status") != "active":
            raise ControlCredentialConflict("credential reference is not active")
        if record.get("revoked_at"):
            raise ControlCredentialConflict("credential reference is revoked")
        if time.time() > float(record.get("expires_at_epoch") or 0):
            record["status"] = "expired"
            _control_private_json_write(_control_credential_path(secret_ref), record)
            raise ControlCredentialConflict("credential reference expired")
        if record.get("adapter") != adapter:
            raise ControlCredentialConflict("credential adapter mismatch")
        if record.get("audience") != audience.strip():
            raise ControlCredentialConflict("credential audience mismatch")
        if record.get("operation") != operation.strip():
            raise ControlCredentialConflict("credential operation mismatch")
        receipt_id = "rc-" + secrets.token_hex(8)
        outcome = "outcome_unknown" if request.get("simulate_timeout_after_send") else "delivered"
        receipt = {
            "schema_version": CONTROL_CREDENTIAL_SCHEMA_VERSION,
            "receipt_id": receipt_id,
            "secret_ref": secret_ref,
            "adapter": adapter,
            "audience": audience.strip(),
            "operation": operation.strip(),
            "outcome": outcome,
            "created_at": _control_authority_timestamp(),
            "reason_code": (
                "timeout_after_send"
                if outcome == "outcome_unknown"
                else "fake_delivery_recorded"
            ),
            "payload_sha256": _control_authority_sha256(payload),
            "secret_sha256": record.get("secret_sha256"),
            "secret_material_printed": False,
        }
        fake_delivery = {
            "schema_version": CONTROL_CREDENTIAL_SCHEMA_VERSION,
            "receipt_id": receipt_id,
            "audience": audience.strip(),
            "operation": operation.strip(),
            "payload": payload,
            "received_secret": record["secret"],
        }
        _control_private_json_write(_control_fake_outbox_path(receipt_id), fake_delivery)
        _control_private_json_write(_control_credential_receipt_path(receipt_id), receipt)
        _control_credential_prune()
        return _control_credential_public_receipt(receipt)


class ControlExternalActionConflict(RuntimeError):
    pass


