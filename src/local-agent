        return _control_run_public_record_locked(server, record)


def _control_trajectory_clean_metadata(details):
    clean = {}

    for key, value in (details or {}).items():
        if key not in CONTROL_TRAJECTORY_METADATA_KEYS:
            continue

        if value is None or value == "":
            continue

        if isinstance(value, bool):
            clean[key] = value
        elif isinstance(value, int):
            clean[key] = value
        elif isinstance(value, float):
            clean[key] = round(value, 3)
        else:
            clean[key] = " ".join(str(value).split())[:160]

    return clean


def _control_trajectory_append_locked(
    record,
    event_type,
    status,
    *,
    reason_code=None,
    at=None,
    parent_span_id=None,
    **metadata,
):
    sequence = int(record.get("trajectory_next_sequence") or 0) + 1
    record["trajectory_next_sequence"] = sequence

    run_id = str(record.get("control_run_id") or "cr-unknown")
    run_suffix = run_id.removeprefix("cr-") or "unknown"
    stem = f"ct-{run_suffix}-{sequence:06d}"
    payload = {
        "schema_version": CONTROL_TRAJECTORY_SCHEMA_VERSION,
        "sequence": sequence,
        "event_id": stem,
        "action_id": stem + "-action",
        "span_id": stem + "-span",
        "parent_span_id": parent_span_id,
        "control_run_id": run_id,
        "event_type": str(event_type)[:80],
        "status": str(status)[:80],
        "actor": "control-supervisor",
        "at": at or control_run_now(),
        "reason_code": str(reason_code or event_type)[:80],
    }

    clean = _control_trajectory_clean_metadata(metadata)
    if clean:
        payload["metadata"] = clean

    events = list(record.get("trajectory_events") or [])
    events.append(payload)
    record["trajectory_events"] = events[-CONTROL_TRAJECTORY_MAX_EVENTS:]
    record["trajectory_schema_version"] = CONTROL_TRAJECTORY_SCHEMA_VERSION
    return payload


def _control_run_trajectory_locked(record):
    events = []

    for event in record.get("trajectory_events") or []:
        if not isinstance(event, dict):
            continue
        if event.get("schema_version") != CONTROL_TRAJECTORY_SCHEMA_VERSION:
            continue
        clean = {
            "schema_version": CONTROL_TRAJECTORY_SCHEMA_VERSION,
            "sequence": int(event.get("sequence") or 0),
            "event_id": str(event.get("event_id") or "")[:120],
            "action_id": str(event.get("action_id") or "")[:120],
            "span_id": str(event.get("span_id") or "")[:120],
            "parent_span_id": event.get("parent_span_id"),
            "control_run_id": str(event.get("control_run_id") or "")[:120],
            "event_type": str(event.get("event_type") or "unknown")[:80],
            "status": str(event.get("status") or "unknown")[:80],
            "actor": str(event.get("actor") or "control-supervisor")[:80],
            "at": str(event.get("at") or "")[:80],
            "reason_code": str(event.get("reason_code") or "unknown")[:80],
        }
        metadata = _control_trajectory_clean_metadata(event.get("metadata") or {})
        if metadata:
            clean["metadata"] = metadata
        events.append(clean)

    events.sort(key=lambda item: item["sequence"])
    return events[:CONTROL_TRAJECTORY_MAX_EVENTS]


def _control_run_event(name, timestamp, status, **details):
    event = {
        "event": name,
        "status": status,
        "at": timestamp,
    }
    clean_details = {
        key: value
        for key, value in details.items()
        if value is not None and value != ""
    }
    if clean_details:
        event["details"] = clean_details
    return event


def _control_run_events_locked(record):
    events = []

    def add(name, timestamp, status, **details):
        if timestamp:
            events.append(_control_run_event(name, timestamp, status, **details))

    output_truncated = (
        bool(record.get("stdout_truncated"))
        or bool(record.get("stderr_truncated"))
    )
    changed_paths = record.get("workspace_changed_paths") or []

    add("queued", record.get("created_at"), "queued")
    add(
        "started", record.get("started_at"), "running",
        mode=record.get("mode"),
        tool_profile=record.get("tool_profile"),
    )
    add(
        "session_context_loaded", record.get("session_context_loaded_at"), "running",
        context_chars=int(record.get("session_context_chars") or 0),
        turns_used=int(record.get("session_turns_used") or 0),
    )
    if record.get("workspace_path"):
        add(
            "workspace_prepared", record.get("workspace_prepared_at") or record.get("started_at"), "running",
            isolated=True,
            source_branch=record.get("workspace_source_branch"),
            source_clean=record.get("workspace_source_clean"),
        )
    add("process_started", record.get("process_started_at"), "running")
    add(
        "output_captured", record.get("output_captured_at"), "running",
        output_truncated=output_truncated,
    )
    add(
        "workspace_result_collected", record.get("workspace_result_collected_at"), "running",
        changed_path_count=len(changed_paths),
        diff_truncated=bool(record.get("workspace_diff_truncated")),
    )
    add(
        "session_persisted", record.get("session_persisted_at"), record.get("status") or "running",
        persisted=True,
    )
    add(
        "session_persist_failed", record.get("session_persist_failed_at"), "failed",
        persisted=False,
    )
    if record.get("cancel_requested"):
        events.append(_control_run_event(
            "cancel_requested",
            record.get("finished_at") or control_run_now(),
            record.get("status") or "running",
        ))
    add(
        "finished", record.get("finished_at"), record.get("status") or "unknown",
        exit_code=record.get("exit_code"),
        output_truncated=output_truncated,
        session_persisted=record.get("session_persisted"),
    )
    return events[:24]


def control_run_events_payload(server, control_run_id):
    with server.control_run_lock:
        record = server.control_run_records.get(str(control_run_id))
        if record is None:
            return None
        events = _control_run_events_locked(record)
        trajectory = _control_run_trajectory_locked(record)
        return {
            "product": PRODUCT_NAME,
            "version": VERSION,
            "repository": str(ROOT),
            "control_run_id": record["control_run_id"],
            "mode": record["mode"],
            "status": record["status"],
            "terminal": record.get("status") in CONTROL_RUN_TERMINAL_STATES,
            "event_count": len(events),
            "events": events,
            "trajectory_schema_version": CONTROL_TRAJECTORY_SCHEMA_VERSION,
            "trajectory_event_count": len(trajectory),
            "trajectory": trajectory,
        }


def control_run_queue_summary(server):
    if server is None or not hasattr(server, "control_run_lock"):
        return {
            "active": 0,
            "queued": 0,
            "queue_limit": CONTROL_RUN_QUEUE_LIMIT,
        }
    with server.control_run_lock:
        queued = sum(
            1
            for run_id in server.control_run_queue
            if (server.control_run_records.get(run_id) or {}).get("status") == "queued"
        )
        return {
            "active": 1 if server.control_run_active_id else 0,
            "queued": queued,
            "queue_limit": CONTROL_RUN_QUEUE_LIMIT,
        }


def _control_prune_records_locked(server):
    while len(server.control_run_records) > CONTROL_RUN_RETAIN_LIMIT:
        victim = None
        for run_id, record in server.control_run_records.items():
            if (
                record.get("status") in CONTROL_RUN_TERMINAL_STATES
                and record.get("promotion_status") != "in_progress"
            ):
                victim = run_id
                break
        if victim is None:
            break
        victim_record = server.control_run_records.pop(victim, None)
        server.control_run_tasks.pop(victim, None)
        if victim_record is not None:
            remove_control_work_workspace(victim_record.get("workspace_path"))


def control_submit_run(server, request):
    if not isinstance(request, dict):
        raise ValueError("JSON object required")
    unknown = sorted(set(request) - {"mode", "task", "session_id"})
    if unknown:
        raise ValueError("unknown fields: " + ", ".join(unknown))
    mode = request.get("mode")
    task = request.get("task")
    if not isinstance(mode, str) or mode not in CONTROL_RUN_ALLOWED_MODES:
        raise ValueError(
            "mode must be one of: " + ", ".join(CONTROL_RUN_ALLOWED_MODES)
        )
    if mode in CONTROL_RUN_WORK_MODES and not remote_project_sandbox_available():
        raise RuntimeError(
            "remote project sandbox is unavailable; required digest-pinned local image "
            + remote_validation_sandbox_image()
            + " was not pulled automatically and no host fallback is allowed"
        )
    if not isinstance(task, str):
        raise ValueError("task must be a string")
    task = task.strip()
    if not task:
        raise ValueError("task must not be empty")
    if "\x00" in task:
        raise ValueError("task must not contain NUL bytes")
    if len(task) > CONTROL_RUN_TASK_MAX_CHARS:
        raise ValueError(
            f"task must be at most {CONTROL_RUN_TASK_MAX_CHARS} characters"
        )
    session_id = request.get("session_id")
    if session_id is not None:
        session_id = validate_control_session_id(session_id)
        with server.control_session_lock:
            try:
                load_control_session(
                    control_session_base(), session_id, str(ROOT.resolve())
                )
            except (FileNotFoundError, PermissionError) as exc:
                raise KeyError(session_id) from exc
    with server.control_run_condition:
        if server.control_run_shutdown:
            raise RuntimeError("control run worker is shutting down")
        queued = sum(
            1
            for run_id in server.control_run_queue
            if (server.control_run_records.get(run_id) or {}).get("status") == "queued"
        )
        if queued >= CONTROL_RUN_QUEUE_LIMIT:
            raise ControlRunQueueFull("control run queue is full")
        control_run_id = "cr-" + secrets.token_hex(8)
        record = {
            "control_run_id": control_run_id,
            "mode": mode,
            "status": "queued",
            "task_chars": len(task),
            "created_at": control_run_now(),
            "started_at": None,
            "finished_at": None,
            "exit_code": None,
            "stdout": "",
            "stderr": "",
            "stdout_truncated": False,
            "stderr_truncated": False,
            "cancel_requested": False,
            "tool_profile": control_run_tool_profile(mode),
            "session_id": session_id,
            "session_context_chars": 0,
            "session_turns_used": 0,
            "session_context_loaded_at": None,
            "session_persisted": None if session_id is None else False,
            "session_persisted_at": None,
            "session_persist_failed_at": None,
            "workspace_path": None,
            "workspace_prepared_at": None,
            "workspace_result_collected_at": None,
            "workspace_git_status": "",
            "workspace_changed_paths": [],
            "workspace_diff": "",
            "workspace_diff_truncated": False,
            "workspace_source_sha": None,
            "workspace_source_branch": None,
            "workspace_source_clean": None,
            "process_started_at": None,
            "output_captured_at": None,
            "promotion_status": "none",
            "promotion_patch_sha256": None,
            "promotion_branch": None,
            "promotion_path": None,
            "promoted_at": None,
            "promotion_validation": None,
            "trajectory_schema_version": CONTROL_TRAJECTORY_SCHEMA_VERSION,
            "trajectory_next_sequence": 0,
            "trajectory_events": [],
            "sandbox_executor": (
                remote_sandbox_public_contract(ready=True)
                if mode in CONTROL_RUN_WORK_MODES
                else None
            ),
        }
        _control_trajectory_append_locked(
            record,
            "task_accepted",
            "queued",
            at=record["created_at"],
            reason_code="request_accepted",
            mode=mode,
            task_chars=len(task),
            session_attached=session_id is not None,
        )
        _control_trajectory_append_locked(
            record,
            "preflight_completed",
            "queued",
            reason_code="request_validated",
            mode=mode,
            task_chars=len(task),
            tool_profile=record["tool_profile"],
            queue_position=queued + 1,
            session_attached=session_id is not None,
        )
        server.control_run_records[control_run_id] = record
        server.control_run_tasks[control_run_id] = task
        server.control_run_queue.append(control_run_id)
        _control_prune_records_locked(server)
        server.control_run_condition.notify_all()
        return _control_run_public_record_locked(server, record)


def _read_bounded_control_output(handle):
    handle.flush()
    handle.seek(0, os.SEEK_END)
    size = handle.tell()
    start = max(0, size - CONTROL_RUN_OUTPUT_LIMIT_BYTES)
    handle.seek(start)
    data = handle.read(CONTROL_RUN_OUTPUT_LIMIT_BYTES)
    return data.decode("utf-8", errors="replace"), size > CONTROL_RUN_OUTPUT_LIMIT_BYTES


def control_terminate_process(process, force=False):
    if process is None or process.poll() is not None:
        return
    pid = getattr(process, "pid", None)
    if pid and hasattr(os, "killpg"):
        try:
            os.killpg(pid, signal.SIGKILL if force else signal.SIGTERM)
            return
        except OSError:
            pass
    try:
        process.kill() if force else process.terminate()
    except OSError:
        pass


def _bounded_utf8_text(text, limit_bytes):
    raw = str(text or "").encode("utf-8", errors="replace")
    if len(raw) <= limit_bytes:
        return raw.decode("utf-8", errors="replace"), False
    clipped = raw[:limit_bytes]
    return clipped.decode("utf-8", errors="replace") + "\n[diff truncated]", True


def _git_z_paths(path, args):
    proc = subprocess.run(
        ["git", *args],
        cwd=path,
        text=False,
        capture_output=True,
        timeout=15,
        shell=False,
    )
    if proc.returncode != 0:
        raise RuntimeError("git path inventory failed")
    values = []
    for raw in proc.stdout.split(b"\0"):
        if not raw:
            continue
        try:
            rel = raw.decode("utf-8", errors="strict")
        except UnicodeDecodeError as exc:
            raise RuntimeError("workspace path is not valid UTF-8") from exc
        values.append(rel)
    return values


def _safe_control_relpath(root, rel):
    root = Path(root).resolve()
    if not isinstance(rel, str) or not rel or any(ord(ch) < 32 or ord(ch) == 127 for ch in rel):
        raise ValueError("unsafe workspace path")
    value = Path(rel)
    if value.is_absolute() or ".." in value.parts or ".git" in value.parts:
        raise ValueError("unsafe workspace path")
    target = (root / value).resolve(strict=False)
    if target != root and root not in target.parents:
        raise ValueError("workspace path escapes root")
    return rel


def control_workspace_diff_base(path):
    path = Path(path).resolve()
    if not (path / SAFE_WORKSPACE_METADATA).is_file():
        return "HEAD"
    try:
        proc = subprocess.run(
            ["git", "rev-list", "--max-parents=0", "HEAD"],
            cwd=path,
            text=True,
            capture_output=True,
            timeout=10,
            shell=False,
        )
    except Exception:
        return "HEAD"
    if proc.returncode != 0:
        return "HEAD"
    commits = [line.strip() for line in proc.stdout.splitlines() if line.strip()]
    return commits[0] if commits else "HEAD"


def control_workspace_changed_paths(path, *, max_paths=None):
    path = Path(path).resolve()
    base_ref = control_workspace_diff_base(path)
    tracked = _git_z_paths(path, ["diff", "--name-only", "-z", base_ref, "--"])
    untracked = _git_z_paths(path, ["ls-files", "--others", "--exclude-standard", "-z"])
    values = []
    for rel in [*tracked, *untracked]:
        rel = _safe_control_relpath(path, rel)
        if rel not in values:
            values.append(rel)
    if max_paths is not None and len(values) > max_paths:
        raise ValueError("promotion changed-path limit exceeded")
    return values


def control_workspace_patch_bytes(path, *, max_bytes=CONTROL_PROMOTION_PATCH_LIMIT_BYTES):
    path = Path(path).resolve()
    base_ref = control_workspace_diff_base(path)
    changed_paths = control_workspace_changed_paths(path, max_paths=CONTROL_PROMOTION_MAX_PATHS)
    tracked = subprocess.run(
        ["git", "diff", "--binary", "--full-index", "--no-color", base_ref, "--"],
        cwd=path,
        text=False,
        capture_output=True,
        timeout=20,
        shell=False,
    )
    if tracked.returncode != 0:
        raise RuntimeError("workspace patch generation failed")
    chunks = [tracked.stdout] if tracked.stdout else []
    untracked = _git_z_paths(path, ["ls-files", "--others", "--exclude-standard", "-z"])
    for rel in untracked:
        rel = _safe_control_relpath(path, rel)
        target = (path / rel).resolve(strict=False)
        if not target.is_file() or target.is_symlink():
            raise ValueError("promotion only supports regular untracked files")
        diff = subprocess.run(
            ["git", "diff", "--binary", "--full-index", "--no-index", "--no-color", "--", "/dev/null", rel],
            cwd=path,
            text=False,
            capture_output=True,
            timeout=20,
            shell=False,
        )
        if diff.returncode not in {0, 1}:
            raise RuntimeError("untracked patch generation failed")
        if diff.stdout:
            chunks.append(diff.stdout)
    patch = b"\n".join(chunks)
    if len(patch) > max_bytes:
        raise ValueError("promotion patch is too large")
    return patch, changed_paths


def load_control_workspace_metadata(path):
    target = Path(path).resolve() / SAFE_WORKSPACE_METADATA
    try:
        payload = json.loads(target.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError("safe workspace metadata is unavailable") from exc
    if not isinstance(payload, dict):
        raise RuntimeError("safe workspace metadata is invalid")
    return payload


def control_promotion_branch_name(control_run_id):
    value = str(control_run_id or "")
    if not re.fullmatch(r"cr-[0-9a-f]{16}", value):
        raise ValueError("invalid control run id")
    return CONTROL_PROMOTION_BRANCH_PREFIX + value[3:]


def control_promotion_worktree_path(control_run_id):
    repo_key = hashlib.sha256(str(ROOT).encode("utf-8")).hexdigest()[:12]
    target = (Path(DATA_BASE) / "promotions" / repo_key / str(control_run_id)).resolve()
    source_root = Path(ROOT).resolve()
    if target == source_root or source_root in target.parents:
        raise ValueError("promotion worktree must be outside the source checkout")
    return target


def control_workspace_status_text(path):
    try:
        proc = subprocess.run(
            ["git", "status", "--short"],
            cwd=path,
            text=True,
            capture_output=True,
            timeout=10,
            shell=False,
        )
    except Exception:
        return "[unavailable]"
    if proc.returncode != 0:
        return "[unavailable]"
    return proc.stdout.rstrip("\n") or "[clean]"


def collect_control_workspace_result(path):
    path = Path(path).resolve()
    status = control_workspace_status_text(path)
    try:
        base_ref = control_workspace_diff_base(path)
        changed_paths = control_workspace_changed_paths(path)[:50]
    except Exception:
        base_ref = "HEAD"
        changed_paths = []

    chunks = []
    try:
        proc = subprocess.run(
            ["git", "diff", "--no-color", base_ref, "--"],
            cwd=path,
            text=True,
            capture_output=True,
            timeout=15,
            shell=False,
        )
        if proc.returncode == 0 and proc.stdout:
            chunks.append(proc.stdout)
    except Exception:
        pass

    try:
        proc = subprocess.run(
            ["git", "ls-files", "--others", "--exclude-standard", "-z"],
            cwd=path,
            text=False,
            capture_output=True,
            timeout=10,
            shell=False,
        )
        if proc.returncode == 0:
            for raw in proc.stdout.split(b"\0")[:8]:
                if not raw:
                    continue
                rel = raw.decode("utf-8", errors="replace")
                target = (path / rel).resolve(strict=False)
                if path not in target.parents or not target.is_file() or target.is_symlink():
                    continue
                diff = subprocess.run(
                    ["git", "diff", "--no-index", "--no-color", "--", "/dev/null", rel],
                    cwd=path,
                    text=True,
                    capture_output=True,
                    timeout=10,
                    shell=False,
                )
                if diff.stdout:
                    chunks.append(diff.stdout)
    except Exception:
        pass

    diff_text, truncated = _bounded_utf8_text(
        "\n".join(chunks), CONTROL_RUN_DIFF_LIMIT_BYTES
    )
    return {
        "git_status": status,
        "changed_paths": changed_paths[:50],
        "diff": diff_text,
        "diff_truncated": truncated,
    }


def _control_promotion_record_snapshot(server, control_run_id):
    with server.control_run_lock:
        record = server.control_run_records.get(str(control_run_id))
        return dict(record) if record is not None else None


def _control_git_branch_exists(branch):
    proc = subprocess.run(
        ["git", "show-ref", "--verify", "--quiet", f"refs/heads/{branch}"],
        cwd=ROOT,
        text=False,
        capture_output=True,
        timeout=10,
        shell=False,
    )
    return proc.returncode == 0


def _control_promotion_summary(record):
    return {
        "status": record.get("promotion_status", "none"),
        "patch_sha256": record.get("promotion_patch_sha256"),
        "branch": record.get("promotion_branch"),
        "path": record.get("promotion_path"),
        "promoted_at": record.get("promoted_at"),
        "validation": record.get("promotion_validation"),
    }


def control_promotion_proposal(server, control_run_id):
    record = _control_promotion_record_snapshot(server, control_run_id)
    if record is None:
        return None
    if record.get("promotion_status") == "promoted":
        return {
            "control_run_id": control_run_id,
            "status": "promoted",
            "promotable": False,
            "reasons": [],
            "promotion": _control_promotion_summary(record),
        }

    reasons = []
    if record.get("mode") not in CONTROL_RUN_WORK_MODES:
        reasons.append("run_is_not_write_capable")
    if record.get("status") != "succeeded":
        reasons.append("run_did_not_succeed")
    workspace_raw = record.get("workspace_path")
    workspace = None
    metadata = {}
    patch = b""
    changed_paths = []
    if workspace_raw:
        try:
            workspace = ensure_safe_workspace_child(safe_workspace_base(), Path(workspace_raw))
            metadata = load_control_workspace_metadata(workspace)
        except Exception:
            reasons.append("workspace_unavailable")
    else:
        reasons.append("workspace_unavailable")

    source_sha = record.get("workspace_source_sha")
    source_branch = record.get("workspace_source_branch")
    source_clean = record.get("workspace_source_clean") is True
    if metadata:
        metadata_matches = (
            metadata.get("source_repository") == str(ROOT)
            and metadata.get("source_sha") == source_sha
            and metadata.get("source_branch") == source_branch
            and (metadata.get("source_clean") is True) == source_clean
        )
        if not metadata_matches:
            reasons.append("workspace_metadata_changed")
    if not isinstance(source_sha, str) or not re.fullmatch(r"[0-9a-f]{40}", source_sha):
        reasons.append("source_sha_unavailable")
    if not isinstance(source_branch, str) or not source_branch or source_branch.startswith("["):
        reasons.append("source_branch_unavailable")
    if not source_clean:
        reasons.append("source_was_not_clean")

    if workspace is not None and record.get("status") == "succeeded":
        try:
            patch, changed_paths = control_workspace_patch_bytes(workspace)
            if not patch:
                reasons.append("workspace_has_no_changes")
        except ValueError as exc:
            reasons.append(str(exc).replace(" ", "_"))
        except Exception:
            reasons.append("workspace_patch_unavailable")

    current_sha = current_git_sha(short=False)
    current_branch = workspace_git_branch()
    current_status = workspace_git_status()
    if source_sha and current_sha != source_sha:
        reasons.append("source_sha_changed")
    if source_branch and current_branch != source_branch:
        reasons.append("source_branch_changed")
    if current_status != "[clean]":
        reasons.append("source_checkout_not_clean")

    branch = None
    target = None
    try:
        branch = control_promotion_branch_name(control_run_id)
        target = control_promotion_worktree_path(control_run_id)
        if _control_git_branch_exists(branch):
            reasons.append("promotion_branch_exists")
        if target.exists():
            reasons.append("promotion_worktree_exists")
    except Exception:
        reasons.append("promotion_target_invalid")

    if workspace is not None:
        if select_validation_command("full", root=workspace) is None:
            reasons.append("validation_command_unavailable")
        if not remote_validation_sandbox_available():
            reasons.append("validation_sandbox_unavailable")

    patch_sha256 = hashlib.sha256(patch).hexdigest() if patch else None
    unique_reasons = list(dict.fromkeys(reasons))
    return {
        "control_run_id": control_run_id,
        "status": "ready" if not unique_reasons else "blocked",
        "promotable": not unique_reasons,
        "reasons": unique_reasons,
        "attempt_status": record.get("promotion_status", "none"),
        "source": {
            "branch": source_branch,
            "sha": source_sha,
            "clean": source_clean,
        },
        "changed_paths": changed_paths,
        "patch_sha256": patch_sha256,
        "patch_bytes": len(patch),
        "target_branch": branch,
    }


def _run_control_promotion_validation(workspace):
    workspace = Path(workspace).resolve()
    argv = select_validation_command("full", root=workspace)
    if argv is None:
        raise ControlPromotionRejected("promotion validation command is unavailable")
    if not remote_validation_sandbox_available():
        raise ControlPromotionRejected("promotion validation sandbox is unavailable")
    command = remote_validation_docker_argv(argv, workspace=workspace, source_root=ROOT)
    try:
        proc = subprocess.run(
            command,
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=VALIDATION_TIMEOUT_SECONDS,
            shell=False,
        )
    except subprocess.TimeoutExpired as exc:
        raise ControlPromotionRejected("promotion validation timed out") from exc
    stdout, stdout_truncated = _bounded_utf8_text(
        proc.stdout, CONTROL_PROMOTION_VALIDATION_OUTPUT_LIMIT_BYTES
    )
    stderr, stderr_truncated = _bounded_utf8_text(
        proc.stderr, CONTROL_PROMOTION_VALIDATION_OUTPUT_LIMIT_BYTES
    )
    result = {
        "profile": "full",
        "argv": list(argv),
        "exit_code": proc.returncode,
        "stdout": stdout,
        "stderr": stderr,
        "stdout_truncated": stdout_truncated,
        "stderr_truncated": stderr_truncated,
    }
    if proc.returncode != 0:
        raise ControlPromotionRejected("promotion validation failed", detail=result)
    return result


def _cleanup_control_promotion_worktree(branch, target):
    target = Path(target).resolve()
    try:
        subprocess.run(
            ["git", "worktree", "remove", "--force", str(target)],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=30,
            shell=False,
        )
    except Exception:
        pass
    if isinstance(branch, str) and branch.startswith(CONTROL_PROMOTION_BRANCH_PREFIX):
        try:
            subprocess.run(
                ["git", "branch", "-D", branch],
                cwd=ROOT,
                text=True,
                capture_output=True,
                timeout=20,
                shell=False,
            )
        except Exception:
            pass
    if target.is_dir():
        shutil.rmtree(target, ignore_errors=True)


def control_promote_run(server, control_run_id, request):
    if not isinstance(request, dict) or set(request) != {"patch_sha256"}:
        raise ValueError("exactly patch_sha256 is required")
    approved_hash = request.get("patch_sha256")
    if not isinstance(approved_hash, str) or not re.fullmatch(r"[0-9a-f]{64}", approved_hash):
        raise ValueError("patch_sha256 must be 64 lowercase hexadecimal characters")

    with server.control_run_lock:
        record = server.control_run_records.get(str(control_run_id))
        if record is None:
            return None
        if record.get("promotion_status") == "promoted":
            if hmac.compare_digest(str(record.get("promotion_patch_sha256") or ""), approved_hash):
                return _control_promotion_summary(record)
            raise ControlPromotionConflict("run was already promoted with a different patch hash")
        if record.get("promotion_status") == "in_progress":
            raise ControlPromotionConflict("promotion is already in progress")

    proposal = control_promotion_proposal(server, control_run_id)
    if proposal is None:
        return None
    if not proposal.get("promotable"):
        raise ControlPromotionRejected("run is not promotable", detail=proposal)
    if not hmac.compare_digest(str(proposal.get("patch_sha256") or ""), approved_hash):
        raise ControlPromotionConflict("approved patch hash does not match current workspace")

    with server.control_run_lock:
        record = server.control_run_records.get(str(control_run_id))
        if record is None:
            return None
        record["promotion_status"] = "in_progress"

    workspace = ensure_safe_workspace_child(safe_workspace_base(), Path(record["workspace_path"]))
    branch = control_promotion_branch_name(control_run_id)
    target = control_promotion_worktree_path(control_run_id)
    created = False
    try:
        validation = _run_control_promotion_validation(workspace)
        refreshed = control_promotion_proposal(server, control_run_id)
        if refreshed is None or not refreshed.get("promotable"):
            raise ControlPromotionConflict("promotion proposal changed during validation")
        if not hmac.compare_digest(str(refreshed.get("patch_sha256") or ""), approved_hash):
            raise ControlPromotionConflict("workspace patch changed during validation")

        patch, changed_paths = control_workspace_patch_bytes(workspace)
        source_sha = refreshed["source"]["sha"]
        source_branch = refreshed["source"]["branch"]
        target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        try:
            target.parent.chmod(0o700)
        except OSError:
            pass
        if target.exists() or _control_git_branch_exists(branch):
            raise ControlPromotionConflict("promotion target already exists")

        add = subprocess.run(
            ["git", "worktree", "add", "-b", branch, str(target), source_sha],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=30,
            shell=False,
        )
        if add.returncode != 0:
            raise ControlPromotionRejected("could not create promotion worktree")
        created = True

        for check_only in (True, False):
            argv = ["git", "apply"]
            if check_only:
                argv.append("--check")
            argv.extend(["--whitespace=nowarn", "-"])
            applied = subprocess.run(
                argv,
                cwd=target,
                input=patch,
                text=False,
                capture_output=True,
                timeout=30,
                shell=False,
            )
            if applied.returncode != 0:
                raise ControlPromotionRejected(
                    "promotion patch could not be applied" if check_only else "promotion patch apply failed"
                )

        promoted_patch, promoted_paths = control_workspace_patch_bytes(target)
        promoted_hash = hashlib.sha256(promoted_patch).hexdigest()
        if not hmac.compare_digest(promoted_hash, approved_hash) or promoted_paths != changed_paths:
            raise ControlPromotionConflict("promoted worktree does not match approved patch")
        if current_git_sha(short=False) != source_sha:
            raise ControlPromotionConflict("source SHA changed during promotion")
        if workspace_git_branch() != source_branch or workspace_git_status() != "[clean]":
            raise ControlPromotionConflict("source checkout changed during promotion")

        with server.control_run_lock:
            live = server.control_run_records.get(str(control_run_id))
            if live is None:
                raise ControlPromotionConflict("control run record was pruned during promotion")
            live["promotion_status"] = "promoted"
            live["promotion_patch_sha256"] = approved_hash
            live["promotion_branch"] = branch
            live["promotion_path"] = str(target)
            live["promoted_at"] = control_run_now()
            live["promotion_validation"] = validation
            return _control_promotion_summary(live)
    except ControlPromotionRejected as exc:
        if created:
            _cleanup_control_promotion_worktree(branch, target)
        with server.control_run_lock:
            live = server.control_run_records.get(str(control_run_id))
            if live is not None:
                live["promotion_status"] = "validation_failed" if exc.detail else "failed"
                if exc.detail:
                    live["promotion_validation"] = exc.detail
        raise
    except BaseException:
        if created:
            _cleanup_control_promotion_worktree(branch, target)
        with server.control_run_lock:
            live = server.control_run_records.get(str(control_run_id))
            if live is not None and live.get("promotion_status") == "in_progress":
                live["promotion_status"] = "failed"
        raise


def create_control_work_workspace(control_run_id):
    name = "control-" + slugify_safe_workspace_name(control_run_id)
    return create_safe_workspace(["--name", name, "--force"])


def remove_control_work_workspace(path):
    if not path:
        return
    try:
        base = safe_workspace_base()
        target = ensure_safe_workspace_child(base, Path(path))
    except (SystemExit, ValueError, OSError):
        return
    if target.is_dir():
        shutil.rmtree(target, ignore_errors=True)


def _control_run_worker(server):
    while True:
        with server.control_run_condition:
            while not server.control_run_shutdown and not server.control_run_queue:
                server.control_run_condition.wait(timeout=0.5)
            if server.control_run_shutdown:
                return
            control_run_id = server.control_run_queue.pop(0)
            record = server.control_run_records.get(control_run_id)
            if record is None or record.get("status") != "queued":
                server.control_run_tasks.pop(control_run_id, None)
                continue
            task = server.control_run_tasks.pop(control_run_id, None)
            if not task:
                record["status"] = "failed"
                record["finished_at"] = control_run_now()
                record["stderr"] = "control runner task unavailable"
                _control_prune_records_locked(server)
                continue
            record["status"] = "running"
            record["started_at"] = control_run_now()
            mode = record["mode"]
            _control_trajectory_append_locked(
                record,
                "run_started",
                "running",
                at=record["started_at"],
                reason_code="dequeued",
                mode=mode,
                task_chars=int(record.get("task_chars") or 0),
                tool_profile=record.get("tool_profile"),
            )
            server.control_run_active_id = control_run_id

        stdout_handle = tempfile.TemporaryFile(mode="w+b")
        stderr_handle = tempfile.TemporaryFile(mode="w+b")
        process = None
        exit_code = None
        workspace_path = ROOT
        effective_task = task
        session_id = record.get("session_id")
        model_bridge_close = None
        try:
            if session_id:
                with server.control_session_lock:
                    session = load_control_session(
                        control_session_base(), session_id, str(ROOT.resolve())
                    )
                effective_task = render_control_session_task(session, task)
                with server.control_run_condition:
                    record["session_context_chars"] = max(0, len(effective_task) - len(task))
                    record["session_turns_used"] = len(session["turns"])
                    record["session_context_loaded_at"] = control_run_now()
                    _control_trajectory_append_locked(
                        record,
                        "session_context_loaded",
                        "running",
                        at=record["session_context_loaded_at"],
                        reason_code="session_context_loaded",
                        session_context_chars=int(record.get("session_context_chars") or 0),
                        session_turns_used=int(record.get("session_turns_used") or 0),
                    )
            if mode in CONTROL_RUN_WORK_MODES:
                workspace = create_control_work_workspace(control_run_id)
                workspace_path = Path(workspace["path"]).resolve()
                with server.control_run_condition:
                    record["workspace_path"] = str(workspace_path)
                    record["workspace_prepared_at"] = control_run_now()
                    record["workspace_source_sha"] = workspace.get("source_sha")
                    record["workspace_source_branch"] = workspace.get("source_branch")
                    record["workspace_source_clean"] = workspace.get("source_clean")
                    _control_trajectory_append_locked(
                        record,
                        "workspace_prepared",
                        "running",
                        at=record["workspace_prepared_at"],
                        reason_code="workspace_created",
                        source_clean=record.get("workspace_source_clean"),
                    )
            child_env = control_run_child_env(source_root=ROOT)
            child_command = control_run_command(mode, effective_task)
            if mode in CONTROL_RUN_WORK_MODES:
                model_bridge_host = child_env.get("LAI_HOST") or gateway()
                try:
                    model_bridge_port = int(child_env.get("LAI_PORT") or LLAMA_PORT)
                except (TypeError, ValueError):
                    model_bridge_port = LLAMA_PORT
                model_bridge_close = start_control_model_bridge(
                    workspace_path / ".lai-model-bridge.sock",
                    model_bridge_host,
                    port=model_bridge_port,
                    api_key_file=child_env.get("LAI_API_KEY_FILE"),
                )
                child_env[CONTROL_MODEL_BRIDGE_SOCKET_ENV] = str(workspace_path / ".lai-model-bridge.sock")
                child_command = remote_control_run_command(mode, effective_task)
                child_env[SANDBOX_EXEC_VERIFIED_ENV] = "1"
                child_command = remote_project_sandbox_docker_argv(
                    child_command,
                    workspace=workspace_path,
                    source_root=ROOT,
                    model_bridge_socket=CONTROL_MODEL_BRIDGE_CONTAINER_SOCKET,
                )
                with server.control_run_condition:
                    record["sandbox_executor"] = remote_sandbox_public_contract(ready=True)
                    _control_trajectory_append_locked(
                        record,
                        "sandbox_executor_verified",
                        "running",
                        reason_code="sandbox_verified",
                        sandbox_backend=REMOTE_SANDBOX_BACKEND,
                        sandbox_ready=True,
                        sandbox_image_pinned=True,
                    )
            process = subprocess.Popen(
                child_command,
                cwd=str(workspace_path),
                env=child_env,
                stdin=subprocess.DEVNULL,
                stdout=stdout_handle,
                stderr=stderr_handle,
                shell=False,
                start_new_session=True,
            )
            with server.control_run_lock:
                record["process_started_at"] = control_run_now()
                _control_trajectory_append_locked(
                    record,
                    "process_started",
                    "running",
                    at=record["process_started_at"],
                    reason_code="child_spawned",
                    mode=mode,
                    tool_profile=record.get("tool_profile"),
                )
                if server.control_run_active_id == control_run_id:
                    server.control_run_process = process

            terminate_at = None
            while True:
                exit_code = process.poll()
                if exit_code is not None:
                    break
                with server.control_run_lock:
                    cancel_requested = bool(record.get("cancel_requested")) or bool(
                        server.control_run_shutdown
                    )
                if cancel_requested:
                    if terminate_at is None:
                        control_terminate_process(process, force=False)
                        terminate_at = time.monotonic()
                    elif time.monotonic() - terminate_at >= CONTROL_RUN_CANCEL_GRACE_SECONDS:
                        control_terminate_process(process, force=True)
                time.sleep(CONTROL_RUN_POLL_SECONDS)
            exit_code = process.wait()
            stdout_text, stdout_truncated = _read_bounded_control_output(stdout_handle)
            stderr_text, stderr_truncated = _read_bounded_control_output(stderr_handle)
            output_captured_at = control_run_now()
            workspace_result = (
                collect_control_workspace_result(workspace_path)
                if mode in CONTROL_RUN_WORK_MODES and workspace_path != ROOT
                else None
            )
            workspace_result_collected_at = control_run_now() if workspace_result is not None else None
            with server.control_run_condition:
                record["exit_code"] = exit_code
                record["output_captured_at"] = output_captured_at
                if workspace_result is not None:
                    record["workspace_git_status"] = workspace_result["git_status"]
                    record["workspace_changed_paths"] = workspace_result["changed_paths"]
                    record["workspace_diff"] = workspace_result["diff"]
                    record["workspace_diff_truncated"] = workspace_result["diff_truncated"]
                    record["workspace_result_collected_at"] = workspace_result_collected_at
                record["stdout"] = stdout_text
                record["stderr"] = stderr_text
                record["stdout_truncated"] = stdout_truncated
                record["stderr_truncated"] = stderr_truncated
                _control_trajectory_append_locked(
                    record,
                    "output_captured",
                    "running",
                    at=output_captured_at,
                    reason_code="child_output_captured",
                    output_truncated=bool(stdout_truncated or stderr_truncated),
                )
                if workspace_result is not None:
                    _control_trajectory_append_locked(
                        record,
                        "workspace_result_collected",
                        "running",
                        at=workspace_result_collected_at,
                        reason_code="workspace_result_collected",
                        changed_path_count=len(record.get("workspace_changed_paths") or []),
                        diff_truncated=bool(record.get("workspace_diff_truncated")),
                    )
                record["finished_at"] = control_run_now()
                if record.get("cancel_requested") or server.control_run_shutdown:
                    terminal_status = "cancelled"
                elif exit_code == 0:
                    terminal_status = "succeeded"
                else:
                    terminal_status = "failed"
            if session_id:
                try:
                    assistant_text = stdout_text if stdout_text.strip() else stderr_text
                    with server.control_session_lock:
                        append_control_session_turn(
                            control_session_base(),
                            session_id,
                            repository=str(ROOT.resolve()),
                            control_run_id=control_run_id,
                            mode=mode,
                            status=terminal_status,
                            task=task,
                            assistant=assistant_text,
                            created_at=str(record.get("created_at") or ""),
                            finished_at=str(record.get("finished_at") or control_run_now()),
                        )
                    with server.control_run_condition:
                        record["session_persisted"] = True
                        record["session_persisted_at"] = control_run_now()
                        _control_trajectory_append_locked(
                            record,
                            "session_persisted",
                            terminal_status,
                            at=record["session_persisted_at"],
                            reason_code="session_turn_persisted",
                            session_persisted=True,
                        )
                except Exception as exc:
                    terminal_status = "failed"
                    with server.control_run_condition:
                        record["session_persisted"] = False
                        record["session_persist_failed_at"] = control_run_now()
                        _control_trajectory_append_locked(
                            record,
                            "session_persist_failed",
                            "failed",
                            at=record["session_persist_failed_at"],
                            reason_code="session_persist_failed",
                            session_persisted=False,
                        )
                        detail = "control session persistence failed: " + type(exc).__name__ + ": " + str(exc)
                        record["stderr"] = ((record.get("stderr") or "") + "\n" + detail).strip()[-2000:]
            with server.control_run_condition:
                record["status"] = terminal_status
                _control_trajectory_append_locked(
                    record,
                    "run_finished",
                    terminal_status,
                    at=record.get("finished_at"),
                    reason_code=(
                        "cancel_requested"
                        if terminal_status == "cancelled"
                        else "exit_code_0"
                        if exit_code == 0
                        else "exit_code_nonzero"
                    ),
                    exit_code=exit_code,
                    output_truncated=bool(record.get("stdout_truncated") or record.get("stderr_truncated")),
                    session_persisted=record.get("session_persisted"),
                )
        except BaseException as exc:
            with server.control_run_condition:
                record["exit_code"] = exit_code
                record["finished_at"] = control_run_now()
                record["status"] = (
                    "cancelled" if record.get("cancel_requested") else "failed"
                )
                _control_trajectory_append_locked(
                    record,
                    "run_finished",
                    record["status"],
                    at=record["finished_at"],
                    reason_code=(
                        "cancel_requested"
                        if record["status"] == "cancelled"
                        else "control_runner_failed"
                    ),
                    exit_code=exit_code,
                )
                record["stderr"] = (
                    "control runner failed: " + type(exc).__name__ + ": " + str(exc)
                )[:2000]
        finally:
            if model_bridge_close is not None:
                model_bridge_close()
            stdout_handle.close()
            stderr_handle.close()
            with server.control_run_condition:
                if server.control_run_active_id == control_run_id:
                    server.control_run_active_id = None
                    server.control_run_process = None
                _control_prune_records_locked(server)
                server.control_run_condition.notify_all()


def initialize_control_runs(server):
    server.control_session_lock = threading.RLock()
    server.control_authority_lock = threading.RLock()
    server.control_credential_lock = threading.RLock()
    server.control_external_action_lock = threading.RLock()
    server.control_delegate_lock = threading.RLock()
    server.control_mcp_execution_lock = threading.RLock()
    server.control_browser_lock = threading.RLock()
    server.control_experiment_lock = threading.RLock()
    server.control_run_lock = threading.RLock()
    server.control_run_condition = threading.Condition(server.control_run_lock)
    server.control_run_queue = []
    server.control_run_records = {}
    server.control_run_tasks = {}
    server.control_run_active_id = None
    server.control_run_process = None
    server.control_run_shutdown = False
    server.control_run_worker = threading.Thread(
        target=_control_run_worker,
        args=(server,),
        name="lai-control-runs",
        daemon=True,
    )
    server.control_run_worker.start()


def shutdown_control_runs(server):
    condition = getattr(server, "control_run_condition", None)
    if condition is None:
        return
    process = None
    worker = None
    with condition:
        if server.control_run_shutdown:
            worker = getattr(server, "control_run_worker", None)
            process = getattr(server, "control_run_process", None)
        else:
            server.control_run_shutdown = True
            now = control_run_now()
            for run_id in list(server.control_run_queue):
                record = server.control_run_records.get(run_id)
                if record is not None and record.get("status") == "queued":
                    record["status"] = "cancelled"
                    record["cancel_requested"] = True
                    record["finished_at"] = now
                    _control_trajectory_append_locked(
                        record,
                        "cancel_requested",
                        "cancelled",
                        at=now,
                        reason_code="shutdown_requested",
                    )
                    _control_trajectory_append_locked(
                        record,
                        "run_finished",
                        "cancelled",
                        at=now,
                        reason_code="shutdown_cancelled_queued_run",
                    )
            server.control_run_queue.clear()
            server.control_run_tasks.clear()
            active_id = server.control_run_active_id
            if active_id:
                active = server.control_run_records.get(active_id)
                if active is not None:
                    active["cancel_requested"] = True
                    _control_trajectory_append_locked(
                        active,
                        "cancel_requested",
                        active.get("status") or "running",
                        reason_code="shutdown_requested",
                    )
            process = server.control_run_process
            worker = server.control_run_worker
            condition.notify_all()
    if process is not None and process.poll() is None:
        control_terminate_process(process, force=False)
    if worker is not None and worker is not threading.current_thread():
        worker.join(timeout=CONTROL_RUN_CANCEL_GRACE_SECONDS + 1.0)
    if process is not None and process.poll() is None:
        control_terminate_process(process, force=True)
        try:
            process.wait(timeout=1)
        except Exception:
            pass


def control_cancel_run(server, control_run_id):
    with server.control_run_condition:
        record = server.control_run_records.get(str(control_run_id))
        if record is None:
            raise KeyError(control_run_id)
        status = record.get("status")
        if status in CONTROL_RUN_TERMINAL_STATES:
            raise ValueError("control run is already terminal")
        record["cancel_requested"] = True
        _control_trajectory_append_locked(
            record,
            "cancel_requested",
            status or "running",
            reason_code="cancel_requested",
        )
        if status == "queued":
            record["status"] = "cancelled"
            record["finished_at"] = control_run_now()
            _control_trajectory_append_locked(
                record,
                "run_finished",
                "cancelled",
                at=record["finished_at"],
                reason_code="queued_cancelled",
            )
            server.control_run_tasks.pop(record["control_run_id"], None)
            server.control_run_queue = [
                run_id
                for run_id in server.control_run_queue
                if run_id != record["control_run_id"]
            ]
            _control_prune_records_locked(server)
            server.control_run_condition.notify_all()
            return 200, _control_run_public_record_locked(server, record)
        process = (
            server.control_run_process
            if server.control_run_active_id == record["control_run_id"]
            else None
        )
        if process is not None and process.poll() is None:
            control_terminate_process(process, force=False)
        server.control_run_condition.notify_all()
        return 202, _control_run_public_record_locked(server, record)


class LaiControlHTTPServer(ThreadingHTTPServer):
    daemon_threads = True

    def server_close(self):
        shutdown_control_runs(self)
        super().server_close()


class LaiControlRequestHandler(BaseHTTPRequestHandler):
    server_version = "lai-control"
    sys_version = ""

    def setup(self):
        super().setup()
        self.connection.settimeout(10)

    def log_message(self, format, *args):
        return

    def _json(self, status, payload, extra_headers=None):
        body = json.dumps(payload, ensure_ascii=False, sort_keys=True).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Connection", "close")
        for key, value in (extra_headers or {}).items():
            self.send_header(key, value)
        self.end_headers()
        self.wfile.write(body)

    def _authorized(self):
        header = self.headers.get("Authorization", "")
        prefix = "Bearer "
        if not header.startswith(prefix):
            return False
        supplied = header[len(prefix):]
        expected = getattr(self.server, "control_token", "")
        return bool(expected) and hmac.compare_digest(supplied, expected)

    def _require_auth(self):
        if self._authorized():
            return True
        self._json(
            401,
            {"error": {"code": "unauthorized", "message": "valid bearer token required"}},
            {"WWW-Authenticate": "Bearer"},
        )
        return False

    def _local_chat_rejected(self, exc):
        self._json(exc.status, _control_local_chat_error(exc))

    def _require_local_chat_headers(self, *, require_csrf=False):
        try:
            control_local_chat_validate_request_headers(
                self.headers, self.server, require_csrf=require_csrf
            )
            return True
        except ControlLocalChatRejected as exc:
            self._local_chat_rejected(exc)
            return False

    def _read_json_body(self):
        if self.headers.get("Transfer-Encoding"):
            raise ValueError("transfer encoding is not supported")
        media_type = self.headers.get("Content-Type", "").split(";", 1)[0].strip().lower()
        if media_type != "application/json":
            raise TypeError("application/json required")
        raw_length = self.headers.get("Content-Length")
        if raw_length is None:
            raise EOFError("Content-Length required")
        try:
            length = int(raw_length)
        except ValueError as exc:
            raise ValueError("invalid Content-Length") from exc
        if length < 0:
            raise ValueError("invalid Content-Length")
        if length > CONTROL_API_MAX_BODY_BYTES:
            raise OverflowError("request body too large")
        raw = self.rfile.read(length)
        try:
            return json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise ValueError("malformed JSON") from exc

    def do_GET(self):
        if not self._require_auth():
            return
        parsed = urllib.parse.urlsplit(self.path)
        if parsed.path == "/v1/status":
            self._json(200, control_status_payload(self.server))
            return
        if parsed.path == "/v1/gateway-contract":
            self._json(200, control_gateway_contract_payload())
            return
        if parsed.path.startswith("/v1/local-chat/"):
            if not self._require_local_chat_headers():
                return
            query = urllib.parse.parse_qs(parsed.query, keep_blank_values=True)
