def distribution_state_path():
    return Path(DATA_BASE) / "distribution" / "installed-state.json"


def load_distribution_state():
    path = distribution_state_path()
    if not path.exists():
        return None
    if path.is_symlink() or not path.is_file():
        raise SystemExit("distribution state is invalid; data preserved")
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise SystemExit("distribution state is unreadable; data preserved") from exc
    if not isinstance(payload, dict):
        raise SystemExit("distribution state is invalid; data preserved")
    schema_version = payload.get("schema_version")
    if not isinstance(schema_version, int):
        raise SystemExit("distribution state schema missing; data preserved")
    if schema_version > DISTRIBUTION_STATE_SCHEMA_VERSION:
        raise SystemExit("unsupported distribution state schema; data preserved")
    if schema_version < 1:
        raise SystemExit("unsupported distribution state schema; data preserved")
    return payload


def distribution_status_payload():
    state = load_distribution_state()
    installed = state is not None
    rollback = state.get("rollback", {}) if isinstance(state, dict) else {}
    installed_components = state.get("components", []) if isinstance(state, dict) else []
    if not isinstance(installed_components, list):
        installed_components = []
    installed_version = state.get("version") if isinstance(state, dict) else None
    previous_version = state.get("previous_version") if isinstance(state, dict) else None
    return {
        "schema_version": DISTRIBUTION_STATE_SCHEMA_VERSION,
        "product": PRODUCT_NAME,
        "version": VERSION,
        "repository": str(ROOT.resolve()),
        "state": {
