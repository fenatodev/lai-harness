def sandbox_exec_available():
    return (
        os.environ.get(CONTROL_RUN_CHILD_ENV) == "1"
        and os.environ.get(SANDBOX_EXEC_VERIFIED_ENV) == "1"
        and globals().get("ACTIVE_MODE", "unknown") in CONTROL_RUN_WORK_MODES
    )


def sandbox_exec_policy(command, mode=None):
    mode = mode or globals().get("ACTIVE_MODE", "unknown")
    if mode not in CONTROL_RUN_WORK_MODES:
        return {"decision": "DENY", "reason": "sandbox_exec is allowed only in remote work modes"}
    if os.environ.get(CONTROL_RUN_CHILD_ENV) != "1" or os.environ.get(SANDBOX_EXEC_VERIFIED_ENV) != "1":
        return {"decision": "DENY", "reason": "sandbox_exec requires verified sandbox executor context"}
    command = str(command or "").strip()
    if not command:
        return {"decision": "DENY", "reason": "sandbox_exec command must not be empty"}
    if "\x00" in command:
        return {"decision": "DENY", "reason": "sandbox_exec command must not contain NUL bytes"}
    if len(command.encode("utf-8", errors="replace")) > 4000:
        return {"decision": "DENY", "reason": "sandbox_exec command is too large"}
    forbidden_patterns = [
        (r"https?://", "external network or registry access is outside the sandbox grant"),
        (r"\b(?:curl|wget|ssh|scp|rsync|nc|netcat|dig|nslookup|host)\b", "network client use is outside the sandbox grant"),
        (r"(?:^|\s)(?:HTTP_PROXY|HTTPS_PROXY|ALL_PROXY|NO_PROXY|http_proxy|https_proxy|all_proxy|no_proxy)=", "proxy configuration is outside the sandbox egress grant"),
        (r"\b(?:python3?|node|ruby|perl)\b[^\n]*(?:urllib|requests|http\.client|fetch\s*\(|XMLHttpRequest)", "scripted network client use is outside the sandbox grant"),
        (r"/var/run/docker\.sock", "Docker daemon socket is outside the sandbox grant"),
        (r"\bdocker\b", "Docker daemon access is outside the sandbox grant"),
        (r"\bsudo\b|\bsu\b", "privilege escalation is outside the sandbox grant"),
        (r"\b(?:apt|apt-get|dnf|yum|pacman|apk)\b", "system package installation is outside the sandbox grant"),
        (r"\b(?:npm|pnpm|yarn)\s+(?:install|add)\b(?![^\n]*(?:\./|fixtures/|tests/fixtures/|file:))", "registry dependency installation requires governed egress"),
        (r"\bpip3?\s+install\b(?![^\n]*(?:\./|fixtures/|tests/fixtures/))", "registry dependency installation requires governed egress"),
        (r"\bgit\s+(?:push|pull|fetch|clone|remote|submodule)\b", "Git remote operations are outside the sandbox grant"),
        (r"\bgit\s+reset\b[^\n]*--hard\b", "destructive Git reset is outside the sandbox grant"),
        (r"\bgit\s+clean\b", "destructive Git clean is outside the sandbox grant"),
        (r"\.\./", "parent path traversal is outside the sandbox grant"),
        (r"/(?:home|root|etc|var|usr|bin|lib|lib64|proc|sys|run)(?:/|\b)", "host or system path is outside the sandbox grant"),
        (r"\b(?:env|printenv|set)\b[^\n]*(?:SECRET|TOKEN|PASSWORD|API[_-]?KEY)", "secret environment probing is outside the sandbox grant"),
    ]
    for pattern, reason in forbidden_patterns:
        if re.search(pattern, command, re.IGNORECASE):
            return {"decision": "DENY", "reason": reason}
    return {"decision": "ALLOW", "reason": "sandbox command allowed by verified sandbox grant"}


def evaluate_tool_policy(name, args, mode=None):
    mode = mode or globals().get("ACTIVE_MODE", "unknown")
    known_tools = {item["function"]["name"] for item in TOOLS}
    if name not in known_tools:
        return {"decision": "DENY", "reason": f"unknown tool: {name}"}

    read_only_modes = {"selection", "test", "review", "debug", "diagnose", "security", "plan", "release"}
    if name in WRITE_TOOLS and mode in read_only_modes:
        return {
            "decision": "DENY",
            "reason": f"tool {name} is not permitted in read-only mode {mode}",
        }

    if name in WRITE_TOOLS and not protected_branch_write_override_enabled():
        branch = current_policy_git_branch()
        if is_protected_write_branch(branch):
            return {
                "decision": "DENY",
                "reason": (
                    f"tool {name} is not permitted on protected branch {branch}; "
                    f"create a feature/test branch or set {PROTECTED_WRITE_OVERRIDE_ENV}=1"
                ),
            }

    if name == "sandbox_exec":
        return sandbox_exec_policy(args.get("command"), mode=mode)

    if name != "bash":
        return {"decision": "ALLOW", "reason": "builtin tool allowed by policy"}

    command = str(args.get("command", "")).strip()
    for pattern, reason in POLICY_DENY_COMMANDS:
        if re.search(pattern, command, re.IGNORECASE):
            return {"decision": "DENY", "reason": reason}

    git_mutation = git_mutation_in_shell(command)
    if git_mutation:
        return {
            "decision": "ASK",
            "reason": f"git {git_mutation} requires explicit user action",
        }

    for pattern, reason in POLICY_ASK_COMMANDS:
        if re.search(pattern, command, re.IGNORECASE):
            return {"decision": "ASK", "reason": reason}

    return {"decision": "ALLOW", "reason": "shell command allowed by policy"}


POLICY_CHECK_USAGE = (
    "Usage: lai policy-check [--stdin | --tool TOOL [--command COMMAND] "
    "[--args-json JSON]] [--mode MODE] [--json]"
)


def parse_policy_check_args(args):
    options = {
        "stdin": False,
        "tool": None,
        "command": None,
        "args_json": None,
        "mode": None,
        "json": False,
    }
    index = 0
    while index < len(args):
        item = args[index]
        if item == "--stdin":
            options["stdin"] = True
            index += 1
            continue
        if item == "--json":
            options["json"] = True
            index += 1
            continue
        if item in {"--tool", "--command", "--args-json", "--mode"}:
            if index + 1 >= len(args):
                raise SystemExit(POLICY_CHECK_USAGE)
            key = item[2:].replace("-", "_")
            options[key] = args[index + 1]
            index += 2
            continue
        raise SystemExit(POLICY_CHECK_USAGE)
    return options


def policy_check_request(options, stdin_text=None):
    if options["stdin"]:
        if options["tool"] or options["command"] or options["args_json"]:
            raise SystemExit(POLICY_CHECK_USAGE)
        raw = sys.stdin.read() if stdin_text is None else stdin_text
        try:
            request = json.loads(raw)
        except (TypeError, json.JSONDecodeError) as exc:
            raise SystemExit(f"Invalid policy-check stdin JSON: {exc}") from exc
        if not isinstance(request, dict):
            raise SystemExit("Invalid policy-check stdin JSON: object required")
        tool = request.get("tool")
        tool_args = request.get("args", {})
        mode = request.get("mode", options["mode"])
    else:
        tool = options["tool"]
        mode = options["mode"]
        tool_args = {}
        if options["args_json"] is not None:
            try:
                tool_args = json.loads(options["args_json"])
            except json.JSONDecodeError as exc:
                raise SystemExit(f"Invalid --args-json: {exc}") from exc
        if options["command"] is not None:
            if not isinstance(tool_args, dict):
                raise SystemExit("Invalid --args-json: object required")
            tool_args = dict(tool_args)
            tool_args["command"] = options["command"]

    if not isinstance(tool, str) or not tool.strip():
        raise SystemExit(POLICY_CHECK_USAGE)
    if not isinstance(tool_args, dict):
        raise SystemExit("Policy-check args must be a JSON object")
    if mode is not None and not isinstance(mode, str):
        raise SystemExit("Policy-check mode must be a string")
    return tool.strip(), tool_args, mode


def render_policy_check(args, stdin_text=None):
    options = parse_policy_check_args(args)
    tool, tool_args, mode = policy_check_request(options, stdin_text=stdin_text)
    policy = evaluate_tool_policy(tool, tool_args, mode=mode)
    payload = {
        "decision": policy["decision"],
        "reason": policy["reason"],
        "tool": tool,
        "mode": mode or globals().get("ACTIVE_MODE", "unknown"),
        "executed": False,
    }
    if options["json"]:
        return json.dumps(payload, ensure_ascii=False, sort_keys=True)
    return f"{payload['decision']}: {payload['reason']}"


def render_policy_result(policy):
    decision = policy.get("decision", "DENY")
    reason = str(policy.get("reason") or "policy decision has no reason")
    if decision == "ASK":
        return f"POLICY ASK: {reason}. Do not execute automatically."
    if decision == "DENY":
        return f"POLICY DENY: {reason}."
    return None



