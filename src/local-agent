            r"(^|\s)(mvn|mvnw)\s+.*\btest\b",
            r"(^|\s)(gradle|gradlew)\s+.*\b(test|check|build)\b",
            r"(^|\s)(ruff|flake8|mypy|pyright|eslint)(\s|$)",
            r"(^|\s)(tsc|npx\s+tsc)(\s|$)",
            r"(^|\s)python3?\s+-m\s+py_compile(\s|$)",
            r"(^|\s)node\s+--check(\s|$)",
        ]

        return any(re.search(pattern, command) for pattern in patterns)

    def normalize_validation_command(value):
        return " ".join(str(value).strip().strip("`").split())

    def task_explicitly_requests_validation_command(task_text, command):
        patterns = (
            r"(?im)\bvalide\s+(?:apenas|somente)\s+com\s*:\s*([^\r\n]+)",
            r"(?im)\bvalidate\s+only\s+with\s*:\s*([^\r\n]+)",
        )

        actual = normalize_validation_command(command)

        if not actual:
            return False

        for pattern in patterns:
            for match in re.finditer(pattern, task_text):
                requested = normalize_validation_command(
                    match.group(1)
                )

                if requested == actual:
                    return True

        return False

    def command_satisfies_validation(command):
        return (
            looks_like_validation(command)
            or task_explicitly_requests_validation_command(
                task,
                command,
            )
        )

    def progress_phase():
        if (
            mode not in {"fix", "refactor", "implement"}
            or not exploration_guard.write_succeeded
        ):
            return None, None

        required_test_change_pending = (
            mode == "implement"
            and task_explicitly_requires_test_change(task)
            and not any(
                looks_like_test_path(path)
                for path in modified_paths
            )
        )

        if last_validation_failure or patch_sanity_issue:
            return (
                "repair",
                set(WRITE_TOOLS) | {"bash"},
            )

        if needs_validation and required_test_change_pending:
            return (
                "complete_or_validate",
                set(WRITE_TOOLS) | {"bash"},
            )

        if needs_validation:
            return "validate", {"bash"}

        if required_test_change_pending:
            return (
                "complete_required_tests",
                set(WRITE_TOOLS),
            )

        return "finish", set()


    for _ in range(max_rounds_by_mode.get(mode, MAX_ROUNDS)):
        active_tools = mode_tools
        round_max_tokens = mode_max_tokens

        if exploration_guard.exhausted and not exploration_guard.write_succeeded:
            active_tools = [
                tool
                for tool in mode_tools
                if tool["function"]["name"] in WRITE_TOOLS
            ]
            round_max_tokens = max(
                round_max_tokens,
                2048,
            )

        progress_phase_name, progress_allowed_tools = (
            progress_phase()
        )

        if progress_allowed_tools is not None:
            active_tools = [
                tool
                for tool in active_tools
                if (
                    tool["function"]["name"]
                    in progress_allowed_tools
                )
            ]

        truncation_retry_used = False
        call_max_tokens = round_max_tokens

        while True:
            result = api_call(
                host,
                messages,
                tools=active_tools,
                max_tokens=call_max_tokens,
            )

            choice = result["choices"][0]
            finish_reason = choice.get("finish_reason")

            if finish_reason != "length":
                break

            retry_max_tokens = min(
                4096,
                max(
                    call_max_tokens * 2,
                    call_max_tokens + 256,
                ),
            )

            truncation_event = {
                "type": "agent_limit",
                "reason": "response_truncated",
                "max_tokens": call_max_tokens,
                "retry": not truncation_retry_used,
                "retry_max_tokens": (
                    retry_max_tokens
                    if not truncation_retry_used
                    else None
                ),
            }

            record_metric_event(truncation_event)
            record_audit_event(truncation_event)

            if truncation_retry_used:
                print(
                    "Agent stopped: model response truncated twice; "
                    "refusing to continue with incomplete assistant output.",
                    file=__import__("sys").stderr,
                )
                raise SystemExit(2)

            truncation_retry_used = True

            messages.append({
                "role": "user",
                "content": (
                    "RESPONSE TRUNCATED: the previous assistant generation "
                    "hit the token limit and was discarded. Retry now with "
                    "a concise response. If a tool is needed, return exactly "
                    "one complete tool call with minimal arguments. Do not "
                    "repeat analysis."
                ),
            })

            call_max_tokens = retry_max_tokens

        message = choice["message"]
        tool_calls = message.get("tool_calls") or []

        messages.append(message)

        if not tool_calls:
            content = message.get("content", "").strip()

            if (
                mode in {"fix", "refactor", "implement"}
                and exploration_guard.exhausted
                and not exploration_guard.write_succeeded
            ):
                impossibility_prefix = "IMPLEMENTATION_IMPOSSIBLE:"
                impossibility_reason = (
                    content[len(impossibility_prefix):].strip()
                    if content.startswith(impossibility_prefix)
                    else ""
                )

                if impossibility_reason:
                    outcome = {
                        "type": "run_outcome",
                        "outcome": "implementation_impossible",
                    }
                    record_metric_event(outcome)
                    record_audit_event(outcome)
                    workspace_state["last_answer"] = content[:1800]
                    save_workspace_state(workspace_state)
                    print(content)
                    return

                messages.append({
                    "role": "user",
                    "content": (
                        "PHASE-SHIFT RESPONSE REJECTED: no successful write "
                        "was recorded. Use edit/create/patch/rewrite now, or reply with "
                        "the exact prefix IMPLEMENTATION_IMPOSSIBLE: followed "
                        "by the reason. Do not claim implementation success."
                    ),
                })
                continue

            if mode == "debug" and not debug_source_inspected:
                messages.append({
                    "role": "user",
                    "content": (
                        "DEBUG EVIDENCE REQUIRED: runtime output alone "
                        "is insufficient. Inspect the relevant source "
                        "and caller/test files, then trace the exact "
                        "value or control-flow transformation."
                    ),
                })
                continue

            if (
                mode == "implement"
                and patch_sanity_issue
            ):
                messages.append({
                    "role": "user",
                    "content": (
                        "POST-PATCH DEFECT MUST BE FIXED: "
                        + patch_sanity_issue
                        + "\nDo not conclude yet. Fix only this "
                          "concrete defect, then rerun the required "
                          "validation after the corrective patch."
                    ),
                })
                continue

            if mode in {"fix", "refactor", "implement"} and needs_validation:
                messages.append({
                    "role": "user",
                    "content": (
                        "VALIDATION REQUIRED: repository files changed after the last "
                        "successful validation. Do not conclude yet. Run the relevant "
                        "existing test/check now. Only conclude after it exits successfully."
                    ),
                })
                continue

            if (
                mode == "implement"
                and task_explicitly_requires_test_change(task)
                and not any(
                    looks_like_test_path(path)
                    for path in modified_paths
                )
            ):
                messages.append({
                    "role": "user",
                    "content": (
                        "IMPLEMENTATION INCOMPLETE: the user explicitly requested "
                        "adding or updating tests, but no test file has been modified. "
                        "Do not conclude or ask whether to do it. Complete the requested "
                        "test change now, then run the relevant validation again."
                    ),
                })
                continue

            if mode == "plan":
                # A plan draft returned during an exploration round is not
