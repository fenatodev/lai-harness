class ControlApprovalConflict(RuntimeError):
    pass


def _control_authority_canonical_json(payload):
    return json.dumps(
        payload,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    )


def _control_authority_sha256(payload):
    return hashlib.sha256(
        _control_authority_canonical_json(payload).encode("utf-8")
    ).hexdigest()


def _control_authority_timestamp(epoch=None):
    value = time.time() if epoch is None else float(epoch)
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(value))


def _control_authority_validate_id(value):
    if not isinstance(value, str) or not re.fullmatch(r"ca-[0-9a-f]{16}", value):
        raise ValueError("approval_intent_id is invalid")
    return value


def _control_authority_path(approval_intent_id):
    checked = _control_authority_validate_id(approval_intent_id)
    return control_authority_base() / f"{checked}.json"


def _control_authority_write(record):
    base = control_authority_base()
    base.mkdir(parents=True, exist_ok=True, mode=0o700)
    target = _control_authority_path(record["approval_intent_id"])
    text = json.dumps(record, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    temp = target.with_name(f".{target.name}.{os.getpid()}.{secrets.token_hex(4)}.tmp")
    try:
        fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.replace(temp, target)
        os.chmod(target, 0o600)
    finally:
        temp.unlink(missing_ok=True)
    return record


def _control_authority_load(approval_intent_id):
    path = _control_authority_path(approval_intent_id)
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise KeyError(approval_intent_id) from None
    except json.JSONDecodeError as exc:
        raise ControlApprovalConflict("approval intent state is invalid") from exc
    if not isinstance(payload, dict):
        raise ControlApprovalConflict("approval intent state is invalid")
    if payload.get("schema_version") != CONTROL_AUTHORITY_SCHEMA_VERSION:
        raise ControlApprovalConflict("approval intent schema version is unsupported")
    if payload.get("approval_intent_id") != approval_intent_id:
        raise ControlApprovalConflict("approval intent identity mismatch")
    return payload


def _control_authority_prune():
    base = control_authority_base()
    if not base.is_dir():
        return
    files = sorted(
        (item for item in base.glob("ca-*.json") if item.is_file()),
        key=lambda item: item.stat().st_mtime,
    )
    for victim in files[:-CONTROL_AUTHORITY_RETAIN_LIMIT]:
        try:
            victim.unlink()
        except OSError:
            pass


