        "diagnose": 8,
        "refactor": 12,
        "security": 8,
        "plan": 2,
        "release": 8,
        "ci-fix": 14,
        "implement": 14,
    }

    needs_validation = False
    last_validation_failure = None
    assertion_test_write_guard = False
    source_repair_since_assertion_failure = False
    modified_paths = set()
    debug_source_inspected = False
    patch_sanity_issue = None
    exploration_guard = PreWriteExplorationGuard(
        mode in {"fix", "ci-fix", "refactor", "implement"}
    )
    exploration_event_recorded = False

    def record_exploration_exhaustion():
        nonlocal exploration_event_recorded

        if exploration_event_recorded or not exploration_guard.exhausted:
            return

        event = {
            "type": "agent_limit",
            "reason": exploration_guard.reason,
            "trigger": exploration_guard.trigger,
            "exploration_calls": exploration_guard.calls,
            "exploration_budget": exploration_guard.budget,
            "tool_name": exploration_guard.tool_name,
            "signature_hash": exploration_guard.signature_hash,
        }
        record_metric_event(event)
        record_audit_event(event)
        exploration_event_recorded = True

    def looks_like_test_path(value):
        rel = str(value or "").replace("\\", "/").lower()
        name = Path(rel).name

        return (
            "test" in name
            or ".spec." in name
            or "/tests/" in f"/{rel}/"
            or "/test/" in f"/{rel}/"
        )

    def write_paths_for_call(name, args):
        if name == "patch":
            values = [
                change.get("path")
                for change in (
                    args.get("changes") or []
                )
                if isinstance(change, dict)
            ]
        elif name in WRITE_TOOLS:
            values = [args.get("path")]
        else:
            values = []

        normalized = []

        for raw in values:
            rel = str(raw or "").replace("\\", "/").strip()

            while rel.startswith("./"):
                rel = rel[2:]

            if rel and rel not in normalized:
                normalized.append(rel)

        return normalized

    def validation_failure_is_assertion(value):
        text = str(value or "")

        return (
            "AssertionError" in text
            or bool(
                re.search(
                    r"(?m)^\s*E\s+assert\b",
                    text,
                )
            )
        )

    def task_explicitly_requires_test_change(value):
        low = value.lower()

        phrases = (
            "adicione um teste",
            "adicione testes",
            "adicionar um teste",
            "adicionar testes",
            "crie um teste",
            "crie testes",
            "criar um teste",
            "criar testes",
            "escreva um teste",
            "escreva testes",
            "atualize o teste",
            "atualize os testes",
            "add a test",
            "add tests",
            "create a test",
            "create tests",
            "write a test",
            "write tests",
            "update the test",
            "update tests",
        )

        if any(phrase in low for phrase in phrases):
            return True

        # Explicit test paths can express the same requirement without
        # natural-language phrases such as "add a test". For example:
        # "Create app.py and tests/test_app.py".
        test_path_patterns = (
            r"(?:^|[\s`'\"(])(?:\.?/)?tests?/[^\s`'\",)]+",
            r"(?:^|[\s`'\"(])test_[A-Za-z0-9_.-]+",
            r"(?:^|[\s`'\"(])[A-Za-z0-9_.-]+\.(?:test|spec)\.[A-Za-z0-9_.-]+",
        )

        change_verb = re.search(
            r"\b(?:add|create|write|update|modify|change)\b",
            low,
        )

        explicit_test_path = any(
            re.search(pattern, low)
            for pattern in test_path_patterns
        )

        return bool(change_verb and explicit_test_path)

    def looks_like_validation(command):
        command = command.strip().lower()

        patterns = [
            r"(^|[;&|]\s*)(python3?|python)\s+[^;&|]*test[^;&|]*\.py(?:\s|$)",
            r"(^|\s)(pytest|python3?\s+-m\s+pytest)(\s|$)",
            r"(^|\s)python3?\s+-m\s+unittest(\s|$)",
            r"(^|\s)go\s+test(\s|$)",
            r"(^|\s)cargo\s+(test|check)(\s|$)",
            r"(^|\s)(npm|pnpm)\s+(test|run\s+(test|lint|build|check|typecheck))(\s|$)",
            r"(^|\s)yarn\s+(test|lint|build|check|typecheck)(\s|$)",
            r"(^|\s)bun\s+(test|run\s+(test|lint|build|check))(\s|$)",
            r"(^|\s)(mvn|mvnw)\s+.*\btest\b",
            r"(^|\s)(gradle|gradlew)\s+.*\b(test|check|build)\b",
            r"(^|\s)(ruff|flake8|mypy|pyright|eslint)(\s|$)",
            r"(^|\s)(tsc|npx\s+tsc)(\s|$)",
            r"(^|\s)python3?\s+-m\s+py_compile(\s|$)",
            r"(^|\s)node\s+--check(\s|$)",
        ]

        return any(re.search(pattern, command) for pattern in patterns)

    def normalize_validation_command(value):
        return " ".join(str(value).strip().strip("`").split())

    def task_explicitly_requests_validation_command(task_text, command):
        patterns = (
            r"(?im)\bvalide\s+(?:apenas|somente)\s+com\s*:\s*([^\r\n]+)",
            r"(?im)\bvalidate\s+only\s+with\s*:\s*([^\r\n]+)",
        )

        actual = normalize_validation_command(command)

        if not actual:
            return False

        for pattern in patterns:
            for match in re.finditer(pattern, task_text):
                requested = normalize_validation_command(
                    match.group(1)
                )

                if requested == actual:
                    return True

        return False

    def command_satisfies_validation(command):
        return (
            looks_like_validation(command)
            or task_explicitly_requests_validation_command(
                task,
                command,
            )
        )

    def progress_phase():
        if (
            mode not in {"fix", "refactor", "implement"}
            or not exploration_guard.write_succeeded
        ):
            return None, None

        required_test_change_pending = (
            mode == "implement"
            and task_explicitly_requires_test_change(task)
            and not any(
                looks_like_test_path(path)
                for path in modified_paths
            )
        )

        if last_validation_failure or patch_sanity_issue:
            return (
                "repair",
                set(WRITE_TOOLS) | {"bash", "validate"},
            )

        if needs_validation and required_test_change_pending:
            return (
                "complete_or_validate",
                set(WRITE_TOOLS) | {"bash", "validate"},
            )

        if needs_validation:
            return "validate", {"bash", "validate"}

        if required_test_change_pending:
            return (
                "complete_required_tests",
                set(WRITE_TOOLS),
            )

        return "finish", set()


    for _ in range(max_rounds_by_mode.get(mode, MAX_ROUNDS)):
        active_tools = mode_tools
        round_max_tokens = mode_max_tokens

        if exploration_guard.exhausted and not exploration_guard.write_succeeded:
            active_tools = [
                tool
                for tool in mode_tools
                if tool["function"]["name"] in WRITE_TOOLS
            ]
            round_max_tokens = max(
                round_max_tokens,
                2048,
            )

        progress_phase_name, progress_allowed_tools = (
            progress_phase()
        )

        if progress_allowed_tools is not None:
            active_tools = [
                tool
                for tool in active_tools
                if (
                    tool["function"]["name"]
                    in progress_allowed_tools
                )
            ]

        truncation_retry_used = False
        call_max_tokens = round_max_tokens

        while True:
            result = api_call(
                host,
                messages,
                tools=active_tools,
                max_tokens=call_max_tokens,
            )

            choice = result["choices"][0]
            finish_reason = choice.get("finish_reason")

            if finish_reason != "length":
                break

            retry_max_tokens = min(
                4096,
                max(
                    call_max_tokens * 2,
                    call_max_tokens + 256,
                ),
            )

            truncation_event = {
                "type": "agent_limit",
                "reason": "response_truncated",
                "max_tokens": call_max_tokens,
                "retry": not truncation_retry_used,
                "retry_max_tokens": (
                    retry_max_tokens
                    if not truncation_retry_used
                    else None
                ),
            }

            record_metric_event(truncation_event)
            record_audit_event(truncation_event)

            if truncation_retry_used:
                print(
                    "Agent stopped: model response truncated twice; "
                    "refusing to continue with incomplete assistant output.",
                    file=__import__("sys").stderr,
                )
                raise SystemExit(2)

            truncation_retry_used = True

            messages.append({
                "role": "user",
                "content": (
                    "RESPONSE TRUNCATED: the previous assistant generation "
                    "hit the token limit and was discarded. Retry now with "
                    "a concise response. If a tool is needed, return exactly "
                    "one complete tool call with minimal arguments. Do not "
                    "repeat analysis."
                ),
            })

            call_max_tokens = retry_max_tokens

        message = choice["message"]
        tool_calls = message.get("tool_calls") or []

        messages.append(message)

        if not tool_calls:
            content = message.get("content", "").strip()

            if (
                mode in {"fix", "ci-fix", "refactor", "implement"}
                and exploration_guard.exhausted
                and not exploration_guard.write_succeeded
            ):
                impossibility_prefix = "IMPLEMENTATION_IMPOSSIBLE:"
                impossibility_reason = (
                    content[len(impossibility_prefix):].strip()
                    if content.startswith(impossibility_prefix)
                    else ""
                )

                if impossibility_reason:
                    outcome = {
                        "type": "run_outcome",
                        "outcome": "implementation_impossible",
                    }
                    record_metric_event(outcome)
                    record_audit_event(outcome)
                    workspace_state["last_answer"] = content[:1800]
                    save_workspace_state(workspace_state)
                    print(content)
                    return

                messages.append({
                    "role": "user",
                    "content": (
                        "PHASE-SHIFT RESPONSE REJECTED: no successful write "
                        "was recorded. Use edit/create/patch/rewrite now, or reply with "
                        "the exact prefix IMPLEMENTATION_IMPOSSIBLE: followed "
                        "by the reason. Do not claim implementation success."
                    ),
                })
                continue

            if mode == "debug" and not debug_source_inspected:
                messages.append({
                    "role": "user",
                    "content": (
                        "DEBUG EVIDENCE REQUIRED: runtime output alone "
                        "is insufficient. Inspect the relevant source "
                        "and caller/test files, then trace the exact "
                        "value or control-flow transformation."
                    ),
                })
                continue

            if (
                mode == "implement"
                and patch_sanity_issue
            ):
                messages.append({
                    "role": "user",
                    "content": (
                        "POST-PATCH DEFECT MUST BE FIXED: "
                        + patch_sanity_issue
                        + "\nDo not conclude yet. Fix only this "
                          "concrete defect, then rerun the required "
                          "validation after the corrective patch."
                    ),
                })
                continue

            if mode in {"fix", "ci-fix", "refactor", "implement"} and needs_validation:
                messages.append({
                    "role": "user",
                    "content": (
                        "VALIDATION REQUIRED: repository files changed after the last "
                        "successful validation. Do not conclude yet. Run the relevant "
                        "existing test/check now. Only conclude after it exits successfully."
                    ),
                })
                continue

            if (
                mode == "implement"
                and task_explicitly_requires_test_change(task)
                and not any(
                    looks_like_test_path(path)
                    for path in modified_paths
                )
            ):
                messages.append({
                    "role": "user",
                    "content": (
                        "IMPLEMENTATION INCOMPLETE: the user explicitly requested "
                        "adding or updating tests, but no test file has been modified. "
                        "Do not conclude or ask whether to do it. Complete the requested "
                        "test change now, then run the relevant validation again."
                    ),
                })
                continue

            if mode == "plan":
                # A plan draft returned during an exploration round is not
                # authoritative final output. Stop exploration and route it
                # through the deterministic plan finalizer below.
                break

            if mode not in {"review", "security"}:
                workspace_state["last_answer"] = content[:1800]
                save_workspace_state(workspace_state)

            if mode == "implement":
                final_paths = sorted(
                    modified_paths
                )

                record_audit_event({
                    "type": "final",
                    "modified_paths": (
                        final_paths
                    ),
                    "final_hashes": (
                        hash_repository_paths(
                            final_paths
                        )
                    ),
                    "answer": content[:1200],
                })

            if mode in {"review", "security", "diagnose", "release"}:
                evidence = []

                if git_review_snapshot:
                    evidence.append(
                        "[git changes preloaded]\n"
                        + git_review_snapshot
                    )

                for msg in messages:
                    if msg.get("role") == "tool":
                        name = msg.get("name", "tool")
                        body = msg.get("content", "")
                        evidence.append(f"[{name}]\n{body}")

                evidence_text = "\n\n".join(evidence)
                if len(evidence_text) > 12000:
                    evidence_text = evidence_text[:12000] + "\n[evidence truncated]"

                if __import__("os").environ.get("LAI_DEBUG_GATE") == "1":
                    print(
                        "\n[GATE_DRAFT]\n" + content,
                        file=sys.stderr,
                    )

                findings = re.findall(
                    r"(?ms)^\s*(\d+)\.\s+(.*?)(?=^\s*\d+\.\s+|\Z)",
                    content,
                )

                if not findings:
                    if "nenhum problema concreto" in content.lower():
                        print("Nenhum problema concreto encontrado no escopo revisado.")
                    else:
                        print(content)
                    return

                def clean_finding_body(body):
                    body = re.sub(
                        r"(?ms)\n\s*(?:---\s*\n)?\s*"
                        r"(?:\*\*)?Nenhum problema "
                        r"(?=[^\n]*\bconcreto\b)"
                        r"(?=[^\n]*\badicional\b)"
                        r"[^\n]*(?:\*\*)?\.?\s*$",
                        "",
                        body,
                    )
                    return body.strip()

                draft_index = {
                    int(number): clean_finding_body(body)
                    for number, body in findings
                }

                if mode == "review":
                    def review_finding_is_deterministically_unsupported(body):
                        low = body.lower()

                        # Findings that explicitly admit there is no concrete defect
                        # and only speculate about ambiguity/policy are not review issues.
                        speculative_policy_terms = (
                            "ambiguity",
                            "ambiguidade",
                            "misalignment",
                            "desalinhamento",
                            "operational practices",
                            "práticas operacionais",
                            "praticas operacionais",
                            "without clarifying",
                            "sem esclarecer",
                            "risk of unintended",
                            "risco de comportamento",
                            "could introduce ambiguity",
                            "pode introduzir ambiguidade",
                        )

                        admits_no_concrete_flaw = any(term in low for term in (
                            "does not introduce a security flaw",
                            "não introduz uma falha de segurança",
                            "nao introduz uma falha de seguranca",
                            "not a security flaw",
                            "não é uma falha de segurança",
                            "nao e uma falha de seguranca",
                            "not a concrete problem",
                            "não é um problema concreto",
                            "nao e um problema concreto",
                        ))

                        speculative_policy_finding = any(
                            term in low
                            for term in speculative_policy_terms
                        )

                        concrete_failure_terms = (
                            "crash",
                            "exception",
                            "incorrect",
                            "wrong result",
                            "regression",
                            "data loss",
                            "command injection",
                            "sql injection",
                            "authorization bypass",
                            "authentication bypass",
                            "race condition",
                            "deadlock",
                            "falha",
                            "erro de execução",
                            "erro de execucao",
                            "resultado incorreto",
                            "regressão",
                            "regressao",
                            "perda de dados",
                            "injeção",
                            "injecao",
                            "bypass",
                        )

                        has_concrete_failure = any(
                            term in low
                            for term in concrete_failure_terms
                        )

                        concrete_doc_contradiction = any(
                            term in low
                            for term in (
                                "contradicts",
                                "contradiction",
                                "contradiz",
                                "contradição",
                                "contradicao",
                                "conflicts with",
                                "conflita com",
                                "inconsistent with",
                                "inconsistente com",
                                "explicitly allows",
                                "explicitly forbids",
                                "permite explicitamente",
                                "proíbe explicitamente",
                                "proibe explicitamente",
                            )
                        )

                        if (
                            speculative_policy_finding
                            and not has_concrete_failure
                            and not concrete_doc_contradiction
                            and (
                                git_review_docs_only
                                or admits_no_concrete_flaw
                            )
                        ):
                            return True

                        # ${VAR} is interpolation, not secret disclosure by itself.
                        has_env_interpolation = bool(
                            re.search(r"\$\{[A-Za-z_][A-Za-z0-9_]*(?::-[^}]*)?\}", body)
                        )
                        claims_secret_exposure = any(term in low for term in (
                            "expõe a senha",
                            "expoe a senha",
                            "senha exposta",
                            "secret exposure",
                            "segredo exposto",
                            "credenciais em claro",
                        ))
                        has_concrete_secret_evidence = any(term in low for term in (
                            "hardcoded",
                            "hard-coded",
                            "valor literal",
                            "senha literal",
                            ".env commit",
                            ".env version",
                            "log contém",
                            "log contem",
                        ))

                        if (
                            has_env_interpolation
                            and claims_secret_exposure
                            and not has_concrete_secret_evidence
                        ):
                            return True

                        # A host port mapping is not proof of internet/public exposure.
                        has_port_mapping = bool(
                            re.search(r'["\']?\d{2,5}:\d{2,5}["\']?', body)
                        )
                        claims_public_exposure = any(term in low for term in (
                            "publicamente",
                            "internet",
                            "public exposure",
                            "exposta publicamente",
                            "exposto publicamente",
                        ))
                        has_public_exposure_evidence = any(term in low for term in (
                            "0.0.0.0",
                            "firewall desabilitado",
                            "firewall disabled",
                            "public ip",
                            "ip público",
                            "ip publico",
                        ))

                        if (
                            has_port_mapping
                            and claims_public_exposure
                            and not has_public_exposure_evidence
                        ):
                            return True

                        return False

                    draft_index = {
                        number: body
                        for number, body in draft_index.items()
                        if not review_finding_is_deterministically_unsupported(body)
                    }

                    if not draft_index:
                        print("Nenhum problema concreto encontrado no escopo revisado.")
                        return

                    findings = [
                        (str(number), body)
                        for number, body in sorted(draft_index.items())
                    ]

                if mode == "security":
                    verifier_system = """You are a strict evidence classifier for defensive security findings.

Decide which numbered findings are directly supported by the repository evidence provided.

KEEP a finding when the evidence establishes a concrete security-relevant source, data/control flow, and dangerous sink or security boundary violation.

Examples of sufficient evidence:
- repository documentation says a value comes directly from an HTTP request, and code interpolates that value into a shell command executed with shell=True: KEEP command injection;
- untrusted input reaches SQL string construction without parameterization: KEEP SQL injection;
- authorization-sensitive action is reachable without the required authorization check: KEEP broken authorization.

DROP a finding when exploitability depends entirely on facts absent from repository evidence.
DROP duplicated findings that describe the same root cause.
DROP missing optional hardening presented as a vulnerability.
Environment-variable interpolation such as ${POSTGRES_PASSWORD} is not itself secret exposure.
Docker port mapping such as 5432:5432 proves host exposure only, not public/internet exposure.

Do not rewrite findings.
Do not explain.
Do not add findings.

Output exactly one of:
KEEP: NONE
KEEP: 1
KEEP: 1,3"""
                else:
                    verifier_system = """You are a strict evidence classifier for software review findings.

Decide which numbered findings are directly supported by the repository evidence provided.

KEEP a finding only when the evidence establishes the actual problem being claimed.
DROP it when the risk depends on deployment state, firewall state, secret handling, configuration, requirements, or other facts not present in the evidence.
DROP optional configuration presented as a defect.
DROP findings whose own reasoning admits there is no evidence of the claimed problem.
Environment-variable interpolation such as ${POSTGRES_PASSWORD} is not secret exposure.
Docker port mapping such as 5432:5432 proves host exposure only, not public/internet exposure.

Do not rewrite findings.
Do not explain.
Do not add findings.

Output exactly one of:
KEEP: NONE
KEEP: 1
KEEP: 1,3"""

                indexed_draft = "\\n\\n".join(
                    f"[{number}]\\n{body}"
                    for number, body in findings
                )

                verifier_messages = [
                    {"role": "system", "content": verifier_system},
                    {
                        "role": "user",
                        "content": (
                            f"PEDIDO ORIGINAL:\\n{task}\\n\\n"
                            f"FINDINGS:\\n{indexed_draft}\\n\\n"
                            f"EVIDÊNCIAS COLETADAS:\\n{evidence_text}"
                        ),
                    },
                ]

                verified = api_call(
                    host,
                    verifier_messages,
                    use_tools=False,
                    max_tokens=32,
                )

                verdict = (
                    verified["choices"][0]["message"]
                    .get("content", "")
                    .strip()
                )

                if __import__("os").environ.get("LAI_DEBUG_GATE") == "1":
                    print(
                        "\n[GATE_VERDICT]\n" + verdict,
                        file=sys.stderr,
                    )

                match = re.search(
                    r"KEEP:\s*(NONE|[0-9, ]+)",
                    verdict,
                    flags=re.IGNORECASE,
                )

                if not match or match.group(1).upper() == "NONE":
                    print("Nenhum problema concreto encontrado no escopo revisado.")
                    return

                keep_ids = {
                    int(value)
                    for value in re.findall(r"\d+", match.group(1))
                }

                kept = [
                    draft_index[number]
                    for number in sorted(keep_ids)
                    if number in draft_index
                ]

                if not kept:
                    print("Nenhum problema concreto encontrado no escopo revisado.")
                    return

                for index, body in enumerate(kept, 1):
                    print(f"{index}. {body}")
                    if index != len(kept):
                        print()

                return

            print(content)
            return

        for call in tool_calls:
            name = call["function"]["name"]

            try:
                args = json.loads(call["function"]["arguments"])
            except json.JSONDecodeError as e:
                tool_result = f"ERROR: invalid tool arguments: {e}"
            else:
                current_phase, current_allowed_tools = progress_phase()
                progress_blocked_result = None

                if (
                    current_allowed_tools is not None
                    and name not in current_allowed_tools
                ):
                    progress_blocked_result = (
                        "BLOCKED: post-write progress phase="
                        + str(current_phase)
                        + " does not allow tool "
                        + str(name)
                        + ". After a successful write, validate before "
                          "further work. After validation failure, repair "
                          "only the concrete failure. After successful "
                          "validation, conclude."
                    )

                    progress_event = {
                        "type": "progress_guard",
                        "reason": "post_write_tool_blocked",
                        "phase": current_phase,
                        "tool_name": str(name),
                    }
                    record_metric_event(progress_event)
                    record_audit_event(progress_event)

                blocked_result = (
                    progress_blocked_result
                    or exploration_guard.check(name, args)
                )

                if blocked_result is not None:
                    tool_result = blocked_result
                else:
                    validation_guard_result = None

                    if (
                        mode == "implement"
                        and assertion_test_write_guard
                        and last_validation_failure
                        and name in WRITE_TOOLS
                    ):
                        proposed_paths = write_paths_for_call(
                            name,
                            args,
                        )

                        proposed_test_paths = [
                            path
                            for path in proposed_paths
                            if looks_like_test_path(path)
                        ]

                        existing_source_changes = any(
                            not looks_like_test_path(path)
                            for path in modified_paths
                        )

                        if (
                            proposed_test_paths
                            and existing_source_changes
                        ):
                            validation_guard_result = (
                                "BLOCKED: VALIDATION FAILURE GUARD: "
                                "the last required validation failed with "
                                "an assertion after implementation code "
                                "was modified. Do not weaken or alter test "
                                "expectations while that assertion failure "
                                "is active. Fix the non-test implementation "
                                "first, then rerun the required validation. "
                                "The previous validation failure remains "
                                "the evidence to satisfy."
                            )

                            guard_event = {
                                "type": "validation_guard",
                                "reason": (
                                    "test_write_after_assertion_failure"
                                ),
                                "paths": proposed_test_paths,
                            }

                            record_metric_event(guard_event)
                            record_audit_event(guard_event)

                    if validation_guard_result is not None:
                        tool_result = validation_guard_result
                    else:
                        tool_result = run_tool(name, args)

                record_exploration_exhaustion()

                if tool_result.startswith("POLICY ASK:"):
                    policy = evaluate_tool_policy(name, args, mode=mode)
                    outcome = {
                        "type": "run_outcome",
                        "outcome": "user_action_required",
                        "tool": name,
                        "reason": policy["reason"],
                    }
                    record_metric_event(outcome)
                    record_audit_event(outcome)
                    checkpoint_run_transition(
                        "user_action_required",
                        terminal=True,
                        tracked_paths=sorted(modified_paths),
                        last_tool=name,
                        reason=policy["reason"],
                    )
                    print(tool_result)
                    return

                if (
                    mode in {"fix", "ci-fix", "refactor", "implement"}
                    and name in WRITE_TOOLS
                    and tool_result.startswith("OK:")
                ):
                    exploration_guard.note_successful_write()
                    needs_validation = True

                    if assertion_test_write_guard:
                        successful_write_paths = (
                            write_paths_for_call(
                                name,
                                args,
                            )
                        )

                        if any(
                            not looks_like_test_path(path)
                            for path in successful_write_paths
                        ):
                            source_repair_since_assertion_failure = True

                    if name == "patch":
                        for change in args.get("changes") or []:
                            changed_path = change.get("path")

                            if changed_path:
                                modified_paths.add(
                                    str(changed_path)
                                )
                    else:
                        changed_path = args.get("path")

                        if changed_path:
                            modified_paths.add(
                                str(changed_path)
                            )

                elif (
                    mode in {"fix", "ci-fix", "refactor", "implement"}
                    and needs_validation
                    and tool_result.startswith("exit_code=")
                    and (
                        name == "validate"
                        or (
                            name == "bash"
                            and command_satisfies_validation(
                                args.get("command", "")
                            )
                        )
                    )
                ):
                    if tool_result.startswith("exit_code=0"):
                        needs_validation = False
                        last_validation_failure = None
                        assertion_test_write_guard = False
                        source_repair_since_assertion_failure = False
                    else:
                        is_assertion_failure = (
                            validation_failure_is_assertion(
                                tool_result
                            )
                        )

                        if is_assertion_failure:
                            if (
                                assertion_test_write_guard
                                and source_repair_since_assertion_failure
                            ):
                                # A non-test repair has already been tried
                                # and revalidated. At this point the test
                                # itself may legitimately need correction.
                                assertion_test_write_guard = False
                            else:
                                assertion_test_write_guard = True
                        else:
                            assertion_test_write_guard = False

                        source_repair_since_assertion_failure = False
                        last_validation_failure = tool_result

                if (
                    mode == "debug"
                    and name == "inspect"
                    and not str(tool_result).startswith("ERROR:")
                ):
                    inspected_paths = args.get("paths") or []

                    for inspected_path in inspected_paths:
                        normalized = (
                            str(inspected_path)
                            .replace("\\", "/")
                        )

                        while normalized.startswith("./"):
                            normalized = normalized[2:]

                        if normalized != "AGENTS.md":
                            debug_source_inspected = True
                            break

                if (
                    mode == "implement"
                    and name in {"patch", "rewrite"}
                    and tool_result.startswith("OK:")
                ):
                    if name == "patch":
                        sanity_paths = [
                            change.get("path")
                            for change in (
                                args.get("changes") or []
                            )
                            if change.get("path")
                        ]
                    else:
                        sanity_paths = [
                            args.get("path")
                        ] if args.get("path") else []

                    patch_sanity_issue = post_patch_sanity(
                        host,
                        task,
                        sanity_paths,
                    )

                    sanity_hashes = (
                        hash_repository_paths(
                            sanity_paths
                        )
                    )

                    expected_hashes = {
                        path: LAST_PATCH_HASHES.get(
                            path
                        )
                        for path in sanity_paths
                    }

                    matches_patch_hashes = (
                        sanity_hashes
                        == expected_hashes
                    )

                    record_audit_event({
                        "type": "sanity",
                        "status": (
                            "BUG"
                            if patch_sanity_issue
                            else "CLEAN"
                        ),
                        "issue": (
                            patch_sanity_issue
                            or None
                        ),
                        "paths": sanity_paths,
                        "hashes": sanity_hashes,
                        "expected_hashes": (
                            expected_hashes
                        ),
                        "matches_patch_hashes": (
                            matches_patch_hashes
                        ),
                    })

                    if patch_sanity_issue:
                        tool_result += (
                            "\nPOST_PATCH_SANITY: "
                            + patch_sanity_issue
                        )
                    else:
                        tool_result += (
                            "\nPOST_PATCH_SANITY: CLEAN"
                        )

                is_validation_call = (
                    name == "validate"
                    or (
                        name == "bash"
                        and command_satisfies_validation(
                            args.get("command", "")
                        )
                    )
                )
                record_workspace_tool(
                    workspace_state,
                    name,
                    args,
                    tool_result,
                    is_validation=is_validation_call,
                )
                checkpoint_paths = set(modified_paths)
                if name in WRITE_TOOLS and tool_result.startswith("OK:"):
                    checkpoint_paths.update(write_paths_for_call(name, args))
                checkpoint_run_transition(
                    (
                        "validation_completed"
                        if is_validation_call
                        else "tool_completed"
                    ),
                    tracked_paths=sorted(checkpoint_paths),
                    last_tool=name,
                )

            messages.append({
                "role": "tool",
                "tool_call_id": call["id"],
                "name": name,
                "content": tool_result,
            })

        if exploration_guard.exhausted and not exploration_guard.write_succeeded:
            phase_message = exploration_guard.phase_message()

            if (
                not messages
                or messages[-1].get("role") != "user"
                or messages[-1].get("content") != phase_message
            ):
                messages.append({
                    "role": "user",
                    "content": phase_message,
                })

    if mode == "plan":
        evidence = []

        if plan_project_snapshot:
            evidence.append(
                "[project snapshot]\n"
                + plan_project_snapshot
            )

        for msg in messages:
            if msg.get("role") == "tool":
                name = msg.get("name", "tool")
                body = msg.get("content", "")
                evidence.append(f"[{name}]\n{body}")

        evidence_text = "\n\n".join(evidence)

        if len(evidence_text) > 10000:
            evidence_text = (
                evidence_text[:10000]
                + "\n[evidence truncated]"
            )

        forced_messages = [
            {
                "role": "system",
                "content": (
                    system
                    + "\n\nExploration budget is exhausted. "
                      "Do not request tools. Synthesize the implementation "
                      "plan now using only the collected repository evidence."
                ),
            },
            {
                "role": "user",
                "content": (
                    task
                    + "\n\nCOLLECTED REPOSITORY EVIDENCE:\n"
                    + evidence_text
                ),
            },
        ]

        plan_synthesis_max_tokens = 1536
        plan_synthesis_retry_used = False

        while True:
            result = api_call(
                host,
                forced_messages,
                use_tools=False,
                max_tokens=plan_synthesis_max_tokens,
            )

            choice = result["choices"][0]

            if choice.get("finish_reason") != "length":
                break

            retry_max_tokens = min(
                4096,
                max(
                    plan_synthesis_max_tokens * 2,
                    plan_synthesis_max_tokens + 256,
                ),
            )

            truncation_event = {
                "type": "agent_limit",
                "reason": "response_truncated",
                "max_tokens": plan_synthesis_max_tokens,
                "retry": not plan_synthesis_retry_used,
                "retry_max_tokens": (
                    retry_max_tokens
                    if not plan_synthesis_retry_used
                    else None
                ),
            }

            record_metric_event(truncation_event)
            record_audit_event(truncation_event)

            if plan_synthesis_retry_used:
                print(
                    "Agent stopped: plan synthesis truncated twice; "
                    "refusing to return incomplete output.",
                    file=sys.stderr,
                )
                raise SystemExit(2)

            plan_synthesis_retry_used = True
            plan_synthesis_max_tokens = retry_max_tokens

        forced_content = (
            choice["message"]
            .get("content", "")
            .strip()
        )

        workspace_state["last_answer"] = forced_content[:1800]
        save_workspace_state(workspace_state)

        print(forced_content)
        return

    event = {
        "type": "agent_limit",
        "reason": "overall_round_limit_reached",
        "round_limit": max_rounds_by_mode.get(mode, MAX_ROUNDS),
    }
    record_metric_event(event)
    record_audit_event(event)
    print(
        "Agent stopped: overall round limit reached "
        f"({event['round_limit']} rounds).",
        file=sys.stderr,
    )
    raise SystemExit(2)


def run_main_with_checkpoint_lifecycle():
    try:
        main()
    except SystemExit as exc:
        finalize_run_checkpoint(
            "failed",
            reason=f"SystemExit:{exc.code}",
        )
        raise
    except BaseException as exc:
        finalize_run_checkpoint(
            "failed",
            reason=type(exc).__name__,
        )
        raise
    else:
        finalize_run_checkpoint("completed")


if __name__ == "__main__":
    run_main_with_checkpoint_lifecycle()
