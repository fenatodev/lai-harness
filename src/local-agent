                tool_result = run_tool(name, args)

                if (
                    mode in {"fix", "refactor", "implement"}
                    and name in {"edit", "create", "patch"}
                    and tool_result.startswith("OK:")
                ):
                    needs_validation = True

                    if name == "patch":
                        for change in args.get("changes") or []:
                            changed_path = change.get("path")

                            if changed_path:
                                modified_paths.add(
                                    str(changed_path)
                                )
                    else:
                        changed_path = args.get("path")

                        if changed_path:
                            modified_paths.add(
                                str(changed_path)
                            )

                elif (
                    mode in {"fix", "refactor", "implement"}
                    and name == "bash"
                    and needs_validation
                    and tool_result.startswith("exit_code=0")
                    and looks_like_validation(args.get("command", ""))
                ):
                    needs_validation = False

                if (
                    mode == "debug"
                    and name == "inspect"
                    and not str(tool_result).startswith("ERROR:")
                ):
                    inspected_paths = args.get("paths") or []

                    for inspected_path in inspected_paths:
                        normalized = (
                            str(inspected_path)
                            .replace("\\", "/")
                        )

                        while normalized.startswith("./"):
                            normalized = normalized[2:]

                        if normalized != "AGENTS.md":
                            debug_source_inspected = True
                            break

                if (
                    mode == "implement"
                    and name == "patch"
                    and tool_result.startswith("OK:")
                ):
                    sanity_paths = [
                        change.get("path")
                        for change in (
                            args.get("changes") or []
                        )
                        if change.get("path")
                    ]

                    patch_sanity_issue = post_patch_sanity(
                        host,
                        task,
                        sanity_paths,
                    )

                    sanity_hashes = (
                        hash_repository_paths(
                            sanity_paths
                        )
                    )

                    expected_hashes = {
                        path: LAST_PATCH_HASHES.get(
                            path
                        )
                        for path in sanity_paths
                    }

                    matches_patch_hashes = (
                        sanity_hashes
                        == expected_hashes
                    )

                    record_audit_event({
                        "type": "sanity",
                        "status": (
                            "BUG"
                            if patch_sanity_issue
                            else "CLEAN"
                        ),
                        "issue": (
                            patch_sanity_issue
                            or None
                        ),
                        "paths": sanity_paths,
                        "hashes": sanity_hashes,
                        "expected_hashes": (
                            expected_hashes
                        ),
                        "matches_patch_hashes": (
                            matches_patch_hashes
                        ),
                    })

                    if patch_sanity_issue:
                        tool_result += (
                            "\nPOST_PATCH_SANITY: "
                            + patch_sanity_issue
                        )
                    else:
                        tool_result += (
                            "\nPOST_PATCH_SANITY: CLEAN"
                        )

                record_workspace_tool(
                    workspace_state,
                    name,
                    args,
                    tool_result,
                    is_validation=(
                        name == "bash"
                        and looks_like_validation(
                            args.get("command", "")
                        )
                    ),
                )

            messages.append({
                "role": "tool",
                "tool_call_id": call["id"],
                "name": name,
                "content": tool_result,
            })

    if mode == "plan":
        evidence = []

        for msg in messages:
            if msg.get("role") == "tool":
                name = msg.get("name", "tool")
                body = msg.get("content", "")
                evidence.append(f"[{name}]\n{body}")

        evidence_text = "\n\n".join(evidence)

        if len(evidence_text) > 10000:
            evidence_text = (
                evidence_text[:10000]
                + "\n[evidence truncated]"
            )

        forced_messages = [
            {
                "role": "system",
                "content": (
                    system
                    + "\n\nExploration budget is exhausted. "
                      "Do not request tools. Synthesize the implementation "
                      "plan now using only the collected repository evidence."
                ),
            },
            {
                "role": "user",
                "content": (
                    task
                    + "\n\nCOLLECTED REPOSITORY EVIDENCE:\n"
                    + evidence_text
                ),
            },
        ]

        result = api_call(
            host,
            forced_messages,
            use_tools=False,
            max_tokens=140,
        )

        forced_content = (
            result["choices"][0]["message"]
            .get("content", "")
            .strip()
        )

        workspace_state["last_answer"] = forced_content[:1800]
        save_workspace_state(workspace_state)

        print(forced_content)
        return

    print("Agent stopped after reaching the tool-call limit.", file=sys.stderr)
    raise SystemExit(2)


if __name__ == "__main__":
    main()
