        f"Latest reachable tag: {payload['latest_tag']}",
        f"Release check: {payload['release_check_overall']} / {payload['release_check_phase']}",
        f"Remote GitHub verification: {'enabled' if payload['remote']['enabled'] else 'disabled'}",
        f"Overall: {payload['overall']}",
        "",
        "## Checks",
    ]
    for check in payload["checks"]:
        lines.append(f"- [{check['status']}] {check['name']}: {check['detail']}")

