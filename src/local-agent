def _context_fold_text(value):
    return "".join(
        char for char in unicodedata.normalize("NFKD", str(value or ""))
        if not unicodedata.combining(char)
    ).lower()


def context_task_terms(task):
    values = re.findall(r"[A-Za-z0-9_.:/-]+", _context_fold_text(task))
    terms = set()
    for value in values:
        for part in re.split(r"[./:_-]+", value):
            if len(part) >= 3 and part not in CONTEXT_STOPWORDS and not part.isdigit():
                terms.add(part)
    return sorted(terms)


def _context_path_allowed(rel):
    path = Path(str(rel).replace("\\", "/"))
    if path.is_absolute() or ".." in path.parts:
        return False
    if any(part in CONTEXT_IGNORED_DIRS for part in path.parts):
        return False
    candidate = ROOT / path
    try:
        if candidate.is_symlink():
            return False
        resolved = candidate.resolve(strict=True)
        resolved.relative_to(ROOT.resolve())
        return resolved.is_file()
    except (OSError, RuntimeError, ValueError):
        return False


def repository_context_inventory(max_files=CONTEXT_INVENTORY_LIMIT):
    max_files = max(1, min(int(max_files), 800))
    paths = []
    try:
        proc = subprocess.run(
            ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
            cwd=ROOT, text=False, capture_output=True, timeout=10,
        )
        if proc.returncode == 0:
            paths = [
                item.decode("utf-8", errors="replace")
                for item in proc.stdout.split(b"\0") if item
            ]
    except Exception:
        paths = []

    if not paths:
        try:
            for current, dirs, files in os.walk(ROOT):
                dirs[:] = sorted(d for d in dirs if d not in CONTEXT_IGNORED_DIRS)
                for name in sorted(files):
                    candidate = Path(current) / name
                    try:
                        rel = candidate.relative_to(ROOT).as_posix()
                    except ValueError:
                        continue
                    paths.append(rel)
                    if len(paths) >= max_files * 2:
                        break
                if len(paths) >= max_files * 2:
                    break
        except OSError:
            pass
    normalized = []
    seen = set()
    for raw in sorted(paths):
        rel = str(raw).replace("\\", "/")
        while rel.startswith("./"):
            rel = rel[2:]
        if not rel or rel in seen or not _context_path_allowed(rel):
            continue
        seen.add(rel)
        normalized.append(rel)
        if len(normalized) >= max_files:
            break
    return normalized



def _context_dir_group(rel):
    parts = tuple(Path(str(rel).replace("\\", "/")).parts)
    if not parts:
        return "."
    if len(parts) == 1:
        return "."
    return parts[0]


def _context_suffix_group(rel):
    path = Path(str(rel).replace("\\", "/"))
    suffix = path.suffix.lower()
    if suffix:
        return suffix
    if path.name in CONTEXT_MANIFESTS:
        return "[manifest]"
    return "[none]"


def _context_limited_counts(values, limit=CONTEXT_MAP_GROUP_LIMIT):
    counts = {}
    for value in values:
        key = str(value or "[unknown]")[:120]
        counts[key] = counts.get(key, 0) + 1
    rows = [
        {"name": key, "count": count}
        for key, count in sorted(counts.items(), key=lambda item: (-item[1], item[0]))
    ]
    return rows[:max(1, min(int(limit), CONTEXT_MAP_GROUP_LIMIT))]


def repository_context_map(max_files=CONTEXT_INVENTORY_LIMIT, max_paths=CONTEXT_MAP_PATH_LIMIT):
    max_files = max(1, min(int(max_files), 800))
    max_paths = max(0, min(int(max_paths), 200))
    inventory = repository_context_inventory(max_files=max_files)
    known = set(inventory)
    changed = sorted(rel for rel in context_git_changed_paths() if rel in known)
    manifests = sorted(rel for rel in inventory if Path(rel).name in CONTEXT_MANIFESTS)
    semantic = []
    for subsystem in SEMANTIC_CODE_CONTRACT.get("subsystems", []):
        existing_paths = [rel for rel in subsystem.get("paths", []) if rel in known]
        if not existing_paths:
            continue
        semantic.append({
            "id": subsystem.get("id", ""),
            "intent": subsystem.get("intent", ""),
            "paths": existing_paths[:8],
            "entrypoints": list(subsystem.get("entrypoints", []))[:8],
        })
    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "map_version": 1,
        "repository": ".",
        "metadata_only": True,
        "inspected_content": False,
        "advisory_only": True,
        "inventory_limit": max_files,
        "file_count": len(inventory),
        "file_list_limit": max_paths,
        "file_list_truncated": len(inventory) > max_paths,
        "files": inventory[:max_paths],
        "directory_groups": _context_limited_counts(_context_dir_group(rel) for rel in inventory),
        "suffix_groups": _context_limited_counts(_context_suffix_group(rel) for rel in inventory),
        "manifests": manifests[:40],
        "changed_paths": changed[:40],
        "changed_path_count": len(changed),
        "semantic_subsystems": semantic[:CONTEXT_MAP_GROUP_LIMIT],
        "code_graph": {
            "graph_version": CONTEXT_GRAPH_SCHEMA_VERSION,
            "parser_version": CONTEXT_GRAPH_PARSER_VERSION,
            "python_file_count": context_code_graph_payload(max_files=max_files, max_edges=40).get("python_file_count", 0),
            "edge_count": context_code_graph_payload(max_files=max_files, max_edges=40).get("edge_count", 0),
            "advisory_only": True,
        },
        "ignored_directories": sorted(CONTEXT_IGNORED_DIRS),
        "trust": (
            "Advisory metadata only. Inspect files before relying on contents; "
            "repository rules, specs, policy, and validation remain authoritative."
        ),
    }


