                match = re.search(
                    r"KEEP:\s*(NONE|[0-9, ]+)",
                    verdict,
                    flags=re.IGNORECASE,
                )

                if not match or match.group(1).upper() == "NONE":
                    print("Nenhum problema concreto encontrado no escopo revisado.")
                    return

                keep_ids = {
                    int(value)
                    for value in re.findall(r"\d+", match.group(1))
                }

                kept = [
                    draft_index[number]
                    for number in sorted(keep_ids)
                    if number in draft_index
                ]

                if not kept:
                    print("Nenhum problema concreto encontrado no escopo revisado.")
                    return

                for index, body in enumerate(kept, 1):
                    print(f"{index}. {body}")
                    if index != len(kept):
                        print()

                return

            print(content)
            return

        for call in tool_calls:
            name = call["function"]["name"]

            try:
                args = json.loads(call["function"]["arguments"])
            except json.JSONDecodeError as e:
                tool_result = f"ERROR: invalid tool arguments: {e}"
            else:
                current_phase, current_allowed_tools = progress_phase()
                progress_blocked_result = None

                if (
                    current_allowed_tools is not None
                    and name not in current_allowed_tools
                ):
                    progress_blocked_result = (
                        "BLOCKED: post-write progress phase="
                        + str(current_phase)
                        + " does not allow tool "
                        + str(name)
                        + ". After a successful write, validate before "
                          "further work. After validation failure, repair "
                          "only the concrete failure. After successful "
                          "validation, conclude."
                    )

                    progress_event = {
                        "type": "progress_guard",
                        "reason": "post_write_tool_blocked",
                        "phase": current_phase,
                        "tool_name": str(name),
                    }
                    record_metric_event(progress_event)
                    record_audit_event(progress_event)

                blocked_result = (
                    progress_blocked_result
                    or exploration_guard.check(name, args)
                )

                if blocked_result is not None:
                    tool_result = blocked_result
                else:
                    validation_guard_result = None

                    if (
                        mode == "implement"
                        and assertion_test_write_guard
                        and last_validation_failure
                        and name in WRITE_TOOLS
                    ):
                        proposed_paths = write_paths_for_call(
                            name,
                            args,
                        )

                        proposed_test_paths = [
                            path
                            for path in proposed_paths
                            if looks_like_test_path(path)
                        ]

                        existing_source_changes = any(
                            not looks_like_test_path(path)
                            for path in modified_paths
                        )

                        if (
                            proposed_test_paths
                            and existing_source_changes
                        ):
                            validation_guard_result = (
                                "BLOCKED: VALIDATION FAILURE GUARD: "
                                "the last required validation failed with "
                                "an assertion after implementation code "
                                "was modified. Do not weaken or alter test "
                                "expectations while that assertion failure "
                                "is active. Fix the non-test implementation "
                                "first, then rerun the required validation. "
                                "The previous validation failure remains "
                                "the evidence to satisfy."
                            )

                            guard_event = {
                                "type": "validation_guard",
                                "reason": (
                                    "test_write_after_assertion_failure"
                                ),
                                "paths": proposed_test_paths,
                            }

                            record_metric_event(guard_event)
                            record_audit_event(guard_event)

                    if validation_guard_result is not None:
                        tool_result = validation_guard_result
                    else:
                        tool_result = run_tool(name, args)

                record_exploration_exhaustion()

                if tool_result.startswith("POLICY ASK:"):
                    policy = evaluate_tool_policy(name, args, mode=mode)
                    outcome = {
                        "type": "run_outcome",
                        "outcome": "user_action_required",
                        "tool": name,
                        "reason": policy["reason"],
                    }
                    record_metric_event(outcome)
                    record_audit_event(outcome)
                    checkpoint_run_transition(
                        "user_action_required",
                        terminal=True,
                        tracked_paths=sorted(modified_paths),
                        last_tool=name,
                        reason=policy["reason"],
                    )
                    print(tool_result)
                    return

                if (
                    mode in {"fix", "refactor", "implement"}
                    and name in WRITE_TOOLS
                    and tool_result.startswith("OK:")
                ):
                    exploration_guard.note_successful_write()
                    needs_validation = True

                    if assertion_test_write_guard:
                        successful_write_paths = (
                            write_paths_for_call(
                                name,
                                args,
                            )
                        )

                        if any(
                            not looks_like_test_path(path)
                            for path in successful_write_paths
                        ):
                            source_repair_since_assertion_failure = True

                    if name == "patch":
                        for change in args.get("changes") or []:
                            changed_path = change.get("path")

                            if changed_path:
                                modified_paths.add(
                                    str(changed_path)
                                )
                    else:
                        changed_path = args.get("path")

                        if changed_path:
                            modified_paths.add(
                                str(changed_path)
                            )

                elif (
                    mode in {"fix", "refactor", "implement"}
                    and name == "bash"
                    and needs_validation
                    and tool_result.startswith("exit_code=")
                    and command_satisfies_validation(
                        args.get("command", "")
                    )
                ):
                    if tool_result.startswith("exit_code=0"):
                        needs_validation = False
                        last_validation_failure = None
                        assertion_test_write_guard = False
                        source_repair_since_assertion_failure = False
                    else:
                        is_assertion_failure = (
                            validation_failure_is_assertion(
                                tool_result
                            )
                        )

                        if is_assertion_failure:
                            if (
