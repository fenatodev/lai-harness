def check_update_source(source):
    source_type = source["source_type"]
    if source_type == "pypi":
        details = check_update_pypi_source(source)
    elif source_type == "npm":
        details = check_update_npm_source(source)
    elif source_type == "github-release":
        details = check_update_github_release_source(source)
    elif source_type == "dependabot":
        details = check_update_dependabot_source(source)
    else:
        raise ValueError(f"unsupported update source type: {source_type}")
    return {
        "id": source["id"],
        "category": source["category"],
        "source_type": source_type,
        **details,
    }


