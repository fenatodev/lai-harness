def write_project_handoff(target=None, remote=False, out_dir=None, force=False):
    payload = project_handoff_payload(target=target, remote=remote)
    output_dir = project_handoff_resolve_out_dir(out_dir, payload["expected_tag"])
    if output_dir.exists() and any(output_dir.iterdir()) and not force:
        raise SystemExit(f"Project handoff directory already exists and is not empty: {output_dir}. Use --force or --out DIR")
    output_dir.mkdir(parents=True, exist_ok=True)
    markdown = render_project_handoff_markdown(payload)
    files = {
        "markdown": output_dir / "PROJECT-HANDOFF.md",
        "next_chat_prompt": output_dir / "NEXT-CHAT-PROMPT.md",
        "summary": output_dir / "summary.json",
    }
    files["markdown"].write_text(markdown, encoding="utf-8")
    prompt = markdown.split("## Prompt to paste into the next ChatGPT chat", 1)[-1].strip()
    files["next_chat_prompt"].write_text(prompt + "\n", encoding="utf-8")
    result = dict(payload)
    result["handoff_dir"] = str(output_dir)
    result["files"] = {name: str(path) for name, path in files.items()}
    files["summary"].write_text(
        json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    return result


def render_project_handoff(args=None):
    options = parse_project_handoff_args(args or [])
    if options["out_dir"]:
        payload = write_project_handoff(
            target=options["target"],
            remote=options["remote"],
            out_dir=options["out_dir"],
            force=options["force"],
        )
        if options["json"]:
            return json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True)
        lines = [
            "# lai project handoff",
            "",
            f"Product: {payload['product']}",
            f"Version: {payload['version']}",
            f"Target version: {payload['target_version']}",
            f"Expected tag: {payload['expected_tag']}",
            f"Repository: {payload['repository']}",
            f"Branch: {payload['branch']}",
            f"HEAD: {payload['head']}",
            f"Release check: {payload['release_check_overall']} / {payload['release_check_phase']}",
            f"Handoff directory: {payload['handoff_dir']}",
            "",
            "## Files",
        ]
        for name, path in payload["files"].items():
            lines.append(f"- {name}: {path}")
        lines.append("")
        lines.append(payload["safety"])
        return "\n".join(lines)

    payload = project_handoff_payload(target=options["target"], remote=options["remote"])
    if options["json"]:
        return json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True)
    return render_project_handoff_markdown(payload)




