def _compact_tool_call_for_model(call):
    function = call.get("function") if isinstance(call, dict) else None
    if not isinstance(function, dict):
        function = {}
    name = function.get("name") or call.get("name") if isinstance(call, dict) else "tool"
    arguments = function.get("arguments") or "{}"
    try:
        if not isinstance(arguments, str):
            arguments = json.dumps(arguments, sort_keys=True)
    except TypeError:
        arguments = str(arguments)
    return f"- {str(name or 'tool')}: {arguments}"


def _compact_tool_result_for_model(message):
    name = str(message.get("name") or "tool")
    content = str(message.get("content") or "")
    return f"[{name}]\n{content}"


def normalize_messages_for_strict_chat_template(messages):
    """Render prior tool-call exchanges as alternating text messages.

    Some llama.cpp chat templates reject OpenAI-style `role=tool` history after
    tool calls. Keep the internal audit history intact, but send the model a
    strict system/user/assistant/user sequence with tool requests and results
    represented as text evidence. New tool calls are still enabled by the
    current `tools` payload.
    """
    normalized = []
    i = 0
    while i < len(messages):
        message = messages[i]
        role = message.get("role")
        if role == "assistant" and message.get("tool_calls"):
            content = str(message.get("content") or "").strip()
            calls = [
                _compact_tool_call_for_model(call)
                for call in (message.get("tool_calls") or [])
                if isinstance(call, dict)
            ]
            body_parts = []
            if content:
                body_parts.append(content)
            if calls:
                body_parts.append("TOOL REQUESTS:\n" + "\n".join(calls))
            normalized.append({"role": "assistant", "content": "\n\n".join(body_parts) or "TOOL REQUESTS:"})
            i += 1
            results = []
            while i < len(messages) and messages[i].get("role") == "tool":
                results.append(_compact_tool_result_for_model(messages[i]))
                i += 1
            if results:
                normalized.append({"role": "user", "content": "TOOL RESULTS:\n" + "\n\n".join(results)})
            continue
        if role == "tool":
            results = []
            while i < len(messages) and messages[i].get("role") == "tool":
                results.append(_compact_tool_result_for_model(messages[i]))
                i += 1
            normalized.append({"role": "user", "content": "TOOL RESULTS:\n" + "\n\n".join(results)})
            continue
        if role not in {"system", "user", "assistant"}:
            role = "user"
        normalized.append({"role": role, "content": str(message.get("content") or "")})
        i += 1
    return coalesce_consecutive_chat_roles(normalized)


def coalesce_consecutive_chat_roles(messages):
    coalesced = []
    for message in messages:
        role = message.get("role")
        content = str(message.get("content") or "")
        if coalesced and coalesced[-1].get("role") == role:
            previous = str(coalesced[-1].get("content") or "")
            coalesced[-1]["content"] = (previous + "\n\n" + content).strip()
            continue
        coalesced.append({"role": role, "content": content})
    return coalesced


def api_call(
    host,
    messages,
    use_tools=True,
    max_tokens=2048,
    tools=None,
):
    payload = {
        "model": MODEL,
        "messages": normalize_messages_for_strict_chat_template(messages),
        "temperature": 0,
        "max_tokens": max_tokens,
    }

    selected_tools = (
        TOOLS
        if tools is None
        else tools
    )

    if use_tools and selected_tools:
        payload["tools"] = selected_tools
        payload["tool_choice"] = "auto"

    bridge_socket = _model_bridge_socket_path()
    key = None
    req = None
    if not bridge_socket:
        key = llama_api_key()
        req = urllib.request.Request(
            f"http://{host}:{LLAMA_PORT}/v1/chat/completions",
            data=json.dumps(payload).encode(),
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Bearer {key}",
            },
        )

    started = _metrics_time.perf_counter()

    try:
        if bridge_socket:
            result = model_bridge_chat_completion(payload)
        else:
            with urllib.request.urlopen(
                req,
                timeout=180,
            ) as response:
                result = json.loads(
                    response.read().decode()
                )
    except urllib.error.HTTPError as e:
        duration_ms = (
            _metrics_time.perf_counter()
            - started
        ) * 1000.0

        message = model_api_http_error_message(e, api_key=key or "")
        record_metric_event({
            "type": "api",
            "duration_ms": round(duration_ms, 2),
            "error": "HTTPError",
            "http_status": int(e.code),
            "prompt_tokens": 0,
            "completion_tokens": 0,
            "total_tokens": 0,
            "max_tokens": max_tokens,
            "tool_schema_count": len(
                selected_tools
                if use_tools
                else []
            ),
        })
        record_trajectory_event(
            "model_call",
            "failed",
            reason_code="http_error",
            duration_ms=round(duration_ms, 2),
            error="HTTPError",
            prompt_tokens=0,
            completion_tokens=0,
            total_tokens=0,
            max_tokens=max_tokens,
            tool_schema_count=len(selected_tools if use_tools else []),
        )

        raise ModelAPIError(message) from None
    except Exception as e:
        duration_ms = (
            _metrics_time.perf_counter()
            - started
        ) * 1000.0

        record_metric_event({
            "type": "api",
            "duration_ms": round(duration_ms, 2),
            "error": type(e).__name__,
            "prompt_tokens": 0,
            "completion_tokens": 0,
            "total_tokens": 0,
            "max_tokens": max_tokens,
            "tool_schema_count": len(
                selected_tools
                if use_tools
                else []
            ),
        })
        record_trajectory_event(
            "model_call",
            "failed",
            reason_code="model_call_failed",
            duration_ms=round(duration_ms, 2),
            error=type(e).__name__,
            prompt_tokens=0,
            completion_tokens=0,
            total_tokens=0,
            max_tokens=max_tokens,
            tool_schema_count=len(selected_tools if use_tools else []),
        )

        raise

    duration_ms = (
        _metrics_time.perf_counter()
        - started
    ) * 1000.0

    usage = result.get("usage") or {}

    prompt_tokens = int(
        usage.get("prompt_tokens") or 0
    )
    completion_tokens = int(
        usage.get("completion_tokens") or 0
    )
    total_tokens = int(
        usage.get("total_tokens") or 0
    )
    tool_schema_count = len(
        selected_tools
        if use_tools
        else []
    )
    record_metric_event({
        "type": "api",
        "duration_ms": round(duration_ms, 2),
        "prompt_tokens": prompt_tokens,
        "completion_tokens": completion_tokens,
        "total_tokens": total_tokens,
        "max_tokens": max_tokens,
        "tool_schema_count": tool_schema_count,
    })
    choices = result.get("choices") or []
    first_message = (
        (choices[0].get("message") or {})
        if choices and isinstance(choices[0], dict)
        else {}
    )
    record_trajectory_event(
        "model_call",
        "succeeded",
        reason_code="model_response",
        duration_ms=round(duration_ms, 2),
        prompt_tokens=prompt_tokens,
        completion_tokens=completion_tokens,
        total_tokens=total_tokens,
        max_tokens=max_tokens,
        tool_schema_count=tool_schema_count,
        tool_call_count=len(first_message.get("tool_calls") or []),
    )

    return result


