def normalize_release_target(target=None):
    value = (target or VERSION).strip()
    if value.startswith("v"):
        tag = value
        version = value[1:]
    else:
        version = value
        tag = "v" + value
    return version, tag


def release_is_prerelease(target_version):
    version, _ = normalize_release_target(str(target_version))
    core = version.split("+", 1)[0]
    return "-" in core


def release_channel(target_version):
    return "prerelease" if release_is_prerelease(target_version) else "stable"


def collect_release_check(target=None):
    target_version, expected_tag = normalize_release_target(target)
    readiness = collect_readiness_status()
    branch = readiness["git"].get("branch")
    head = git_command_text(["rev-parse", "HEAD"])
    origin_main = git_command_text(["rev-parse", "origin/main"], default="[unavailable]")
    exact_tag = git_command_text(
        ["describe", "--tags", "--exact-match", "HEAD"],
        default="[none]",
    )
    latest_tag = git_command_text(
        ["describe", "--tags", "--abbrev=0"],
        default="[none]",
    )
    tag_target = git_command_text(
        ["rev-parse", f"{expected_tag}^{{}}"],
        default="[none]",
    )
    commands = release_validation_commands()
    checks = []

    def add_check(name, status, detail=""):
        checks.append({
            "name": name,
            "status": status,
            "detail": str(detail or "")[:500],
        })

    add_check(
        "version_target",
        "ok" if VERSION == target_version else "fail",
        f"current={VERSION} target={target_version}",
    )
    add_check(
        "git_status",
        "ok" if readiness["git"].get("clean") else "fail",
        readiness["git"].get("status"),
    )

    on_main = branch == "main"
    main_synced = on_main and origin_main != "[unavailable]" and head == origin_main
    if on_main:
        if origin_main == "[unavailable]":
            integration_status = "fail"
            integration_detail = "origin/main is unavailable; cannot prove the local main tag target"
        elif head != origin_main:
            integration_status = "fail"
            integration_detail = f"local main {head} differs from origin/main {origin_main}"
        else:
            integration_status = "ok"
            integration_detail = "local main matches the origin/main tracking ref"
    else:
        integration_status = "ok"
        integration_detail = f"candidate branch {branch}; merge through protected main before tagging"
    add_check("main_integration", integration_status, integration_detail)

    if tag_target != "[none]" and tag_target != head:
        tag_status = "fail"
        tag_detail = f"{expected_tag} points to {tag_target}, not HEAD {head}"
        phase = "blocked"
    elif tag_target == head and not main_synced:
        tag_status = "fail"
        tag_detail = f"{expected_tag} points to HEAD but tagging is invalid until synchronized main is checked out"
        phase = "blocked"
    elif tag_target == head:
        tag_status = "ok"
        tag_detail = "expected tag peels to synchronized main HEAD"
        phase = "released"
    elif on_main and main_synced:
        tag_status = "ok"
        tag_detail = "expected tag does not exist; synchronized main is the candidate tag target"
        phase = "ready_to_tag"
    elif on_main:
        tag_status = "fail"
        tag_detail = "expected tag does not exist but main integration evidence is invalid"
        phase = "blocked"
    else:
        tag_status = "ok"
        tag_detail = "expected tag does not exist; candidate must integrate through protected main before tagging"
        phase = "ready_for_integration"
    add_check("tag_state", tag_status, tag_detail)

    readiness_status = readiness.get("overall")
    add_check(
        "readiness",
        "ok" if readiness_status == "ready" else ("fail" if readiness_status == "blocked" else "warn"),
        readiness_status,
    )
    add_check(
        "validation_commands",
        "ok" if commands else "fail",
        ", ".join(commands),
    )
    add_check(
        "release_safety",
        "ok",
        "no tag, merge, push, upload, or publication was executed",
    )

    has_failure = any(check["status"] == "fail" for check in checks)
    has_warning = any(check["status"] == "warn" for check in checks)
    overall = "blocked" if has_failure else ("attention" if has_warning else "ready")
    if overall == "blocked":
        phase = "blocked"
    elif overall != "ready" and phase == "ready_to_tag":
        phase = "attention"

    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "target_version": target_version,
        "expected_tag": expected_tag,
        "release_channel": release_channel(target_version),
        "expected_prerelease": release_is_prerelease(target_version),
        "repository": str(ROOT),
        "branch": branch,
        "origin": readiness["git"].get("origin"),
        "head": head,
        "origin_main": origin_main,
        "exact_tag": exact_tag,
        "latest_tag": latest_tag,
        "tag_target": tag_target,
        "tag_ready": phase == "ready_to_tag" and overall == "ready",
        "phase": phase,
        "overall": overall,
        "readiness_overall": readiness_status,
        "validation_commands": commands,
        "checks": checks,
    }


def parse_release_check_args(args):
    raw = list(args)
    json_mode = "--json" in raw
    raw = [item for item in raw if item != "--json"]
    target = None
    if "--target" in raw:
        index = raw.index("--target")
        try:
            target = raw[index + 1]
        except Exception:
            raise SystemExit("Usage: lai release-check [--target VERSION] [--json]")
        del raw[index:index + 2]
    if raw:
        if len(raw) == 1 and not raw[0].startswith("-"):
            target = raw[0]
        else:
            raise SystemExit("Usage: lai release-check [--target VERSION] [--json]")
    return target, json_mode


