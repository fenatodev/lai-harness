    env = os.environ.copy()
    env.update({
        "LAI_METRICS_DIR": str(metrics_dir),
        "LAI_AUDIT_DIR": str(audit_dir),
        "LAI_STATE_DIR": str(state_dir),
        "PYTHONDONTWRITEBYTECODE": "1",
    })
    source_skills = Path(__file__).resolve().parent.parent / "skills"
    if source_skills.is_dir():
        env["LAI_SKILLS_DIR"] = str(source_skills)

    command = [
        sys.executable,
        str(Path(__file__).resolve()),
        f"--{fixture['mode']}",
        str(fixture["prompt"]),
    ]
    started = time.monotonic()
    try:
        proc = subprocess.run(
            command,
            cwd=repo,
            env=env,
            text=True,
            capture_output=True,
            timeout=300,
        )
    except subprocess.TimeoutExpired as exc:
        proc = subprocess.CompletedProcess(
            command,
            124,
            stdout=exc.stdout or "",
            stderr=(exc.stderr or "") + "\nmodel evaluation timeout",
        )
    latency_ms = round((time.monotonic() - started) * 1000, 2)

    final_diff = model_evaluation_git(repo, "diff", "--binary").stdout
    final_paths = model_evaluation_changed_paths(repo)
    validation_proc = None
    validation_profile = (fixture.get("expected") or {}).get("validation_profile")
    validation_argv = model_evaluation_validation_argv(validation_profile)
    if validation_argv:
        validation_proc = subprocess.run(
            validation_argv,
            cwd=repo,
            env=env,
            text=True,
            capture_output=True,
            timeout=60,
        )
    evaluated = model_evaluation_validate_result(
        fixture,
        proc,
        baseline_diff,
        baseline_paths,
        final_diff,
        final_paths,
        validation_proc,
    )
    metrics_events = model_evaluation_read_events(metrics_dir / "events.jsonl")
    audit_events = model_evaluation_read_events(audit_dir / "events.jsonl")
    measured = model_evaluation_measure_events(metrics_events, audit_events)
    notes = "; ".join(evaluated["failures"])
    if validation_proc is not None and validation_proc.returncode != 0:
        validator_tail = ((validation_proc.stdout or "") + "\n" + (validation_proc.stderr or "")).strip()
        if validator_tail:
            notes = (notes + "; " if notes else "") + "validator=" + validator_tail[-400:].replace("\n", " | ")

    return {
        "model": server_profile["model_alias"],
        "scenario": fixture["id"],
        "outcome": evaluated["outcome"],
        "validation": evaluated["validation"],
        "latency_ms": latency_ms,
        "prompt_tokens": measured["prompt_tokens"],
        "completion_tokens": measured["completion_tokens"],
        "tool_calls": measured["tool_calls"],
        "truncation_retries": measured["truncation_retries"],
        "policy_blocks": measured["policy_blocks"],
        "hallucination_flags": evaluated["hallucination_flags"],
        "notes": notes[:1200],
        "agent_exit_code": proc.returncode,
        "changed_paths": final_paths,
        "response_sha256": hashlib.sha256(evaluated["output"].encode("utf-8")).hexdigest(),
        "response_excerpt": evaluated["output"].strip()[-1600:],
    }


def parse_model_evaluation_run_args(args):
    json_mode = False
    scenarios = []
    repeat = 1
    index = 0
    while index < len(args):
        item = args[index]
        if item == "--json":
            json_mode = True
            index += 1
            continue
        if item == "--scenario":
            if index + 1 >= len(args):
                raise SystemExit("Missing value for --scenario")
            scenarios.append(args[index + 1])
            index += 2
            continue
        if item == "--repeat":
            if index + 1 >= len(args):
                raise SystemExit("Missing value for --repeat")
            try:
                repeat = int(args[index + 1])
            except ValueError as exc:
                raise SystemExit("--repeat must be an integer from 1 to 5") from exc
            if repeat < 1 or repeat > 5:
                raise SystemExit("--repeat must be an integer from 1 to 5")
            index += 2
            continue
        raise SystemExit("Usage: lai model run [--scenario ID] [--repeat 1..5] [--json]")
    return {"json": json_mode, "scenarios": scenarios, "repeat": repeat}


def model_evaluation_source_state():
    head = subprocess.run(
        ["git", "rev-parse", "HEAD"],
        cwd=ROOT, text=True, capture_output=True, timeout=10,
    )
    status = subprocess.run(
        ["git", "status", "--porcelain=v1", "-z"],
        cwd=ROOT, text=True, capture_output=True, timeout=10,
    )
    if head.returncode != 0 or status.returncode != 0:
        raise ValueError("model evaluation requires a Git repository")
    return {"head": head.stdout.strip(), "status": status.stdout}


def run_model_evaluation(args):
    options = parse_model_evaluation_run_args(args)
    fixture_payload = load_model_evaluation_fixtures()
    fixtures = fixture_payload["fixtures"]
    by_id = {fixture["id"]: fixture for fixture in fixtures}
    selected_ids = list(dict.fromkeys(
        options["scenarios"] or [fixture["id"] for fixture in fixtures]
    ))
    unknown = [item for item in selected_ids if item not in by_id]
    if unknown:
        raise SystemExit("Unknown model evaluation scenario(s): " + ", ".join(unknown))

    source_before = model_evaluation_source_state()
    fixture_file = model_evaluation_fixture_file()
    fixture_sha256 = hashlib.sha256(fixture_file.read_bytes()).hexdigest()
    server_profile = model_evaluation_server_profile()
    hardware_profile = model_evaluation_hardware_profile(server_profile)
    result_dir = model_evaluation_result_dir()
    result_dir.mkdir(parents=True, exist_ok=True)
    try:
        result_dir.chmod(0o700)
    except OSError:
        pass

    run_id = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + "-" + secrets.token_hex(4)
    stem = run_id + "-" + model_evaluation_slug(server_profile["model_alias"])
    results_path = result_dir / f"{stem}.jsonl"
    summary_path = result_dir / f"{stem}.summary.json"

    records = []
    with tempfile.TemporaryDirectory(prefix="lai-model-eval-") as temp_dir:
        run_root = Path(temp_dir)
        for sample_index in range(1, options["repeat"] + 1):
            for scenario_id in selected_ids:
                record = run_model_evaluation_fixture(
                    by_id[scenario_id], run_root / f"sample-{sample_index}", server_profile
                )
                record["sample_index"] = sample_index
                records.append(record)

    source_after = model_evaluation_source_state()
    if source_after != source_before:
        raise ValueError("source repository changed during model evaluation")

    results_path.write_text(
        "\n".join(json.dumps(record, ensure_ascii=False, sort_keys=True) for record in records) + "\n",
        encoding="utf-8",
    )
    average_score = (
        sum(score_model_evaluation_record(normalize_model_eval_record(record, index + 1)) for index, record in enumerate(records))
        / len(records)
    ) if records else 0.0
    executable = Path(__file__).resolve()
    try:
        executable.relative_to(ROOT.resolve())
        harness_commit = source_before["head"]
    except ValueError:
        harness_commit = None
    source_clean = not bool(source_before["status"])
    summary = {
        "schema_version": MODEL_EVALUATION_RUN_SCHEMA_VERSION,
        "product": PRODUCT_NAME,
        "version": VERSION,
        "evaluation_run_id": run_id,
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "fixture_schema_version": fixture_payload["schema_version"],
        "fixture_sha256": fixture_sha256,
        "harness_executable_sha256": hashlib.sha256(executable.read_bytes()).hexdigest(),
        "harness_commit": harness_commit,
        "evaluation_repository_commit": source_before["head"],
        "source_clean": source_clean,
        "model": server_profile["model_alias"],
        "server": server_profile,
        "hardware": hardware_profile,
        "scenarios": selected_ids,
        "repeat": options["repeat"],
        "decision_eligible": (
            source_clean
            and options["repeat"] >= 2
            and set(selected_ids) == MODEL_EVALUATION_MODEL_BACKED_SCENARIOS
        ),
        "average_score": round(average_score, 2),
        "results_path": str(results_path),
        "summary_path": str(summary_path),
    }
    summary_path.write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return summary, records, options["json"]


def render_model_evaluation_run(summary, records, json_mode=False):
    if json_mode:
        return json.dumps({**summary, "records": records}, indent=2, sort_keys=True)
    lines = [
        "# lai model evaluation run",
        f"Model: {summary['model']}",
        f"Evaluation run: {summary['evaluation_run_id']}",
        f"Average score: {summary['average_score']:.1f}",
        f"Repeat: {summary['repeat']}",
        f"Decision eligible: {'yes' if summary['decision_eligible'] else 'no'}",
        f"Results: {summary['results_path']}",
        f"Summary: {summary['summary_path']}",
        "",
        "Scenarios:",
    ]
    for record in records:
        lines.append(
            f"- {record['scenario']}[sample={record.get('sample_index', 1)}]: "
            f"{record['outcome']} / {record['validation']} "
            f"score={score_model_evaluation_record(normalize_model_eval_record(record, 1)):.1f} "
            f"latency_ms={record['latency_ms']:.0f} tools={record['tool_calls']} "
            f"hallucinations={record['hallucination_flags']}"
        )
        if record.get("notes"):
            lines.append(f"  notes: {record['notes']}")
    lines.extend([
        "",
        "Safety:",
        "- The runner evaluated only the already-loaded model.",
        "- It did not download, start, stop, switch, or select a default model.",
        "- Fixture repositories were disposable and removed after evaluation.",
    ])
    return "\n".join(lines)


UPDATE_INTELLIGENCE_SCHEMA_VERSION = 1
UPDATE_ALLOWED_HOSTS = {"api.github.com", "pypi.org", "registry.npmjs.org"}
UPDATE_MAX_RESPONSE_BYTES = 8 * 1024 * 1024
UPDATE_HTTP_TIMEOUT = 10
UPDATE_RESULT_RETENTION = 30
UPDATE_SOURCE_TYPES = {"pypi", "npm", "github-release", "dependabot"}
UPDATE_CATEGORIES = {
    "dev-sensor", "harness-tool", "runtime", "managed-dependency", "reference-agent"
}
UPDATE_CURRENT_DETECTORS = {
    "dev-pin", "harness-score-pin", "llama-props-build", "dependabot", "none"
}
UPDATE_SECURITY_SOURCES = {"pypi-release", "dependabot", "none"}
UPDATE_SOURCE_MANIFEST = Path(__file__).resolve().parent.parent / "updates" / "sources-v1.json"


def update_intelligence_dir():
    return DATA_BASE / "update-intelligence"


def update_source_manifest_file():
    if UPDATE_SOURCE_MANIFEST.is_file():
        return UPDATE_SOURCE_MANIFEST
    return update_intelligence_dir() / "sources-v1.json"


def running_from_source_checkout():
    candidate = ROOT / "src" / "local-agent"
    try:
        return candidate.is_file() and candidate.resolve() == Path(__file__).resolve()
    except OSError:
        return False


def parse_update_dev_pins():
    path = ROOT / "requirements-dev.in"
    if not running_from_source_checkout() or not path.is_file():
        return {}
    pins = {}
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.split("#", 1)[0].strip()
        match = re.match(r"^([A-Za-z0-9_.-]+)==([^\s]+)$", line)
        if match:
            pins[match.group(1).lower()] = match.group(2)
    return pins


def parse_update_harness_score_pin():
    path = ROOT / "Makefile"
    if not running_from_source_checkout() or not path.is_file():
        return None
    match = re.search(
        r"harness-score@([0-9]+(?:\.[0-9]+){1,3}(?:[-+][A-Za-z0-9._-]+)?)",
        path.read_text(encoding="utf-8"),
    )
    return match.group(1) if match else None


def update_source_current_version(source, *, allow_server=False):
    detector = source["current_detector"]
    if detector == "dev-pin":
        current = parse_update_dev_pins().get(str(source.get("package", "")).lower())
        return current or source.get("current_version")
    if detector == "harness-score-pin":
        return parse_update_harness_score_pin() or source.get("current_version")
    if detector == "dependabot":
        return "managed"
    if detector == "llama-props-build":
        return update_llama_cpp_build() if allow_server else None
    return None


def load_update_sources():
    path = update_source_manifest_file()
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError(f"invalid update source manifest: {exc}") from exc
    if payload.get("schema_version") != 1 or not isinstance(payload.get("sources"), list):
        raise ValueError("unsupported update source manifest schema")
    policy = payload.get("policy") or {}
    if policy != {
        "automatic_apply": False,
        "arbitrary_urls": False,
        "reference_upstreams_are_dependencies": False,
    }:
        raise ValueError("update source manifest policy must remain fail-closed")

    seen = set()
    dev_pins = parse_update_dev_pins()
    harness_pin = parse_update_harness_score_pin()
    for source in payload["sources"]:
        if not isinstance(source, dict):
            raise ValueError("update sources must be objects")
        source_id = str(source.get("id") or "")
        if not re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,79}", source_id):
            raise ValueError(f"invalid update source id: {source_id!r}")
        if source_id in seen:
            raise ValueError(f"duplicate update source id: {source_id}")
        seen.add(source_id)
        source_type = source.get("source_type")
        category = source.get("category")
        detector = source.get("current_detector")
        security_source = source.get("security_source")
        if source_type not in UPDATE_SOURCE_TYPES:
            raise ValueError(f"unsupported update source type for {source_id}")
        if category not in UPDATE_CATEGORIES:
            raise ValueError(f"unsupported update category for {source_id}")
        if detector not in UPDATE_CURRENT_DETECTORS:
            raise ValueError(f"unsupported current detector for {source_id}")
        if security_source not in UPDATE_SECURITY_SOURCES:
            raise ValueError(f"unsupported security source for {source_id}")

        if source_type == "pypi":
            package = str(source.get("package") or "")
            if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", package):
                raise ValueError(f"invalid PyPI package for {source_id}")
        elif source_type == "npm":
            package = str(source.get("package") or "")
            if not re.fullmatch(r"(?:@[A-Za-z0-9._-]+/)?[A-Za-z0-9._-]+", package):
                raise ValueError(f"invalid npm package for {source_id}")
        elif source_type == "github-release":
            repository = str(source.get("repository") or "")
            if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repository):
                raise ValueError(f"invalid GitHub repository for {source_id}")
        elif detector != "dependabot":
            raise ValueError(f"dependabot source {source_id} requires dependabot detector")

        declared_current = source.get("current_version")
        if detector == "dev-pin" and running_from_source_checkout():
            observed = dev_pins.get(str(source.get("package", "")).lower())
            if not observed or declared_current != observed:
                raise ValueError(
                    f"update manifest pin drift for {source_id}: manifest={declared_current} repo={observed}"
                )
        if detector == "harness-score-pin" and running_from_source_checkout():
            if not harness_pin or declared_current != harness_pin:
                raise ValueError(
                    f"update manifest pin drift for {source_id}: manifest={declared_current} repo={harness_pin}"
                )
        if category == "reference-agent" and detector != "none":
            raise ValueError(f"reference upstream {source_id} cannot be treated as installed")

    payload["manifest_path"] = str(path)
    payload["manifest_sha256"] = hashlib.sha256(path.read_bytes()).hexdigest()
    return payload


class UpdateNoRedirectHandler(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def update_http_json(url):
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme != "https" or parsed.hostname not in UPDATE_ALLOWED_HOSTS:
        raise ValueError("update source URL is not on the fixed HTTPS allowlist")
    if parsed.username or parsed.password or parsed.fragment:
        raise ValueError("update source URL contains forbidden URL components")
    headers = {
        "Accept": "application/json",
        "User-Agent": f"lai-harness/{VERSION}",
    }
    request = urllib.request.Request(url, headers=headers, method="GET")
    opener = urllib.request.build_opener(UpdateNoRedirectHandler())
    try:
        with opener.open(request, timeout=UPDATE_HTTP_TIMEOUT) as response:
            final = urllib.parse.urlparse(response.geturl())
            if final.scheme != "https" or final.hostname not in UPDATE_ALLOWED_HOSTS:
                raise ValueError("update response escaped the fixed HTTPS allowlist")
            content_type = ""
            if getattr(response, "headers", None) is not None:
                try:
                    content_type = response.headers.get_content_type()
                except AttributeError:
                    content_type = str(response.headers.get("Content-Type") or "").split(";", 1)[0]
                length = response.headers.get("Content-Length")
                if length and int(length) > UPDATE_MAX_RESPONSE_BYTES:
                    raise ValueError("update response exceeds size limit")
            if content_type and content_type not in {"application/json", "application/vnd.github+json"}:
                raise ValueError(f"update response is not JSON: {content_type}")
            raw = response.read(UPDATE_MAX_RESPONSE_BYTES + 1)
    except urllib.error.HTTPError as exc:
        raise ValueError(f"update source HTTP {exc.code}") from exc
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        raise ValueError(f"update source unavailable: {exc}") from exc
    if len(raw) > UPDATE_MAX_RESPONSE_BYTES:
        raise ValueError("update response exceeds size limit")
    try:
        return json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ValueError("update response contains invalid JSON") from exc


def update_llama_cpp_build():
    try:
        api_key = llama_api_key()
        request = urllib.request.Request(
            f"http://{gateway()}:{LLAMA_PORT}/props",
            headers={"Authorization": f"Bearer {api_key}"},
            method="GET",
        )
        with urllib.request.urlopen(request, timeout=5) as response:
            payload = json.loads(response.read(256 * 1024).decode("utf-8"))
    except (RuntimeError, OSError, urllib.error.URLError, urllib.error.HTTPError, json.JSONDecodeError):
        return None
    build_info = str(payload.get("build_info") or "").strip()
    match = re.match(r"^(b\d+)(?:[-+].*)?$", build_info)
    return match.group(1) if match else None


def update_version_key(value):
    text = str(value or "").strip()
    build = re.match(r"^b(\d+)(?:[-+].*)?$", text, flags=re.IGNORECASE)
    if build:
        return ("build", (int(build.group(1)),))
    semver = re.match(r"^v?(\d+)(?:\.(\d+))?(?:\.(\d+))?(?:\.(\d+))?", text)
    if semver:
        parts = tuple(int(part or 0) for part in semver.groups())
        return ("numeric", parts)
    return None


def classify_update_version(current, latest, *, reference=False):
    if reference:
        return "observed"
    if current in (None, ""):
        return "current_unknown"
    if latest in (None, ""):
        return "latest_unknown"
    if str(current).lstrip("v") == str(latest).lstrip("v"):
        return "current"
    current_key = update_version_key(current)
    latest_key = update_version_key(latest)
    if current_key and latest_key and current_key[0] == latest_key[0]:
        if latest_key[1] > current_key[1]:
            return "update_available"
        if latest_key[1] < current_key[1]:
            return "ahead_of_latest"
    return "version_changed_manual_review"


def update_change_scope(current, latest):
    current_key = update_version_key(current)
    latest_key = update_version_key(latest)
    if not current_key or not latest_key or current_key[0] != latest_key[0]:
        return "unknown"
    if current_key[0] == "build":
        return "build"
    current_parts = tuple(current_key[1])
    latest_parts = tuple(latest_key[1])
    if latest_parts == current_parts:
        return "none"
    if latest_parts[0] != current_parts[0]:
        return "major"
    if latest_parts[1] != current_parts[1]:
        return "minor"
    if latest_parts[2] != current_parts[2]:
        return "patch"
    return "revision"


def triage_update_record(record):
    status = str(record.get("status") or "unknown")
    security = str(record.get("security_status") or "unknown")
    vulnerabilities = int(record.get("vulnerability_count") or 0)
    category = str(record.get("category") or "unknown")
    scope = update_change_scope(record.get("current_version"), record.get("latest_version"))
    reasons = []

    if security == "vulnerable" or vulnerabilities > 0:
        priority, urgency, action = "security", "immediate", "review_security_update"
        reasons.append("known_vulnerability")
    elif status == "check_failed":
        priority, urgency, action = "visibility", "medium", "investigate_source_failure"
        reasons.append("source_check_failed")
    elif status == "version_changed_manual_review":
        priority, urgency, action = "compatibility", "medium", "manual_compatibility_review"
        reasons.append("incomparable_version_scheme")
    elif status == "update_available":
        priority = "maintenance"
        if scope == "patch":
            urgency, action = "low", "schedule_maintenance"
        elif scope == "minor":
            urgency, action = "medium", "review_maintenance_update"
        else:
            urgency, action = "high", "manual_compatibility_review"
        reasons.extend(["update_available", f"scope_{scope}"])
    elif status in {"current_unknown", "latest_unknown"}:
        priority, urgency, action = "visibility", "low", "improve_version_detection"
        reasons.append(status)
    elif status == "managed_by_dependabot":
        priority, urgency, action = "managed", "informational", "review_managed_proposals"
        reasons.append("managed_by_dependabot")
    elif category == "reference-agent":
        priority = "reference"
        if record.get("changed_since_last_check") is True:
            urgency, action = "informational", "evaluate_if_relevant"
            reasons.append("reference_changed")
        else:
            urgency, action = "none", "observe"
            reasons.append("reference_observed")
    else:
        priority, urgency, action = "current", "none", "none"
        reasons.append(status)

    return {
        "id": str(record.get("id") or "unknown"),
        "category": category,
        "priority": priority,
        "urgency": urgency,
        "action": action,
        "reason_codes": reasons,
        "change_scope": scope,
        "current_version": record.get("current_version"),
        "latest_version": record.get("latest_version"),
        "status": status,
        "security_status": security,
        "vulnerability_count": vulnerabilities,
        "changed_since_last_check": record.get("changed_since_last_check"),
        "source_url": str(record.get("source_url") or ""),
    }


def update_triage_evidence_status(summary):
    manifest = load_update_sources()
    snapshot_version = str(summary.get("version") or "")
    current_version = VERSION
    snapshot_manifest_sha256 = str(summary.get("manifest_sha256") or "")
    current_manifest_sha256 = str(manifest.get("manifest_sha256") or "")
    reasons = []
    if not snapshot_version:
        reasons.append("snapshot_version_missing")
    elif snapshot_version != current_version:
        reasons.append("snapshot_version_mismatch")
    if not snapshot_manifest_sha256:
        reasons.append("snapshot_manifest_missing")
    elif snapshot_manifest_sha256 != current_manifest_sha256:
        reasons.append("snapshot_manifest_mismatch")
    return {
        "status": "stale" if reasons else "current",
        "reason_codes": reasons,
        "snapshot_version": snapshot_version or None,
        "current_version": current_version,
        "snapshot_manifest_sha256": snapshot_manifest_sha256 or None,
        "current_manifest_sha256": current_manifest_sha256 or None,
        "refresh_command": "lai update check --remote",
    }


def build_update_triage(summary):
    urgency_order = {"immediate": 0, "high": 1, "medium": 2, "low": 3, "informational": 4, "none": 5}
    priority_order = {"security": 0, "compatibility": 1, "visibility": 2, "maintenance": 3, "reference": 4, "managed": 5, "current": 6}
    evidence = update_triage_evidence_status(summary)
    if evidence["status"] == "stale":
        items = [{
            "id": "update-evidence",
            "category": "maintenance-evidence",
            "priority": "visibility",
            "urgency": "medium",
            "action": "refresh_update_evidence",
            "reason_codes": list(evidence["reason_codes"]),
            "change_scope": "unknown",
            "current_version": evidence["snapshot_version"],
            "latest_version": evidence["current_version"],
            "status": "stale_evidence",
            "security_status": "unknown",
            "vulnerability_count": 0,
            "changed_since_last_check": None,
            "source_url": "",
        }]
        overall = "refresh_required"
    else:
        items = [triage_update_record(record) for record in summary.get("sources", []) if isinstance(record, dict)]
        items.sort(key=lambda item: (
            urgency_order.get(item["urgency"], 9),
            priority_order.get(item["priority"], 9),
            item["id"],
        ))
        priorities = {item["priority"] for item in items}
        if "security" in priorities:
            overall = "security_attention"
        elif "compatibility" in priorities or any(item["priority"] == "visibility" and item["urgency"] == "medium" for item in items):
            overall = "review_required"
        elif "maintenance" in priorities:
            overall = "maintenance_available"
        elif any(item["priority"] == "reference" and item["changed_since_last_check"] is True for item in items):
            overall = "reference_changes"
        else:
            overall = "current"
    return {
        "schema_version": 1,
        "product": PRODUCT_NAME,
        "version": VERSION,
        "mode": "offline-triage",
        "network": "disabled",
        "source_check_id": summary.get("check_id"),
        "source_created_at": summary.get("created_at"),
        "source_result_path": summary.get("result_path"),
        "overall": overall,
        "evidence": evidence,
        "counts": {
            key: sum(1 for item in items if item["priority"] == key)
            for key in ("security", "compatibility", "visibility", "maintenance", "reference", "managed", "current")
        },
        "items": items,
        "policy": {
            "release_notes_used_for_priority": False,
            "automatic_apply": False,
            "automatic_refresh": False,
            "model_call": False,
            "stale_source_actions_suppressed": evidence["status"] == "stale",
        },
    }


def update_release_excerpt(value, limit=1600):
    text = str(value or "").replace("\x00", "")
