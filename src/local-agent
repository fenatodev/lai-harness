def plan_active_spec_fast_path_response(task, active_spec=None, ranked_context=None):
    """Answer simple active-spec planning orientation without a model round trip."""
    if active_spec is None:
        return None

    task_lower = str(task or "").lower()
    simple_terms = (
        "next high-value", "highest-value", "next milestone",
        "próximo milestone", "proximo milestone", "próxima etapa",
        "proxima etapa", "likely files", "files and tests",
        "arquivos e testes", "where to modify", "onde modificar",
        "implementation-facing plan", "workplan",
    )
    mutation_terms = (
        "edit", "modify files", "patch", "rewrite", "implement now",
        "make changes", "apply", "corrija agora", "implemente agora",
        "edite", "modifique", "altere arquivos",
    )
    negated_mutation_phrases = (
        "do not edit", "don't edit", "do not modify", "don't modify",
        "do not patch", "don't patch", "do not rewrite", "don't rewrite",
        "do not make changes", "don't make changes",
        "sem editar", "não edite", "nao edite",
        "sem modificar", "não modifique", "nao modifique",
        "sem alterar arquivos", "não altere arquivos", "nao altere arquivos",
    )
    mutation_task = task_lower
    for phrase in negated_mutation_phrases:
        mutation_task = mutation_task.replace(phrase, "")

    if not _task_mentions_any(task_lower, simple_terms):
        return None
    if _task_mentions_any(mutation_task, mutation_terms):
        return None

    candidate_by_path = {}
    for index, candidate in enumerate(ranked_context or []):
        path = str(candidate.get("path") or "[unknown]")
        candidate_by_path[path] = {
            "path": path,
            "score": int(candidate.get("score") or 0),
            "reasons": list(candidate.get("reasons") or []),
            "index": index,
        }

    for changed_path in sorted(context_git_changed_paths()):
        if not (
            changed_path.startswith("src/")
            or changed_path.startswith("tests/")
            or changed_path.startswith(".specs/")
            or changed_path.startswith("docs/M1-")
        ):
            continue
        if changed_path not in candidate_by_path:
            candidate_by_path[changed_path] = {
                "path": changed_path,
                "score": 0,
                "reasons": ["git_changed"],
                "index": 999,
            }

    def plan_candidate_priority(candidate):
        path = str(candidate.get("path") or "")
        if path.startswith("src/"):
            group = 0
        elif path.startswith("tests/"):
            group = 1
        elif path.startswith(".specs/"):
            group = 2
        elif path.startswith("docs/M1-"):
            group = 3
        elif path in {"CHANGELOG.md", "ROADMAP.md"}:
            group = 5
        else:
            group = 4
        return (group, -int(candidate.get("score") or 0), int(candidate.get("index") or 0), path)

    candidates = sorted(candidate_by_path.values(), key=plan_candidate_priority)
    candidate_lines = []
    for candidate in candidates[:6]:
        path = str(candidate.get("path") or "[unknown]")
        reasons = ",".join(str(item) for item in candidate.get("reasons") or [])
        suffix = f" [{reasons}]" if reasons else ""
        candidate_lines.append(f"- {path}{suffix}")
    if not candidate_lines:
        candidate_lines.append("- [no ranked candidates available]")

    checks = context_checks_payload(limit=12)
    targets = checks.get("make_targets") or []
    target_names = []
    for item in targets[:6]:
        name = item.get("name") if isinstance(item, dict) else item
        if name:
            target_names.append(str(name))
    if not target_names:
        target_names = ["make check"]

    requirements = ", ".join(active_spec.get("requirements") or []) or "[none]"
    lines = [
        "PLAN PREFLIGHT RESULT",
        "source: active spec and deterministic context metadata",
        "active_spec: " + str(active_spec.get("title") or "[unknown]"),
        "workflow: " + str(active_spec.get("mode") or "[unknown]"),
        "requirements: " + requirements,
        "goal: follow the active spec before opening new Gateway/UI polish work.",
        "candidate_files:",
        *candidate_lines,
        "validation:",
        "- focused context/spec/diagnose tests",
        "- " + ", ".join(target_names[:4]),
        "next_step: validate this M1 cut, then use measured dogfood to decide whether broader model-backed planning still needs context improvements.",
        "files_modified: false",
    ]
    return "\n".join(lines)


