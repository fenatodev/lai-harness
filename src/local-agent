def _context_rel_path_safe(rel):
    value = str(rel or "").replace("\\", "/").strip()
    while value.startswith("./"):
        value = value[2:]
    if not value or "\0" in value or len(value) > 300:
        return None
    path = PurePosixPath(value)
    if path.is_absolute() or ".." in path.parts:
        return None
    if any(part in CONTEXT_IGNORED_DIRS for part in path.parts):
        return None
    return path.as_posix()


def _git_shortstat(args):
    try:
        proc = subprocess.run(
            ["git", *args, "--shortstat"],
            cwd=ROOT, text=True, capture_output=True, timeout=10,
        )
    except Exception:
        return ""
    if proc.returncode != 0:
        return ""
    return " ".join(proc.stdout.strip().split())[:240]


def context_git_changes_payload(limit=60):
    limit = max(1, min(int(limit), 200))
    entries = []
    try:
        proc = subprocess.run(
            ["git", "status", "--porcelain=v1", "--untracked-files=all"],
            cwd=ROOT, text=True, capture_output=True, timeout=10,
        )
    except Exception as exc:
        return {
            "product": PRODUCT_NAME,
            "version": VERSION,
            "changes_version": 1,
            "repository": ".",
            "metadata_only": True,
            "overall": "unknown",
            "error": type(exc).__name__,
            "entries": [],
            "entry_count": 0,
            "entry_limit": limit,
            "entry_list_truncated": False,
            "counts": {"staged": 0, "unstaged": 0, "untracked": 0},
            "shortstat": {"unstaged": "", "staged": ""},
        }
    if proc.returncode != 0:
        return {
            "product": PRODUCT_NAME,
            "version": VERSION,
            "changes_version": 1,
            "repository": ".",
            "metadata_only": True,
            "overall": "unknown",
            "error": "git_status_failed",
            "entries": [],
            "entry_count": 0,
            "entry_limit": limit,
            "entry_list_truncated": False,
            "counts": {"staged": 0, "unstaged": 0, "untracked": 0},
            "shortstat": {"unstaged": "", "staged": ""},
        }
    counts = {"staged": 0, "unstaged": 0, "untracked": 0}
    for line in proc.stdout.splitlines():
        if len(line) < 4:
            continue
        index_status = line[0]
        worktree_status = line[1]
        raw_path = line[3:]
        if " -> " in raw_path:
            raw_path = raw_path.split(" -> ", 1)[1]
        rel = _context_rel_path_safe(raw_path)
        if rel is None:
            continue
        staged = index_status not in {" ", "?"}
        unstaged = worktree_status not in {" ", "?"}
        untracked = index_status == "?" and worktree_status == "?"
        if staged:
            counts["staged"] += 1
        if unstaged:
            counts["unstaged"] += 1
        if untracked:
            counts["untracked"] += 1
        entries.append({
            "path": rel,
            "index_status": index_status,
            "worktree_status": worktree_status,
            "staged": staged,
            "unstaged": unstaged,
            "untracked": untracked,
        })
    entries.sort(key=lambda item: item["path"])
    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "changes_version": 1,
        "repository": ".",
        "metadata_only": True,
        "overall": "clean" if not entries else "dirty",
        "entries": entries[:limit],
        "entry_count": len(entries),
        "entry_limit": limit,
        "entry_list_truncated": len(entries) > limit,
        "counts": counts,
        "shortstat": {
            "unstaged": _git_shortstat(["diff"]),
            "staged": _git_shortstat(["diff", "--cached"]),
        },
        "trust": "Metadata-only Git status summary. Inspect diffs before relying on code changes.",
    }


