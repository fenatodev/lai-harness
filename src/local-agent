def model_evaluation_claim_flags(output, baseline_diff, final_diff, validation_returncode, fixture):
    flags = []
    expected = fixture.get("expected") or {}
    if not expected.get("read_only"):
        claimed_edit = re.search(
            r"\b(implemented|changed|updated|replaced|edited|modified|fixed)\b",
            output,
            flags=re.IGNORECASE,
        )
        if claimed_edit and final_diff == baseline_diff:
            flags.append("claimed_edit_without_diff")
        claimed_validation = re.search(
            r"\b(tests?|validation)\b.{0,40}\b(pass(?:ed)?|successful|success|ok)\b",
            output,
            flags=re.IGNORECASE | re.DOTALL,
        )
        if claimed_validation and validation_returncode not in (None, 0):
            flags.append("claimed_validation_success_but_validator_failed")

    max_lines = 0
    for content in (fixture.get("files") or {}).values():
        max_lines = max(max_lines, len(str(content).splitlines()))
    for content in (fixture.get("pre_run_changes") or {}).values():
        max_lines = max(max_lines, len(str(content).splitlines()))
    cited = [int(value) for value in re.findall(r"\bline\s+(\d+)\b", output, flags=re.IGNORECASE)]
    if cited and max(cited) > max_lines:
        flags.append("impossible_line_reference")
    return sorted(set(flags))


def model_evaluation_validate_result(fixture, proc, baseline_diff, baseline_paths, final_diff, final_paths, validation_proc):
    expected = fixture.get("expected") or {}
    output = (proc.stdout or "") + "\n" + (proc.stderr or "")
    failures = []

    if proc.returncode != 0:
        failures.append(f"agent_exit={proc.returncode}")
    if expected.get("read_only") and final_diff != baseline_diff:
        failures.append("read_only_diff_changed")
    if expected.get("read_only") and final_paths != baseline_paths:
        failures.append("read_only_status_changed")

    expected_paths = sorted(expected.get("expected_changed_paths") or [])
    if expected_paths and final_paths != expected_paths:
        failures.append(
            "changed_paths=" + ",".join(final_paths) + ";expected=" + ",".join(expected_paths)
        )

    for pattern in expected.get("required_output_patterns") or []:
        if not re.search(pattern, output, flags=re.IGNORECASE | re.DOTALL):
            failures.append(f"missing_output_pattern={pattern}")

    validation_returncode = validation_proc.returncode if validation_proc is not None else None
    if validation_proc is not None and validation_proc.returncode != 0:
        failures.append(f"validator_exit={validation_proc.returncode}")

    claim_flags = model_evaluation_claim_flags(
        output,
        baseline_diff,
        final_diff,
        validation_returncode,
        fixture,
    )
    failures.extend(f"hallucination={item}" for item in claim_flags)

    validation = "pass" if not failures else "fail"
    if proc.returncode != 0 or (validation_proc is not None and validation_proc.returncode != 0):
        outcome = "fail"
    elif failures:
        outcome = "partial"
    else:
        outcome = "pass"
    return {
        "outcome": outcome,
        "validation": validation,
        "hallucination_flags": len(claim_flags),
        "failures": failures,
        "output": output,
    }


