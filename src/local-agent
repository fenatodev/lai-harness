def release_pack_slug(value):
    text = str(value or "release").strip().lower()
    text = re.sub(r"[^a-z0-9_.-]+", "-", text)
    text = text.strip(".-")
    return text or "release"


def release_pack_path_is_inside(path, base):
    try:
        path.resolve().relative_to(base.resolve())
        return True
    except ValueError:
        return False


def release_pack_default_dir(expected_tag):
    return RELEASE_PACK_DEFAULT_BASE / f"lai-harness-release-pack-{release_pack_slug(expected_tag)}"


def parse_release_pack_args(args):
    raw = list(args)
    json_mode = False
    include_vsix = False
    force = False
    out_dir = None
    target = None

    index = 0
    positional = []
    while index < len(raw):
        item = raw[index]
        if item == "--json":
            json_mode = True
        elif item == "--with-vsix":
            include_vsix = True
        elif item == "--force":
            force = True
        elif item == "--target":
            index += 1
            if index >= len(raw):
                raise SystemExit("Usage: lai release-pack [--target VERSION] [--out DIR] [--with-vsix] [--force] [--json]")
            target = raw[index]
        elif item == "--out":
            index += 1
            if index >= len(raw):
                raise SystemExit("Usage: lai release-pack [--target VERSION] [--out DIR] [--with-vsix] [--force] [--json]")
            out_dir = raw[index]
        elif item.startswith("-"):
            raise SystemExit("Usage: lai release-pack [--target VERSION] [--out DIR] [--with-vsix] [--force] [--json]")
        else:
            positional.append(item)
        index += 1

    if positional:
        if len(positional) == 1 and target is None:
            target = positional[0]
        else:
            raise SystemExit("Usage: lai release-pack [--target VERSION] [--out DIR] [--with-vsix] [--force] [--json]")

    return {
        "target": target,
        "out_dir": out_dir,
        "with_vsix": include_vsix,
        "force": force,
        "json": json_mode,
    }


def release_pack_read(path):
    full = ROOT / path
    if not full.is_file():
        return ""
    return full.read_text(encoding="utf-8", errors="replace")


def release_pack_notes_section(target_version):
    notes = release_pack_read("docs/RELEASE-NOTES.md")
    heading_prefix = f"## {PRODUCT_NAME} v{target_version}"
    lines = notes.splitlines()
    start = next((
        index for index, line in enumerate(lines)
        if line == heading_prefix or line.startswith(heading_prefix + " —")
    ), None)
    if start is None:
        return ""
    end = next((
        index for index in range(start + 1, len(lines))
        if lines[index].startswith("## ")
    ), len(lines))
    return "\n".join(lines[start:end]).strip()


def release_pack_body(target_version, expected_tag):
    section = release_pack_notes_section(target_version)
    if section:
        return section + "\n"

    if release_is_prerelease(target_version):
        opening = f"{PRODUCT_NAME} {expected_tag} is a pre-release of the local coding harness."
        posture = "This release remains local-first and experimental."
    else:
        opening = f"{PRODUCT_NAME} {expected_tag} is a stable release of the local coding harness."
        posture = "This release remains local-first and auditable."
    return "\n".join([
        opening,
        "",
        posture + " It does not include model weights, llama.cpp, VS Code, or third-party assets.",
        "",
    ])


def release_pack_publish_commands(release_payload):
    branch = str(release_payload.get("branch") or "feature/release")
    expected_tag = str(release_payload.get("expected_tag") or "v" + VERSION)
    target_version = str(release_payload.get("target_version") or VERSION)
    title = release_pack_title(target_version)
    lines = [
        "# human-run release commands; this file is documentation only",
        "# Run from your local lai-harness checkout; local paths are intentionally omitted.",
        "cd /path/to/lai-harness-checkout",
        "",
    ]
    if branch and not is_protected_write_branch(branch):
        lines.extend([
            "# Push this feature branch, then open and merge a PR into protected main after CI passes.",
            f"git push -u origin {shlex.quote(branch)}",
            "",
        ])
    else:
        lines.extend([
            "# Start from a feature branch and merge it into protected main through a green PR.",
            "",
        ])
    lines.extend([
        "# After the PR is merged and main CI is green, sync main before tagging.",
        "git switch main",
        "git pull --ff-only origin main",
        "",
        f"git tag -a {shlex.quote(expected_tag)} \\",
        f"  -m {shlex.quote(title)}",
        f"git push origin {shlex.quote(expected_tag)}",
        "",
    ])
    return "\n".join(lines)


def release_pack_title(target_version):
    section = release_pack_notes_section(target_version)
    if section:
        heading = section.splitlines()[0].removeprefix("## ").strip()
        product_prefix = f"{PRODUCT_NAME} "
        if heading.startswith(product_prefix):
            heading = heading[len(product_prefix):].strip()
        if heading:
            return heading
    return f"v{target_version} — lai harness release"


def release_pack_resolve_out_dir(raw_out, expected_tag):
    target = Path(raw_out).expanduser() if raw_out else release_pack_default_dir(expected_tag)
    target = target.resolve()
    if release_pack_path_is_inside(target, ROOT):
        raise SystemExit("Refusing to write release pack inside the repository; use --out under /tmp or another external directory")
    return target


def release_pack_files(pack_dir, release_payload, include_vsix=False):
    target_version = release_payload["target_version"]
    files = {
        "release_body": pack_dir / "release-body.md",
        "checklist": pack_dir / "release-checklist.md",
        "publishing": pack_dir / "github-publishing.md",
        "commands": pack_dir / "human-release-commands.sh",
        "summary": pack_dir / "summary.json",
    }
    if include_vsix:
        files["vsix"] = pack_dir / f"lai-harness-{target_version}.vsix"
    return files


def write_release_pack(target=None, out_dir=None, include_vsix=False, force=False):
    release_payload = collect_release_check(target=target)
    pack_dir = release_pack_resolve_out_dir(out_dir, release_payload["expected_tag"])
    files = release_pack_files(pack_dir, release_payload, include_vsix=include_vsix)

    if pack_dir.exists() and any(pack_dir.iterdir()) and not force:
        raise SystemExit(f"Release pack directory already exists and is not empty: {pack_dir}. Use --force or --out DIR")
    pack_dir.mkdir(parents=True, exist_ok=True)

    (files["release_body"]).write_text(
        release_pack_body(release_payload["target_version"], release_payload["expected_tag"]),
        encoding="utf-8",
    )
    (files["checklist"]).write_text(
        release_pack_read("docs/RELEASE-CHECKLIST.md"),
        encoding="utf-8",
    )
    (files["publishing"]).write_text(
        release_pack_read("docs/GITHUB-PUBLISHING.md"),
        encoding="utf-8",
    )
    (files["commands"]).write_text(
        release_pack_publish_commands(release_payload),
        encoding="utf-8",
    )

    vsix_result = None
    if include_vsix:
        script = ROOT / "scripts" / "package-vsix.sh"
        proc = subprocess.run(
            [str(script), str(files["vsix"])],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=120,
        )
        vsix_result = {
            "returncode": proc.returncode,
            "stdout_tail": proc.stdout[-1000:],
            "stderr_tail": proc.stderr[-1000:],
        }
        if proc.returncode != 0:
            raise SystemExit("VSIX packaging failed; run scripts/package-vsix.sh directly for details")

    summary = release_pack_payload(
        release_payload,
        pack_dir,
        files,
        include_vsix=include_vsix,
        vsix_result=vsix_result,
    )
    (files["summary"]).write_text(
        json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    return summary


def release_pack_payload(release_payload, pack_dir, files, include_vsix=False, vsix_result=None):
    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "target_version": release_payload["target_version"],
        "expected_tag": release_payload["expected_tag"],
        "release_channel": release_payload["release_channel"],
        "expected_prerelease": release_payload["expected_prerelease"],
        "repository": "<repo-checkout>",
        "branch": release_payload.get("branch"),
        "head": release_payload.get("head"),
        "release_check_overall": release_payload.get("overall"),
        "release_check_phase": release_payload.get("phase"),
        "pack_dir": str(pack_dir),
        "files": {name: str(path) for name, path in files.items()},
        "with_vsix": bool(include_vsix),
        "vsix": vsix_result,
        "release_safety": "pack only; no tag, merge, push, upload, publication, model call, or repository file mutation was executed",
    }


def render_release_pack(args=None):
    options = parse_release_pack_args(args or [])
    payload = write_release_pack(
        target=options["target"],
        out_dir=options["out_dir"],
        include_vsix=options["with_vsix"],
        force=options["force"],
    )
    if options["json"]:
