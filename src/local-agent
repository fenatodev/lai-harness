def load_jsonl_tail(path, max_lines=5000):
    if not path.is_file():
        return []

    try:
        lines = path.read_text(errors="replace").splitlines()[-max_lines:]
    except Exception:
        return []

    events = []

    for line in lines:
        try:
            payload = json.loads(line)
        except Exception:
            continue

        if runtime_record_schema_supported(payload):
            events.append(payload)

    return events


def empty_run_history_record(run_id):
    return {
        "run_id": run_id,
        "first_ts": None,
        "last_ts": None,
        "repo": str(ROOT),
        "mode": "unknown",
        "status": "observed",
        "api_calls": 0,
        "tool_calls": 0,
        "prompt_tokens": 0,
        "completion_tokens": 0,
        "api_ms": 0.0,
        "tool_ms": 0.0,
        "tools": {},
        "policy": {},
        "validation_count": 0,
        "validation_events": [],
        "modified_paths": [],
        "phases": [],
        "limits": [],
        "events": [],
        "checkpoint": None,
    }


def compact_run_history_value(value, limit=180):
    text = " ".join(str(value or "").replace("\n", " ").split())
    if not text:
        return "[none]"
    return text[:limit]


def update_run_history_time(run, ts):
    if not ts:
        return

    value = str(ts)

    if not run.get("first_ts") or value < run["first_ts"]:
        run["first_ts"] = value

    if not run.get("last_ts") or value > run["last_ts"]:
        run["last_ts"] = value


def append_unique_run_history_path(run, path):
    value = str(path or "").strip()

    if value and value not in run["modified_paths"]:
        run["modified_paths"].append(value)


def run_history_validation_status(event):
    result = compact_run_history_value(event.get("result"), limit=260).lower()

    if result == "[none]":
        return "unknown"

    failure_markers = (
        "traceback",
        "failed",
        "failure",
        "error:",
        "exit code 1",
        "returned non-zero",
        "syntaxerror",
        "assertionerror",
        "bug:",
    )

    if any(marker in result for marker in failure_markers):
        return "fail"

    pass_markers = (
        "ok",
        "passed",
        "success",
        "exit code 0",
        "authentication: ok",
        "all lai harness publication gates passed",
    )

    if result in {"ok", "pass", "success"}:
        return "pass"

    if any(marker in result for marker in pass_markers):
        return "pass"

    return "unknown"


def run_history_validation_summary(event):
    return {
        "ts": event.get("ts"),
        "command": compact_run_history_value(event.get("command"), limit=160),
        "status": run_history_validation_status(event),
        "result": compact_run_history_value(event.get("result"), limit=240),
    }


def run_history_sorted_events(run):
    return sorted(
        run.get("events") or [],
        key=lambda event: (
            str(event.get("ts") or ""),
            int(event.get("_seq") or 0),
            str(event.get("source") or ""),
            str(event.get("type") or ""),
        ),
    )


def run_history_last_failure(run):
    successful_outcomes = {
        "completed",
        "complete",
        "success",
        "succeeded",
        "final",
    }

    for event in reversed(run_history_sorted_events(run)):
        kind = str(event.get("type") or "")

        if kind == "validation" and run_history_validation_status(event) == "fail":
            return {
                "ts": event.get("ts"),
                "type": "validation",
                "status": "fail",
                "command": compact_run_history_value(event.get("command"), limit=160),
                "reason": compact_run_history_value(event.get("result"), limit=240),
            }

        if kind == "agent_limit":
            return {
                "ts": event.get("ts"),
                "type": "agent_limit",
                "reason": compact_run_history_value(event.get("reason"), limit=200),
            }

        if kind == "recovery_blocked":
            reasons = event.get("reasons") or []
            reason = "; ".join(str(item) for item in reasons) if reasons else event.get("reason")
            return {
                "ts": event.get("ts"),
                "type": "recovery_blocked",
                "reason": compact_run_history_value(reason, limit=240),
            }

        if kind == "run_outcome":
            outcome = str(event.get("outcome") or "").strip()
            if outcome and outcome not in successful_outcomes:
                return {
                    "ts": event.get("ts"),
                    "type": "run_outcome",
                    "outcome": outcome[:80],
                    "reason": compact_run_history_value(event.get("reason"), limit=240),
                }

        if kind == "checkpoint":
            phase = str(event.get("phase") or "").strip()
            reason = event.get("reason")
            if phase in {"failed", "blocked"} or reason:
                return {
                    "ts": event.get("ts"),
                    "type": "checkpoint",
                    "phase": phase[:80] or "[unknown]",
                    "reason": compact_run_history_value(reason, limit=240),
                }

    return None


def collect_run_history(max_lines=5000):
    runs = {}
    sequence = 0

    def ensure_run(run_id):
        return runs.setdefault(
            run_id,
            empty_run_history_record(run_id),
        )

    for source, path in (
        ("metrics", METRICS_FILE),
        ("audit", AUDIT_FILE),
    ):
        for event in load_jsonl_tail(path, max_lines=max_lines):
            run_id = str(event.get("run_id") or "").strip()

            if not run_id:
                continue

            if event.get("repo") != str(ROOT):
                continue

            event_copy = dict(event)
            event_copy["source"] = source
            event_copy["_seq"] = sequence
            sequence += 1

            run = ensure_run(run_id)
            run["events"].append(event_copy)
            update_run_history_time(run, event.get("ts"))

            if event.get("mode"):
                run["mode"] = str(event.get("mode"))[:80]

            kind = event.get("type")

            if source == "metrics" and kind == "run_start":
                if run["status"] == "observed":
                    run["status"] = "started"
                run["task_chars"] = int(event.get("task_chars") or 0)

            elif source == "metrics" and kind == "api":
                run["api_calls"] += 1
                run["prompt_tokens"] += int(event.get("prompt_tokens") or 0)
                run["completion_tokens"] += int(event.get("completion_tokens") or 0)
                run["api_ms"] += float(event.get("duration_ms") or 0)

            elif source == "metrics" and kind == "tool":
                name = str(event.get("name") or "unknown")[:80]
                run["tool_calls"] += 1
                run["tool_ms"] += float(event.get("duration_ms") or 0)
                run["tools"][name] = run["tools"].get(name, 0) + 1

            elif kind == "agent_limit":
                run["limits"].append(event_copy)
                if run["status"] not in {"completed", "failed"}:
                    run["status"] = "limited"

            elif source == "audit" and kind == "policy_decision":
                decision = str(event.get("decision") or "unknown")[:40]
                run["policy"][decision] = run["policy"].get(decision, 0) + 1

            elif source == "audit" and kind == "checkpoint":
                phase = str(event.get("phase") or "unknown")[:80]
                run["phases"].append(phase)
                if event.get("terminal"):
                    run["status"] = phase
                elif run["status"] in {"observed", "started"}:
                    run["status"] = phase

            elif source == "audit" and kind == "run_outcome":
                run["status"] = str(event.get("outcome") or "outcome")[:80]

            elif source == "audit" and kind == "patch":
                for path in event.get("paths") or []:
                    append_unique_run_history_path(run, path)

            elif source == "audit" and kind == "validation":
                run["validation_count"] += 1
                run["validation_events"].append(event_copy)

            elif source == "audit" and kind == "final":
                if run["status"] not in {"completed", "failed"}:
                    run["status"] = "final"
                for path in event.get("modified_paths") or []:
                    append_unique_run_history_path(run, path)

    try:
        checkpoint = load_run_checkpoint()
    except Exception:
        checkpoint = None

    if isinstance(checkpoint, dict) and checkpoint.get("root") == str(ROOT):
        run_id = str(checkpoint.get("run_id") or "").strip()
        if run_id:
            run = ensure_run(run_id)
            run["checkpoint"] = checkpoint
            if checkpoint.get("mode"):
                run["mode"] = str(checkpoint.get("mode"))[:80]
            update_run_history_time(run, checkpoint.get("updated_at"))
            phase = str(checkpoint.get("phase") or "checkpoint")[:80]
            if phase not in run["phases"]:
                run["phases"].append(phase)
            if checkpoint.get("terminal"):
                run["status"] = phase
            elif run["status"] in {"observed", "started"}:
                run["status"] = phase

    return sorted(
        runs.values(),
        key=lambda item: (
            item.get("last_ts") or "",
            item.get("run_id") or "",
        ),
    )


def run_history_public_record(run):
    validation_events = [
        run_history_validation_summary(event)
        for event in (run.get("validation_events") or [])[-20:]
    ]
    return {
        "run_id": run["run_id"],
        "control_run_id": run["run_id"],
        "first_ts": run.get("first_ts"),
        "last_ts": run.get("last_ts"),
        "mode": run.get("mode"),
        "status": run.get("status"),
        "api_calls": run.get("api_calls", 0),
        "tool_calls": run.get("tool_calls", 0),
        "prompt_tokens": run.get("prompt_tokens", 0),
        "completion_tokens": run.get("completion_tokens", 0),
        "validation_count": run.get("validation_count", 0),
        "validation_events": validation_events,
        "last_validation": validation_events[-1] if validation_events else None,
        "last_failure": run_history_last_failure(run),
        "modified_paths": run.get("modified_paths", []),
        "policy": run.get("policy", {}),
        "tools": run.get("tools", {}),
        "phases": run.get("phases", []),
    }


def render_run_history_list(limit=10, json_mode=False):
    runs = collect_run_history()
    recent = runs[-limit:] if limit else runs

    if json_mode:
        return json.dumps(
            {
                "product": PRODUCT_NAME,
                "version": VERSION,
                "repository": str(ROOT),
                "runs": [run_history_public_record(run) for run in recent],
            },
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
        )

    lines = [
        "# lai run history",
        "",
        f"Repository: {ROOT}",
        f"Metrics file: {METRICS_FILE}",
        f"Audit file: {AUDIT_FILE}",
        f"Recorded runs: {len(runs)}",
        "",
        "## Recent runs",
    ]

    if not recent:
        lines.append("- [none]")
        return "\n".join(lines)

    for run in recent:
        tools = ",".join(
            f"{name}:{count}"
            for name, count in sorted(run["tools"].items())
        ) or "-"
        policy = ",".join(
            f"{name}:{count}"
            for name, count in sorted(run["policy"].items())
        ) or "-"
        failure = run_history_last_failure(run)
        failure_text = "yes" if failure else "no"
        lines.append(
            f"- {run['run_id']} | "
            f"last={run.get('last_ts') or '[unknown]'} | "
            f"mode={run.get('mode') or 'unknown'} | "
            f"status={run.get('status') or 'unknown'} | "
            f"failure={failure_text} | "
            f"api={run.get('api_calls', 0)} | "
            f"tools={run.get('tool_calls', 0)} [{tools}] | "
            f"validation={run.get('validation_count', 0)} | "
            f"policy=[{policy}]"
        )

    lines.extend([
        "",
        "Use `lai run last`, `lai run show <run-id|--last>`, or `lai run tail <run-id|--last>` for details.",
    ])
    return "\n".join(lines)


def find_run_history_record(run_id, runs=None):
    wanted = str(run_id or "").strip()
    for run in (runs if runs is not None else collect_run_history()):
        if run.get("run_id") == wanted:
            return run
    return None


def latest_run_history_record(runs=None):
    records = runs if runs is not None else collect_run_history()
    if not records:
        return None
    return records[-1]


def resolve_run_history_record(selector):
    records = collect_run_history()
    wanted = str(selector or "").strip()

    if wanted in {"--last", "last", "latest"}:
        run = latest_run_history_record(records)
        if run is None:
            raise SystemExit("No runs recorded for this repository.")
        return run

    run = find_run_history_record(wanted, runs=records)
    if run is None:
        raise SystemExit(f"Run not found for this repository: {selector}")
    return run


def render_run_history_failure(failure):
    if not failure:
        return "- [none]"

    parts = [
        "- " + str(failure.get("ts") or "[unknown]"),
        "type=" + str(failure.get("type") or "unknown"),
    ]
    for key in ("status", "phase", "outcome", "command", "reason"):
        if failure.get(key):
            parts.append(key + "=" + compact_run_history_value(failure.get(key), limit=160))
    return " | ".join(parts)


def render_run_history_validation(event):
