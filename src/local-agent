            "current_url": record.get("current_url"),
            "dom_sha256": record.get("dom_sha256"),
            "text": text,
            "text_sha256": hashlib.sha256(text.encode("utf-8", errors="replace")).hexdigest(),
            "truncated": truncated,
            "untrusted_browser_content": True,
