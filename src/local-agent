def semantic_code_contract_payload():
    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "contract": SEMANTIC_CODE_CONTRACT,
    }


def render_semantic_code_contract(json_mode=False):
    payload = semantic_code_contract_payload()
    if json_mode:
        return json.dumps(payload, indent=2, sort_keys=True)

    lines = [
        "# lai code semantics",
        f"Version: {VERSION}",
        "",
        "Purpose:",
        f"- {SEMANTIC_CODE_CONTRACT['purpose']}",
        "",
        "Rules:",
    ]
    for rule in SEMANTIC_CODE_CONTRACT["rules"]:
        lines.append(f"- {rule}")
    lines.extend(["", "Subsystems:"])
    for subsystem in SEMANTIC_CODE_CONTRACT["subsystems"]:
        lines.append(f"- {subsystem['id']}: {subsystem['intent']}")
        lines.append("  - paths: " + ", ".join(subsystem["paths"]))
        lines.append("  - entrypoints: " + ", ".join(subsystem["entrypoints"]))
        lines.append("  - terms: " + ", ".join(subsystem["terms"]))
    return "\n".join(lines)


def _semantic_contract_tokens(subsystem):
    values = [
        subsystem.get("id", ""),
        " ".join(subsystem.get("entrypoints") or []),
        " ".join(subsystem.get("terms") or []),
    ]
    tokens = set()
    for value in values:
        folded = _context_fold_text(value)
        for token in re.split(r"[^a-z0-9]+", folded):
            if len(token) >= 3 and token not in CONTEXT_STOPWORDS:
                tokens.add(token)
    return tokens


def context_semantic_references(terms, inventory):
    if not terms or not inventory:
        return {}
    known_paths = set(inventory)
    references = {}
    for subsystem in SEMANTIC_CODE_CONTRACT["subsystems"]:
        contract_terms = _semantic_contract_tokens(subsystem)
        if not any(term in contract_terms for term in terms):
            continue
        for rel in subsystem.get("paths") or []:
            if rel in known_paths:
                references.setdefault(rel, []).append(subsystem["id"])
    return references


