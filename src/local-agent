def hash_repository_paths(paths):
    hashlib = __import__("hashlib")

    output = {}

    for raw_path in paths:
        rel = str(raw_path or "").strip()

        while rel.startswith("./"):
            rel = rel[2:]

        if not rel:
            continue

        candidate = ROOT / rel

        try:
            resolved = candidate.resolve()
            resolved.relative_to(ROOT.resolve())
        except Exception:
            output[rel] = "[invalid]"
            continue

        if not resolved.is_file():
            output[rel] = "[missing]"
            continue

        try:
            digest = hashlib.sha256(
                resolved.read_bytes()
            ).hexdigest()

            output[rel] = digest
        except Exception as exc:
            output[rel] = (
                "[error:"
                + type(exc).__name__
                + "]"
            )

    return output


def record_audit_event(event):
    AUDIT_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    try:
        if (
            AUDIT_FILE.is_file()
            and AUDIT_FILE.stat().st_size
            > 5_000_000
        ):
            lines = AUDIT_FILE.read_text(
                errors="replace"
            ).splitlines()

            AUDIT_FILE.write_text(
                "\n".join(lines[-4000:])
                + "\n"
            )
    except Exception:
        pass

    payload = {
        "ts": _metrics_time.strftime(
            "%Y-%m-%dT%H:%M:%SZ",
            _metrics_time.gmtime(),
        ),
        "run_id": RUN_ID,
        "repo": str(ROOT),
        "mode": ACTIVE_MODE,
        **event,
    }

    try:
        with AUDIT_FILE.open(
            "a",
            encoding="utf-8",
        ) as fh:
            fh.write(
                json.dumps(
                    payload,
                    ensure_ascii=False,
                )
                + "\n"
            )
    except Exception:
        pass


