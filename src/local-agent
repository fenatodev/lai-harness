def control_local_chat_sanitize_text(text, *, server=None):
    redacted = redact_model_api_error_text(
        text,
        api_key=getattr(server, "control_token", "") if server is not None else "",
        limit=LOCAL_CHAT_MAX_CONTENT_BYTES,
    )
    return redacted


def control_local_chat_content_payload(server, query=None):
    query = query or {}
    control_local_chat_negotiate_query(query)
    workspace_id = (query.get("workspace_id") or [""])[0]
    control_local_chat_validate_workspace_id(workspace_id)
    rel = (query.get("path") or [""])[0]
    try:
        safe_rel = _safe_control_relpath(ROOT, rel)
    except ValueError as exc:
        raise ControlLocalChatRejected(400, "invalid_path", str(exc)) from exc
    target = (Path(ROOT).resolve() / safe_rel).resolve(strict=False)
    if not target.is_file() or target.is_symlink():
        raise ControlLocalChatRejected(404, "content_not_found", "content path is not a regular file")
    try:
        raw = target.read_bytes()
    except OSError as exc:
        raise ControlLocalChatRejected(404, "content_not_found", "content path is not readable") from exc
    truncated = len(raw) > LOCAL_CHAT_MAX_CONTENT_BYTES
    raw = raw[:LOCAL_CHAT_MAX_CONTENT_BYTES]
    if b"\x00" in raw:
        raise ControlLocalChatRejected(415, "unsupported_content", "binary content is not exposed")
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise ControlLocalChatRejected(415, "unsupported_content", "content must be UTF-8 text") from exc
    sanitized = control_local_chat_sanitize_text(text, server=server)
    return {
        "schema_version": LOCAL_CHAT_CONTRACT_SCHEMA_VERSION,
        "product": PRODUCT_NAME,
        "version": VERSION,
        "workspace_id": workspace_id,
        "path": safe_rel,
        "content": sanitized,
        "truncated": truncated,
        "bytes_read": len(raw),
        "secret_material_printed": False,
    }


def control_submit_local_chat_run(server, request):
    if not isinstance(request, dict):
        raise ControlLocalChatRejected(400, "invalid_local_chat_run", "JSON object required")
    allowed = {"client_version", "workspace_id", "mode", "task", "session_id", "model_id"}
    extra = set(request) - allowed
    if extra:
        raise ControlLocalChatRejected(
            400, "invalid_local_chat_run", "unsupported field(s): " + ", ".join(sorted(extra))
        )
    control_local_chat_parse_client_version(request.get("client_version"))
    control_local_chat_validate_workspace_id(request.get("workspace_id"))
    model_id = request.get("model_id", "default")
    if model_id != "default":
        raise ControlLocalChatRejected(
            400, "model_not_registered", "model_id is not registered on this server"
        )
    mode = request.get("mode")
    if mode not in CONTROL_RUN_ALLOWED_MODES:
        raise ControlLocalChatRejected(
            400, "invalid_run_mode", "mode is not registered on this server"
        )
    payload = {"mode": mode, "task": request.get("task", "")}
    if request.get("session_id") is not None:
        payload["session_id"] = request.get("session_id")
    return control_submit_run(server, payload)


def control_local_chat_run_events_payload(server, control_run_id, query=None):
    query = query or {}
    control_local_chat_negotiate_query(query)
    try:
        cursor = int((query.get("cursor") or ["0"])[0])
    except (TypeError, ValueError) as exc:
        raise ControlLocalChatRejected(400, "invalid_cursor", "cursor must be an integer") from exc
    if cursor < 0:
        raise ControlLocalChatRejected(400, "invalid_cursor", "cursor must be non-negative")
    payload = control_run_events_payload(server, control_run_id)
    if payload is None:
        raise ControlLocalChatRejected(404, "run_not_found", "control run not found")
    trajectory = [
        event for event in payload.get("trajectory") or []
        if int(event.get("sequence") or 0) > cursor
    ][:LOCAL_CHAT_MAX_EVENTS_PER_POLL]
    next_cursor = cursor
    if trajectory:
        next_cursor = max(int(event.get("sequence") or 0) for event in trajectory)
    return {
        "schema_version": LOCAL_CHAT_CONTRACT_SCHEMA_VERSION,
        "product": PRODUCT_NAME,
        "version": VERSION,
        "control_run_id": control_run_id,
        "mode": payload.get("mode"),
        "status": payload.get("status"),
        "terminal": payload.get("terminal"),
        "cursor": cursor,
        "next_cursor": next_cursor,
        "event_count": len(trajectory),
        "events": trajectory,
        "stdout_included": False,
        "stderr_included": False,
    }


def control_local_chat_require_workspace_query(query):
    control_local_chat_negotiate_query(query or {})
    workspace_id = ((query or {}).get("workspace_id") or [""])[0]
    return control_local_chat_validate_workspace_id(workspace_id)


def _control_local_chat_lifecycle(record):
    status = str(record.get("status") or "unknown")
    terminal = status in CONTROL_RUN_TERMINAL_STATES
    return {
        "cancel_supported": True,
        "cancel_available": not terminal,
        "pause_supported": False,
        "pause_available": False,
        "continue_supported": False,
        "continue_available": False,
        "reason_code": "terminal" if terminal else "running_or_queued",
    }


def control_local_chat_run_review_payload(server, control_run_id, query=None):
    query = query or {}
    workspace_id = control_local_chat_require_workspace_query(query)
    with server.control_run_lock:
        record = server.control_run_records.get(str(control_run_id))
        if record is None:
            raise ControlLocalChatRejected(404, "run_not_found", "control run not found")
        public = _control_run_public_record_locked(server, record)
        trajectory = _control_run_trajectory_locked(record)
        workspace_record = dict(public.get("workspace") or {}) if public.get("workspace") else None
    promotion = control_promotion_proposal(server, control_run_id)
    diff_preview = ""
    diff_truncated = False
    changed_paths = []
    workspace = None
    if workspace_record is not None:
        raw_diff = workspace_record.get("diff", "") or ""
        diff_preview = control_local_chat_sanitize_text(raw_diff, server=server)
        if len(diff_preview.encode("utf-8")) > CONTROL_RUN_DIFF_LIMIT_BYTES:
            diff_preview = diff_preview.encode("utf-8")[:CONTROL_RUN_DIFF_LIMIT_BYTES].decode("utf-8", errors="replace")
            diff_truncated = True
        changed_paths = list(workspace_record.get("changed_paths") or [])[:CONTROL_PROMOTION_MAX_PATHS]
        workspace = {
            "isolated": bool(workspace_record.get("isolated")),
            "path_included": False,
            "git_status": workspace_record.get("git_status", ""),
            "changed_paths": changed_paths,
            "changed_path_count": len(changed_paths),
            "diff_preview": diff_preview,
            "diff_truncated": bool(workspace_record.get("diff_truncated")) or diff_truncated,
        }
    return {
        "schema_version": LOCAL_CHAT_CONTRACT_SCHEMA_VERSION,
        "product": PRODUCT_NAME,
        "version": VERSION,
        "workspace_id": workspace_id,
        "review": {
            "control_run_id": control_run_id,
            "mode": public.get("mode"),
            "status": public.get("status"),
            "terminal": public.get("status") in CONTROL_RUN_TERMINAL_STATES,
            "tool_profile": public.get("tool_profile"),
            "task_chars": int(public.get("task_chars") or 0),
            "stdout_included": False,
            "stderr_included": False,
            "workspace": workspace,
            "promotion": promotion,
            "lifecycle": _control_local_chat_lifecycle(public),
            "ask": {
                "exposed": True,
                "execution_enabled": False,
                "reason_code": "approval_intents_are_records_not_replayable_tools",
            },
            "budget": {
                "exposed": True,
                "projection": "trajectory_metadata_only",
                "trajectory_event_count": len(trajectory),
            },
            "validation": {
                "required_before_promotion": True,
                "last_result": (promotion or {}).get("promotion", {}).get("validation"),
            },
        },
    }


def control_promote_local_chat_run(server, control_run_id, request):
    if not isinstance(request, dict):
        raise ControlLocalChatRejected(400, "invalid_promotion_request", "JSON object required")
    unknown = sorted(set(request) - {"client_version", "workspace_id", "patch_sha256"})
    if unknown:
        raise ControlLocalChatRejected(
            400, "invalid_promotion_request", "unsupported field(s): " + ", ".join(unknown)
        )
    control_local_chat_parse_client_version(request.get("client_version"))
    workspace_id = control_local_chat_validate_workspace_id(request.get("workspace_id"))
    patch_sha256 = request.get("patch_sha256")
    if not isinstance(patch_sha256, str) or not re.fullmatch(r"[0-9a-f]{64}", patch_sha256):
        raise ControlLocalChatRejected(400, "invalid_promotion_request", "patch_sha256 is invalid")
    promotion = control_promote_run(server, control_run_id, {"patch_sha256": patch_sha256})
    if promotion is None:
        raise ControlLocalChatRejected(404, "run_not_found", "control run not found")
    return {
        "schema_version": LOCAL_CHAT_CONTRACT_SCHEMA_VERSION,
        "product": PRODUCT_NAME,
        "version": VERSION,
        "workspace_id": workspace_id,
        "promotion": promotion,
        "executed_by": "harness-promotion",
        "source_checkout_write": False,
    }


def control_local_chat_lifecycle_action(server, control_run_id, request):
    if not isinstance(request, dict):
        raise ControlLocalChatRejected(400, "invalid_lifecycle_request", "JSON object required")
    unknown = sorted(set(request) - {"client_version", "workspace_id", "action"})
    if unknown:
        raise ControlLocalChatRejected(
            400, "invalid_lifecycle_request", "unsupported field(s): " + ", ".join(unknown)
        )
    control_local_chat_parse_client_version(request.get("client_version"))
    control_local_chat_validate_workspace_id(request.get("workspace_id"))
    action = request.get("action")
    if action == "cancel":
        with server.control_run_lock:
            existing = server.control_run_records.get(str(control_run_id))
            if existing is not None and existing.get("cancel_requested"):
                return {
                    "schema_version": LOCAL_CHAT_CONTRACT_SCHEMA_VERSION,
                    "product": PRODUCT_NAME,
                    "version": VERSION,
                    "action": "cancel",
                    "status_code": 200,
                    "already_requested": True,
                    "run": _control_run_public_record_locked(server, existing),
                }
        status, record = control_cancel_run(server, control_run_id)
        return {
            "schema_version": LOCAL_CHAT_CONTRACT_SCHEMA_VERSION,
            "product": PRODUCT_NAME,
            "version": VERSION,
            "action": "cancel",
            "status_code": status,
            "already_requested": False,
            "run": record,
        }
    if action in {"pause", "continue"}:
        raise ControlLocalChatRejected(
            409, f"{action}_not_supported", f"local-chat {action} is not supported by this supervisor"
        )
    raise ControlLocalChatRejected(400, "invalid_lifecycle_action", "action must be cancel, pause, or continue")



def chat_bootstrap_parse_args(args):
    options = {
        "json": False,
        "control_url": f"http://127.0.0.1:{CONTROL_API_DEFAULT_PORT}",
        "gateway_url": CHAT_BOOTSTRAP_DEFAULT_GATEWAY_URL,
        "task": "Return a concise local-chat Safe bootstrap acknowledgement.",
        "chat": True,
    }
    index = 0
    while index < len(args):
        item = args[index]
        if item == "--json":
            options["json"] = True
            index += 1
            continue
        if item == "--no-chat":
            options["chat"] = False
            index += 1
            continue
        if item in {"--control-url", "--gateway-url", "--task"}:
            if index + 1 >= len(args):
                raise SystemExit(CHAT_BOOTSTRAP_USAGE)
            options[item[2:].replace("-", "_")] = args[index + 1]
            index += 2
            continue
        if item in {"--help", "-h", "help"} and len(args) == 1:
            raise SystemExit(CHAT_BOOTSTRAP_USAGE)
        raise SystemExit(CHAT_BOOTSTRAP_USAGE)
    options["control_url"] = chat_bootstrap_validate_loopback_url(
        options["control_url"], "control-url"
    )
    options["gateway_url"] = chat_bootstrap_validate_loopback_url(
        options["gateway_url"], "gateway-url"
    )
    if not isinstance(options["task"], str) or not options["task"].strip():
        raise SystemExit("chat-bootstrap --task must not be empty")
    options["task"] = options["task"].strip()[:CONTROL_RUN_TASK_MAX_CHARS]
    return options


def chat_bootstrap_validate_loopback_url(value, label):
    try:
        parsed = urllib.parse.urlsplit(str(value or ""))
    except ValueError as exc:
        raise SystemExit(f"invalid {label}") from exc
    if parsed.scheme != "http" or not parsed.hostname:
        raise SystemExit(f"invalid {label}: expected http://127.0.0.1:PORT")
    if parsed.username or parsed.password:
        raise SystemExit(f"invalid {label}: credentials are not allowed")
    if not control_local_chat_host_is_loopback(parsed.netloc):
        raise SystemExit(f"invalid {label}: host must be loopback")
    if parsed.path not in {"", "/"} or parsed.query or parsed.fragment:
        raise SystemExit(f"invalid {label}: path, query and fragment are not allowed")
    port = parsed.port
    if port is None or not 1 <= port <= 65535:
        raise SystemExit(f"invalid {label}: port must be between 1 and 65535")
    host = parsed.hostname
    if ":" in host and not host.startswith("["):
        host = f"[{host}]"
    return f"http://{host}:{port}"


def chat_bootstrap_platform_payload():
    system = platform.system().lower()
    release = platform.release()
    proc_version = ""
    try:
        proc_version = Path("/proc/version").read_text(encoding="utf-8", errors="ignore")[:500]
    except OSError:
        proc_version = ""
    wsl = bool(os.environ.get("WSL_DISTRO_NAME")) or "microsoft" in proc_version.lower()
    runtime = "wsl2" if wsl else ("linux" if system == "linux" else system or "unknown")
    return {
        "runtime": runtime,
        "system": system,
        "release": release[:120],
        "linux_or_wsl2_supported": runtime in {"linux", "wsl2"},
        "windows_native_runtime": False,
    }


def chat_bootstrap_http_json(base_url, token, path, *, method="GET", body=None, csrf_token=None):
    headers = {
        "Authorization": f"Bearer {token}",
        "Accept": "application/json",
    }
    data = None
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"
    if csrf_token:
        headers[LOCAL_CHAT_CSRF_HEADER] = csrf_token
    request = urllib.request.Request(
        base_url + path,
        data=data,
        method=method,
        headers=headers,
    )
    try:
        with urllib.request.urlopen(request, timeout=2) as response:
            raw = response.read().decode("utf-8")
            payload = json.loads(raw) if raw else {}
            return response.status, payload, None
    except urllib.error.HTTPError as exc:
        try:
            payload = json.loads(exc.read().decode("utf-8"))
        except Exception:
            payload = {"error": {"code": "http_error", "message": str(exc)}}
        return exc.code, payload, None
    except (urllib.error.URLError, TimeoutError, OSError, json.JSONDecodeError) as exc:
        return None, None, str(exc)


def chat_bootstrap_payload(args=None):
    options = chat_bootstrap_parse_args(list(args or []))
    payload = {
        "schema_version": CHAT_BOOTSTRAP_SCHEMA_VERSION,
        "product": PRODUCT_NAME,
        "version": VERSION,
        "repository": str(ROOT.resolve()),
        "platform": chat_bootstrap_platform_payload(),
        "no_model_download": True,
        "no_optional_install": True,
        "no_persistent_runtime_started": True,
        "browser_opened": False,
        "control_endpoint": {
            "url": options["control_url"],
            "loopback_only": True,
            "reachable": False,
            "authenticated": False,
            "token_available": False,
            "token_printed": False,
        },
        "gateway": {
            "component": "lai-gateway",
            "separate_project": True,
            "local_url": options["gateway_url"],
            "started_by_bootstrap": False,
            "installed_by_bootstrap": False,
            "optional_component_installed": False,
        },
        "model_backend": {
            "configured_host": gateway(),
            "configured_port": LLAMA_PORT,
            "ready": False,
            "downloaded_by_bootstrap": False,
            "started_by_bootstrap": False,
        },
        "sandbox": {
            "ready": remote_project_sandbox_available(),
            "opt_in_only": True,
            "core_blocked_when_missing": False,
            "image": remote_validation_sandbox_image(),
        },
        "local_chat": {
            "contract_negotiated": False,
            "workspace_registered": False,
            "workspace_selected": False,
            "model_registered": False,
            "csrf_received": False,
            "read_only_runs": False,
            "work_runs": False,
        },
        "workspace": None,
        "first_chat": {
            "attempted": False,
            "skipped": False,
            "skip_reason": None,
            "mode": "plan",
            "safe_chat": True,
            "control_run_id": None,
            "terminal_status": None,
            "output_included": False,
        },
        "uninstall": {
            "available": True,
            "preserve_data_by_default": True,
            "delete_data_requires_explicit_flag": True,
        },
        "actions": [],
        "secret_material_printed": False,
    }

    try:
        token = control_api_key()
    except Exception as exc:
        payload["control_endpoint"]["error"] = str(exc)[:160]
        payload["first_chat"].update({"skipped": True, "skip_reason": "control_token_unavailable"})
        payload["actions"].append("Run `lai control-token init` explicitly, then start `lai serve` on loopback.")
        return payload
    payload["control_endpoint"]["token_available"] = True

    try:
        payload["model_backend"]["ready"] = bool(server_ready(gateway()))
    except Exception:
        payload["model_backend"]["ready"] = False

    status, contract, error = chat_bootstrap_http_json(
        options["control_url"], token, "/v1/local-chat/contract?client_version=1"
    )
    payload["control_endpoint"]["reachable"] = status is not None
    payload["control_endpoint"]["authenticated"] = status == 200
    if error:
        payload["control_endpoint"]["error"] = error[:160]
    if status != 200 or not isinstance(contract, dict):
        if isinstance(contract, dict) and contract.get("error"):
            payload["control_endpoint"]["error"] = str(contract["error"].get("code") or "local_chat_unavailable")[:160]
        payload["first_chat"].update({"skipped": True, "skip_reason": "control_endpoint_unavailable"})
        payload["actions"].append("Start `lai serve --port <port>` explicitly and rerun chat-bootstrap.")
        return payload

    csrf_token = (((contract.get("security") or {}).get("csrf_token")) or "")
    capabilities = contract.get("capabilities") or {}
    payload["local_chat"].update({
        "contract_negotiated": True,
        "csrf_received": bool(csrf_token),
        "read_only_runs": bool(capabilities.get("read_only_runs")),
        "work_runs": bool(capabilities.get("work_runs")),
    })

    status, workspaces, error = chat_bootstrap_http_json(
        options["control_url"], token, "/v1/local-chat/workspaces?client_version=1"
    )
    workspace_id = None
    if status == 200 and isinstance(workspaces, dict) and workspaces.get("workspaces"):
        workspace = dict(workspaces["workspaces"][0])
        workspace_id = workspace.get("workspace_id")
        payload["workspace"] = {
            "workspace_id": workspace_id,
            "display_name": workspace.get("display_name"),
            "repository_name": workspace.get("repository_name"),
            "branch": workspace.get("branch"),
            "git_clean": workspace.get("git_clean"),
            "client_path_authority": False,
        }
        payload["local_chat"].update({
            "workspace_registered": True,
            "workspace_selected": True,
        })
    else:
        payload["first_chat"].update({"skipped": True, "skip_reason": "workspace_not_registered"})
        return payload

    status, models, error = chat_bootstrap_http_json(
        options["control_url"], token,
        f"/v1/local-chat/models?client_version=1&workspace_id={urllib.parse.quote(str(workspace_id))}",
    )
    if status == 200 and isinstance(models, dict) and models.get("models"):
        payload["local_chat"]["model_registered"] = any(
            item.get("model_id") == "default" for item in models.get("models") or []
        )
    else:
        payload["first_chat"].update({"skipped": True, "skip_reason": "model_not_registered"})
        return payload

    if not options["chat"]:
        payload["first_chat"].update({"skipped": True, "skip_reason": "chat_disabled_by_flag"})
        return payload
    if not payload["model_backend"]["ready"]:
        payload["first_chat"].update({"skipped": True, "skip_reason": "model_backend_unavailable"})
        payload["actions"].append("Provide an authenticated model endpoint and rerun chat-bootstrap for the first Safe chat.")
        return payload
    if not csrf_token:
        payload["first_chat"].update({"skipped": True, "skip_reason": "csrf_unavailable"})
        return payload

    payload["first_chat"]["attempted"] = True
    status, run_payload, error = chat_bootstrap_http_json(
        options["control_url"], token, "/v1/local-chat/runs",
        method="POST",
        csrf_token=csrf_token,
        body={
            "client_version": LOCAL_CHAT_SUPPORTED_CLIENT_VERSION,
            "workspace_id": workspace_id,
            "model_id": "default",
            "mode": "plan",
            "task": options["task"],
        },
    )
    if status != 202 or not isinstance(run_payload, dict):
        payload["first_chat"].update({"skipped": True, "skip_reason": "run_not_accepted"})
        if error:
            payload["first_chat"]["error"] = error[:160]
        return payload
    run_id = ((run_payload.get("run") or {}).get("control_run_id"))
    payload["first_chat"]["control_run_id"] = run_id
    deadline = time.monotonic() + CHAT_BOOTSTRAP_POLL_TIMEOUT_SECONDS
    cursor = 0
    while run_id and time.monotonic() < deadline:
        status, events, error = chat_bootstrap_http_json(
            options["control_url"], token,
            f"/v1/local-chat/runs/{run_id}/events?client_version=1&cursor={cursor}",
        )
        if status == 200 and isinstance(events, dict):
            cursor = int(events.get("next_cursor") or cursor)
            payload["first_chat"]["terminal_status"] = events.get("status")
            if events.get("terminal"):
                break
        time.sleep(CHAT_BOOTSTRAP_POLL_SECONDS)
    if payload["first_chat"].get("terminal_status") is None:
        payload["first_chat"]["terminal_status"] = "unknown"
        payload["first_chat"]["skip_reason"] = "run_timeout"
    return payload


def render_chat_bootstrap(args=None):
    args = list(args or [])
    json_mode = "--json" in args
    payload = chat_bootstrap_payload(args)
    if json_mode:
        return json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True)
    lines = [
        "# lai chat bootstrap",
