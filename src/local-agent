def _parse_context_positive_int(raw, *, label, maximum, minimum=1):
    try:
        value = int(raw)
    except (TypeError, ValueError):
        raise SystemExit(f"{label} must be an integer")
    if value < minimum or value > maximum:
        raise SystemExit(f"{label} must be between {minimum} and {maximum}")
    return value



def _context_symbol_path(raw_path):
    rel = _context_rel_path_safe(raw_path)
    if rel is None:
        raise SystemExit("symbol path must be a safe repository-relative path")
    if not _context_path_allowed(rel):
        raise SystemExit("symbol path must point to an existing regular repository file")
    return rel


def _context_python_symbols(rel, text, limit):
    try:
        tree = ast.parse(text, filename=rel)
    except SyntaxError:
        return [], "python_parse_failed"
    symbols = []
    for node in tree.body:
        if isinstance(node, ast.ClassDef):
            symbols.append({"kind": "class", "name": node.name, "line": int(getattr(node, "lineno", 0) or 0)})
            for child in node.body:
                if isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef)):
                    symbols.append({
                        "kind": "method",
                        "name": f"{node.name}.{child.name}",
                        "line": int(getattr(child, "lineno", 0) or 0),
                    })
                    if len(symbols) >= limit:
                        return symbols, "ok"
        elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            symbols.append({
                "kind": "function" if isinstance(node, ast.FunctionDef) else "async_function",
                "name": node.name,
                "line": int(getattr(node, "lineno", 0) or 0),
            })
        if len(symbols) >= limit:
            return symbols, "ok"
    return symbols, "ok"


def _context_javascript_symbols(text, limit):
    patterns = [
        ("class", re.compile(r"^\s*class\s+([A-Za-z_$][\w$]*)", re.MULTILINE)),
        ("function", re.compile(r"^\s*(?:export\s+)?(?:async\s+)?function\s+([A-Za-z_$][\w$]*)\s*\(", re.MULTILINE)),
        ("function", re.compile(r"^\s*(?:export\s+)?(?:const|let|var)\s+([A-Za-z_$][\w$]*)\s*=\s*(?:async\s*)?(?:\([^)]*\)|[A-Za-z_$][\w$]*)\s*=>", re.MULTILINE)),
        ("method", re.compile(r"^\s{2,}([A-Za-z_$][\w$]*)\s*\([^)]*\)\s*\{", re.MULTILINE)),
    ]
    rows = []
    seen = set()
    line_starts = [0]
    for match in re.finditer(r"\n", text):
        line_starts.append(match.end())
    def line_for(pos):
        # bisect without importing another module; symbol lists are small.
        line = 1
        for idx, start in enumerate(line_starts):
            if start > pos:
                break
            line = idx + 1
        return line
    for kind, pattern in patterns:
        for match in pattern.finditer(text):
            name = match.group(1)
            key = (kind, name, match.start())
            if key in seen:
                continue
            seen.add(key)
            rows.append({"kind": kind, "name": name, "line": line_for(match.start())})
    rows.sort(key=lambda item: (int(item["line"]), item["kind"], item["name"]))
    return rows[:limit], "ok"


def context_symbols_payload(path, limit=80):
    limit = max(1, min(int(limit), 200))
    rel = _context_symbol_path(path)
    file_path = ROOT / rel
    try:
        size = file_path.stat().st_size
        if size > 1024 * 1024:
            raise SystemExit("symbol path is too large for deterministic summary")
        content = file_path.read_text(encoding="utf-8", errors="replace")
    except OSError as exc:
        raise SystemExit(f"cannot read symbol path: {type(exc).__name__}")
    suffix = file_path.suffix.lower()
    if suffix in {".py", ""}:
        symbols, parser = _context_python_symbols(rel, content, limit)
        if parser != "ok" and suffix == "":
            symbols, parser = _context_javascript_symbols(content, limit)
    elif suffix in {".js", ".mjs", ".cjs", ".jsx", ".ts", ".tsx"}:
        symbols, parser = _context_javascript_symbols(content, limit)
    else:
        symbols, parser = [], "unsupported_suffix"
    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "symbols_version": 1,
        "repository": ".",
        "path": rel,
        "metadata_only": True,
        "inspected_content": False,
        "parser": parser,
        "symbol_count": len(symbols),
        "symbol_limit": limit,
        "symbols": symbols,
        "trust": "Advisory symbol metadata only. Read the file before relying on implementation behavior.",
    }


