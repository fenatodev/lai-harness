def _control_credential_load(secret_ref):
    path = _control_credential_path(secret_ref)
    try:
        record = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise KeyError(secret_ref) from None
    except json.JSONDecodeError as exc:
        raise ControlCredentialConflict("credential reference state is invalid") from exc
    if not isinstance(record, dict):
        raise ControlCredentialConflict("credential reference state is invalid")
    if record.get("schema_version") != CONTROL_CREDENTIAL_SCHEMA_VERSION:
        raise ControlCredentialConflict("credential reference schema version is unsupported")
    if record.get("secret_ref") != secret_ref:
        raise ControlCredentialConflict("credential reference identity mismatch")
    return record


def _control_credential_prune():
    for subdir in ("refs", "receipts", "fake-outbox"):
        base = control_credential_base() / subdir
        if not base.is_dir():
            continue
        files = sorted(
            (item for item in base.glob("*.json") if item.is_file()),
            key=lambda item: item.stat().st_mtime,
        )
        for victim in files[:-CONTROL_CREDENTIAL_RETAIN_LIMIT]:
            try:
                victim.unlink()
            except OSError:
                pass


