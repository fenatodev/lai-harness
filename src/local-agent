def render_run_history_event(event):
    source = str(event.get("source") or "event")
    kind = str(event.get("type") or "unknown")
    parts = [
        f"- {event.get('ts') or '[unknown]'} {source}:{kind}"
    ]

    if event.get("mode"):
        parts.append("mode=" + str(event.get("mode"))[:80])
    if event.get("name"):
        parts.append("tool=" + str(event.get("name"))[:80])
    if event.get("tool"):
        parts.append("tool=" + str(event.get("tool"))[:80])
    if event.get("decision"):
        parts.append("decision=" + str(event.get("decision"))[:40])
    if event.get("command"):
        parts.append("command=" + compact_run_history_value(event.get("command"), limit=120))
    if event.get("phase"):
        parts.append("phase=" + str(event.get("phase"))[:80])
    if event.get("outcome"):
        parts.append("outcome=" + str(event.get("outcome"))[:80])
    if kind == "validation":
        parts.append("status=" + run_history_validation_status(event))
    if event.get("reason"):
        parts.append("reason=" + str(event.get("reason"))[:140])

    return " | ".join(parts)


