def config_error(message, config_file=None):
    if config_file:
        raise SystemExit(f"Invalid LAI config {config_file}: {message}")
    raise SystemExit(f"Invalid LAI configuration: {message}")


def validate_config_mapping(mapping, *, config_file=None, file_scope=False):
    allowed = CONFIG_FILE_KEYS if file_scope else CONFIG_VALUE_KEYS
    unknown = sorted(set(mapping) - allowed)
    if unknown:
        joined = ", ".join(unknown)
        config_error(f"unknown key(s): {joined}", config_file)


def require_config_string(key, value, *, config_file=None, optional=False):
    if value is None and optional:
        return None
    if not isinstance(value, str):
        config_error(f"{key} must be a string", config_file)
    if not value.strip():
        config_error(f"{key} must not be empty", config_file)
    if "\x00" in value:
        config_error(f"{key} must not contain NUL bytes", config_file)
    return value


def normalize_config_path(key, value, *, config_file=None):
    if value is None:
        return None
    if not isinstance(value, (str, os.PathLike)):
        config_error(f"{key} must be a filesystem path string", config_file)
    text = str(value)
    if not text.strip():
        config_error(f"{key} must not be empty", config_file)
    if "\x00" in text:
        config_error(f"{key} must not contain NUL bytes", config_file)
    return Path(text).expanduser()


def normalize_config_values(values, *, config_file=None, file_scope=False):
    validate_config_mapping(values, config_file=config_file, file_scope=file_scope)
    normalized = dict(values)

    if "port" in normalized:
        raw_port = normalized["port"]
        if isinstance(raw_port, bool):
            config_error("port must be an integer from 1 to 65535", config_file)
        try:
            normalized["port"] = int(raw_port)
        except (TypeError, ValueError) as exc:
            config_error("port must be an integer from 1 to 65535", config_file)
        if not 1 <= normalized["port"] <= 65535:
            config_error("port must be an integer from 1 to 65535", config_file)

    for key in CONFIG_REQUIRED_STRING_KEYS:
        if key in normalized:
            normalized[key] = require_config_string(
                key, normalized[key], config_file=config_file,
            )

    for key in CONFIG_OPTIONAL_STRING_KEYS:
        if key in normalized:
            normalized[key] = require_config_string(
                key, normalized[key], config_file=config_file, optional=True,
            )
            if normalized[key] is not None:
                host = normalized[key]
                if any(ch.isspace() for ch in host) or "://" in host or "/" in host:
                    config_error(
                        "host must be a hostname or IP address, not a URL or path",
                        config_file,
                    )

    for key in CONFIG_PATH_KEYS:
        if key in normalized:
            normalized[key] = normalize_config_path(
                key, normalized[key], config_file=config_file,
            )

    return normalized


def load_configuration(argv, environ=None, home=None):
    environ = dict(os.environ if environ is None else environ)
    home = Path.home() if home is None else Path(home)
    remaining = list(argv)
    cli = {}

    while remaining and remaining[0] in CONFIG_OPTIONS:
        option = remaining.pop(0)
        if not remaining:
            raise SystemExit(f"Missing value for {option}")
        cli[CONFIG_OPTIONS[option]] = remaining.pop(0)

    cli = normalize_config_values(cli)

    default_config_dir = Path(
        environ.get(
            "LAI_CONFIG_DIR",
            Path(environ.get("XDG_CONFIG_HOME", home / ".config")) / "lai",
        )
    ).expanduser()
    config_dir = Path(cli.get("config_dir", default_config_dir)).expanduser()
    config_file = Path(
        cli.get(
            "config_file",
            environ.get("LAI_CONFIG_FILE", config_dir / "config.toml"),
        )
    ).expanduser()

    file_values = {}
    if config_file.is_file():
        try:
            document = tomllib.loads(config_file.read_text(encoding="utf-8"))
        except (OSError, tomllib.TOMLDecodeError) as exc:
            config_error(str(exc), config_file)
        file_values = document.get("lai", {})
        if not isinstance(file_values, dict):
            config_error("[lai] must be a TOML table", config_file)
        file_values = normalize_config_values(
            file_values, config_file=config_file, file_scope=True,
        )

    default_data_dir = Path(
        environ.get(
            "XDG_DATA_HOME",
            home / ".local" / "share",
        )
    ) / "lai"
    defaults = {
        "host": None,
        "port": 8080,
        "model": DEFAULT_MODEL,
        "config_dir": config_dir,
        "config_file": config_file,
        "data_dir": default_data_dir,
        "api_key_file": config_dir / "llama-api-key",
        "skills_dir": None,
        "state_dir": None,
        "metrics_dir": None,
        "audit_dir": None,
        "llama_server": None,
        "server_launcher": "lai-server-start",
        "chat_template": None,
    }
    env_names = {
        key: "LAI_" + key.upper()
        for key in defaults
    }
    env_values = {
        key: environ[name]
        for key, name in env_names.items()
        if name in environ
    }
    values = {**defaults, **file_values}
    values.update(normalize_config_values(env_values))
    values.update(cli)
    values = normalize_config_values(values)

    data_dir = values["data_dir"]
    for key, fallback in {
        "config_dir": config_dir,
        "config_file": config_file,
        "data_dir": data_dir,
        "api_key_file": config_dir / "llama-api-key",
        "skills_dir": data_dir / "skills",
        "state_dir": data_dir / "state",
        "metrics_dir": data_dir / "metrics",
        "audit_dir": data_dir / "audit",
    }.items():
        values[key] = normalize_config_path(key, values.get(key) or fallback)

    return values, remaining


def path_status(path, *, expect_dir=False, expect_file=False, secret=False):
    try:
        if path.exists():
            if expect_dir and not path.is_dir():
                return "ERROR: exists but is not a directory"
            if expect_file and not path.is_file():
                return "ERROR: exists but is not a file"
            if secret and path.is_file() and path.stat().st_size <= 0:
                return "ERROR: file is empty"
            return "OK"
        parent = path.parent
        if parent.exists() and not parent.is_dir():
            return "ERROR: parent exists but is not a directory"
        return "MISSING"
    except OSError as exc:
        return f"ERROR: {exc}"


def render_config_status(config=None):
    config = CONFIG if config is None else config
    lines = [
        "# LAI Config",
        f"Version: {VERSION}",
        "",
        "Effective values:",
    ]
    for key in sorted(config):
        value = config[key]
        if isinstance(value, Path):
            value = str(value)
        lines.append(f"- {key}: {value if value is not None else '[auto]'}")

    checks = [
        ("config_file", config["config_file"], False, True, False),
        ("config_dir", config["config_dir"], True, False, False),
        ("api_key_file", config["api_key_file"], False, True, True),
        ("data_dir", config["data_dir"], True, False, False),
        ("skills_dir", config["skills_dir"], True, False, False),
        ("state_dir", config["state_dir"], True, False, False),
        ("metrics_dir", config["metrics_dir"], True, False, False),
        ("audit_dir", config["audit_dir"], True, False, False),
    ]
    if config.get("llama_server"):
        checks.append(("llama_server", config["llama_server"], False, True, False))
    if config.get("chat_template"):
        checks.append(("chat_template", config["chat_template"], False, True, False))

    lines.extend(["", "Checks:"])
    for key, path, expect_dir, expect_file, secret in checks:
        status = path_status(
            path, expect_dir=expect_dir, expect_file=expect_file, secret=secret,
        )
        lines.append(f"- {key}: {status}")
    lines.extend([
        "",
        "Notes:",
        "- MISSING means the path does not exist yet; it is not fatal for deterministic commands.",
        "- API key contents are never printed.",
    ])
    return "\n".join(lines)


