def run_tool(name, args):
    print(
        f"\n[{name}] "
        f"{json.dumps(args, ensure_ascii=False)}",
        file=sys.stderr,
    )

    started = _metrics_time.perf_counter()

    global LAST_PATCH_HASHES, LAST_PATCH_PATHS

    policy = evaluate_tool_policy(name, args)
    policy_result = render_policy_result(policy)
    if policy_result is not None:
        record_audit_event({
            "type": "policy_decision",
            "tool": name,
            "decision": policy["decision"],
            "reason": policy["reason"],
        })
        duration_ms = (
            _metrics_time.perf_counter()
            - started
        ) * 1000.0
        record_metric_event({
            "type": "tool",
            "name": name,
            "duration_ms": round(duration_ms, 2),
            "ok": False,
            "policy": policy["decision"],
        })
        return policy_result

    audit_patch_paths = []

    if name == "patch":
        audit_patch_paths = [
            str(change.get("path"))
            for change in (
                args.get("changes") or []
            )
            if change.get("path")
        ]
    elif name == "rewrite":
        rewrite_path = args.get("path")
        audit_patch_paths = (
            [str(rewrite_path)]
            if rewrite_path
            else []
        )

    if name in {"patch", "rewrite"}:
        audit_before_hashes = (
            hash_repository_paths(
                audit_patch_paths
            )
        )
    else:
        audit_before_hashes = {}

    try:
        if name == "read":
            result = tool_read(args)
        elif name == "search":
            result = tool_search(args)
        elif name == "list":
            result = tool_list(args)
        elif name == "git":
            result = tool_git(args)
        elif name == "project":
            result = tool_project(args)
        elif name == "inspect":
            result = tool_inspect(args)
        elif name == "patch":
            result = tool_patch(args)
        elif name == "edit":
            result = tool_edit(args)
        elif name == "create":
            result = tool_create(args)
        elif name == "rewrite":
            result = tool_rewrite(args)
        elif name == "bash":
            result = tool_bash(args)
        else:
            result = f"ERROR: unknown tool: {name}"
    except Exception as e:
        result = (
            f"ERROR: {type(e).__name__}: {e}"
        )

    duration_ms = (
        _metrics_time.perf_counter()
        - started
    ) * 1000.0

    if name in {"patch", "rewrite"}:
        audit_after_hashes = (
            hash_repository_paths(
                audit_patch_paths
            )
        )

        LAST_PATCH_PATHS = list(
            audit_patch_paths
        )

        LAST_PATCH_HASHES = dict(
            audit_after_hashes
        )

        record_audit_event({
            "type": name,
            "paths": audit_patch_paths,
            "before_hashes": (
                audit_before_hashes
            ),
            "after_hashes": (
                audit_after_hashes
            ),
            "result": str(result)[:900],
        })

    record_metric_event({
        "type": "tool",
        "name": name,
        "duration_ms": round(duration_ms, 2),
        "ok": not (
            str(result).startswith("ERROR:")
            or str(result).startswith("BLOCKED:")
            or str(result).startswith("POLICY ASK:")
            or str(result).startswith("POLICY DENY:")
        ),
    })

    return result



def api_call(
    host,
    messages,
    use_tools=True,
    max_tokens=2048,
    tools=None,
):
    payload = {
        "model": MODEL,
        "messages": messages,
        "temperature": 0,
        "max_tokens": max_tokens,
    }

    selected_tools = (
        TOOLS
        if tools is None
        else tools
    )

    if use_tools and selected_tools:
        payload["tools"] = selected_tools
        payload["tool_choice"] = "auto"

    key = llama_api_key()

    req = urllib.request.Request(
        f"http://{host}:{LLAMA_PORT}/v1/chat/completions",
        data=json.dumps(payload).encode(),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {key}",
        },
    )

    started = _metrics_time.perf_counter()

    try:
        with urllib.request.urlopen(
            req,
            timeout=180,
        ) as response:
            result = json.loads(
                response.read().decode()
            )
    except Exception as e:
        duration_ms = (
            _metrics_time.perf_counter()
            - started
        ) * 1000.0

        record_metric_event({
            "type": "api",
            "duration_ms": round(duration_ms, 2),
