def print_lai_metrics():
    if not METRICS_FILE.is_file():
        print("# lai metrics")
        print()
        print("No metrics recorded yet.")
        return

    events = []

    try:
        lines = METRICS_FILE.read_text(
            errors="replace"
        ).splitlines()[-2500:]

        for line in lines:
            try:
                payload = json.loads(line)
            except Exception:
                continue
            if runtime_record_schema_supported(payload):
                events.append(payload)
    except Exception as e:
        print(f"ERROR reading metrics: {e}")
        return

    runs = {}

    for event in events:
        run_id = event.get("run_id")

        if not run_id:
            continue

        run = runs.setdefault(
            run_id,
            {
                "ts": event.get("ts"),
                "repo": event.get("repo"),
                "mode": event.get("mode", "unknown"),
                "api_calls": 0,
                "tool_calls": 0,
                "prompt_tokens": 0,
                "completion_tokens": 0,
                "api_ms": 0.0,
                "tool_ms": 0.0,
                "tools": {},
                "limits": [],
            },
        )

        if event.get("type") == "run_start":
            run["mode"] = event.get(
                "mode",
                run["mode"],
            )
            run["ts"] = event.get(
                "ts",
                run["ts"],
            )

        elif event.get("type") == "api":
            run["api_calls"] += 1
            run["prompt_tokens"] += int(
                event.get("prompt_tokens") or 0
            )
            run["completion_tokens"] += int(
                event.get("completion_tokens") or 0
            )
            run["api_ms"] += float(
                event.get("duration_ms") or 0
            )

        elif event.get("type") == "tool":
            run["tool_calls"] += 1
            run["tool_ms"] += float(
                event.get("duration_ms") or 0
            )

            name = event.get("name", "unknown")
            run["tools"][name] = (
                run["tools"].get(name, 0) + 1
            )

        elif event.get("type") == "agent_limit":
            run["limits"].append(event)

    ordered = sorted(
        runs.values(),
        key=lambda item: item.get("ts") or "",
    )

    recent = ordered[-10:]

    print("# lai metrics")
    print()
    print(f"Metrics file: {METRICS_FILE}")
    print(f"Recorded runs: {len(ordered)}")
    print()

    print("## Recent runs")

    if not recent:
        print("[none]")
    else:
        for run in recent:
            compute_s = (
                run["api_ms"]
                + run["tool_ms"]
            ) / 1000.0

            tools = ", ".join(
                f"{name}:{count}"
                for name, count
                in sorted(run["tools"].items())
            ) or "-"

            limits = []
            for limit in run["limits"]:
                reason = str(limit.get("reason") or "unknown")
                if reason == "exploration_budget_exhausted":
                    limits.append(
                        reason
                        + f" trigger={limit.get('trigger', '[unknown]')}"
                        + f" exploration={limit.get('exploration_calls', 0)}/"
                        + str(limit.get("exploration_budget", 0))
                    )
                elif reason == "overall_round_limit_reached":
                    limits.append(
                        reason
                        + f" round_limit={limit.get('round_limit', 0)}"
                    )

            limit_text = "; ".join(limits) or "-"

            print(
                f"- {run['ts']} "
                f"mode={run['mode']} "
                f"api={run['api_calls']} "
                f"tools={run['tool_calls']} "
                f"prompt={run['prompt_tokens']} "
                f"completion={run['completion_tokens']} "
                f"compute={compute_s:.2f}s "
                f"[{tools}] "
                f"limits=[{limit_text}]"
            )

    print()
    print("## By mode (recent history)")

    by_mode = {}

    for run in ordered[-50:]:
        mode = run["mode"]

        stat = by_mode.setdefault(
            mode,
            {
                "runs": 0,
                "api": 0,
                "tools": 0,
                "prompt": 0,
                "completion": 0,
                "api_ms": 0.0,
            },
        )

        stat["runs"] += 1
        stat["api"] += run["api_calls"]
        stat["tools"] += run["tool_calls"]
        stat["prompt"] += run["prompt_tokens"]
        stat["completion"] += run["completion_tokens"]
        stat["api_ms"] += run["api_ms"]

    for mode, stat in sorted(by_mode.items()):
        n = max(1, stat["runs"])

        print(
            f"- {mode}: "
            f"runs={stat['runs']} "
            f"avg_api={stat['api'] / n:.1f} "
            f"avg_tools={stat['tools'] / n:.1f} "
            f"avg_prompt={stat['prompt'] / n:.0f} "
            f"avg_completion={stat['completion'] / n:.0f} "
            f"avg_inference={stat['api_ms'] / n / 1000:.2f}s"
        )




