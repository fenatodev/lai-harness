def gateway():
    configured = CONFIG.get("host")

    if configured:
        return configured

    return subprocess.check_output(
        "ip route | awk '/default/ {print $3; exit}'",
        shell=True,
        text=True,
    ).strip()


def safe_path(value):
    p = (ROOT / value).resolve()

    try:
        p.relative_to(ROOT)
    except ValueError:
        raise ValueError("Path outside repository is blocked")

    return p


