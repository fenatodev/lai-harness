SNAPSHOT_MAX_FILE_BYTES = 500_000


def run_snapshot_path(run_id=None):
    safe_run_id = re.sub(r"[^A-Za-z0-9_.-]+", "-", str(run_id or RUN_ID)).strip(".-")
    if not safe_run_id:
        safe_run_id = "unknown"
    path = STATE_BASE.parent / "snapshots" / f"{safe_run_id}.json"
    try:
        path.resolve().relative_to(ROOT.resolve())
    except ValueError:
        return path
    raise RuntimeError("snapshot directory must be outside repository")


def normalize_snapshot_path(raw_path):
    rel = str(raw_path or "").replace("\\", "/").strip()
    while rel.startswith("./"):
        rel = rel[2:]
    if not rel or Path(rel).is_absolute():
        return None
    return rel


def build_file_snapshot(rel):
    normalized = normalize_snapshot_path(rel)
    if not normalized:
        return {"path": str(rel or ""), "status": "skipped", "reason": "invalid path"}
    root_real = ROOT.resolve()
    candidate = root_real / normalized
    try:
        resolved = candidate.resolve()
        resolved.relative_to(root_real)
    except Exception:
        return {"path": normalized, "status": "skipped", "reason": "path escapes repository"}
    cursor = root_real
    for part in Path(normalized).parts:
        cursor = cursor / part
        if cursor.is_symlink():
            return {"path": normalized, "status": "skipped", "reason": "symlink path"}
    if not candidate.exists():
        return {"path": normalized, "status": "captured", "exists": False, "sha256": None, "content": None}
    if not candidate.is_file():
        return {"path": normalized, "status": "skipped", "reason": "not a file"}
    data = candidate.read_bytes()
    sha = hashlib.sha256(data).hexdigest()
    if len(data) > SNAPSHOT_MAX_FILE_BYTES:
        return {"path": normalized, "status": "skipped", "reason": "file too large", "exists": True, "sha256": sha}
    try:
        content = data.decode("utf-8")
    except UnicodeDecodeError:
        return {"path": normalized, "status": "skipped", "reason": "non-utf8 file", "exists": True, "sha256": sha}
    return {"path": normalized, "status": "captured", "exists": True, "sha256": sha, "content": content}


def load_run_snapshots(run_id=None):
    path = run_snapshot_path(run_id)
    if not path.is_file():
        return None
    data = json.loads(path.read_text(encoding="utf-8", errors="replace"))
    if data.get("schema_version") != RUNTIME_RECORD_SCHEMA_VERSION:
        raise ValueError("unsupported snapshot schema")
    if data.get("root") != str(ROOT):
        raise ValueError("snapshot repository mismatch")
    return data


def save_run_snapshots(payload):
    path = run_snapshot_path(payload.get("run_id"))
    text = json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    _atomic_write_text(path, text)
    return path


def capture_prewrite_snapshots(run_id, paths):
    normalized = []
    for raw in paths or []:
        rel = normalize_snapshot_path(raw)
        if rel and rel not in normalized:
            normalized.append(rel)
    if not normalized:
        return None
    try:
        existing = load_run_snapshots(run_id) or {}
    except Exception:
        existing = {}
    records = {item.get("path"): item for item in existing.get("files") or [] if isinstance(item, dict)}
    for rel in normalized:
        records.setdefault(rel, build_file_snapshot(rel))
    payload = {
        "schema_version": RUNTIME_RECORD_SCHEMA_VERSION,
        "product": PRODUCT_NAME,
        "version": VERSION,
        "root": str(ROOT),
        "run_id": str(run_id),
        "snapshot_kind": "prewrite",
        "max_file_bytes": SNAPSHOT_MAX_FILE_BYTES,
        "files": [records[key] for key in sorted(records)],
        "updated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    save_run_snapshots(payload)
    return payload


