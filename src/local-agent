                if __import__("os").environ.get("LAI_DEBUG_GATE") == "1":
                    print(
                        "\n[GATE_DRAFT]\n" + content,
                        file=sys.stderr,
                    )

                findings = re.findall(
                    r"(?ms)^\s*(\d+)\.\s+(.*?)(?=^\s*\d+\.\s+|\Z)",
                    content,
                )

                if not findings:
                    if "nenhum problema concreto" in content.lower():
                        print("Nenhum problema concreto encontrado no escopo revisado.")
                    else:
                        print(content)
                    return

                def clean_finding_body(body):
                    body = re.sub(
                        r"(?ms)\n\s*(?:---\s*\n)?\s*"
                        r"(?:\*\*)?Nenhum problema "
                        r"(?=[^\n]*\bconcreto\b)"
                        r"(?=[^\n]*\badicional\b)"
                        r"[^\n]*(?:\*\*)?\.?\s*$",
                        "",
                        body,
                    )
                    return body.strip()

                draft_index = {
                    int(number): clean_finding_body(body)
                    for number, body in findings
                }

                if mode == "review":
                    def review_finding_is_deterministically_unsupported(body):
                        low = body.lower()

                        # Findings that explicitly admit there is no concrete defect
                        # and only speculate about ambiguity/policy are not review issues.
                        speculative_policy_terms = (
                            "ambiguity",
                            "ambiguidade",
                            "misalignment",
                            "desalinhamento",
                            "operational practices",
                            "práticas operacionais",
                            "praticas operacionais",
                            "without clarifying",
                            "sem esclarecer",
                            "risk of unintended",
                            "risco de comportamento",
                            "could introduce ambiguity",
                            "pode introduzir ambiguidade",
                        )

                        admits_no_concrete_flaw = any(term in low for term in (
                            "does not introduce a security flaw",
                            "não introduz uma falha de segurança",
                            "nao introduz uma falha de seguranca",
                            "not a security flaw",
                            "não é uma falha de segurança",
                            "nao e uma falha de seguranca",
                            "not a concrete problem",
                            "não é um problema concreto",
                            "nao e um problema concreto",
                        ))

                        speculative_policy_finding = any(
                            term in low
                            for term in speculative_policy_terms
                        )

                        concrete_failure_terms = (
                            "crash",
                            "exception",
                            "incorrect",
                            "wrong result",
                            "regression",
                            "data loss",
                            "command injection",
                            "sql injection",
                            "authorization bypass",
                            "authentication bypass",
                            "race condition",
                            "deadlock",
                            "falha",
                            "erro de execução",
                            "erro de execucao",
                            "resultado incorreto",
                            "regressão",
                            "regressao",
                            "perda de dados",
                            "injeção",
                            "injecao",
                            "bypass",
                        )

                        has_concrete_failure = any(
                            term in low
                            for term in concrete_failure_terms
                        )

                        concrete_doc_contradiction = any(
                            term in low
                            for term in (
                                "contradicts",
                                "contradiction",
                                "contradiz",
                                "contradição",
                                "contradicao",
                                "conflicts with",
                                "conflita com",
                                "inconsistent with",
                                "inconsistente com",
                                "explicitly allows",
                                "explicitly forbids",
                                "permite explicitamente",
                                "proíbe explicitamente",
                                "proibe explicitamente",
                            )
                        )

                        if (
                            speculative_policy_finding
                            and not has_concrete_failure
                            and not concrete_doc_contradiction
                            and (
                                git_review_docs_only
                                or admits_no_concrete_flaw
                            )
                        ):
                            return True

                        # ${VAR} is interpolation, not secret disclosure by itself.
                        has_env_interpolation = bool(
                            re.search(r"\$\{[A-Za-z_][A-Za-z0-9_]*(?::-[^}]*)?\}", body)
                        )
                        claims_secret_exposure = any(term in low for term in (
                            "expõe a senha",
                            "expoe a senha",
                            "senha exposta",
                            "secret exposure",
                            "segredo exposto",
                            "credenciais em claro",
                        ))
                        has_concrete_secret_evidence = any(term in low for term in (
                            "hardcoded",
                            "hard-coded",
                            "valor literal",
                            "senha literal",
                            ".env commit",
                            ".env version",
                            "log contém",
                            "log contem",
                        ))

                        if (
                            has_env_interpolation
                            and claims_secret_exposure
                            and not has_concrete_secret_evidence
                        ):
                            return True

                        # A host port mapping is not proof of internet/public exposure.
                        has_port_mapping = bool(
                            re.search(r'["\']?\d{2,5}:\d{2,5}["\']?', body)
                        )
                        claims_public_exposure = any(term in low for term in (
                            "publicamente",
                            "internet",
                            "public exposure",
                            "exposta publicamente",
                            "exposto publicamente",
                        ))
                        has_public_exposure_evidence = any(term in low for term in (
                            "0.0.0.0",
                            "firewall desabilitado",
                            "firewall disabled",
                            "public ip",
                            "ip público",
                            "ip publico",
                        ))

                        if (
                            has_port_mapping
                            and claims_public_exposure
                            and not has_public_exposure_evidence
                        ):
                            return True

                        return False

                    draft_index = {
                        number: body
                        for number, body in draft_index.items()
                        if not review_finding_is_deterministically_unsupported(body)
                    }

                    if not draft_index:
                        print("Nenhum problema concreto encontrado no escopo revisado.")
                        return

                    findings = [
                        (str(number), body)
                        for number, body in sorted(draft_index.items())
                    ]

                if mode == "security":
                    verifier_system = """You are a strict evidence classifier for defensive security findings.

Decide which numbered findings are directly supported by the repository evidence provided.

KEEP a finding when the evidence establishes a concrete security-relevant source, data/control flow, and dangerous sink or security boundary violation.

Examples of sufficient evidence:
- repository documentation says a value comes directly from an HTTP request, and code interpolates that value into a shell command executed with shell=True: KEEP command injection;
- untrusted input reaches SQL string construction without parameterization: KEEP SQL injection;
- authorization-sensitive action is reachable without the required authorization check: KEEP broken authorization.

DROP a finding when exploitability depends entirely on facts absent from repository evidence.
DROP duplicated findings that describe the same root cause.
DROP missing optional hardening presented as a vulnerability.
Environment-variable interpolation such as ${POSTGRES_PASSWORD} is not itself secret exposure.
Docker port mapping such as 5432:5432 proves host exposure only, not public/internet exposure.

Do not rewrite findings.
Do not explain.
Do not add findings.

Output exactly one of:
KEEP: NONE
KEEP: 1
KEEP: 1,3"""
                else:
                    verifier_system = """You are a strict evidence classifier for software review findings.

Decide which numbered findings are directly supported by the repository evidence provided.

KEEP a finding only when the evidence establishes the actual problem being claimed.
DROP it when the risk depends on deployment state, firewall state, secret handling, configuration, requirements, or other facts not present in the evidence.
DROP optional configuration presented as a defect.
DROP findings whose own reasoning admits there is no evidence of the claimed problem.
Environment-variable interpolation such as ${POSTGRES_PASSWORD} is not secret exposure.
Docker port mapping such as 5432:5432 proves host exposure only, not public/internet exposure.

Do not rewrite findings.
Do not explain.
Do not add findings.

Output exactly one of:
KEEP: NONE
KEEP: 1
KEEP: 1,3"""

                indexed_draft = "\\n\\n".join(
                    f"[{number}]\\n{body}"
                    for number, body in findings
                )

                verifier_messages = [
                    {"role": "system", "content": verifier_system},
                    {
                        "role": "user",
                        "content": (
                            f"PEDIDO ORIGINAL:\\n{task}\\n\\n"
                            f"FINDINGS:\\n{indexed_draft}\\n\\n"
                            f"EVIDÊNCIAS COLETADAS:\\n{evidence_text}"
