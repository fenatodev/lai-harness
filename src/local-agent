def _context_make_targets(limit=80):
    makefile = ROOT / "Makefile"
    targets = []
    seen = set()
    try:
        for line in makefile.read_text(encoding="utf-8", errors="replace").splitlines():
            if not line or line.startswith(("\t", "#", ".")) or ":" not in line:
                continue
            left = line.split(":", 1)[0].strip()
            if not left or "=" in left or "%" in left:
                continue
            for raw in left.split():
                name = raw.strip()
                if not re.fullmatch(r"[A-Za-z0-9_.-]+", name):
                    continue
                if name not in seen:
                    seen.add(name)
                    targets.append(name)
    except OSError:
        return []
    preferred = [name for name in CONTEXT_CHECK_TARGET_ORDER if name in seen]
    remaining = sorted(name for name in targets if name not in set(preferred))
    return (preferred + remaining)[:max(1, min(int(limit), 120))]


def _context_test_file_summary(rel):
    path = ROOT / rel
    summary = {"path": rel, "classes": 0, "tests": 0, "parser": "unknown"}
    if path.suffix.lower() != ".py":
        summary["parser"] = "unsupported_suffix"
        return summary
    try:
        if path.stat().st_size > 1024 * 1024:
            summary["parser"] = "too_large"
            return summary
        tree = ast.parse(path.read_text(encoding="utf-8", errors="replace"), filename=rel)
    except (OSError, SyntaxError, UnicodeError):
        summary["parser"] = "unavailable"
        return summary
    classes = 0
    tests = 0
    for node in ast.walk(tree):
        if isinstance(node, ast.ClassDef) and node.name.endswith("Test"):
            classes += 1
        elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name.startswith("test_"):
            tests += 1
    summary.update({"classes": classes, "tests": tests, "parser": "ok"})
    return summary


def context_checks_payload(limit=40):
    limit = max(1, min(int(limit), 120))
    inventory = repository_context_inventory(max_files=CONTEXT_INVENTORY_LIMIT)
    test_paths = sorted(
        rel for rel in inventory
        if rel.startswith("tests/") and Path(rel).name.startswith("test_") and rel.endswith(".py")
    )
    summaries = [_context_test_file_summary(rel) for rel in test_paths[:limit]]
    changed = sorted(context_git_changed_paths())
    docs_only = bool(changed) and all(
        rel.endswith((".md", ".txt")) or rel.startswith("docs/") for rel in changed
    )
    runtime_changed = any(
        rel.startswith("src/") or rel.startswith(".cursor/hooks/") or rel.startswith("tests/")
        for rel in changed
    )
    suggestions = []
    if changed:
        suggestions.append({"check": "focused regression", "reason": "validate touched behavior before broad gates"})
    if docs_only:
        suggestions.append({"check": "make check", "reason": "documentation/static validation is usually enough during active development"})
    elif runtime_changed:
        suggestions.append({"check": "make test", "reason": "runtime or tests changed; run dependency-free regression before install"})
        suggestions.append({"check": "make check", "reason": "syntax/static gate before committing"})
    else:
        suggestions.append({"check": "make check", "reason": "general static validation before committing"})
    suggestions.append({"check": "make milestone-gate", "reason": "reserve for milestone or release freeze, not every small edit"})
    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "checks_version": 1,
        "repository": ".",
        "metadata_only": True,
        "inspected_content": False,
        "make_targets": _context_make_targets(),
        "validation_profiles": ["test", "check", "lint", "typecheck", "build", "full"],
        "test_files": summaries,
        "test_file_count": len(test_paths),
        "test_file_limit": limit,
        "test_file_list_truncated": len(test_paths) > limit,
        "test_count": sum(int(item.get("tests") or 0) for item in summaries),
        "changed_path_count": len(changed),
        "changed_paths_sample": changed[:20],
        "suggested_feedback": suggestions,
        "trust": "Advisory validation metadata only. Run the selected command before claiming evidence.",
    }


