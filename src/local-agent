PROJECT_HANDOFF_DEFAULT_BASE = Path("/tmp")


def project_handoff_default_dir(expected_tag):
    return PROJECT_HANDOFF_DEFAULT_BASE / f"lai-harness-project-handoff-{release_pack_slug(expected_tag)}"


def parse_project_handoff_args(args):
    raw = list(args)
    json_mode = False
    remote = False
    force = False
    out_dir = None
    target = None
    positional = []
    index = 0
    while index < len(raw):
        item = raw[index]
        if item == "--json":
            json_mode = True
        elif item == "--remote":
            remote = True
        elif item == "--force":
            force = True
        elif item == "--target":
            index += 1
            if index >= len(raw):
                raise SystemExit(PROJECT_HANDOFF_USAGE)
            target = raw[index]
        elif item == "--out":
            index += 1
            if index >= len(raw):
                raise SystemExit(PROJECT_HANDOFF_USAGE)
            out_dir = raw[index]
        elif item.startswith("-"):
            raise SystemExit(PROJECT_HANDOFF_USAGE)
        else:
            positional.append(item)
        index += 1

    if positional:
        if len(positional) == 1 and target is None:
            target = positional[0]
        else:
            raise SystemExit(PROJECT_HANDOFF_USAGE)

    return {"target": target, "remote": remote, "out_dir": out_dir, "force": force, "json": json_mode}


def project_handoff_resolve_out_dir(raw_out, expected_tag):
    target = Path(raw_out).expanduser() if raw_out else project_handoff_default_dir(expected_tag)
    target = target.resolve()
    if release_pack_path_is_inside(target, ROOT):
        raise SystemExit("Refusing to write project handoff inside the repository; use --out under /tmp or another external directory")
    return target


def project_handoff_payload(target=None, remote=False):
    release_payload = collect_release_check(target=target)
    governance_local = collect_release_governance(target=target, remote=False)
    governance_remote = collect_release_governance(target=target, remote=True) if remote else None
    governance_effective = governance_remote or governance_local
    safe_workspace = collect_safe_workspace_status([])
    spec = load_active_spec()
    active_spec = None
    if spec is not None:
        try:
            spec_path = str(spec["path"].relative_to(ROOT))
        except ValueError:
            spec_path = str(spec["path"])
        active_spec = {
            "path": spec_path,
            "title": spec.get("title"),
            "mode": spec.get("mode"),
            "status": spec.get("status"),
            "requirements": spec.get("requirements") or [],
        }

    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "target_version": release_payload["target_version"],
        "expected_tag": release_payload["expected_tag"],
        "repository": str(ROOT),
        "public_repository": "fenatodev/lai-harness",
        "local_checkout": str(ROOT),
        "branch": release_payload.get("branch"),
        "head": release_payload.get("head"),
        "latest_tag": release_payload.get("latest_tag"),
        "exact_tag": release_payload.get("exact_tag"),
        "release_check_overall": release_payload.get("overall"),
        "release_check_phase": release_payload.get("phase"),
        "release_governance_overall": governance_effective.get("overall"),
        "release_governance_local_overall": governance_local.get("overall"),
        "release_governance_remote_overall": governance_remote.get("overall") if governance_remote else None,
        "release_governance_remote_enabled": bool(governance_remote),
        "release_governance_remote": (governance_remote or {}).get("remote", {"enabled": False}),
        "release_pack": governance_effective.get("release_pack"),
        "manual_actions": governance_effective.get("manual_actions"),
        "safe_workspace_base": safe_workspace.get("base_dir"),
        "safe_workspace_count": len(safe_workspace.get("workspaces") or []),
        "active_spec": active_spec,
        "current_model": DEFAULT_MODEL,
        "server": {
            "default_host": str(CONFIG.get("host")),
            "default_port": int(CONFIG.get("port", 0) or 0),
            "model": str(CONFIG.get("model") or DEFAULT_MODEL),
