def project_handoff_default_dir(expected_tag):
    return PROJECT_HANDOFF_DEFAULT_BASE / f"lai-harness-project-handoff-{release_pack_slug(expected_tag)}"


def parse_project_handoff_args(args):
    raw = list(args)
    json_mode = False
    remote = False
    force = False
    out_dir = None
    target = None
    positional = []
    index = 0
    while index < len(raw):
        item = raw[index]
        if item == "--json":
            json_mode = True
        elif item == "--remote":
            remote = True
        elif item == "--force":
            force = True
        elif item == "--target":
            index += 1
            if index >= len(raw):
                raise SystemExit(PROJECT_HANDOFF_USAGE)
            target = raw[index]
        elif item == "--out":
            index += 1
            if index >= len(raw):
                raise SystemExit(PROJECT_HANDOFF_USAGE)
            out_dir = raw[index]
        elif item.startswith("-"):
            raise SystemExit(PROJECT_HANDOFF_USAGE)
        else:
            positional.append(item)
        index += 1

    if positional:
        if len(positional) == 1 and target is None:
            target = positional[0]
        else:
            raise SystemExit(PROJECT_HANDOFF_USAGE)

    return {"target": target, "remote": remote, "out_dir": out_dir, "force": force, "json": json_mode}


def project_handoff_resolve_out_dir(raw_out, expected_tag):
