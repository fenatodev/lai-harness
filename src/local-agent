def parse_run_history_limit(args, default=20):
    if "--limit" not in args:
        return default
    index = args.index("--limit")
    try:
        value = int(args[index + 1])
    except Exception:
        raise SystemExit("Invalid --limit value")
    if value < 1 or value > 200:
        raise SystemExit("--limit must be between 1 and 200")
    del args[index:index + 2]
    return value


def handle_run_history(args):
    raw = list(args)
    json_mode = "--json" in raw
    raw = [item for item in raw if item != "--json"]

    command = raw[0] if raw else "list"

    if command == "list":
        limit = parse_run_history_limit(raw, default=10)
        print(render_run_history_list(limit=limit, json_mode=json_mode))
        return

    if command == "last":
        print(render_run_history_show("--last", json_mode=json_mode))
        return

    if command == "show":
        if len(raw) < 2:
            raise SystemExit("Usage: lai run show <run-id|--last>")
        print(render_run_history_show(raw[1], json_mode=json_mode))
        return

    if command == "tail":
        if len(raw) < 2:
            raise SystemExit("Usage: lai run tail <run-id|--last> [--limit N]")
        limit = parse_run_history_limit(raw, default=20)
        print(render_run_history_tail(raw[1], limit=limit, json_mode=json_mode))
        return

    if command == "export":
        if len(raw) < 2:
            raise SystemExit("Usage: lai run export <run-id|--last> [--out DIR] [--json]")
        out_dir = parse_run_history_out_dir(raw)
        print(render_run_history_export(raw[1], out_dir=out_dir, json_mode=json_mode))
        return

    raise SystemExit("Usage: lai runs [--limit N] | lai run last | lai run show <run-id|--last> | lai run tail <run-id|--last> [--limit N] | lai run export <run-id|--last> [--out DIR]")


def git_origin_url():
    try:
        proc = subprocess.run(
            ["git", "remote", "get-url", "origin"],
            cwd=ROOT,
            text=True,
            capture_output=True,
            timeout=10,
        )
        if proc.returncode != 0:
            return "[missing]"
        return proc.stdout.strip() or "[missing]"
    except Exception:
        return "[unavailable]"


def skill_contract_capability_report(mode, contract):
    declared = contract.get("declared") or {}
    declared_tools = set(declared.get("tools") or [])
    try:
        available_tools = set(tool_names_for_mode(mode))
    except Exception:
        available_tools = set()
    known_capabilities = {
        "instructions", "repository-context", "read-repository", "rank-context",
        "validate", "write-workspace", "sandbox-exec", "web-evidence",
        "mcp-fixture", "review-output", "security-review", "debug-python",
    }
    declared_capabilities = set(declared.get("capabilities") or [])
    return {
        "schema_version": SKILL_CONTRACT_SCHEMA_VERSION,
        "declared_schema_version": contract.get("declared_schema_version"),
        "version": contract.get("version"),
        "provenance": contract.get("provenance"),
        "capabilities": sorted(declared_capabilities),
        "tools": sorted(declared_tools),
        "context": list(declared.get("context") or []),
        "validation": list(declared.get("validation") or []),
        "outputs": list(declared.get("outputs") or []),
        "available_tools": sorted(available_tools & declared_tools),
        "missing_tools": sorted(declared_tools - available_tools),
        "missing_capabilities": sorted(declared_capabilities - known_capabilities),
        "unknown_metadata_fields": list(contract.get("unknown_metadata_fields") or []),
        "authority_claims": list(contract.get("authority_claims") or []),
        "grants_authority": False,
        "executes_hooks_on_load": False,
        "tool_permissions_from_skill": False,
        "body_sha256": contract.get("body_sha256"),
    }


def configured_mode_skill_status(mode):
    standard = Path(SKILLS_DIR) / mode / "SKILL.md"
    legacy = Path(SKILLS_DIR) / f"{mode}.txt"
    bundled = ROOT / ".agents" / "skills" / mode / "SKILL.md"

    if standard.is_file():
        try:
            contract = parse_standard_skill_contract(standard, expected_name=mode)
            return {
                "mode": mode,
                "status": "ok",
                "path": str(standard),
                "contract": skill_contract_capability_report(mode, contract),
            }
        except Exception as exc:
            return {
                "mode": mode,
                "status": "fail",
                "path": str(standard),
                "detail": str(exc)[:200],
            }

    if legacy.is_file():
        return {
            "mode": mode,
            "status": "warn",
            "path": str(legacy),
            "detail": "legacy skill format",
            "contract": {
                "schema_version": 0,
                "grants_authority": False,
                "executes_hooks_on_load": False,
                "tool_permissions_from_skill": False,
            },
        }

    if bundled.is_file():
        return {"mode": mode, "status": "warn", "path": str(bundled), "detail": "bundled but not installed"}

    return {"mode": mode, "status": "fail", "path": str(standard), "detail": "missing skill"}


def collect_readiness_status():
    checks = []

    def add_check(name, status, detail=""):
        checks.append({
            "name": name,
            "status": status,
            "detail": str(detail or "")[:500],
        })

    git_branch = workspace_git_branch()
    git_status = workspace_git_status()
    git_clean = git_status == "[clean]"
    origin = git_origin_url()

    add_check(
        "git_branch",
        "fail" if git_branch == "[unavailable]" else "ok",
        git_branch,
    )
    add_check(
        "git_status",
        "ok" if git_clean else "warn",
        git_status,
    )
    add_check(
        "git_origin",
        "ok" if "fenatodev/lai-harness" in origin else "warn",
        origin,
    )

    path_checks = {
        "config_dir": path_status(CONFIG["config_dir"], expect_dir=True),
        "api_key_file": path_status(CONFIG["api_key_file"], expect_file=True, secret=True),
        "data_dir": path_status(CONFIG["data_dir"], expect_dir=True),
        "skills_dir": path_status(CONFIG["skills_dir"], expect_dir=True),
        "metrics_dir": path_status(CONFIG["metrics_dir"], expect_dir=True),
        "audit_dir": path_status(CONFIG["audit_dir"], expect_dir=True),
    }
    for name, detail in path_checks.items():
        status = "ok" if detail == "OK" else ("warn" if detail == "MISSING" else "fail")
        add_check(name, status, detail)

    skill_modes = [
        "plan",
        "debug",
        "diagnose",
        "test",
        "review",
        "security",
        "fix",
        "ci-fix",
        "refactor",
        "implement",
        "release",
    ]
    skills = [configured_mode_skill_status(mode) for mode in skill_modes]
    failing_skills = [item for item in skills if item["status"] == "fail"]
    warning_skills = [item for item in skills if item["status"] == "warn"]
    add_check(
        "mode_skills",
        "fail" if failing_skills else ("warn" if warning_skills else "ok"),
        (
            "missing=" + ",".join(item["mode"] for item in failing_skills)
            if failing_skills
            else (
                "legacy_or_bundled=" + ",".join(item["mode"] for item in warning_skills)
                if warning_skills
                else "all standard skills available"
            )
        ),
    )

    try:
        host = gateway()
    except Exception as exc:
        host = "[unavailable]"
        unauthenticated = 0
        authenticated = 0
        server_detail = str(exc)[:300]
    else:
        try:
            unauthenticated, authenticated = doctor_status(host)
            server_detail = f"unauthenticated={unauthenticated or '000'} authenticated={authenticated or '000'}"
        except Exception as exc:
            unauthenticated = 0
            authenticated = 0
            server_detail = str(exc)[:300]

    server_ok = authenticated == 200 and unauthenticated != 200
    add_check(
        "server_authentication",
        "ok" if server_ok else "fail",
        server_detail,
    )

    try:
        active_spec = load_active_spec()
        if active_spec is None:
            spec_status = {"status": "none"}
        else:
            try:
                spec_path = str(active_spec["path"].relative_to(ROOT))
            except Exception:
                spec_path = str(active_spec.get("path"))
            spec_status = {
                "status": active_spec.get("status"),
                "mode": active_spec.get("mode"),
                "path": spec_path,
                "requirements": active_spec.get("requirements", []),
            }
        add_check("active_spec", "ok", spec_status.get("status"))
    except SystemExit as exc:
        spec_status = {"status": "error", "detail": str(exc)}
        add_check("active_spec", "fail", str(exc))

    try:
        recovery = inspect_recovery_checkpoint()
        recovery_status = {
            "status": recovery.get("status"),
            "resumable": bool(recovery.get("resumable")),
            "reasons": recovery.get("reasons") or [],
        }
        add_check(
            "recovery",
            "warn" if recovery_status["resumable"] else "ok",
            recovery_status.get("status"),
        )
    except Exception as exc:
        recovery_status = {"status": "error", "resumable": False, "reasons": [str(exc)]}
        add_check("recovery", "fail", str(exc))

    runs = collect_run_history()
    latest = latest_run_history_record(runs)
    latest_public = run_history_public_record(latest) if latest else None
    add_check(
        "run_history",
        "ok" if latest else "warn",
        f"recorded={len(runs)}",
    )

    fatal_failures = {
        "git_branch",
        "api_key_file",
        "mode_skills",
        "server_authentication",
        "active_spec",
        "recovery",
    }
    has_fatal_failure = any(
        check["status"] == "fail" and check["name"] in fatal_failures
        for check in checks
    )
    has_warning = any(check["status"] == "warn" for check in checks)
    overall = "blocked" if has_fatal_failure else ("attention" if has_warning else "ready")

    return {
        "product": PRODUCT_NAME,
        "version": VERSION,
        "repository": str(ROOT),
        "overall": overall,
        "git": {
            "branch": git_branch,
            "status": git_status,
