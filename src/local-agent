            if mode == "implement":
                final_paths = sorted(
                    modified_paths
                )

                record_audit_event({
                    "type": "final",
                    "modified_paths": (
                        final_paths
                    ),
                    "final_hashes": (
                        hash_repository_paths(
                            final_paths
                        )
                    ),
                    "answer": content[:1200],
                })

            if mode in {"review", "security"}:
                evidence = []

                if git_review_snapshot:
