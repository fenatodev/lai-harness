    for relative_path, content in (fixture.get("files") or {}).items():
        model_evaluation_write_fixture_file(repo, relative_path, content)
    model_evaluation_git(repo, "init", "-q")
    model_evaluation_git(repo, "checkout", "-q", "-b", "test/model-eval")
    model_evaluation_git(repo, "config", "user.name", "LAI Model Eval")
    model_evaluation_git(repo, "config", "user.email", "model-eval@example.invalid")
    model_evaluation_git(repo, "add", "-A")
    model_evaluation_git(repo, "commit", "-q", "-m", "fixture baseline")
    for relative_path, content in (fixture.get("pre_run_changes") or {}).items():
        model_evaluation_write_fixture_file(repo, relative_path, content)
    baseline_diff = model_evaluation_git(repo, "diff", "--binary").stdout
    baseline_paths = model_evaluation_changed_paths(repo)
    return repo, baseline_diff, baseline_paths


