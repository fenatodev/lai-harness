def handle_update_intelligence(args):
    command = args[0] if args else "plan"
    rest = args[1:] if args else []
    json_mode = "--json" in rest
    unexpected = [item for item in rest if item not in {"--json", "--remote"}]
    if unexpected:
        raise SystemExit(
            "Usage: lai update [plan [--json]|check --remote [--json]|latest [--json]|triage [--json]]"
        )
    if command == "plan":
        if "--remote" in rest:
            raise SystemExit("lai update plan is offline; remove --remote")
        return render_update_plan(json_mode=json_mode)
    if command == "check":
        if "--remote" not in rest:
            raise SystemExit("lai update check requires explicit --remote")
        try:
            return render_update_check(run_update_check(), json_mode=json_mode)
        except (OSError, ValueError) as exc:
            raise SystemExit(f"Update intelligence check failed: {exc}") from exc
    if command == "latest":
        if "--remote" in rest:
            raise SystemExit("lai update latest is local-only; remove --remote")
        try:
            return render_update_latest(json_mode=json_mode)
        except (OSError, ValueError) as exc:
            raise SystemExit(f"Update intelligence latest failed: {exc}") from exc
    if command == "triage":
        if "--remote" in rest:
            raise SystemExit("lai update triage is local-only; remove --remote")
        try:
            return render_update_triage(json_mode=json_mode)
        except (OSError, ValueError) as exc:
            raise SystemExit(f"Update intelligence triage failed: {exc}") from exc
    raise SystemExit(
        "Usage: lai update [plan [--json]|check --remote [--json]|latest [--json]|triage [--json]]"
    )


