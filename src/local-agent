        "stderr": record.get("stderr", ""),
        "stdout_truncated": bool(record.get("stdout_truncated")),
        "stderr_truncated": bool(record.get("stderr_truncated")),
        "cancel_requested": bool(record.get("cancel_requested")),
        "tool_profile": record.get("tool_profile", CONTROL_RUN_TOOL_PROFILE),
        "sandbox_executor": record.get("sandbox_executor"),
        "session_id": record.get("session_id"),
