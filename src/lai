#!/usr/bin/env bash
set -euo pipefail

bin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
command_name="${1:-}"

case "$command_name" in
    doctor)
        shift
        exec "$bin_dir/local-agent" "$@" --doctor
        ;;
    server-start|server-stop|server-restart)
        shift
        exec "$bin_dir/lai-$command_name" "$@"
        ;;
    config)
        shift
        exec "$bin_dir/local-agent" "$@" --config-status
        ;;
    status|metrics|audit|handoff|clear-context|recovery|context|semantics|runs|readiness|ready|release-check|workspace)
        shift
        if [ "$command_name" = "ready" ]; then
            exec "$bin_dir/local-agent" --readiness "$@"
        fi
        if [ "$command_name" = "release-check" ]; then
            exec "$bin_dir/local-agent" --release-check "$@"
        fi
        if [ "$command_name" = "workspace" ]; then
            exec "$bin_dir/local-agent" --workspace "$@"
        fi
        exec "$bin_dir/local-agent" "--$command_name" "$@"
        ;;
    semantic)
        shift
        exec "$bin_dir/local-agent" --semantics "$@"
        ;;
    run)
        shift
        exec "$bin_dir/local-agent" --run "$@"
        ;;
    model|models)
        shift
        exec "$bin_dir/local-agent" --model-eval "$@"
        ;;
    plan|debug|diagnose|fix|ci-fix|test|review|security|refactor|implement|release)
        shift
        exec "$bin_dir/local-agent" "--$command_name" "$@"
        ;;
    spec)
        shift
        exec "$bin_dir/local-agent" --spec-status "$@"
        ;;
    resume)
        shift
        exec "$bin_dir/local-agent" --resume "$@"
        ;;
    version)
        exec "$bin_dir/local-agent" --version
        ;;
    "")
        exec "$bin_dir/local-agent"
        ;;
    *)
        exec "$bin_dir/local-agent" "$@"
        ;;
esac
